/* Tailles */
.ic--xs { width: 24rpx; height: 24rpx; }
.ic--sm { width: 30rpx; height: 30rpx; }
.ic--md { width: 36rpx; height: 36rpx; }
.ic--lg { width: 52rpx; height: 52rpx; }
.ic--xl { width: 64rpx; height: 64rpx; }

/* Icône + texte sur une ligne (badges, boutons, puces) */
.ic-row { display: inline-flex; align-items: center; gap: 8rpx; }

/* Pastille ronde (remplace le caractère « • »), prend la couleur du texte */
.ui-dot {
  display: inline-block;
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: currentColor;
  font-size: 0;
}

/* Alignement icône / texte même si le conteneur reste en display: block */
.ic-row > .ic { vertical-align: middle; }
