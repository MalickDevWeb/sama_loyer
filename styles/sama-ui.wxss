/* ==========================================================================
   SAMA LOYER — éléments communs des écrans (d'après la maquette)
   Échelle : 1 px maquette = 2 rpx. À importer en tête du .wxss d'une page :
   @import "/styles/sama-ui.wxss";
   ========================================================================== */

@import "/styles/icons.wxss";

page {
  background: var(--sl-white);
  color: var(--sl-text);
  font-family: var(--sl-font);
}

/* --- Barre du haut (retour + titre) -------------------------------------- */
.sl-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--sl-white);
  border-bottom: 2rpx solid var(--sl-divider);
}

.sl-topbar__inner {
  height: 120rpx;
  box-sizing: border-box;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sl-topbar__title {
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
}

.sl-icon-btn {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sl-icon-btn--soft {
  background: var(--sl-surface-3);
}

.sl-icon-btn--glass {
  background: rgba(255, 255, 255, 0.12);
}

.sl-hover {
  opacity: 0.75;
}

/* --- Barre d'action en bas ----------------------------------------------- */
.sl-bottombar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  box-sizing: border-box;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--sl-border);
  background: var(--sl-white);
  display: flex;
  gap: 20rpx;
}

.sl-bottom-spacer {
  height: calc(220rpx + env(safe-area-inset-bottom));
}

/* --- Boutons ------------------------------------------------------------- */
.sl-btn {
  flex: 1;
  height: 112rpx;
  border-radius: 32rpx;
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  text-align: center;
  box-sizing: border-box;
}

.sl-btn--berry {
  background: var(--sl-berry);
  color: var(--sl-on-dark);
}

.sl-btn--navy {
  background: var(--sl-navy);
  color: var(--sl-on-dark);
}

.sl-btn--outline {
  background: var(--sl-white);
  border: 2rpx solid var(--sl-border);
  color: var(--sl-text);
  font-weight: var(--sl-fw-bold);
}

.sl-btn--outline-navy {
  background: var(--sl-white);
  border: 4rpx solid var(--sl-navy);
  color: var(--sl-text);
}

.sl-btn--soft {
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
  padding: 0 24rpx;
}

.sl-btn--success-soft {
  background: var(--sl-success-soft);
  color: var(--sl-success-text);
}

/* --- Case à cocher (ligne entière cliquable) ------------------------------ */
.sl-check-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 16rpx 28rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  border: 4rpx solid var(--sl-border);
  background: var(--sl-white);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.sl-check-row--on {
  background: var(--sl-success-soft);
  border-color: var(--sl-success);
}

.sl-check-row--berry.sl-check-row--on {
  background: var(--sl-berry-soft);
  border-color: var(--sl-berry);
}

.sl-check-row--locked {
  color: #A3AAB8;
}

.sl-check-box {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 4rpx solid var(--sl-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sl-check-row--on .sl-check-box {
  border: 0;
  background: var(--sl-success);
}

.sl-check-row--berry.sl-check-row--on .sl-check-box {
  background: var(--sl-berry);
}

.sl-check-box .ic {
  width: 28rpx;
  height: 28rpx;
}

/* --- Interrupteur -------------------------------------------------------- */
.sl-switch {
  position: relative;
  width: 96rpx;
  height: 56rpx;
  flex: 0 0 96rpx;
  border-radius: 28rpx;
  background: var(--sl-border-strong);
  transition: background 0.15s;
}

.sl-switch--on {
  background: var(--sl-success);
}

.sl-switch__knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: var(--sl-white);
  transition: left 0.15s;
}

.sl-switch--on .sl-switch__knob {
  left: 46rpx;
}

/* --- Carte « l'essentiel » (4 chiffres clés) ------------------------------ */
.sl-keys {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.sl-key {
  padding: 24rpx;
  border-radius: 32rpx;
  background: var(--sl-surface-2);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sl-key__label {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.sl-key__value {
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
}

.sl-key__sub {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
}

/* --- Articles de contrat (accordéon) ------------------------------------- */
.sl-articles {
  border-radius: 40rpx;
  background: var(--sl-white);
  border: 2rpx solid var(--sl-border);
  overflow: hidden;
}

.sl-article {
  border-bottom: 2rpx solid var(--sl-divider);
}

.sl-article__head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
}

.sl-article__num {
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 20rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sl-surface-3);
  color: var(--sl-text);
}

.sl-article--open .sl-article__num {
  background: var(--sl-berry);
  color: var(--sl-on-dark);
}

.sl-article__titles {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sl-article__title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.sl-article__hint {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.sl-article__chev {
  width: 36rpx;
  height: 36rpx;
  transition: transform 0.2s;
}

.sl-article--open .sl-article__chev {
  transform: rotate(180deg);
}

.sl-article__text {
  display: block;
  padding: 0 32rpx 32rpx 116rpx;
  font-size: var(--sl-fs-body);
  line-height: 1.6;
  color: var(--sl-text-2);
}

/* --- Bouton audio (résumé en wolof) -------------------------------------- */
.sl-audio {
  margin-top: 24rpx;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
}

.sl-audio--playing {
  background: var(--sl-berry);
  color: var(--sl-on-dark);
}

.sl-audio__label {
  flex: 1;
}

.sl-audio__dur {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  opacity: 0.8;
}

.sl-audio .ic {
  width: 40rpx;
  height: 40rpx;
}

.sl-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 40rpx;
}

.sl-wave__bar {
  width: 6rpx;
  height: 40rpx;
  border-radius: 4rpx;
  background: currentColor;
  animation: sl-wave 0.8s ease-in-out infinite;
}

.sl-wave__bar:nth-child(2) {
  animation-delay: 0.15s;
}

.sl-wave__bar:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes sl-wave {
  0%, 100% { transform: scaleY(0.35); }
  50% { transform: scaleY(1); }
}

/* --- Message de confirmation (toast) ------------------------------------- */
.sl-toast {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  z-index: 80;
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
}

/* --- Badges -------------------------------------------------------------- */
.sl-badge {
  flex: 0 0 auto;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
}

.sl-badge--navy {
  background: var(--sl-navy);
  color: var(--sl-on-dark);
}

.sl-badge--green {
  background: var(--sl-success);
  color: var(--sl-on-dark);
}

/* --- Max it (simulation) : fenêtre de paiement partagée ------------------- */
.sl-mx-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(15, 30, 61, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.sl-mx {
  width: 100%;
  border-radius: 48rpx;
  background: var(--sl-white);
  padding: 44rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.sl-mx-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 60rpx;
  background: var(--sl-berry-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sl-mx-icon .ic {
  width: 56rpx;
  height: 56rpx;
}

.sl-mx-title {
  font-size: var(--sl-fs-h3);
  font-weight: var(--sl-fw-extrabold);
}

.sl-mx-title--sm {
  font-size: var(--sl-fs-title);
}

.sl-mx-amount {
  font-size: 60rpx;
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.02em;
}

.sl-mx-to {
  font-size: var(--sl-fs-body);
  color: var(--sl-text-2);
}

.sl-mx-note {
  font-size: var(--sl-fs-body-sm);
  line-height: 1.5;
  color: var(--sl-muted);
  background: var(--sl-surface-2);
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
}

.sl-mx-btn {
  flex: none;
  height: 108rpx;
}

.sl-mx-cancel {
  height: 92rpx;
  line-height: 92rpx;
  color: var(--sl-muted);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
}

.sl-mx-spinner {
  width: 112rpx;
  height: 112rpx;
  margin: 24rpx auto 8rpx;
  border-radius: 56rpx;
  border: 10rpx solid var(--sl-berry-border);
  border-top-color: var(--sl-berry);
  box-sizing: border-box;
  animation: sl-spin 0.9s linear infinite;
}

@keyframes sl-spin {
  to { transform: rotate(360deg); }
}

.sl-mx-sim {
  align-self: center;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.12em;
  color: var(--sl-warning-text);
  background: var(--sl-warning-bg);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

.sl-mx-box {
  border: 4rpx dashed var(--sl-border-strong);
  border-radius: 36rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  text-align: left;
}

.sl-mx-brand {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
}

.sl-mx-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  font-size: var(--sl-fs-body);
}

.sl-mx-row--total {
  font-size: var(--sl-fs-subtitle);
  padding-top: 16rpx;
  border-top: 2rpx solid var(--sl-divider);
}

.sl-mx-small {
  font-size: var(--sl-fs-small);
  line-height: 1.5;
  color: var(--sl-muted);
}

.sl-mx-refuse {
  flex: none;
  height: 92rpx;
  color: var(--sl-danger);
  font-size: var(--sl-fs-body);
}

.sl-mx-muted {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.sl-mx-strong {
  font-weight: var(--sl-fw-extrabold);
}

.sl-mx-right {
  text-align: right;
}


/* Masquer les barres de defilement */
::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  color: transparent !important;
}
