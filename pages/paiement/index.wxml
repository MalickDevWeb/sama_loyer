<app-layout
  title="Paiement"
  showBack="{{true}}"
  showLogo="{{false}}"
  transparent="{{true}}"
  showNavBorder="{{false}}"
  showTabBar="{{false}}"
>
  <scroll-view
    class="payment-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="payment-page">
      <view class="payment-summary-card">
        <app-typography
          containerClass="payment-summary-card__label"
          fontSize="24rpx"
          weight="400"
          color="rgba(255, 255, 255, 0.72)"
          lineHeight="44rpx"
        >
          Votre Réservation
        </app-typography>

        <app-typography
          containerClass="payment-summary-card__title"
          fontSize="44rpx"
          weight="700"
          color="#FFFFFF"
          lineHeight="56rpx"
        >
          {{ reservation.title }}
        </app-typography>

        <view class="payment-summary-card__divider"></view>

        <view class="payment-summary-card__meta">
          <view class="payment-summary-card__meta-item">
            <app-typography
              fontSize="25rpx"
              weight="400"
              color="rgba(255, 255, 255, 0.72)"
              lineHeight="36rpx"
            >
              Catégorie
            </app-typography>
            <app-typography
              fontSize="31rpx"
              weight="600"
              color="#FFFFFF"
              lineHeight="42rpx"
            >
              {{ reservation.category }}
            </app-typography>
          </view>

          <view class="payment-summary-card__meta-item">
            <app-typography
              fontSize="25rpx"
              weight="400"
              color="rgba(255, 255, 255, 0.72)"
              lineHeight="36rpx"
            >
              Durée
            </app-typography>
            <app-typography
              fontSize="31rpx"
              weight="600"
              color="#FFFFFF"
              lineHeight="42rpx"
            >
              {{ reservation.duration }}
            </app-typography>
          </view>
        </view>

        <view class="payment-summary-card__divider"></view>

        <view class="payment-summary-card__total">
          <app-typography
            fontSize="27rpx"
            weight="400"
            color="rgba(255, 255, 255, 0.72)"
            lineHeight="40rpx"
          >
            Montant Total
          </app-typography>
          <app-typography
            fontSize="48rpx"
            weight="700"
            color="#FFFFFF"
            lineHeight="58rpx"
            align="right"
          >
            {{ reservation.amount }}
          </app-typography>
        </view>
      </view>

      <app-typography
        containerClass="payment-section-title"
        fontSize="35rpx"
        weight="700"
        color="#1C1C1C"
        lineHeight="48rpx"
      >
        Moyen de Paiement
      </app-typography>

      <view class="payment-secure-card">
        <view class="payment-secure-card__icon">
          <app-icon icon="Vector" width="{{30}}" height="{{38}}" />
        </view>

        <view class="payment-secure-card__copy">
          <app-typography
            fontSize="29rpx"
            weight="700"
            color="#174EA6"
            lineHeight="40rpx"
          >
            Paiement Sécurisé
          </app-typography>
          <app-typography
            containerClass="payment-secure-card__description"
            fontSize="28rpx"
            weight="400"
            color="#0F52FF"
            lineHeight="44rpx"
          >
            Toutes les transactions sont cryptées et traitées de manière sécurisée via la super-app Max It. Vos informations de paiement ne sont jamais stockées.
          </app-typography>
        </view>
      </view>

      <app-typography
        containerClass="payment-terms"
        fontSize="24rpx"
        weight="400"
        color="#7A8094"
        lineHeight="56rpx"
      >
        <view>En finalisant cette réservation, vous acceptez nos</view>
        <view><text class="payment-terms__link" style="font-size: 28rpx;" catchtap="openTerms">Conditions d'Utilisation</text> et notre</view>
        <view><text class="payment-terms__link" style="font-size: 28rpx;" catchtap="openPolicy">Politique d'Annulation</text>. Remboursement complet</view>
        <view>disponible jusqu'à 24h avant le voyage.</view>
      </app-typography>
    </view>
  </scroll-view>

  <view class="payment-footer">
    <app-button
      type="primary"
      buttonClass="payment-pay-button"
      loading="{{ isPaying }}"
      bind:onPress="handlePay"
    >
      <app-typography
        fontSize="32rpx"
        weight="600"
        color="#FFFFFF"
        lineHeight="48rpx"
        align="center"
      >
        Payer {{ reservation.amount }}
      </app-typography>
    </app-button>
  </view>
  </app-layout>




<app-modal
  visible="{{showPolicy}}"
  placement="bottom"
  size="full"
  hasHeader="{{true}}"
  hasContent="{{true}}"
  bind:close="closePolicy"
>
  <view slot="header" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
    <text style="font-weight: 600; font-size: 32rpx; color: #1C1C1C;">Politique d'Annulation</text>
    <view catchtap="closePolicy" style="padding: 10rpx;">
      <icon type="cancel" size="24" color="#666" />
    </view>
  </view>
  <view slot="content" style="max-height: 70vh; padding-bottom: env(safe-area-inset-bottom, 40rpx);">
    <app-cancellation-policy />
  </view>
</app-modal>

<app-modal
  visible="{{showTerms}}"
  placement="bottom"
  size="full"
  hasHeader="{{true}}"
  hasContent="{{true}}"
  bind:close="closeTerms"
>
  <view slot="header" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
    <text style="font-weight: 600; font-size: 32rpx; color: #1C1C1C;">Conditions d'Utilisation</text>
    <view catchtap="closeTerms" style="padding: 10rpx;">
      <icon type="cancel" size="24" color="#666" />
    </view>
  </view>
  <view slot="content" style="max-height: 70vh; padding-bottom: env(safe-area-inset-bottom, 40rpx);">
    <app-terms-of-use />
  </view>
</app-modal>


