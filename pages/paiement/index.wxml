<view class="payment-page">
  <scroll-view class="payment-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête -->
    <view class="pay-header" style="padding-top: {{ statusBarHeight + 12 }}px;">
      <view class="btn-back" bindtap="onBackTap">
        <text class="back-arrow">‹</text>
      </view>
      <text class="pay-title">Règlement du loyer</text>
      <view class="header-placeholder"></view>
    </view>

    <!-- Carte Récapitulative de l'échéance -->
    <view class="echeance-card">
      <view class="echeance-top">
        <text class="echeance-badge">Échéance de loyer</text>
        <text class="echeance-periode">{{ echeance.periode }}</text>
      </view>

      <text class="echeance-property">{{ echeance.logementTitre }}</text>
      <text class="echeance-place">{{ echeance.quartier }}</text>

      <view class="echeance-divider"></view>

      <view class="echeance-detail-row">
        <text class="detail-label">Bénéficiaire</text>
        <text class="detail-val">{{ echeance.bailleurNom }}</text>
      </view>

      <view class="echeance-detail-row">
        <text class="detail-label">Réf. Contrat</text>
        <text class="detail-val">{{ echeance.refLocation }}</text>
      </view>

      <view class="echeance-detail-row">
        <text class="detail-label">Date limite</text>
        <text class="detail-val highlight-date">{{ echeance.dateEcheance }}</text>
      </view>

      <view class="echeance-amount-box">
        <text class="amount-label">Montant à régler :</text>
        <view class="amount-val-group">
          <text class="amount-number">{{ echeance.total }}</text>
          <text class="amount-currency">FCFA</text>
        </view>
      </view>
    </view>

    <!-- Méthode de paiement -->
    <view class="pay-section">
      <text class="section-label">Moyen de paiement sécurisé</text>

      <view
        class="method-card {{ paymentMethod === 'orange_money' ? 'method-card--active' : '' }}"
        data-method="orange_money"
        bindtap="onSelectMethod"
      >
        <view class="method-icon-box om-bg">
          <text class="om-text">OM</text>
        </view>
        <view class="method-info">
          <text class="method-name">Orange Money Sénégal</text>
          <text class="method-desc">Paiement instantané depuis votre compte +221 {{ payerPhone }}</text>
        </view>
        <view class="method-radio {{ paymentMethod === 'orange_money' ? 'radio-checked' : '' }}">
          <view wx:if="{{ paymentMethod === 'orange_money' }}" class="radio-inner"></view>
        </view>
      </view>

      <view
        class="method-card {{ paymentMethod === 'wave' ? 'method-card--active' : '' }}"
        data-method="wave"
        bindtap="onSelectMethod"
      >
        <view class="method-icon-box wave-bg">
          <text class="wave-text">W</text>
        </view>
        <view class="method-info">
          <text class="method-name">Wave Sénégal</text>
          <text class="method-desc">Paiement direct sans frais supplémentaires</text>
        </view>
        <view class="method-radio {{ paymentMethod === 'wave' ? 'radio-checked' : '' }}">
          <view wx:if="{{ paymentMethod === 'wave' }}" class="radio-inner"></view>
        </view>
      </view>
    </view>

    <!-- Garantie et conformité BCEAO -->
    <view class="compliance-box">
      <text class="compliance-icon">🔒</text>
      <text class="compliance-text">Transaction sécurisée direct compte à compte. Aucun code secret ni mot de passe ne vous est demandé sur l’application.</text>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Bouton de paiement fixe -->
  <view class="fixed-pay-bar">
    <button class="btn-pay-now" loading="{{ isProcessing }}" bindtap="onPayRent">
      ⚡ Confirmer et payer {{ echeance.total }} FCFA
    </button>
  </view>

  <!-- ======================================================== -->
  <!-- MODAL QUITTANCE / REÇU HORODATÉ -->
  <!-- ======================================================== -->
  <view wx:if="{{ showReceiptModal }}" class="modal-backdrop" bindtap="onCloseReceipt">
    <view class="receipt-card" catchtap="true">
      
      <view class="receipt-success-badge">
        <text class="check-icon">✓</text>
      </view>

      <text class="receipt-header-title">Quittance de Loyer Électronique</text>
      <text class="receipt-header-sub">SAMA LOGEMENT · Paiement validé</text>

      <view class="receipt-details-box">
        <view class="receipt-row">
          <text class="rec-label">N° Reçu</text>
          <text class="rec-val bold">{{ receiptData.recId }}</text>
        </view>
        <view class="receipt-row">
          <text class="rec-label">Réf. Orange Money</text>
          <text class="rec-val">{{ receiptData.omTx }}</text>
        </view>
        <view class="receipt-row">
          <text class="rec-label">Période acquittée</text>
          <text class="rec-val bold">{{ receiptData.periode }}</text>
        </view>
        <view class="receipt-row">
          <text class="rec-label">Bénéficiaire</text>
          <text class="rec-val">{{ receiptData.bailleur }}</text>
        </view>
        <view class="receipt-row">
          <text class="rec-label">Logement</text>
          <text class="rec-val">{{ receiptData.logement }}</text>
        </view>
        <view class="receipt-row">
          <text class="rec-label">Date & Heure</text>
          <text class="rec-val">{{ receiptData.dateFormatted }}</text>
        </view>
        <view class="receipt-divider"></view>
        <view class="receipt-row total">
          <text class="rec-label total">Montant payé</text>
          <text class="rec-val total">{{ receiptData.montant }} FCFA</text>
        </view>
      </view>

      <view class="receipt-actions">
        <button class="btn-receipt-share" bindtap="onShareReceipt">
          📋 Copier la quittance
        </button>
        <button class="btn-receipt-done" bindtap="onCloseReceipt">
          Terminer
        </button>
      </view>

    </view>
  </view>

</view>
