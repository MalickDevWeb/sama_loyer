<view class="start-page">
  <scroll-view class="start-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête de bienvenue -->
    <view class="start-header" style="padding-top: {{ statusBarHeight + 16 }}px;">
      <view class="brand-badge">
        <view class="icon-svg icon-house-teal"></view>
      </view>
      <text class="brand-title">SAMA LOGEMENT</text>
      <text class="brand-slogan">Trouver. Vérifier. Louer. Payer. Suivre.</text>
    </view>

    <!-- Carte Compte Max it -->
    <view class="maxit-card">
      <view class="maxit-status">
        <text class="check-icon">✓</text>
        <text class="status-text">Connectée avec votre compte Max it</text>
      </view>

      <view class="user-row">
        <view class="user-avatar">
          <text class="avatar-initials">AN</text>
        </view>
        <view class="user-details">
          <text class="user-name">Awa Ndiaye</text>
          <text class="user-phone">+221 77 • • • • • 67</text>
        </view>
      </view>

      <text class="maxit-explanation">
        Sama Logement utilise votre nom et votre numéro Max it pour vos demandes de visite et vos reçus de loyer. Rien d’autre n’est partagé.
      </text>

      <view class="data-link" bindtap="onOpenDataInfo">
        <text class="data-link__text">Voir les données partagées</text>
      </view>
    </view>

    <!-- Section Choix d'action -->
    <view class="choices-section">
      <text class="section-heading">Que voulez-vous faire ?</text>

      <!-- Option 1 : Trouver un logement -->
      <view class="action-card action-card--primary" hover-class="action-card--hover" bindtap="onGoToSearch">
        <view class="action-icon action-icon--search">
          <view class="icon-svg icon-search-white"></view>
        </view>
        <view class="action-text">
          <text class="action-title">Trouver un logement</text>
          <text class="action-desc">Décrivez votre besoin, recevez les 3 meilleures options</text>
        </view>
      </view>

      <!-- Option 2 : Payer mon loyer -->
      <view class="action-card action-card--secondary" hover-class="action-card--hover" bindtap="onGoToPayRent">
        <view class="action-icon action-icon--card">
          <view class="icon-svg icon-card-teal"></view>
        </view>
        <view class="action-text">
          <text class="action-title">Payer mon loyer</text>
          <text class="action-desc">J’ai le code de mon logement donné par le propriétaire</text>
        </view>
      </view>
    </view>

    <!-- Pied de page Propriétaire / Pilote -->
    <view class="start-footer">
      <view class="landlord-link" bindtap="onOpenLandlordSpace">
        <text class="footer-note">Vous êtes propriétaire ? </text>
        <text class="footer-link">L’espace propriétaire a son propre parcours.</text>
      </view>
      <text class="footer-zone">Zone pilote : région de Dakar.</text>
    </view>

  </scroll-view>

  <!-- Modal d'information données partagées Max it -->
  <view wx:if="{{ showDataModal }}" class="modal-backdrop" bindtap="onCloseDataModal">
    <view class="modal-card" catchtap="true">
      <view class="modal-header">
        <text class="modal-title">Données partagées Max it</text>
        <view class="modal-close" bindtap="onCloseDataModal">✕</view>
      </view>
      <view class="modal-content">
        <view class="data-item">
          <text class="data-item__label">👤 Identité :</text>
          <text class="data-item__val">Awa Ndiaye (pour vos quittances de loyer)</text>
        </view>
        <view class="data-item">
          <text class="data-item__label">📱 Téléphone :</text>
          <text class="data-item__val">+221 77 123 45 67 (pour les contacts bailleurs)</text>
        </view>
        <view class="data-item">
          <text class="data-item__label">🔒 Confidentialité :</text>
          <text class="data-item__val">Aucun mot de passe ni code secret Orange Money n'est partagé ou stocké.</text>
        </view>
      </view>
      <button class="btn-modal-confirm" bindtap="onCloseDataModal">Compris</button>
    </view>
  </view>

</view>
