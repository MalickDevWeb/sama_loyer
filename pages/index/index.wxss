/* ============================================================================
   SAMA LOGEMENT — PROFIL & ESPACE BAILLEUR
   ============================================================================ */

.profile-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #F8F9FA;
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #0F1E3D;
}

.profile-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  padding: 0 36rpx calc(150rpx + env(safe-area-inset-bottom));
}

.profile-header {
  margin-bottom: 32rpx;
}

.user-card-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #E4E7EE;
  padding: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 30, 61, 0.04);
}

.user-avatar-circle {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background-color: #0F1E3D;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 110rpx;
}

.user-meta-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.user-phone-sub {
  font-size: 26rpx;
  color: #5B6475;
}

.maxit-verified-chip {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #E2F0EA;
  color: #007C3D;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
}

.chip-check {
  font-weight: 800;
}

/* Commutateur de rôle */
.role-switcher-box {
  display: flex;
  gap: 16rpx;
  background-color: #EAECEF;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 36rpx;
}

.role-switch-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #5B6475;
  transition: all 0.2s;
}

.role-switch-btn--active {
  background-color: #FFFFFF;
  color: #0F1E3D;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(15, 30, 61, 0.08);
}

.role-view {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.profile-section {
  display: flex;
  flex-direction: column;
}

.section-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 16rpx;
}

.section-count {
  font-size: 24rpx;
  color: #7A8294;
}

/* Quittances */
.quittances-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quittance-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  border-radius: 24rpx;
  padding: 24rpx;
}

.quittance-icon {
  font-size: 40rpx;
}

.quittance-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.quittance-period {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.quittance-bailleur {
  font-size: 22rpx;
  color: #5B6475;
}

.quittance-date {
  font-size: 20rpx;
  color: #9CA3AF;
}

.quittance-amount-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.quittance-price {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.quittance-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #FF6600;
  background-color: #FFF2E8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* Visites Locataire */
.visites-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.visite-card {
  background-color: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.visite-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.visite-property {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.visite-status {
  font-size: 20rpx;
  font-weight: 700;
  color: #007C3D;
  background-color: #E2F0EA;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.visite-place {
  font-size: 24rpx;
  color: #5B6475;
}

.visite-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #C8235F;
  margin-top: 4rpx;
}

/* Espace Bailleur */
.bailleur-summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 32rpx;
  border: 2rpx solid #E4E7EE;
}

.summary-stat {
  display: flex;
  flex-direction: column;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 900;
  color: #0F1E3D;
}

.stat-label {
  font-size: 24rpx;
  color: #5B6475;
}

.btn-publish-new {
  height: 80rpx;
  border-radius: 20rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  margin: 0;
}

.bailleur-biens-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bien-card {
  background-color: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bien-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bien-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.bien-status-chip {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.chip-success {
  background-color: #E2F0EA;
  color: #007C3D;
}

.chip-warning {
  background-color: #FFF3CD;
  color: #856404;
}

.bien-place {
  font-size: 24rpx;
  color: #5B6475;
}

.bien-price {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-top: 4rpx;
}

.bien-meta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #F1F3F6;
}

.bien-meta-text {
  font-size: 22rpx;
  color: #5B6475;
}

.bien-confirmation-text {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-left: auto;
}

.reconfirmation-box {
  background-color: #FFF8E6;
  border: 2rpx solid #FFE08A;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reconfirm-text {
  font-size: 22rpx;
  color: #7A5300;
  line-height: 1.35;
}

.btn-reconfirm {
  height: 72rpx;
  border-radius: 16rpx;
  background-color: #0F1E3D;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.reconfirm-ok-box {
  background-color: #E2F0EA;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-top: 14rpx;
}

.reconfirm-ok-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #007C3D;
}

/* Modal publication */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 30, 61, 0.65);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(4px);
}

.publish-sheet {
  width: 100%;
  background-color: #FFFFFF;
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  padding: 36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.publish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.publish-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.modal-close {
  font-size: 36rpx;
  color: #7A8294;
  padding: 8rpx;
}

.publish-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pub-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pub-row {
  display: flex;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

.pub-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.pub-input {
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #F1F3F6;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #0F1E3D;
}

.btn-submit-publish {
  height: 96rpx;
  border-radius: 24rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(200, 35, 95, 0.3);
}

.scroll-spacer {
  height: 60rpx;
}
