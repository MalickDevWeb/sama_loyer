@import "/styles/sama-ui.wxss";

.lsv__body {
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.lsv__intro {
  padding: 36rpx 8rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lsv__h2 {
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
}

.lsv__lead {
  font-size: var(--sl-fs-body);
  line-height: 1.5;
  color: var(--sl-muted);
}

/* Étapes numérotées */
.lsv__step {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 8rpx 20rpx;
}

.lsv__step--spaced {
  margin-top: 44rpx;
}

.lsv__step-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lsv__step-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

/* Photos et vidéo */
.lsv__media-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lsv__media {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  background: var(--sl-white);
  border: 4rpx solid var(--sl-border);
}

.lsv__media--seen {
  background: var(--sl-success-soft);
  border-color: #BFDDCD;
}

.lsv__media-thumb {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lsv__media-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.lsv__media-label {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.lsv__media-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.lsv__video-call {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  border: 2rpx dashed var(--sl-border-strong);
}

.lsv__video-call .ic {
  width: 40rpx;
  height: 40rpx;
}

.lsv__call-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

/* Garanties */
.lsv__guards {
  border-radius: 36rpx;
  background: var(--sl-surface-2);
  padding: 12rpx 28rpx;
}

.lsv__guard {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--sl-border);
}

.lsv__guard-icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
}

.lsv__guard-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.lsv__guard-desc {
  font-size: var(--sl-fs-small);
  line-height: 1.45;
  color: var(--sl-muted);
}

.lsv__checks {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ============================================================================
   POPUP MODAL ÉLÉGANT SAMA LOYER (Adapté aux couleurs de l'app)
   ============================================================================ */
.sama-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background-color: rgba(15, 30, 61, 0.65);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  animation: fadeIn 0.25s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popUp {
  from { opacity: 0; transform: translateY(30rpx) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.sama-modal-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  background-color: var(--sl-white);
  border-radius: 40rpx;
  padding: 48rpx 36rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 20rpx 50rpx rgba(15, 30, 61, 0.25);
  animation: popUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-close-round {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: var(--sl-surface-3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sl-muted);
  font-size: var(--sl-fs-body-sm);
}

.modal-illu-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--sl-berry-soft) 0%, #FFE3EE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(200, 35, 95, 0.15);
}

.modal-illu-emoji {
  font-size: 56rpx;
}

.modal-title {
  font-size: var(--sl-fs-title-lg);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 12rpx;
  letter-spacing: -0.01em;
}

.modal-desc {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.modal-actions-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.modal-media-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: var(--sl-bg);
  border: 3rpx solid var(--sl-border);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  text-align: left;
  transition: all 0.2s;
}

.modal-media-item--done {
  background-color: var(--sl-success-soft);
  border-color: #BFDDCD;
}

.modal-media-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sl-fs-title-sm);
  flex-shrink: 0;
}

.icon--photos {
  background-color: #FBE3EC;
}

.icon--video {
  background-color: var(--sl-info-bg);
}

.modal-media-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.modal-media-name {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.modal-media-detail {
  font-size: var(--sl-fs-caption);
  color: var(--sl-placeholder);
  margin-top: 2rpx;
}

.modal-media-status {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
}

.status--pending {
  background-color: var(--sl-berry);
  color: var(--sl-on-dark);
}

.status--done {
  background-color: var(--sl-success);
  color: var(--sl-on-dark);
}

.btn-modal-confirm {
  width: 100%;
  height: 104rpx;
  border-radius: 28rpx;
  background-color: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  box-shadow: 0 8rpx 24rpx rgba(200, 35, 95, 0.3);
  border: none;
}

.modal-close-link {
  margin-top: 24rpx;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-placeholder);
  font-weight: var(--sl-fw-bold);
  padding: 8rpx;
}

/* ============================================================================
   NOTIFICATION FLOTTANTE SAMA LOYER
   ============================================================================ */
.sama-floating-toast {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 10000;
  display: flex;
  justify-content: center;
  pointer-events: auto;
}

.toast-pill-body {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: rgba(15, 30, 61, 0.95);
  backdrop-filter: blur(14px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
  padding: 14rpx 26rpx 14rpx 18rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.28);
}

.toast-icon-wrapper {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.toast-icon--success { background: linear-gradient(135deg, #059669 0%, #10B981 100%); }
.toast-icon--warning { background: linear-gradient(135deg, var(--sl-berry) 0%, #E83D84 100%); }

.toast-symbol {
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
}

.toast-text-block {
  display: flex;
  flex-direction: column;
}

.toast-title-text {
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
}

.toast-subtitle-text {
  color: #CBD5E1;
  font-size: var(--sl-fs-micro);
}

.toast-badge-sparkle {
  font-size: var(--sl-fs-small);
  margin-left: 6rpx;
}

.toast--show {
  animation: toastPopIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.toast--hide {
  animation: toastFadeOut 0.25s ease-in forwards;
}

@keyframes toastPopIn {
  from { opacity: 0; transform: translateY(-20rpx) scale(0.94); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes toastFadeOut {
  from { opacity: 1; transform: translateY(0) scale(1); }
  to { opacity: 0; transform: translateY(-16rpx) scale(0.94); }
}


/* --- Vignettes photo / vidéo ---------------------------------------------- */
.lsv__media-thumb {
  overflow: hidden;
}

.lsv__media-play {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lsv__media-play .ic {
  width: 28rpx;
  height: 28rpx;
}

/* --- Lecteur vidéo -------------------------------------------------------- */
.lsv__player-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(8, 15, 32, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.lsv__player {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.lsv__player-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lsv__player-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-on-dark);
}

.lsv__player-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lsv__player-close .ic {
  width: 28rpx;
  height: 28rpx;
}

.lsv__player-video {
  width: 100%;
  height: 420rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.lsv__player-btn {
  flex: none;
}
