<view class="cmsg">
  <!-- En-tête -->
  <view class="cmsg__header" style="padding-top: {{ statusBarHeight + 22 }}px;">
    <text class="cmsg__title">Messages</text>
    <text class="cmsg__subtitle">Tes échanges avec les bailleurs</text>
  </view>

  <!-- Recherche -->
  <view class="cmsg__search">
    <view class="ic ic-search-muted cmsg__search-ic"></view>
    <input
      class="cmsg__search-input"
      value="{{ query }}"
      placeholder="Nom ou quartier"
      placeholder-class="cmsg__placeholder"
      confirm-type="search"
      aria-label="Rechercher une conversation"
      bindinput="onSearchInput"
    />
  </view>

  <!-- Onglets -->
  <view class="cmsg__tabs">
    <view
      wx:for="{{ tabs }}"
      wx:key="id"
      class="cmsg__pill {{ filter === item.id ? 'cmsg__pill--on' : '' }}"
      data-id="{{ item.id }}"
      bindtap="onSelectFilter"
    >{{ item.label }}</view>
  </view>

  <!-- Liste -->
  <view class="cmsg__list">
    <view
      wx:for="{{ visible }}"
      wx:key="id"
      class="cmsg__conv"
      hover-class="cmsg__conv--hover"
      data-id="{{ item.id }}"
      bindtap="onOpenChat"
      aria-label="{{ item.aria }}"
    >
      <view class="cmsg__avatar-wrap">
        <view class="cmsg__avatar" style="background: {{ item.avatarBg }};">{{ item.initial }}</view>
        <view wx:if="{{ item.verified }}" class="cmsg__verified">
          <view class="ic ic-check-white cmsg__verified-ic"></view>
        </view>
      </view>

      <view class="cmsg__body">
        <view class="cmsg__row">
          <text class="cmsg__name {{ item.unread ? 'cmsg__name--unread' : '' }}">{{ item.name }}</text>
          <text class="cmsg__time {{ item.unread ? 'cmsg__time--unread' : '' }}">{{ item.time }}</text>
        </view>
        <text class="cmsg__listing">{{ item.property }}</text>
        <view class="cmsg__row">
          <text class="cmsg__last {{ item.unread ? 'cmsg__last--unread' : '' }}">{{ item.snippet }}</text>
          <text wx:if="{{ item.unread }}" class="cmsg__unread">{{ item.unread }}</text>
        </view>
        <view wx:if="{{ item.visiteBadge }}" class="cmsg__status">
          <view class="ic ic-cal-navy cmsg__status-ic"></view>
          <text>{{ item.visiteBadge }}</text>
        </view>
      </view>
    </view>

    <!-- Vide -->
    <view wx:if="{{ !visible.length }}" class="cmsg__empty">
      <text class="cmsg__empty-title">Aucune conversation</text>
      <text class="cmsg__empty-text">Quand tu contactes un bailleur, la discussion apparaît ici.</text>
      <view class="sl-btn sl-btn--berry cmsg__empty-btn" hover-class="sl-hover" bindtap="onSearchHome">Chercher un logement</view>
    </view>
  </view>

  <view class="cmsg__tab-spacer"></view>
</view>
