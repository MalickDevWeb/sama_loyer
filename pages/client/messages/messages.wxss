@import "/styles/sama-ui.wxss";

/* ============================================================================
   SAMA LOYER — Messages (locataire), d'après la maquette Messages
   ============================================================================ */

.cmsg__header {
  padding-top: 14rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.cmsg__title {
  display: block;
  font-size: var(--sl-fs-h1);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.02em;
}

.cmsg__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: var(--sl-fs-body);
  color: var(--sl-muted);
}

/* --- Recherche ----------------------------------------------------------- */
.cmsg__search {
  margin: 32rpx 40rpx 0;
  height: 100rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: var(--sl-surface-3);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cmsg__search-ic {
  width: 36rpx;
  height: 36rpx;
}

.cmsg__search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-medium);
  color: var(--sl-text);
}

.cmsg__placeholder {
  color: var(--sl-placeholder);
}

/* --- Onglets ------------------------------------------------------------- */
.cmsg__tabs {
  padding: 28rpx 40rpx 0;
  display: flex;
  gap: 16rpx;
}

.cmsg__pill {
  height: 80rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  display: flex;
  align-items: center;
  background: var(--sl-white);
  color: var(--sl-text);
  border: 2rpx solid var(--sl-border);
}

.cmsg__pill--on {
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  border-color: var(--sl-navy);
}

/* --- Liste --------------------------------------------------------------- */
.cmsg__list {
  padding: 24rpx 24rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.cmsg__conv {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 16rpx;
  border-radius: 36rpx;
  border-bottom: 2rpx solid var(--sl-divider);
}

.cmsg__conv--hover {
  background: var(--sl-surface-2);
}

.cmsg__avatar-wrap {
  position: relative;
  flex: 0 0 104rpx;
}

.cmsg__avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmsg__verified {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: var(--sl-success);
  border: 4rpx solid var(--sl-white);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmsg__verified-ic {
  width: 20rpx;
  height: 20rpx;
}

.cmsg__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cmsg__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.cmsg__name {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-bold);
}

.cmsg__name--unread {
  font-weight: var(--sl-fw-extrabold);
}

.cmsg__time {
  flex: 0 0 auto;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-medium);
  color: var(--sl-muted);
}

.cmsg__time--unread {
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.cmsg__listing {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-berry);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cmsg__last {
  flex: 1;
  min-width: 0;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cmsg__last--unread {
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.cmsg__unread {
  flex: 0 0 auto;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmsg__status {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--sl-info-bg);
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.cmsg__status-ic {
  width: 24rpx;
  height: 24rpx;
}

/* --- Vide ---------------------------------------------------------------- */
.cmsg__empty {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.cmsg__empty-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

.cmsg__empty-text {
  margin: 12rpx 0 32rpx;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.cmsg__empty-btn {
  flex: none;
  height: 92rpx;
  padding: 0 36rpx;
}

.cmsg__tab-spacer {
  height: calc(156rpx + env(safe-area-inset-bottom));
}

/* --- Ligne simplifiée : nom + statut ------------------------------------- */
.cmsg__conv {
  align-items: center;
}

.cmsg__body {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.cmsg__name {
  flex: 1;
  min-width: 0;
  font-size: var(--sl-fs-subtitle);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cmsg__right {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cmsg__tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  background: var(--sl-surface-3);
  color: var(--sl-muted);
}

.cmsg__tag--visit { background: var(--sl-berry-tint); color: var(--sl-berry); }
.cmsg__tag--ok    { background: var(--sl-success-bg); color: var(--sl-success); }
.cmsg__tag--wait  { background: var(--sl-info-bg); color: var(--sl-text); }
.cmsg__tag--off   { background: var(--sl-surface-3); color: var(--sl-placeholder); }

.cmsg__chev {
  opacity: 0.6;
}
