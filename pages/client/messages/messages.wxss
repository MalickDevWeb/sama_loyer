@import "/styles/sama-ui.wxss";

/* ============================================================================
   SAMA LOYER — Messages (locataire), d'après la maquette Messages
   ============================================================================ */

.cmsg__header {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.cmsg__title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.cmsg__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #5B6475;
}

/* --- Recherche ----------------------------------------------------------- */
.cmsg__search {
  margin: 32rpx 40rpx 0;
  height: 100rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: #F1F3F6;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cmsg__search-ic {
  width: 36rpx;
  height: 36rpx;
}

.cmsg__search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #0F1E3D;
}

.cmsg__placeholder {
  color: #7A8294;
}

/* --- Onglets ------------------------------------------------------------- */
.cmsg__tabs {
  padding: 28rpx 40rpx 0;
  display: flex;
  gap: 16rpx;
}

.cmsg__pill {
  height: 80rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  color: #0F1E3D;
  border: 2rpx solid #E4E7EE;
}

.cmsg__pill--on {
  background: #0F1E3D;
  color: #FFFFFF;
  border-color: #0F1E3D;
}

/* --- Liste --------------------------------------------------------------- */
.cmsg__list {
  padding: 24rpx 24rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.cmsg__conv {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 16rpx;
  border-radius: 36rpx;
  border-bottom: 2rpx solid #EEF0F4;
}

.cmsg__conv--hover {
  background: #F7F8FA;
}

.cmsg__avatar-wrap {
  position: relative;
  flex: 0 0 104rpx;
}

.cmsg__avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmsg__verified {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #11643F;
  border: 4rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmsg__verified-ic {
  width: 20rpx;
  height: 20rpx;
}

.cmsg__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cmsg__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.cmsg__name {
  font-size: 30rpx;
  font-weight: 700;
}

.cmsg__name--unread {
  font-weight: 800;
}

.cmsg__time {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 500;
  color: #5B6475;
}

.cmsg__time--unread {
  font-weight: 800;
  color: #C8235F;
}

.cmsg__listing {
  font-size: 24rpx;
  font-weight: 700;
  color: #C8235F;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cmsg__last {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #5B6475;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cmsg__last--unread {
  font-weight: 700;
  color: #0F1E3D;
}

.cmsg__unread {
  flex: 0 0 auto;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #C8235F;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmsg__status {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #E3E9F5;
  font-size: 22rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.cmsg__status-ic {
  width: 24rpx;
  height: 24rpx;
}

/* --- Vide ---------------------------------------------------------------- */
.cmsg__empty {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.cmsg__empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.cmsg__empty-text {
  margin: 12rpx 0 32rpx;
  font-size: 26rpx;
  color: #5B6475;
}

.cmsg__empty-btn {
  flex: none;
  height: 92rpx;
  padding: 0 36rpx;
}

.cmsg__tab-spacer {
  height: calc(156rpx + env(safe-area-inset-bottom));
}
