<!-- pages/loyers/loyers.wxml -->
<view class="mon-loyer-page">
  <scroll-view class="mon-loyer-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" style="padding-top: {{ statusBarHeight + 12 }}px;">
    
    <!-- En-tête de la page -->
    <view class="page-top-header">
      <text class="page-main-heading">Mon loyer</text>
      <text class="page-sub-heading">2 logements · chacun avec son bailleur et ses reçus</text>
    </view>

    <!-- Synthèse Dark Card (Novembre - tous mes logements) -->
    <view class="dark-synthese-card">
      <view class="synthese-top-row">
        <text class="synthese-month-label">Novembre · tous mes logements</text>
        <text class="synthese-counter-badge">{{ nbPayes }} / {{ nbTotal }} payé(s)</text>
      </view>
      
      <view class="synthese-amount-row">
        <text class="synthese-amount-num">{{ totalRestant }}</text>
        <text class="synthese-amount-desc">restent à payer sur {{ totalGlobal }}</text>
      </view>

      <!-- Barre de progression à 2 segments -->
      <view class="progress-bar-track">
        <block wx:for="{{ logements }}" wx:key="id">
          <view class="progress-bar-segment {{ item.isPaid ? 'segment-paid' : 'segment-unpaid' }}"></view>
        </block>
      </view>
    </view>

    <!-- Sélecteur horizontal : Mes logements -->
    <view class="section-mes-logements">
      <text class="section-block-title">Mes logements</text>
      <scroll-view class="logements-horizontal-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="logements-row">
          <block wx:for="{{ logements }}" wx:key="id">
            <view 
              class="logement-tab-card {{ selectedLogementId === item.id ? 'tab-card--selected' : '' }}"
              data-id="{{ item.id }}"
              bindtap="onSelectLogementTab"
            >
              <view class="logement-thumb-square" style="background-color: {{ item.avatarBg }};">
                <text class="thumb-house-icon">⌂</text>
              </view>
              <view class="logement-tab-info">
                <text class="tab-logement-title">{{ item.shortTitle }}</text>
                <text class="tab-logement-price">{{ item.loyerFormatted }} / mois</text>
                <view class="tab-status-chip {{ item.isPaid ? 'chip-paid' : 'chip-due' }}">
                  {{ item.isPaid ? '✓ Réglé' : 'À payer' }}
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- Carte descriptive du logement sélectionné -->
    <view class="current-selected-card">
      <text class="selected-prop-title">{{ currentLogement.fullTitle }}</text>
      <text class="selected-prop-sub">{{ currentLogement.place }} · Bailleur : {{ currentLogement.bailleurNom }}</text>
      <text class="selected-prop-date">{{ currentLogement.depuis }}</text>
    </view>

    <!-- Grosse Carte Berry Pink "Loyer de novembre" -->
    <view class="pink-due-card">
      <view class="pink-card-header">
        <text class="pink-card-month">{{ currentLogement.moisActuel }}</text>
        <view class="pink-due-badge {{ currentLogement.isPaid ? 'badge-green-pill' : 'badge-white-pill' }}">
          {{ currentLogement.isPaid ? '✓ Payé' : 'À payer' }}
        </view>
      </view>

      <view class="pink-amount-value">
        {{ currentLogement.loyerFormatted }}
      </view>

      <text class="pink-deadline-txt">
        {{ currentLogement.isPaid ? 'Loyer de novembre réglé avec succès' : currentLogement.echeance }}
      </text>

      <button 
        wx:if="{{ !currentLogement.isPaid }}" 
        class="btn-white-pay-cta" 
        bindtap="onOpenPayModal"
      >
        Payer ce loyer
      </button>
      <view wx:else class="paid-success-banner">
        <text class="paid-check-symbol">✓</text>
        <text class="paid-check-label">Reçu officiel disponible ci-dessous</text>
      </view>
    </view>

    <!-- Deux cartes côte-à-côte (Caution & Contrat) -->
    <view class="two-columns-row">
      <!-- Colonne 1 : Caution -->
      <view class="sub-info-card">
        <text class="sub-card-label">Caution</text>
        <text class="sub-card-value">{{ currentLogement.cautionMontant }}</text>
        <text class="sub-card-detail">{{ currentLogement.cautionDetail }}</text>
        <view class="mint-confirmed-badge">
          {{ currentLogement.cautionBadge }}
        </view>
      </view>

      <!-- Colonne 2 : Contrat -->
      <view class="sub-info-card">
        <text class="sub-card-label">Contrat</text>
        <text class="sub-card-value font-navy">{{ currentLogement.contratStatut }}</text>
        <text class="sub-card-detail">{{ currentLogement.contratDetail }}</text>
        <view class="link-voir-contrat" bindtap="onViewContrat">
          Voir le contrat
        </view>
      </view>
    </view>

    <!-- Mention légale / note de protection -->
    <view class="disclaimer-note-wrap">
      <text class="disclaimer-note-txt">La caution n'est pas un loyer. Elle te sera rendue à ton départ, moins les réparations prévues au contrat.</text>
    </view>

    <!-- 3 Boutons d'action rapide -->
    <view class="three-actions-row">
      <view class="action-card-btn" bindtap="onWriteBailleur">
        <view class="action-icon-circle">💬</view>
        <text class="action-btn-title">Écrire au bailleur</text>
      </view>

      <view class="action-card-btn" bindtap="onReportProblem">
        <view class="action-icon-circle">🔧</view>
        <text class="action-btn-title">Signaler un problème</text>
      </view>

      <view class="action-card-btn" bindtap="onPrevenirDepart">
        <view class="action-icon-circle">🚪</view>
        <text class="action-btn-title">Prévenir de mon départ</text>
      </view>
    </view>

    <!-- SECTION : Historique des paiements -->
    <view class="history-section">
      <text class="section-block-title">Historique des paiements</text>
      
      <view class="payments-history-group">
        <block wx:for="{{ currentLogement.historique }}" wx:key="id">
          <view class="history-item-row" data-receipt="{{ item }}" bindtap="onViewReceipt">
            <!-- Rond avec coche -->
            <view class="history-circle {{ item.isEntry ? 'circle-slate' : 'circle-mint' }}">
              <text class="circle-check">✓</text>
            </view>

            <!-- Infos loyer & mode -->
            <view class="history-item-center">
              <text class="history-item-title">{{ item.title }}</text>
              <text class="history-item-sub">{{ item.date }}</text>
            </view>

            <!-- Montant & Reçu -->
            <view class="history-item-right">
              <text class="history-item-amount">{{ item.amount }}</text>
              <text class="history-recu-link">Reçu</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- MODALE 1 : CHOIX DU PAIEMENT (ORANGE MONEY / WAVE) -->
  <view wx:if="{{ showPayModal }}" class="modal-backdrop" bindtap="onClosePayModal">
    <view class="modal-sheet" catchtap="true">
      <view class="sheet-handle"></view>
      <text class="sheet-title">Régler {{ currentLogement.moisActuel }}</text>
      <text class="sheet-subtitle">{{ currentLogement.fullTitle }} · {{ currentLogement.loyerFormatted }}</text>

      <view class="payment-methods-grid">
        <view 
          class="method-choice-card {{ selectedPaymentMethod === 'orange_money' ? 'card--active' : '' }}"
          data-method="orange_money"
          bindtap="onSelectMethod"
        >
          <view class="om-circle">OM</view>
          <view class="method-meta">
            <text class="method-title-txt">Orange Money</text>
            <text class="method-sub-txt">Paiement marchand direct</text>
          </view>
          <text wx:if="{{ selectedPaymentMethod === 'orange_money' }}" class="choice-check">✓</text>
        </view>

        <view 
          class="method-choice-card {{ selectedPaymentMethod === 'wave' ? 'card--active' : '' }}"
          data-method="wave"
          bindtap="onSelectMethod"
        >
          <view class="wave-circle">🌊</view>
          <view class="method-meta">
            <text class="method-title-txt">Wave</text>
            <text class="method-sub-txt">1% sans frais cachés</text>
          </view>
          <text wx:if="{{ selectedPaymentMethod === 'wave' }}" class="choice-check">✓</text>
        </view>
      </view>

      <button class="btn-primary-confirm" bindtap="onConfirmPayment">
        Confirmer et payer {{ currentLogement.loyerFormatted }}
      </button>
      <button class="btn-secondary-cancel" bindtap="onClosePayModal">
        Annuler
      </button>
    </view>
  </view>

  <!-- MODALE 2 : QUITTANCE OFFICIELLE CERTIFIÉE -->
  <view wx:if="{{ showReceiptModal }}" class="modal-backdrop" bindtap="onCloseReceiptModal">
    <view class="receipt-sheet-container" catchtap="true">
      <view class="official-quittance-paper">
        <view class="paper-top-header">
          <view class="paper-brand-tag">SAMA LOGEMENT</view>
          <text class="paper-heading-title">QUITTANCE DE LOYER</text>
          <text class="paper-legal-note">Décret de mars 2023 · République du Sénégal</text>
        </view>

        <view class="paper-body-details">
          <view class="paper-detail-row">
            <text class="p-label">N° Reçu :</text>
            <text class="p-value font-mono">#{{ activeReceipt.ref }}</text>
          </view>
          <view class="paper-detail-row">
            <text class="p-label">Transaction :</text>
            <text class="p-value font-mono">{{ activeReceipt.txId }}</text>
          </view>
          <view class="paper-detail-row">
            <text class="p-label">Objet :</text>
            <text class="p-value font-bold">{{ activeReceipt.title }}</text>
          </view>
          <view class="paper-detail-row">
            <text class="p-label">Logement :</text>
            <text class="p-value">{{ currentLogement.fullTitle }} ({{ currentLogement.place }})</text>
          </view>
          <view class="paper-detail-row">
            <text class="p-label">Locataire :</text>
            <text class="p-value">Awa Diop</text>
          </view>
          <view class="paper-detail-row">
            <text class="p-label">Bailleur bénéficiaire :</text>
            <text class="p-value">{{ currentLogement.bailleurNom }}</text>
          </view>
          <view class="paper-sep-line"></view>
          <view class="paper-detail-row total-highlight-row">
            <text class="p-label font-bold">Montant acquitté :</text>
            <text class="p-value price-green">{{ activeReceipt.amount }}</text>
          </view>
          <view class="paper-detail-row">
            <text class="p-label">Mode :</text>
            <text class="p-value">{{ activeReceipt.date }}</text>
          </view>
        </view>

        <!-- Cachet officiel vert -->
        <view class="paper-stamp-box">
          <view class="stamp-oval">
            <text class="stamp-top-txt">SAMA LOGEMENT DAKAR</text>
            <text class="stamp-main-txt">✓ CERTIFIÉ CONFORME</text>
            <text class="stamp-sub-txt">PAIEMENT SÉCURISÉ</text>
          </view>
        </view>

        <view class="paper-actions-col">
          <button class="btn-download-pdf" bindtap="onDownloadPDF">
            📥 Télécharger le PDF officiel
          </button>
          <button class="btn-close-paper" bindtap="onCloseReceiptModal">
            Fermer
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- MODALE 3 : CONTRAT DE BAIL -->
  <view wx:if="{{ showContratModal }}" class="modal-backdrop" bindtap="onCloseContratModal">
    <view class="modal-sheet" catchtap="true">
      <view class="sheet-handle"></view>
      <text class="sheet-title">Contrat de bail certifié</text>
      <text class="sheet-subtitle">{{ currentLogement.fullTitle }} · {{ currentLogement.bailleurNom }}</text>
      
      <view class="contrat-summary-box">
        <view class="c-item">
          <text class="c-label">Statut du bail :</text>
          <text class="c-val text-green">En cours de validité (Signé)</text>
        </view>
        <view class="c-item">
          <text class="c-label">Durée :</text>
          <text class="c-val">{{ currentLogement.contratDetail }}</text>
        </view>
        <view class="c-item">
          <text class="c-label">Loyer mensuel :</text>
          <text class="c-val font-bold">{{ currentLogement.loyerFormatted }} / mois</text>
        </view>
        <view class="c-item">
          <text class="c-label">Caution consignée :</text>
          <text class="c-val">{{ currentLogement.cautionMontant }} ({{ currentLogement.cautionDetail }})</text>
        </view>
        <view class="c-item">
          <text class="c-label">Préavis légal de départ :</text>
          <text class="c-val">1 mois (Conforme loi sénégalaise)</text>
        </view>
      </view>

      <button class="btn-primary-confirm" bindtap="onCloseContratModal">
        Fermer l'aperçu
      </button>
    </view>
  </view>

  <!-- MODALE 4 : SIGNALER UN PROBLÈME -->
  <view wx:if="{{ showProblemModal }}" class="modal-backdrop" bindtap="onCloseProblemModal">
    <view class="modal-sheet" catchtap="true">
      <view class="sheet-handle"></view>
      <text class="sheet-title">Signaler un problème 🔧</text>
      <text class="sheet-subtitle">Votre bailleur {{ currentLogement.bailleurNom }} sera notifié</text>

      <view class="problem-chips-grid">
        <block wx:for="{{ problemCategories }}" wx:key="*this">
          <view 
            class="problem-chip {{ selectedProblem === item ? 'chip--active' : '' }}"
            data-cat="{{ item }}"
            bindtap="onSelectProblemCategory"
          >
            {{ item }}
          </view>
        </block>
      </view>

      <button class="btn-primary-confirm" bindtap="onSubmitProblem">
        Envoyer le signalement
      </button>
      <button class="btn-secondary-cancel" bindtap="onCloseProblemModal">
        Annuler
      </button>
    </view>
  </view>

  <!-- MODALE 5 : PRÉVENIR DE MON DÉPART -->
  <view wx:if="{{ showDepartModal }}" class="modal-backdrop" bindtap="onCloseDepartModal">
    <view class="modal-sheet" catchtap="true">
      <view class="sheet-handle"></view>
      <text class="sheet-title">Prévenir de mon départ 🚪</text>
      <text class="sheet-subtitle">Notification de préavis légal d'un mois</text>

      <view class="notice-info-card">
        <text class="notice-info-text">Conformément à la réglementation sénégalaise, un préavis d'un mois débute à compter de la date d'envoi. Un état des lieux de sortie sera planifié avec {{ currentLogement.bailleurNom }}, puis votre caution de {{ currentLogement.cautionMontant }} vous sera restituée.</text>
      </view>

      <button class="btn-depart-confirm" bindtap="onConfirmDepart">
        Confirmer et notifier le bailleur
      </button>
      <button class="btn-secondary-cancel" bindtap="onCloseDepartModal">
        Annuler
      </button>
    </view>
  </view>

</view>
