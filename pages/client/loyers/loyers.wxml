<view class="loy">
  <!-- En-tête -->
  <view class="loy__header" style="padding-top: {{ statusBarHeight + 22 }}px;">
    <text class="loy__title">Mon loyer</text>
    <text class="loy__subtitle">{{ subtitle }}</text>
  </view>

  <!-- Synthèse du mois -->
  <view class="loy__section">
    <view class="loy__summary">
      <view class="loy__summary-top">
        <text class="loy__summary-label">Novembre · tous mes logements</text>
        <text class="loy__summary-count">{{ paidCount }}</text>
      </view>
      <view class="loy__summary-amount">
        <text class="loy__summary-left">{{ totalLeft }}</text>
        <text class="loy__summary-label">{{ totalLeftLabel }}</text>
      </view>
      <view class="loy__segments">
        <view
          wx:for="{{ segments }}"
          wx:key="id"
          class="loy__segment {{ item.paid ? 'loy__segment--paid' : '' }}"
          style="flex: {{ item.weight }} 1 0;"
        ></view>
      </view>
    </view>
  </view>

  <!-- Mes logements -->
  <view class="loy__homes-wrap">
    <text class="loy__h2 loy__h2--homes">Mes logements</text>
    <scroll-view class="loy__homes" scroll-x="{{ true }}" enhanced="{{ true }}" show-scrollbar="{{ false }}">
      <view class="loy__homes-row">
        <view
          wx:for="{{ homes }}"
          wx:key="id"
          class="loy__home {{ item.on ? 'loy__home--on' : '' }}"
          data-id="{{ item.id }}"
          bindtap="onSelectHome"
        >
          <view class="loy__home-thumb" style="background: {{ item.tint }};"></view>
          <view class="loy__home-text">
            <text class="loy__home-name">{{ item.name }}</text>
            <text class="loy__home-rent">{{ item.rent }} F / mois</text>
            <text class="loy__home-badge {{ item.paid ? 'loy__home-badge--paid' : '' }}">{{ item.paid ? 'Payé' : 'À payer' }}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Logement choisi -->
  <view class="loy__section loy__section--tight">
    <view class="loy__card loy__current">
      <text class="loy__current-name">{{ cur.name }}</text>
      <text class="loy__current-place">{{ cur.place }} · Bailleur : {{ cur.owner }}</text>
      <text class="loy__current-since">{{ cur.since }}</text>
    </view>
  </view>

  <!-- Loyer du mois -->
  <view class="loy__section loy__section--tight">
    <view class="loy__due {{ cur.paid ? 'loy__due--paid' : '' }}">
      <view class="loy__due-top">
        <text class="loy__due-label">Loyer de novembre</text>
        <text class="loy__due-status">{{ cur.paid ? 'Payé' : 'À payer' }}</text>
      </view>
      <text class="loy__due-amount">{{ cur.rentText }} F</text>
      <text class="loy__due-text">{{ cur.paid ? 'Payé aujourd’hui via Max it. Merci !' : cur.due }}</text>
      <view wx:if="{{ !cur.paid }}" class="loy__due-pay" hover-class="sl-hover" bindtap="onOpenPay">Payer avec Max it</view>
      <view wx:else class="loy__due-receipt" hover-class="sl-hover" data-index="0" bindtap="onViewReceipt">
        <view class="ic ic-download-white loy__due-receipt-ic"></view>
        <text>Télécharger le reçu</text>
      </view>
    </view>
  </view>

  <!-- Caution + contrat -->
  <view class="loy__section loy__section--tight loy__duo">
    <view class="loy__card loy__tile">
      <text class="loy__tile-label">Caution</text>
      <text class="loy__tile-value">{{ cur.depositText }} F</text>
      <text class="loy__tile-sub">{{ cur.depositInfo }}</text>
      <text class="loy__tile-badge">Payée via Max it</text>
    </view>
    <view class="loy__card loy__tile" hover-class="loy__card--hover" bindtap="onViewContrat">
      <text class="loy__tile-label">Contrat</text>
      <text class="loy__tile-value loy__tile-value--sm">Signé</text>
      <text class="loy__tile-sub">{{ cur.contract }}</text>
      <text class="loy__tile-link">Voir le contrat</text>
    </view>
  </view>

  <!-- Actions -->
  <view class="loy__section loy__section--tight loy__actions">
    <view class="loy__card loy__action" hover-class="loy__card--hover" bindtap="onWriteBailleur">
      <view class="ic ic-chat-berry loy__action-ic"></view>
      <text>Écrire au bailleur</text>
    </view>
    <view class="loy__card loy__action" hover-class="loy__card--hover" bindtap="onReportProblem">
      <view class="ic ic-tool-berry loy__action-ic"></view>
      <text>Signaler un problème</text>
    </view>
    <view class="loy__card loy__action" hover-class="loy__card--hover" bindtap="onPrevenirDepart">
      <view class="ic ic-logout-berry loy__action-ic"></view>
      <text>Prévenir de mon départ</text>
    </view>
  </view>

  <!-- Historique -->
  <view class="loy__section loy__history">
    <text class="loy__h2">Historique · {{ cur.name }}</text>
    <view class="loy__card loy__history-list">
      <view wx:for="{{ history }}" wx:key="id" class="loy__history-row">
        <view class="loy__history-ic {{ item.kind === 'entry' ? 'loy__history-ic--entry' : '' }}">
          <view class="ic {{ item.kind === 'entry' ? 'ic-check-navy' : 'ic-check-berry' }}"></view>
        </view>
        <view class="loy__history-text">
          <text class="loy__history-label">{{ item.label }}</text>
          <text class="loy__history-sub">{{ item.sub }}</text>
        </view>
        <view class="loy__history-right">
          <text class="loy__history-amount">{{ item.amountText }}</text>
          <text class="loy__history-receipt" data-index="{{ index }}" bindtap="onViewReceipt">Reçu</text>
        </view>
      </view>
    </view>
    <text class="loy__note">Tous les paiements passent par Max it. Chaque logement a son bailleur, son contrat, sa caution et ses reçus.</text>
  </view>

  <view class="loy__tab-spacer"></view>

  <!-- ================= MAX IT (simulation) ================= -->
  <view wx:if="{{ mx }}" class="sl-mx-backdrop" catchtouchmove="noop">
    <view class="sl-mx" aria-label="Paiement avec Max it">
      <block wx:if="{{ mx === 'confirm' }}">
        <view class="sl-mx-icon"><view class="ic ic-maxit-berry"></view></view>
        <text class="sl-mx-title">Payer avec Max it</text>
        <text class="sl-mx-amount">{{ cur.rentText }} F</text>
        <text class="sl-mx-to">À {{ cur.owner }} · {{ mxLabel }}</text>
        <text class="sl-mx-note">Tu vas être redirigé·e vers l'application Max it pour valider le paiement avec ton code secret.</text>
        <view class="sl-btn sl-btn--berry sl-mx-btn" hover-class="sl-hover" bindtap="onMxGo">Continuer vers Max it</view>
        <view class="sl-mx-cancel" hover-class="sl-hover" bindtap="onMxClose">Annuler</view>
      </block>

      <block wx:if="{{ mx === 'redirect' }}">
        <view class="sl-mx-spinner"></view>
        <text class="sl-mx-title sl-mx-title--sm">Ouverture de Max it…</text>
        <text class="sl-mx-muted">Ne ferme pas l'application.</text>
      </block>

      <block wx:if="{{ mx === 'maxit' }}">
        <text class="sl-mx-sim">SIMULATION · ÉCRAN MAX IT</text>
        <view class="sl-mx-box">
          <text class="sl-mx-brand">Max it</text>
          <text class="sl-mx-muted">Demande de paiement</text>
          <view class="sl-mx-row"><text class="sl-mx-muted">Marchand</text><text class="sl-mx-strong">SAMA LOYER</text></view>
          <view class="sl-mx-row"><text class="sl-mx-muted">Bénéficiaire</text><text class="sl-mx-strong">{{ cur.owner }}</text></view>
          <view class="sl-mx-row"><text class="sl-mx-muted">Motif</text><text class="sl-mx-strong sl-mx-right">{{ mxLabel }}</text></view>
          <view class="sl-mx-row sl-mx-row--total"><text class="sl-mx-strong">Montant</text><text class="sl-mx-strong">{{ cur.rentText }} F</text></view>
        </view>
        <text class="sl-mx-small">Dans la vraie application, tu tapes ici ton code secret Max it. SAMA LOYER ne voit jamais ton code.</text>
        <view class="sl-btn sl-btn--navy sl-mx-btn" hover-class="sl-hover" bindtap="onMxValidate">Valider le paiement</view>
        <view class="sl-btn sl-btn--outline sl-mx-refuse" hover-class="sl-hover" bindtap="onMxClose">Refuser et revenir</view>
      </block>

      <block wx:if="{{ mx === 'done' }}">
        <view class="sl-mx-icon"><view class="ic ic-check-berry"></view></view>
        <text class="sl-mx-title">Paiement validé</text>
        <text class="sl-mx-to">{{ cur.rentText }} F payés à {{ cur.owner }} via Max it. Ton reçu est prêt.</text>
        <view class="sl-btn sl-btn--berry sl-mx-btn" hover-class="sl-hover" bindtap="onMxClose">Retour à Mon loyer</view>
      </block>
    </view>
  </view>

  <!-- ================= QUITTANCE OFFICIELLE DE LOYER ================= -->
  <view wx:if="{{ receipt }}" class="sl-mx-backdrop" catchtouchmove="noop" bindtap="onCloseReceipt">
    <view class="sl-mx loy__quittance-modal" catchtap="noop" aria-label="Quittance de loyer">
      <view class="loy__quittance-header">
        <view class="loy__quittance-repub">
          <text class="loy__repub-flag">🇸🇳</text>
          <text class="loy__repub-txt">RÉPUBLIQUE DU SÉNÉGAL</text>
        </view>
        <view class="loy__quittance-close" hover-class="sl-hover" bindtap="onCloseReceipt">
          <view class="ic ic-close-navy" style="width: 28rpx; height: 28rpx;"></view>
        </view>
      </view>

      <view class="loy__quittance-body">
        <text class="loy__quittance-badge">QUITTANCE DE LOYER OFFICIELLE</text>
        <text class="loy__quittance-ref">{{ quittance.quittanceNo }}</text>
        <text class="loy__quittance-date">Délivrée le {{ quittance.dateEmission }}</text>

        <!-- Sceau Acquitté -->
        <view class="loy__quittance-seal">
          <view class="ic ic-shield-check-green" style="width: 36rpx; height: 36rpx;"></view>
          <text class="loy__seal-txt">ACQUITTÉ · PAIEMENT CERTIFIÉ MAX IT</text>
        </view>

        <!-- Montant mis en avant -->
        <view class="loy__quittance-amount-box">
          <text class="loy__amount-label">MONTANT TOTAL ACQUITTÉ</text>
          <text class="loy__amount-val">{{ quittance.totalPayeText }}</text>
          <text class="loy__amount-period">{{ quittance.periode }}</text>
        </view>

        <!-- Détails officiel -->
        <view class="loy__quittance-grid">
          <view class="loy__q-row">
            <text class="loy__q-lbl">Bailleur</text>
            <text class="loy__q-val">{{ quittance.bailleurName }}</text>
          </view>
          <view class="loy__q-row">
            <text class="loy__q-lbl">Locataire</text>
            <text class="loy__q-val">{{ quittance.locataireName }}</text>
          </view>
          <view class="loy__q-row">
            <text class="loy__q-lbl">Logement</text>
            <text class="loy__q-val">{{ quittance.logementTitle }} · {{ quittance.logementPlace }}</text>
          </view>
          <view class="loy__q-row">
            <text class="loy__q-lbl">Loyer principal</text>
            <text class="loy__q-val">{{ quittance.montantLoyerText }}</text>
          </view>
          <view class="loy__q-row">
            <text class="loy__q-lbl">Charges</text>
            <text class="loy__q-val">{{ quittance.montantChargesText }}</text>
          </view>
          <view class="loy__q-row loy__q-row--total">
            <text class="loy__q-lbl">Réf. transaction OM</text>
            <text class="loy__q-val loy__q-val--code">{{ quittance.hashSecurite }}</text>
          </view>
        </view>

        <text class="loy__quittance-legal">Cette quittance électronique certifie le paiement libératoire du loyer pour le terme désigné, sans réserve d'encaissement via Orange Money.</text>
      </view>

      <view class="loy__quittance-actions">
        <view class="sl-btn sl-btn--berry loy__q-btn" hover-class="sl-hover" bindtap="onDownloadReceipt">
          <view class="ic ic-download-white" style="width: 36rpx; height: 36rpx;"></view>
          <text>Télécharger le PDF officiel</text>
        </view>
        <view class="sl-btn sl-btn--outline-navy loy__q-btn" hover-class="sl-hover" bindtap="onShareReceipt">
          <text>Partager la quittance</text>
        </view>
      </view>
    </view>
  </view>
</view>
