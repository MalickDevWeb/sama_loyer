@import "/styles/sama-ui.wxss";

/* ============================================================================
   SAMA LOYER — Mon loyer, d'après la maquette MonLoyer
   ============================================================================ */

page {
  background: #F7F8FA;
}

.loy__header {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.loy__title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.loy__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #5B6475;
}

.loy__section {
  padding: 32rpx 32rpx 0;
}

.loy__section--tight {
  padding-top: 24rpx;
}

.loy__h2 {
  display: block;
  margin: 0 0 24rpx 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.loy__card {
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4E7EE;
}

.loy__card--hover {
  background: #F7F8FA;
}

/* --- Synthèse ------------------------------------------------------------ */
.loy__summary {
  border-radius: 44rpx;
  background: #0F1E3D;
  color: #FFFFFF;
  padding: 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.loy__summary-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.loy__summary-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #C9D0DE;
}

.loy__summary-amount .loy__summary-label {
  font-weight: 400;
}

.loy__summary-count {
  font-size: 24rpx;
  font-weight: 800;
  color: #F08DB2;
}

.loy__summary-amount {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.loy__summary-left {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.loy__segments {
  display: flex;
  gap: 8rpx;
  height: 16rpx;
}

.loy__segment {
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
}

.loy__segment--paid {
  background: #F08DB2;
}

/* --- Mes logements ------------------------------------------------------- */
.loy__homes-wrap {
  padding-top: 36rpx;
}

.loy__h2--homes {
  margin: 0 40rpx 20rpx;
  font-size: 30rpx;
}

.loy__homes {
  white-space: nowrap;
}

.loy__homes-row {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 32rpx 8rpx;
}

.loy__home {
  flex: 0 0 472rpx;
  width: 472rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 4rpx solid #E4E7EE;
  white-space: normal;
}

.loy__home--on {
  border-color: #0F1E3D;
}

.loy__home-thumb {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 24rpx;
}

.loy__home-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.loy__home-name {
  font-size: 28rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.loy__home-rent {
  font-size: 24rpx;
  color: #5B6475;
}

.loy__home-badge {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  background: #FDF1F5;
  color: #9E1749;
}

.loy__home-badge--paid {
  background: #E3E9F5;
  color: #0F1E3D;
}

/* --- Logement choisi ----------------------------------------------------- */
.loy__current {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.loy__current-name {
  font-size: 30rpx;
  font-weight: 800;
}

.loy__current-place {
  font-size: 26rpx;
  color: #5B6475;
}

.loy__current-since {
  font-size: 24rpx;
  color: #5B6475;
}

/* --- Loyer du mois ------------------------------------------------------- */
.loy__due {
  border-radius: 44rpx;
  padding: 36rpx;
  background: #C8235F;
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.loy__due--paid {
  background: #0F1E3D;
}

.loy__due-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loy__due-label {
  font-size: 28rpx;
  font-weight: 700;
  opacity: 0.85;
}

.loy__due-status {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #C8235F;
  font-size: 24rpx;
  font-weight: 800;
}

.loy__due--paid .loy__due-status {
  color: #0F1E3D;
}

.loy__due-amount {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.loy__due-text {
  font-size: 28rpx;
  opacity: 0.9;
}

.loy__due-pay {
  margin-top: 12rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #C8235F;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__due-receipt {
  margin-top: 12rpx;
  height: 100rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loy__due-receipt-ic {
  width: 36rpx;
  height: 36rpx;
}

/* --- Caution + contrat --------------------------------------------------- */
.loy__duo {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.loy__tile {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.loy__tile-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #5B6475;
}

.loy__tile-value {
  font-size: 40rpx;
  font-weight: 800;
}

.loy__tile-value--sm {
  font-size: 32rpx;
}

.loy__tile-sub {
  font-size: 24rpx;
  color: #3A4458;
}

.loy__tile-badge {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #FDF1F5;
  color: #9E1749;
  font-size: 22rpx;
  font-weight: 800;
}

.loy__tile-link {
  margin-top: auto;
  font-size: 24rpx;
  font-weight: 800;
  color: #C8235F;
}

/* --- Actions ------------------------------------------------------------- */
.loy__actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.loy__action {
  padding: 24rpx 12rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.loy__action-ic {
  width: 44rpx;
  height: 44rpx;
}

/* --- Historique ---------------------------------------------------------- */
.loy__history {
  padding-top: 40rpx;
  padding-bottom: 48rpx;
}

.loy__history-toggle {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
}

.loy__history-toggle-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.loy__history-toggle-title {
  font-size: 32rpx;
  font-weight: 800;
}

.loy__history-chevron {
  width: 36rpx;
  height: 36rpx;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.loy__history-toggle--open .loy__history-chevron {
  transform: rotate(-90deg);
}

.loy__history-empty {
  padding: 24rpx 8rpx 0;
  font-size: 26rpx;
  color: #5B6475;
}

.loy__history-list {
  overflow: hidden;
  margin-top: 16rpx;
}

.loy__history-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid #EEF0F4;
}

.loy__history-row:last-child {
  border-bottom: 0;
}

.loy__history-ic {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 34rpx;
  background: #FDF1F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__history-ic--entry {
  background: #E3E9F5;
}

.loy__history-ic .ic {
  width: 32rpx;
  height: 32rpx;
}

.loy__history-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.loy__history-label {
  font-size: 28rpx;
  font-weight: 700;
}

.loy__history-sub {
  font-size: 24rpx;
  color: #5B6475;
}

.loy__history-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.loy__history-amount {
  font-size: 28rpx;
  font-weight: 800;
}

.loy__history-receipt {
  padding: 8rpx 0 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #C8235F;
}

.loy__note {
  display: block;
  margin: 24rpx 8rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5B6475;
}

.loy__tab-spacer {
  height: calc(156rpx + env(safe-area-inset-bottom));
}

/* --- Reçu ---------------------------------------------------------------- */
.loy__receipt .sl-mx-amount {
  font-size: 52rpx;
}

/* ============================================================================
   SAMA LOYER — Modal Quittance de Loyer Officielle Certifiée
   ============================================================================ */
.loy__quittance-modal {
  max-width: 660rpx;
  width: 92%;
  padding: 32rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 60rpx rgba(15, 30, 61, 0.35);
}

.loy__quittance-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #E8EBF2;
}

.loy__quittance-repub {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loy__repub-flag {
  font-size: 32rpx;
}

.loy__repub-txt {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: #0F1E3D;
}

.loy__quittance-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #F1F4F9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__quittance-body {
  padding: 24rpx 0 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loy__quittance-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  background: #0F1E3D;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.loy__quittance-ref {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.loy__quittance-date {
  font-size: 22rpx;
  color: #7A8294;
  margin-top: 2rpx;
  margin-bottom: 20rpx;
}

.loy__quittance-seal {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #EAF7EE;
  border: 2rpx solid #C4EED0;
  margin-bottom: 24rpx;
}

.loy__seal-txt {
  font-size: 22rpx;
  font-weight: 800;
  color: #11643F;
  letter-spacing: 0.02em;
}

.loy__quittance-amount-box {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F8F9FD;
  border: 2rpx solid #E2E6F0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.loy__amount-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: #7A8294;
}

.loy__amount-val {
  font-size: 50rpx;
  font-weight: 900;
  color: #C8235F;
  margin: 6rpx 0;
  letter-spacing: -0.02em;
}

.loy__amount-period {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.loy__quittance-grid {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 2rpx solid #EAECEF;
  background: #FFFFFF;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.loy__q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-bottom: 2rpx solid #F1F3F7;
  font-size: 24rpx;
}

.loy__q-row:last-child {
  border-bottom: 0;
}

.loy__q-row--total {
  background: #FBFBFD;
}

.loy__q-lbl {
  color: #7A8294;
  font-weight: 600;
}

.loy__q-val {
  color: #0F1E3D;
  font-weight: 700;
  text-align: right;
  max-width: 60%;
}

.loy__q-val--code {
  font-family: monospace;
  color: #11643F;
  font-weight: 800;
}

.loy__quittance-legal {
  font-size: 20rpx;
  line-height: 1.45;
  color: #7A8294;
  text-align: center;
  padding: 0 10rpx;
}

.loy__quittance-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.loy__q-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
}
