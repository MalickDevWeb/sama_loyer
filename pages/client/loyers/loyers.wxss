@import "/styles/sama-ui.wxss";

/* ============================================================================
   SAMA LOYER — Mon loyer, d'après la maquette MonLoyer
   ============================================================================ */

page {
  background: var(--sl-surface-2);
}

.loy__header {
  padding-top: 14rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.loy__title {
  display: block;
  font-size: var(--sl-fs-h1);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.02em;
}

.loy__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: var(--sl-fs-body);
  color: var(--sl-muted);
}

.loy__section {
  padding: 32rpx 32rpx 0;
}

.loy__section--tight {
  padding-top: 24rpx;
}

.loy__h2 {
  display: block;
  margin: 0 0 24rpx 8rpx;
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

.loy__card {
  border-radius: 36rpx;
  background: var(--sl-white);
  border: 2rpx solid var(--sl-border);
}

.loy__card--hover {
  background: var(--sl-surface-2);
}

/* --- Synthèse ------------------------------------------------------------ */
.loy__summary {
  border-radius: 44rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  padding: 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.loy__summary-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.loy__summary-label {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-border-strong);
}

.loy__summary-amount .loy__summary-label {
  font-weight: var(--sl-fw-regular);
}

.loy__summary-count {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  color: #F08DB2;
}

.loy__summary-amount {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.loy__summary-left {
  font-size: 56rpx;
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.02em;
}

.loy__segments {
  display: flex;
  gap: 8rpx;
  height: 16rpx;
}

.loy__segment {
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
}

.loy__segment--paid {
  background: #F08DB2;
}

/* --- Mes logements ------------------------------------------------------- */
.loy__homes-wrap {
  padding-top: 36rpx;
}

.loy__h2--homes {
  margin: 0 40rpx 20rpx;
  font-size: var(--sl-fs-body-lg);
}

.loy__homes {
  white-space: nowrap;
}

.loy__homes-row {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 32rpx 8rpx;
}

.loy__home {
  flex: 0 0 472rpx;
  width: 472rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 36rpx;
  background: var(--sl-white);
  border: 4rpx solid var(--sl-border);
  white-space: normal;
}

.loy__home--on {
  border-color: var(--sl-navy);
}

.loy__home-thumb {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 24rpx;
}

.loy__home-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.loy__home-name {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.loy__home-rent {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.loy__home-badge {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
}

.loy__home-badge--paid {
  background: var(--sl-info-bg);
  color: var(--sl-text);
}

/* --- Logement choisi ----------------------------------------------------- */
.loy__current {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.loy__current-name {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.loy__current-place {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.loy__current-since {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

/* --- Loyer du mois ------------------------------------------------------- */
.loy__due {
  border-radius: 44rpx;
  padding: 36rpx;
  background: var(--sl-berry);
  color: var(--sl-on-dark);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.loy__due--paid {
  background: var(--sl-navy);
}

.loy__due-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loy__due-label {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  opacity: 0.85;
}

.loy__due-status {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--sl-white);
  color: var(--sl-berry);
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
}

.loy__due--paid .loy__due-status {
  color: var(--sl-text);
}

.loy__due-amount {
  font-size: 64rpx;
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.02em;
}

.loy__due-text {
  font-size: var(--sl-fs-body);
  opacity: 0.9;
}

.loy__due-btns {
  margin-top: 12rpx;
  display: flex;
  gap: 16rpx;
}

.loy__due-details {
  flex: 1;
  height: 100rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__due-pay {
  flex: 1;
  height: 100rpx;
  border-radius: 32rpx;
  background: var(--sl-white);
  color: var(--sl-berry);
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__due-receipt {
  flex: 1;
  height: 100rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loy__due-receipt-ic {
  width: 36rpx;
  height: 36rpx;
}

/* --- Caution + contrat --------------------------------------------------- */
.loy__duo {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.loy__tile {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.loy__tile-label {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-muted);
}

.loy__tile-value {
  font-size: var(--sl-fs-h3);
  font-weight: var(--sl-fw-extrabold);
}

.loy__tile-value--sm {
  font-size: var(--sl-fs-subtitle);
}

.loy__tile-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-text-2);
}

.loy__tile-badge {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
}

.loy__tile-link {
  margin-top: auto;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.loy__tile--soft {
  background: var(--sl-surface-2);
  box-shadow: none;
}

/* --- Détails du logement ------------------------------------------------- */
.loy__details {
  max-height: 86vh;
  overflow-y: auto;
  text-align: left;
}

.loy__details-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loy__details-title {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
}

.loy__details-home {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.loy__details-rows {
  display: flex;
  flex-direction: column;
}

/* --- Actions ------------------------------------------------------------- */
.loy__actions {
  padding: 0 24rpx;
}

.loy__action {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--sl-divider);
}

.loy__action:last-child {
  border-bottom: 0;
}

.loy__action--hover {
  opacity: 0.7;
}

.loy__action-tile {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__action-tile--berry { background: var(--sl-berry-tint); }
.loy__action-tile--navy { background: var(--sl-info-bg); }
.loy__action-tile--grey { background: var(--sl-divider); }

.loy__action-ic {
  width: 40rpx;
  height: 40rpx;
}

.loy__action-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.loy__action-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.loy__action-sub {
  font-size: 23rpx;
  color: var(--sl-placeholder);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.loy__action-chev {
  width: 30rpx;
  height: 30rpx;
}

/* --- Historique ---------------------------------------------------------- */
.loy__history {
  padding-top: 40rpx;
  padding-bottom: 48rpx;
}

.loy__history-toggle {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
}

.loy__history-toggle-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.loy__history-toggle-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

.loy__history-chevron {
  width: 36rpx;
  height: 36rpx;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.loy__history-toggle--open .loy__history-chevron {
  transform: rotate(-90deg);
}

.loy__history-empty {
  padding: 24rpx 8rpx 0;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.loy__history-list {
  overflow: hidden;
  margin-top: 16rpx;
}

.loy__history-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid var(--sl-divider);
}

.loy__history-row:last-child {
  border-bottom: 0;
}

.loy__history-ic {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 34rpx;
  background: var(--sl-berry-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__history-ic--entry {
  background: var(--sl-info-bg);
}

.loy__history-ic .ic {
  width: 32rpx;
  height: 32rpx;
}

.loy__history-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.loy__history-label {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
}

.loy__history-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.loy__history-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.loy__history-amount {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.loy__history-receipt {
  padding: 8rpx 0 8rpx 16rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.loy__note {
  display: block;
  margin: 24rpx 8rpx 0;
  font-size: var(--sl-fs-small);
  line-height: 1.5;
  color: var(--sl-muted);
}

.loy__tab-spacer {
  height: calc(156rpx + env(safe-area-inset-bottom));
}

/* --- Reçu ---------------------------------------------------------------- */
.loy__receipt .sl-mx-amount {
  font-size: var(--sl-fs-h1);
}

/* ============================================================================
   SAMA LOYER — Modal Quittance de Loyer Officielle Certifiée
   ============================================================================ */
.loy__quittance-modal {
  max-width: 660rpx;
  width: 92%;
  padding: 32rpx;
  border-radius: 40rpx;
  background: var(--sl-white);
  box-shadow: 0 20rpx 60rpx rgba(15, 30, 61, 0.35);
}

.loy__quittance-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--sl-border);
}

.loy__quittance-repub {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loy__repub-flag {
  font-size: var(--sl-fs-subtitle);
}

.loy__repub-txt {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.06em;
  color: var(--sl-text);
}

.loy__quittance-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: var(--sl-surface-3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__quittance-body {
  padding: 24rpx 0 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loy__quittance-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.loy__quittance-ref {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.loy__quittance-date {
  font-size: var(--sl-fs-caption);
  color: var(--sl-placeholder);
  margin-top: 2rpx;
  margin-bottom: 20rpx;
}

.loy__quittance-seal {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: var(--sl-green-bg);
  border: 2rpx solid #C4EED0;
  margin-bottom: 24rpx;
}

.loy__seal-txt {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-success);
  letter-spacing: 0.02em;
}

.loy__quittance-amount-box {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--sl-bg);
  border: 2rpx solid var(--sl-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.loy__amount-label {
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.05em;
  color: var(--sl-placeholder);
}

.loy__amount-val {
  font-size: 50rpx;
  font-weight: var(--sl-fw-black);
  color: var(--sl-berry);
  margin: 6rpx 0;
  letter-spacing: -0.02em;
}

.loy__amount-period {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.loy__quittance-grid {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 2rpx solid #EAECEF;
  background: var(--sl-white);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.loy__q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-bottom: 2rpx solid var(--sl-surface-3);
  font-size: var(--sl-fs-small);
}

.loy__q-row:last-child {
  border-bottom: 0;
}

.loy__q-row--total {
  background: var(--sl-bg);
}

.loy__q-lbl {
  color: var(--sl-placeholder);
  font-weight: var(--sl-fw-semibold);
}

.loy__q-val {
  color: var(--sl-text);
  font-weight: var(--sl-fw-bold);
  text-align: right;
  max-width: 60%;
}

.loy__q-val--code {
  font-family: var(--sl-font-mono);
  color: var(--sl-success);
  font-weight: var(--sl-fw-extrabold);
}

.loy__quittance-legal {
  font-size: var(--sl-fs-micro);
  line-height: 1.45;
  color: var(--sl-placeholder);
  text-align: center;
  padding: 0 10rpx;
}

.loy__quittance-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.loy__q-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  font-size: var(--sl-fs-body);
}
