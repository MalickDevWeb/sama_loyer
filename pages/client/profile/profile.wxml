<view class="prof">
  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <!-- Sélecteur de profil (Locataire / Bailleur) -->
  <view class="prof__role-switch-wrap">
    <view class="role-switch-bar">
      <view class="role-segment role-segment--active">
        <view class="ic ic-home-white ic--sm"></view>
        <text class="role-label">{{ i18n.profile.roleTenant || 'Locataire' }}</text>
      </view>
      <view 
        class="role-segment" 
        hover-class="role-segment--hover" 
        bindtap="onSwitchToBailleur"
        aria-label="Basculer vers l'espace Bailleur"
      >
        <view class="ic ic-users-navy ic--sm"></view>
        <text class="role-label">{{ i18n.profile.roleLandlord || 'Bailleur' }}</text>
      </view>
    </view>
  </view>

  <!-- Carte profil -->
  <view class="prof__header">
    <text class="prof__title">{{ i18n.tabs.profile || 'Profil' }}</text>
    <view class="prof__card">
      <view class="prof__avatar">{{ userInitials }}</view>
      <view class="prof__who">
        <text class="prof__name">{{ userName }}</text>
        <text class="prof__phone">{{ userPhone }}</text>
        <view class="prof__verified">
          <view class="ic ic-check-green prof__verified-ic"></view>
          <text>{{ i18n.profile.verifiedNumber || 'Numéro vérifié · Max it' }}</text>
        </view>
      </view>
    </view>

    <view class="prof__stats">
      <view class="prof__stat" hover-class="sl-hover" bindtap="onNavFavoris">
        <text class="prof__stat-num">{{ stats.favoris }}</text>
        <text class="prof__stat-label">{{ i18n.favoris.title || 'Favoris' }}</text>
      </view>
      <view class="prof__stat" hover-class="sl-hover" bindtap="onNavVisites">
        <text class="prof__stat-num">{{ stats.visites }}</text>
        <text class="prof__stat-label">{{ i18n.tabs.visits || 'Visites' }}</text>
      </view>
      <view class="prof__stat" hover-class="sl-hover" bindtap="onNavMessages">
        <text class="prof__stat-num">{{ stats.conversations }}</text>
        <text class="prof__stat-label">{{ i18n.profile.conversations || 'Conversations' }}</text>
      </view>
    </view>
  </view>

  <!-- Notifications -->
  <view class="prof__section">
    <text class="prof__section-title">{{ i18n.profile.notifications || 'NOTIFICATIONS' }}</text>
    <view class="prof__group">
      <!-- 1. Nouveaux messages -->
      <view class="prof__row prof__row--notif">
        <view class="prof__row-text">
          <text class="prof__row-label">{{ i18n.profile.notifMsgLabel || 'Nouveaux messages' }}</text>
          <text class="prof__row-sub">{{ i18n.profile.notifMsgSub || 'Quand un bailleur te répond' }}</text>
        </view>
        <view
          class="prof__switch {{ prefs.notifs.msg ? 'prof__switch--on' : '' }}"
          data-id="msg"
          bindtap="onToggleNotif"
          aria-label="{{ i18n.profile.notifMsgLabel || 'Nouveaux messages' }}"
        >
          <view class="prof__knob"></view>
        </view>
      </view>

      <!-- 2. Réponses aux visites -->
      <view class="prof__row prof__row--notif">
        <view class="prof__row-text">
          <text class="prof__row-label">{{ i18n.profile.notifVisitLabel || 'Réponses aux visites' }}</text>
          <text class="prof__row-sub">{{ i18n.profile.notifVisitSub || 'Acceptée, refusée ou modifiée' }}</text>
        </view>
        <view
          class="prof__switch {{ prefs.notifs.visit ? 'prof__switch--on' : '' }}"
          data-id="visit"
          bindtap="onToggleNotif"
          aria-label="{{ i18n.profile.notifVisitLabel || 'Réponses aux visites' }}"
        >
          <view class="prof__knob"></view>
        </view>
      </view>

      <!-- 3. Nouvelles annonces -->
      <view class="prof__row prof__row--notif">
        <view class="prof__row-text">
          <text class="prof__row-label">{{ i18n.profile.notifNewLabel || 'Nouvelles annonces' }}</text>
          <text class="prof__row-sub">{{ i18n.profile.notifNewSub || 'Dans tes quartiers préférés' }}</text>
        </view>
        <view
          class="prof__switch {{ prefs.notifs.new ? 'prof__switch--on' : '' }}"
          data-id="new"
          bindtap="onToggleNotif"
          aria-label="{{ i18n.profile.notifNewLabel || 'Nouvelles annonces' }}"
        >
          <view class="prof__knob"></view>
        </view>
      </view>

      <!-- 4. Baisses de prix -->
      <view class="prof__row prof__row--notif">
        <view class="prof__row-text">
          <text class="prof__row-label">{{ i18n.profile.notifPriceLabel || 'Baisses de prix' }}</text>
          <text class="prof__row-sub">{{ i18n.profile.notifPriceSub || 'Sur tes favoris' }}</text>
        </view>
        <view
          class="prof__switch {{ prefs.notifs.price ? 'prof__switch--on' : '' }}"
          data-id="price"
          bindtap="onToggleNotif"
          aria-label="{{ i18n.profile.notifPriceLabel || 'Baisses de prix' }}"
        >
          <view class="prof__knob"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 🧪 SECTION TEST & DÉMO COLOCATION -->
  <view class="prof__section">
    <text class="prof__section-title">🧪 TESTEUR COLOCATION (PROMPT MAÎTRE)</text>
    <view class="prof__group">
      <!-- Changement rapide de profil de test -->
      <view class="prof__row prof__row--tall">
        <view class="prof__row-text">
          <text class="prof__row-label">Simuler un profil candidat</text>
          <text class="prof__row-sub">Genre : {{ userGender }} · {{ userSmokeStatus }} · {{ userCoupleStatus }}</text>
        </view>
      </view>

      <view class="prof__segmented" style="margin: 12rpx 24rpx 20rpx;">
        <view
          class="prof__segment {{ testProfileId === 'moussa' ? 'prof__segment--on' : '' }}"
          bindtap="onSelectTestProfile"
          data-profile="moussa"
        >👤 Moussa (H)</view>
        <view
          class="prof__segment {{ testProfileId === 'fatou' ? 'prof__segment--on' : '' }}"
          bindtap="onSelectTestProfile"
          data-profile="fatou"
        >👩 Fatou (F)</view>
        <view
          class="prof__segment {{ testProfileId === 'couple' ? 'prof__segment--on' : '' }}"
          bindtap="onSelectTestProfile"
          data-profile="couple"
        >👫 Couple</view>
      </view>

      <view class="prof__row prof__row--tall" hover-class="prof__row--hover" bindtap="onOpenTestLab" style="border-top: 1.5rpx dashed #E2E8F0; background: #FFF1F5; padding: 16rpx 20rpx;">
        <view class="prof__row-text">
          <text class="prof__row-label" style="color: #C8235F; font-weight: 800;">🚀 Ouvrir le Laboratoire de Test Complet</text>
          <text class="prof__row-sub">Tester toutes les règles, verrous, remboursements et chambres</text>
        </view>
        <view class="ic ic-chevron-berry prof__chev"></view>
      </view>
    </view>
  </view>

  <!-- Préférences -->
  <view class="prof__section">
    <text class="prof__section-title">{{ i18n.profile.preferences || 'PRÉFÉRENCES' }}</text>
    <view class="prof__group">
      <view class="prof__lang">
        <text class="prof__row-label">{{ i18n.profile.language || 'Langue de l’application' }}</text>
        <view class="prof__segmented">
          <view
            wx:for="{{ langs }}"
            wx:key="id"
            class="prof__segment {{ lang === item.id ? 'prof__segment--on' : '' }}"
            data-lang="{{ item.id }}"
            bindtap="onSelectLang"
          >{{ item.label }}</view>
        </view>
      </view>
      <view class="prof__row prof__row--tall" hover-class="prof__row--hover" bindtap="onOpenZones">
        <view class="prof__row-text">
          <text class="prof__row-label">{{ i18n.profile.preferredZones || 'Quartiers préférés' }}</text>
          <text class="prof__row-sub">{{ prefs.zones }}</text>
        </view>
        <view class="ic ic-chevron-grey prof__chev"></view>
      </view>
      <view class="prof__row prof__row--tall" hover-class="prof__row--hover" bindtap="onOpenBudget">
        <view class="prof__row-text">
          <text class="prof__row-label">{{ i18n.profile.budgetMax || 'Budget habituel' }}</text>
          <text class="prof__row-sub">{{ prefs.budget }}</text>
        </view>
        <view class="ic ic-chevron-grey prof__chev"></view>
      </view>
    </view>
  </view>

  <!-- Bouton Changer de profil (Bascule vers le profil Bailleur) -->
  <view class="prof__section">
    <view class="prof__switch-profile" hover-class="prof__switch-profile--hover" bindtap="onSwitchToBailleur">
      <view class="prof__switch-profile-ic">
        <view class="ic ic-users-white ic--lg"></view>
      </view>
      <view class="prof__switch-profile-text">
        <text class="prof__switch-profile-title">{{ i18n.profile.switchToBailleur || 'Changer de profil' }}</text>
        <text class="prof__switch-profile-sub">{{ i18n.profile.roleLandlord || 'Basculer vers le profil Bailleur' }}</text>
      </view>
      <view class="prof__switch-profile-badge">
        <text>{{ i18n.profile.roleLandlord || 'Bailleur' }}</text>
        <view class="ic ic-chevron-white ic--sm"></view>
      </view>
    </view>
  </view>

  <!-- Aide -->
  <view class="prof__section">
    <text class="prof__section-title">{{ i18n.profile.helpAndLegal || 'AIDE & SUPPORT' }}</text>
    <view class="prof__group">
      <view class="prof__row prof__row--short" hover-class="prof__row--hover" bindtap="onOpenHelp">
        <view class="ic ic-help-berry prof__row-ic"></view>
        <text class="prof__row-label">{{ i18n.profile.helpCenter || 'Centre d’aide' }}</text>
        <view class="ic ic-chevron-grey prof__chev"></view>
      </view>
      <view class="prof__row prof__row--short" hover-class="prof__row--hover" bindtap="onOpenSecurity">
        <view class="ic ic-shield-line-berry prof__row-ic"></view>
        <text class="prof__row-label">{{ i18n.profile.securityTips || 'Conseils de sécurité' }}</text>
        <view class="ic ic-chevron-grey prof__chev"></view>
      </view>
      <view class="prof__row prof__row--short" hover-class="prof__row--hover" bindtap="onOpenSupport">
        <view class="ic ic-chat-berry prof__row-ic"></view>
        <text class="prof__row-label">{{ i18n.profile.contactSupport || 'Contacter le support' }}</text>
        <view class="ic ic-chevron-grey prof__chev"></view>
      </view>
    </view>
  </view>

  <!-- Version SAMA LOYER -->
  <view class="prof__section prof__section--last">
    <text class="prof__version">SAMA LOYER · version 1.0 (Orange Max it)</text>
  </view>

  <view class="prof__tab-spacer"></view>

  <!-- =========================================================================
       MODALS INTERACTIVES
       ========================================================================= -->

  <!-- Modal 1 : Informations personnelles -->
  <view wx:if="{{ activeModal === 'info' }}" class="prof__sheet-overlay" catchtouchmove="noop" bindtap="onCloseModal">
    <view class="prof__sheet" catchtap="noop">
      <view class="prof__sheet-handle"></view>
      <view class="prof__sheet-header">
        <view class="prof__sheet-heading">
          <text class="prof__sheet-title">{{ i18n.profile.personalInfo || 'Informations personnelles' }}</text>
          <text class="prof__sheet-sub">{{ i18n.profile.certifiedIdentity || 'Identité certifiée via Orange Max it' }}</text>
        </view>
        <view class="prof__sheet-close" hover-class="sl-hover" bindtap="onCloseModal">
          <view class="ic ic-close-navy prof__sheet-close-ic"></view>
        </view>
      </view>

      <view class="prof__sheet-body">
        <!-- Carte Identité Certifiée Max it -->
        <view class="prof__id-card">
          <view class="prof__id-avatar">{{ userInitials }}</view>
          <view class="prof__id-info">
            <text class="prof__id-name">{{ userName }}</text>
            <view class="prof__id-badge">
              <view class="ic ic-shield-check-green prof__id-badge-ic"></view>
              <text>{{ i18n.profile.certifiedMaxit || 'Identité certifiée Max it' }}</text>
            </view>
          </view>
        </view>

        <!-- Liste des détails du compte vérifié -->
        <view class="prof__id-rows">
          <view class="prof__id-row">
            <text class="prof__id-label">{{ i18n.profile.ownerNumber || 'Numéro titulaire' }}</text>
            <text class="prof__id-val">{{ userPhone }}</text>
          </view>
          <view class="prof__id-row">
            <text class="prof__id-label">{{ i18n.profile.accountStatus || 'Statut du compte' }}</text>
            <text class="prof__id-val prof__id-val--green">{{ i18n.profile.kycLevel || 'KYC Vérifié · Niveau 2' }}</text>
          </view>
          <view class="prof__id-row">
            <text class="prof__id-label">{{ i18n.profile.samaRole || 'Rôle sur Sama Loyer' }}</text>
            <text class="prof__id-val">{{ i18n.profile.certifiedTenant || 'Locataire certifié·e' }}</text>
          </view>
        </view>

        <!-- Champ d'ajustement du nom d'affichage -->
        <view class="prof__field" style="margin-top: 10rpx;">
          <text class="prof__field-label">{{ i18n.profile.displayNameLabel || 'Nom d’affichage (visible par les bailleurs)' }}</text>
          <input
            class="prof__field-input"
            value="{{ editForm.fullName }}"
            placeholder="Awa Diop"
            bindinput="onInputFullName"
          />
        </view>

        <!-- Message de réassurance sécurité -->
        <view class="prof__sec-note">
          <view class="ic ic-shield-check-green prof__sec-note-ic"></view>
          <text class="prof__sec-note-text">{{ i18n.profile.secNote || 'Votre compte est protégé par l’authentification forte Orange Max it. Vos données sont sécurisées.' }}</text>
        </view>
      </view>

      <view class="prof__sheet-footer">
        <button class="prof__btn-primary" hover-class="sl-hover" bindtap="onSavePersonalInfo">
          Valider
        </button>
      </view>
    </view>
  </view>

  <!-- Modal 2 : Numéro de téléphone -->
  <view wx:if="{{ activeModal === 'phone' }}" class="prof__sheet-overlay" catchtouchmove="noop" bindtap="onCloseModal">
    <view class="prof__sheet" catchtap="noop">
      <view class="prof__sheet-handle"></view>
      <view class="prof__sheet-header">
        <view class="prof__sheet-heading">
          <text class="prof__sheet-title">{{ i18n.profile.phoneNumberTitle || 'Numéro de téléphone' }}</text>
          <text class="prof__sheet-sub">{{ i18n.profile.phoneCertifiedLine || 'Ligne certifiée Orange Sénégal' }}</text>
        </view>
        <view class="prof__sheet-close" hover-class="sl-hover" bindtap="onCloseModal">
          <view class="ic ic-close-navy prof__sheet-close-ic"></view>
        </view>
      </view>

      <view class="prof__sheet-body">
        <!-- Carte Grand Numéro Sécurisé -->
        <view class="prof__phone-card">
          <view class="prof__phone-card-top">
            <view class="prof__phone-sim-badge">
              <view class="ic ic-check-green prof__badge-ic"></view>
              <text>{{ i18n.profile.maxitBalance || 'Compte & Solde Max it' }}</text>
            </view>
          </view>
          <text class="prof__phone-number">{{ userPhone }}</text>
          <text class="prof__phone-status">{{ i18n.profile.phoneActiveVerified || '● Numéro actif et vérifié' }}</text>
        </view>

        <!-- Explication de sécurité Max it -->
        <view class="prof__sec-box">
          <view class="prof__sec-box-item">
            <view class="prof__sec-bullet"></view>
            <view class="prof__sec-box-text">
              <text class="prof__sec-box-title">{{ i18n.profile.autoAuthTitle || 'Authentification automatique' }}</text>
              <text class="prof__sec-box-sub">{{ i18n.profile.autoAuthSub || 'Ce numéro est relié à votre session Max it. Aucun mot de passe requis.' }}</text>
            </view>
          </view>
          <view class="prof__sec-box-item">
            <view class="prof__sec-bullet"></view>
            <view class="prof__sec-box-text">
              <text class="prof__sec-box-title">{{ i18n.profile.secPaymentsTitle || 'Paiements de loyers sécurisés' }}</text>
              <text class="prof__sec-box-sub">{{ i18n.profile.secPaymentsSub || 'Toutes vos quittances et débits Max it sont envoyés vers ce numéro.' }}</text>
            </view>
          </view>
        </view>

        <view class="prof__sec-info">
          <text>{{ i18n.profile.phoneChangeNote || 'ℹ️ Pour changer de numéro principal, modifiez directement votre compte dans l’application Orange Max it.' }}</text>
        </view>
      </view>

      <view class="prof__sheet-footer">
        <button class="prof__btn-primary" hover-class="sl-hover" bindtap="onCloseModal">
          Compris
        </button>
      </view>
    </view>
  </view>

  <!-- Modal 3 : Quartiers préférés -->
  <view wx:if="{{ activeModal === 'zones' }}" class="prof__sheet-overlay" catchtouchmove="noop" bindtap="onCloseModal">
    <view class="prof__sheet" catchtap="noop">
      <view class="prof__sheet-handle"></view>
      <view class="prof__sheet-header">
        <view class="prof__sheet-heading">
          <text class="prof__sheet-title">{{ i18n.profile.preferredZonesTitle || 'Quartiers préférés' }}</text>
          <text class="prof__sheet-sub">{{ i18n.profile.preferredZonesSub || 'Sélectionnez vos zones prioritaires à Dakar' }}</text>
        </view>
        <view class="prof__sheet-close" hover-class="sl-hover" bindtap="onCloseModal">
          <view class="ic ic-close-navy prof__sheet-close-ic"></view>
        </view>
      </view>

      <view class="prof__sheet-body">
        <view class="prof__chips-wrap">
          <view
            wx:for="{{ allZones }}"
            wx:key="*this"
            class="prof__chip {{ tempZones.includes(item) ? 'prof__chip--on' : '' }}"
            data-zone="{{ item }}"
            hover-class="sl-hover"
            bindtap="onToggleZone"
          >
            <view wx:if="{{ tempZones.includes(item) }}" class="ic ic-check-green prof__chip-ic"></view>
            <text>{{ item }}</text>
          </view>
        </view>
      </view>

      <view class="prof__sheet-footer">
        <button class="prof__btn-primary" hover-class="sl-hover" bindtap="onSaveZones">
          Valider la sélection ({{ tempZones.length }})
        </button>
      </view>
    </view>
  </view>

  <!-- Modal 4 : Budget habituel -->
  <view wx:if="{{ activeModal === 'budget' }}" class="prof__sheet-overlay" catchtouchmove="noop" bindtap="onCloseModal">
    <view class="prof__sheet" catchtap="noop">
      <view class="prof__sheet-handle"></view>
      <view class="prof__sheet-header">
        <view class="prof__sheet-heading">
          <text class="prof__sheet-title">{{ i18n.profile.budgetTitle || 'Budget habituel' }}</text>
          <text class="prof__sheet-sub">{{ i18n.profile.budgetSub || 'Votre tranche mensuelle de loyer' }}</text>
        </view>
        <view class="prof__sheet-close" hover-class="sl-hover" bindtap="onCloseModal">
          <view class="ic ic-close-navy prof__sheet-close-ic"></view>
        </view>
      </view>

      <view class="prof__sheet-body">
        <view class="prof__radios">
          <view
            wx:for="{{ budgetOptions }}"
            wx:key="*this"
            class="prof__radio-item {{ tempBudget === item ? 'prof__radio-item--on' : '' }}"
            data-budget="{{ item }}"
            hover-class="sl-hover"
            bindtap="onSelectBudget"
          >
            <view class="prof__radio-circle {{ tempBudget === item ? 'prof__radio-circle--on' : '' }}">
              <view wx:if="{{ tempBudget === item }}" class="prof__radio-dot"></view>
            </view>
            <text class="prof__radio-label">{{ item }}</text>
          </view>
        </view>
      </view>

      <view class="prof__sheet-footer">
        <button class="prof__btn-primary" hover-class="sl-hover" bindtap="onSaveBudget">
          {{ i18n.profile.confirmBudget || 'Confirmer ce budget' }}
        </button>
      </view>
    </view>
  </view>

  <!-- Modal 5 : Centre d'aide -->
  <view wx:if="{{ activeModal === 'help' }}" class="prof__sheet-overlay" catchtouchmove="noop" bindtap="onCloseModal">
    <view class="prof__sheet" catchtap="noop">
      <view class="prof__sheet-handle"></view>
      <view class="prof__sheet-header">
        <view class="prof__sheet-heading">
          <text class="prof__sheet-title">{{ i18n.profile.helpTitle || 'Centre d’aide' }}</text>
          <text class="prof__sheet-sub">{{ i18n.profile.helpSub || 'Questions fréquentes des locataires' }}</text>
        </view>
        <view class="prof__sheet-close" hover-class="sl-hover" bindtap="onCloseModal">
          <view class="ic ic-close-navy prof__sheet-close-ic"></view>
        </view>
      </view>

      <view class="prof__sheet-body">
        <view class="prof__faq-item">
          <view class="prof__faq-q ic-row"><view class="ic ic-cal-berry ic--sm"></view><text>Comment planifier une visite ?</text></view>
          <text class="prof__faq-a">Parcourez les annonces, cliquez sur « Réserver une visite » et choisissez la date et l'horaire. Le bailleur reçoit une notification instantanée et confirme sous 24h.</text>
        </view>

        <view class="prof__faq-item">
          <view class="prof__faq-q ic-row"><view class="ic ic-card-berry ic--sm"></view><text>Comment payer mon loyer ?</text></view>
          <text class="prof__faq-a">Dans l'onglet « Mes loyers », appuyez sur « Payer le loyer ». La transaction s'effectue en toute sécurité avec Max it et génère automatiquement un reçu horodaté officiel.</text>
        </view>

        <view class="prof__faq-item">
          <view class="prof__faq-q ic-row"><view class="ic ic-lock-berry ic--sm"></view><text>Comment ma caution est-elle sécurisée ?</text></view>
          <text class="prof__faq-a">La caution est enregistrée dans votre contrat numérique Sama Loyer. En cas de départ, un préavis légal est déclenché et le remboursement est sécurisé post état des lieux.</text>
        </view>
      </view>

      <view class="prof__sheet-footer">
        <button class="prof__btn-primary" hover-class="sl-hover" bindtap="onCloseModal">
          {{ i18n.profile.understood || 'J’ai compris' }}
        </button>
      </view>
    </view>
  </view>

  <!-- Modal 6 : Conseils de sécurité -->
  <view wx:if="{{ activeModal === 'security' }}" class="prof__sheet-overlay" catchtouchmove="noop" bindtap="onCloseModal">
    <view class="prof__sheet" catchtap="noop">
      <view class="prof__sheet-handle"></view>
      <view class="prof__sheet-header">
        <view class="prof__sheet-heading">
          <text class="prof__sheet-title">{{ i18n.profile.securityTipsTitle || 'Conseils de sécurité' }}</text>
          <text class="prof__sheet-sub">{{ i18n.profile.securityTipsSub || 'Protégez-vous contre les arnaques' }}</text>
        </view>
        <view class="prof__sheet-close" hover-class="sl-hover" bindtap="onCloseModal">
          <view class="ic ic-close-navy prof__sheet-close-ic"></view>
        </view>
      </view>

      <view class="prof__sheet-body">
        <view class="prof__security-card prof__security-card--warn">
          <view class="ic ic-warn-amber prof__sec-ic"></view>
          <view class="prof__sec-text">
            <text class="prof__sec-title">{{ i18n.profile.securityRule1Title || 'Ne payez jamais avant la visite' }}</text>
            <text class="prof__sec-desc">{{ i18n.profile.securityRule1Sub || 'N’acceptez aucun transfert d’avance sous prétexte de « réserver la clé » ou bloquer le logement.' }}</text>
          </view>
        </view>

        <view class="prof__security-card">
          <view class="ic ic-shield-check-green prof__sec-ic"></view>
          <view class="prof__sec-text">
            <text class="prof__sec-title">{{ i18n.profile.securityRule2Title || 'Exigez le contrat numérique Sama Loyer' }}</text>
            <text class="prof__sec-desc">{{ i18n.profile.securityRule2Sub || 'Chaque bail dispose d’un QR code infalsifiable et protège juridiquement le bailleur et le locataire.' }}</text>
          </view>
        </view>

        <view class="prof__security-card">
          <view class="ic ic-check-green prof__sec-ic"></view>
          <view class="prof__sec-text">
            <text class="prof__sec-title">{{ i18n.profile.securityRule3Title || 'Payez toujours via Orange Max it' }}</text>
            <text class="prof__sec-desc">{{ i18n.profile.securityRule3Sub || 'Les paiements intégrés constituent une preuve légale irréfutable en cas de litige.' }}</text>
          </view>
        </view>
      </view>

      <view class="prof__sheet-footer">
        <button class="prof__btn-primary" hover-class="sl-hover" bindtap="onCloseModal">
          {{ i18n.profile.understoodThanks || 'Compris, merci' }}
        </button>
      </view>
    </view>
  </view>

  <!-- Modal 7 : Support & Assistance -->
  <view wx:if="{{ activeModal === 'support' }}" class="prof__sheet-overlay" catchtouchmove="noop" bindtap="onCloseModal">
    <view class="prof__sheet" catchtap="noop">
      <view class="prof__sheet-handle"></view>
      <view class="prof__sheet-header">
        <view class="prof__sheet-heading">
          <text class="prof__sheet-title">{{ i18n.profile.supportTitle || 'Assistance Sama Loyer' }}</text>
          <text class="prof__sheet-sub">{{ i18n.profile.supportSub || 'Notre équipe est là pour vous accompagner' }}</text>
        </view>
        <view class="prof__sheet-close" hover-class="sl-hover" bindtap="onCloseModal">
          <view class="ic ic-close-navy prof__sheet-close-ic"></view>
        </view>
      </view>

      <view class="prof__sheet-body">
        <view class="prof__support-opt" hover-class="sl-hover" bindtap="onCallSupport">
          <view class="prof__support-opt-ic prof__support-opt-ic--berry">
            <view class="ic ic-phone-call-berry" style="width: 44rpx; height: 44rpx;"></view>
          </view>
          <view class="prof__support-opt-text">
            <text class="prof__support-opt-title">{{ i18n.profile.supportCallTitle || 'Appeler le service client (1444)' }}</text>
            <text class="prof__support-opt-sub">{{ i18n.profile.supportCallSub || 'Appel gratuit depuis votre ligne Orange · 7j/7' }}</text>
          </view>
          <view class="ic ic-chevron-grey prof__chev"></view>
        </view>

        <view class="prof__support-opt" hover-class="sl-hover" bindtap="onCopySupportWhatsApp">
          <view class="prof__support-opt-ic prof__support-opt-ic--green">
            <view class="ic ic-whatsapp-green" style="width: 44rpx; height: 44rpx;"></view>
          </view>
          <view class="prof__support-opt-text">
            <text class="prof__support-opt-title">{{ i18n.profile.supportWhatsAppTitle || 'Assistance WhatsApp' }}</text>
            <text class="prof__support-opt-sub">{{ i18n.profile.supportWhatsAppSub || 'Réponse rapide de 8h à 20h · +221 77 000 00 00' }}</text>
          </view>
          <view class="ic ic-chevron-grey prof__chev"></view>
        </view>
      </view>

      <view class="prof__sheet-footer">
        <button class="prof__btn-secondary" hover-class="sl-hover" bindtap="onCloseModal">
          {{ i18n.common.close || 'Fermer' }}
        </button>
      </view>
    </view>
  </view>
</view>
