@import "/styles/sama-ui.wxss";

/* ============================================================================
   SAMA LOYER — Profil et paramètres, d'après la maquette Profil
   ============================================================================ */

page {
  background: #F7F8FA;
}

.prof__header {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.prof__title {
  display: block;
  margin-bottom: 32rpx;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.prof__card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4E7EE;
}

.prof__avatar {
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  border-radius: 60rpx;
  background: #0F1E3D;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prof__who {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.prof__name {
  font-size: 36rpx;
  font-weight: 800;
}

.prof__phone {
  font-size: 28rpx;
  color: #3A4458;
}

.prof__verified {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #11643F;
}

.prof__verified-ic {
  width: 24rpx;
  height: 24rpx;
}

.prof__edit-ic {
  width: 36rpx;
  height: 36rpx;
}

.prof__stats {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.prof__stat {
  padding: 24rpx 16rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.prof__stat-num {
  font-size: 40rpx;
  font-weight: 800;
}

.prof__stat-label {
  font-size: 24rpx;
  color: #5B6475;
}

/* --- Sections ------------------------------------------------------------ */
.prof__section {
  padding: 44rpx 40rpx 0;
}

.prof__section--last {
  padding-bottom: 56rpx;
}

.prof__section-title {
  display: block;
  margin: 0 0 16rpx 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #5B6475;
}

.prof__group {
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  overflow: hidden;
}

.prof__row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 28rpx;
  min-height: 116rpx;
  box-sizing: border-box;
  border-bottom: 2rpx solid #EEF0F4;
}

.prof__row:last-child {
  border-bottom: 0;
}

.prof__row--hover {
  background: #F7F8FA;
}

.prof__row--notif,
.prof__row--tall {
  min-height: 124rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.prof__row--short {
  min-height: 112rpx;
}

.prof__row-ic {
  width: 40rpx;
  height: 40rpx;
}

.prof__row-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.prof__row-label {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.prof__row-text .prof__row-label {
  flex: none;
}

.prof__row-sub {
  font-size: 24rpx;
  color: #5B6475;
}

.prof__chev {
  width: 32rpx;
  height: 32rpx;
}

/* --- Interrupteur -------------------------------------------------------- */
.prof__switch {
  position: relative;
  width: 104rpx;
  height: 64rpx;
  flex: 0 0 104rpx;
  border-radius: 32rpx;
  background: #C9CFDA;
  transition: background 0.15s;
}

.prof__switch--on {
  background: #C8235F;
}

.prof__knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(15, 30, 61, 0.25);
  transition: left 0.15s;
}

.prof__switch--on .prof__knob {
  left: 46rpx;
}

/* --- Langue -------------------------------------------------------------- */
.prof__lang {
  padding: 28rpx;
  border-bottom: 2rpx solid #EEF0F4;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prof__segmented {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 28rpx;
  background: #F1F3F6;
}

.prof__segment {
  height: 80rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #5B6475;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prof__segment--on {
  background: #FFFFFF;
  color: #0F1E3D;
  box-shadow: 0 2rpx 8rpx rgba(15, 30, 61, 0.12);
}

/* --- Bailleur ------------------------------------------------------------ */
.prof__owner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: #0F1E3D;
  color: #FFFFFF;
}

.prof__owner-ic {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 24rpx;
  background: #C8235F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prof__owner-ic .ic {
  width: 40rpx;
  height: 40rpx;
}

.prof__owner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.prof__owner-title {
  font-size: 30rpx;
  font-weight: 800;
}

.prof__owner-sub {
  font-size: 24rpx;
  color: #C9D0DE;
}

/* --- Déconnexion --------------------------------------------------------- */
.prof__logout {
  height: 108rpx;
  border-radius: 32rpx;
  border: 2rpx solid #F1C7C4;
  background: #FFFFFF;
  color: #A3261F;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.prof__logout-ic {
  width: 36rpx;
  height: 36rpx;
}

.prof__version {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #5B6475;
}

.prof__tab-spacer {
  height: calc(156rpx + env(safe-area-inset-bottom));
}

/* --- Confirmation -------------------------------------------------------- */
.prof__overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  padding: 48rpx;
  background: rgba(15, 30, 61, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.prof__dialog {
  width: 100%;
  padding: 44rpx;
  border-radius: 44rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prof__dialog-title {
  font-size: 38rpx;
  font-weight: 800;
}

.prof__dialog-text {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #5B6475;
}

.prof__dialog-btn {
  height: 100rpx;
  border-radius: 28rpx;
  border: 2rpx solid #E4E7EE;
  background: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prof__dialog-btn--danger {
  border: 0;
  background: #A3261F;
  color: #FFFFFF;
  font-weight: 800;
}

/* ============================================================================
   SAMA LOYER — Bottom Sheets & Modals pour Mon Compte / Préférences / Support
   ============================================================================ */

.prof__sheet-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2000;
  background: rgba(15, 30, 61, 0.55);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: profFadeIn 0.22s ease-out;
}

@keyframes profFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.prof__sheet {
  width: 100%;
  max-height: 85vh;
  box-sizing: border-box;
  background: #FFFFFF;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom)) 40rpx;
  display: flex;
  flex-direction: column;
  animation: profSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -12rpx 40rpx rgba(15, 30, 61, 0.12);
}

@keyframes profSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.prof__sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #D5DAE5;
  margin: 0 auto 24rpx auto;
}

.prof__sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.prof__sheet-heading {
  flex: 1;
  min-width: 0;
}

.prof__sheet-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #0F1E3D;
  letter-spacing: -0.01em;
}

.prof__sheet-sub {
  display: block;
  font-size: 26rpx;
  color: #7A8294;
  margin-top: 6rpx;
}

.prof__sheet-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #F1F4F9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.prof__sheet-close-ic {
  width: 28rpx;
  height: 28rpx;
}

.prof__sheet-body {
  overflow-y: auto;
  max-height: 55vh;
  padding-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Champs de formulaires */
.prof__field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.prof__field-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #3A4458;
}

.prof__field-input {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  background: #F7F8FA;
  border: 2rpx solid #E4E7EE;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0F1E3D;
}

.prof__field-hint {
  font-size: 22rpx;
  color: #7A8294;
  margin-top: 4rpx;
}

/* Numéro de téléphone */
.prof__phone-box {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border: 2rpx solid #E4E7EE;
  border-radius: 24rpx;
  height: 96rpx;
  overflow: hidden;
}

.prof__phone-prefix {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 24rpx;
  border-right: 2rpx solid #E4E7EE;
  background: #ECEFF5;
  height: 100%;
}

.prof__phone-flag {
  font-size: 32rpx;
}

.prof__phone-code {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.prof__field-input--phone {
  flex: 1;
  background: transparent;
  border: 0;
  height: 100%;
  padding: 0 24rpx;
}

/* Badge certifié Max it */
.prof__badge-maxit {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #EAF7EE;
  border: 2rpx solid #C4EED0;
}

.prof__badge-ic {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.prof__badge-text {
  flex: 1;
  min-width: 0;
}

.prof__badge-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #11643F;
}

.prof__badge-desc {
  display: block;
  font-size: 24rpx;
  color: #2F6F48;
  margin-top: 4rpx;
}

/* Boutons footer */
.prof__sheet-footer {
  margin-top: 24rpx;
}

.prof__btn-primary {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
  border-radius: 30rpx;
  background: #C8235F;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  border: 0;
  box-shadow: 0 10rpx 28rpx rgba(200, 35, 95, 0.28);
}

.prof__btn-primary::after {
  border: none;
}

.prof__btn-secondary {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
  border-radius: 30rpx;
  background: #F1F4F9;
  color: #0F1E3D;
  font-size: 30rpx;
  font-weight: 700;
  border: 0;
}

.prof__btn-secondary::after {
  border: none;
}

/* Chips Quartiers */
.prof__chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 8rpx;
}

.prof__chip {
  padding: 18rpx 32rpx;
  border-radius: 36rpx;
  background: #F4F6F9;
  border: 2rpx solid #E2E6EE;
  font-size: 26rpx;
  font-weight: 700;
  color: #3A4458;
  display: flex;
  align-items: center;
  gap: 10rpx;
  transition: all 0.15s ease;
}

.prof__chip--on {
  background: #FDE8EF;
  border-color: #C8235F;
  color: #C8235F;
  font-weight: 800;
}

.prof__chip-ic {
  width: 24rpx;
  height: 24rpx;
}

/* Radios Budget */
.prof__radios {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.prof__radio-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #F7F8FA;
  border: 2rpx solid #E4E7EE;
  transition: all 0.15s ease;
}

.prof__radio-item--on {
  background: #FDE8EF;
  border-color: #C8235F;
}

.prof__radio-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 3rpx solid #C9CFDA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prof__radio-circle--on {
  border-color: #C8235F;
  background: #FFFFFF;
}

.prof__radio-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: #C8235F;
}

.prof__radio-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F1E3D;
}

/* FAQ & Sécurité */
.prof__faq-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F7F8FA;
  border: 2rpx solid #E4E7EE;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.prof__faq-q {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.prof__faq-a {
  font-size: 26rpx;
  line-height: 1.5;
  color: #5B6475;
}

.prof__security-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F7F8FA;
  border: 2rpx solid #E4E7EE;
}

.prof__security-card--warn {
  background: #FFF9ED;
  border-color: #F8E3B6;
}

.prof__sec-ic {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  margin-top: 4rpx;
}

.prof__sec-text {
  flex: 1;
  min-width: 0;
}

.prof__sec-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.prof__sec-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  color: #5B6475;
  margin-top: 6rpx;
}

/* Support Options */
.prof__support-opt {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #F7F8FA;
  border: 2rpx solid #E4E7EE;
}

.prof__support-opt-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 80rpx;
}

.prof__support-opt-ic--berry {
  background: #FDE8EF;
}

.prof__support-opt-ic--green {
  background: #EAF7EE;
}

.prof__support-opt-text {
  flex: 1;
  min-width: 0;
}

.prof__support-opt-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.prof__support-opt-sub {
  display: block;
  font-size: 24rpx;
  color: #7A8294;
  margin-top: 4rpx;
}

/* --- Profil Certifié Max it & Carte Identité ---------------------------- */
.prof__id-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #F4F6FB;
  border: 2rpx solid #E2E6F0;
}

.prof__id-avatar {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 52rpx;
  background: #0F1E3D;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prof__id-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.prof__id-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.prof__id-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #11643F;
}

.prof__id-badge-ic {
  width: 24rpx;
  height: 24rpx;
}

.prof__id-rows {
  display: flex;
  flex-direction: column;
  border-radius: 28rpx;
  background: #F8F9FC;
  border: 2rpx solid #E8EBF2;
  overflow: hidden;
}

.prof__id-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #EDF0F7;
}

.prof__id-row:last-child {
  border-bottom: 0;
}

.prof__id-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #5B6475;
}

.prof__id-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.prof__id-val--green {
  color: #11643F;
}

.prof__sec-note {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #EAF7EE;
  border: 2rpx solid #C4EED0;
}

.prof__sec-note-ic {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.prof__sec-note-text {
  font-size: 23rpx;
  line-height: 1.4;
  color: #11643F;
  font-weight: 600;
}

/* --- Carte Numéro Orange Max it ----------------------------------------- */
.prof__phone-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #0F1E3D 0%, #1D3567 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(15, 30, 61, 0.2);
}

.prof__phone-card-top {
  margin-bottom: 16rpx;
}

.prof__phone-sim-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  font-weight: 700;
  color: #E2E6F0;
}

.prof__phone-number {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  margin-bottom: 10rpx;
  color: #FFFFFF;
}

.prof__phone-status {
  font-size: 24rpx;
  font-weight: 600;
  color: #6EE7B7;
}

.prof__sec-box {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #F7F8FA;
  border: 2rpx solid #E4E7EE;
}

.prof__sec-box-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.prof__sec-bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #C8235F;
  margin-top: 10rpx;
  flex: 0 0 12rpx;
}

.prof__sec-box-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.prof__sec-box-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.prof__sec-box-sub {
  font-size: 23rpx;
  line-height: 1.45;
  color: #5B6475;
}

.prof__sec-info {
  font-size: 23rpx;
  line-height: 1.45;
  color: #7A8294;
  padding: 0 12rpx;
}
