@import "/styles/sama-ui.wxss";

/* --- Barre du haut + progression ----------------------------------------- */
.entree__top {
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entree__title {
  font-size: 32rpx;
  font-weight: 800;
}

.entree__step-count {
  width: 88rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #5B6475;
}

.entree__bars {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 12rpx 40rpx 24rpx;
}

.entree__bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: #E4E7EE;
}

.entree__bar--on {
  background: #C8235F;
}

/* --- Corps --------------------------------------------------------------- */
.entree__body {
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

.entree__home {
  margin-top: 36rpx;
  margin-bottom: 36rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 20rpx;
  border-radius: 36rpx;
  border: 2rpx solid #E4E7EE;
}

.entree__home-thumb {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 28rpx;
}

.entree__home-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entree__home-title {
  font-size: 28rpx;
  font-weight: 800;
}

.entree__muted {
  font-size: 26rpx;
  color: #5B6475;
}

.entree__strong {
  font-weight: 800;
}

.entree__berry {
  color: #C8235F;
}

.entree__right {
  text-align: right;
}

.entree__h2 {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.entree__lead {
  display: block;
  font-size: 28rpx;
  color: #5B6475;
  margin-bottom: 28rpx;
}

/* --- Étape 1 : récapitulatif --------------------------------------------- */
.entree__recap {
  border: 2rpx solid #E4E7EE;
  border-radius: 36rpx;
  overflow: hidden;
}

.entree__recap-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #EEF0F4;
}

.entree__recap-row--total {
  padding: 32rpx;
  background: #FDF1F5;
  border-bottom: 0;
}

.entree__recap-label {
  display: flex;
  flex-direction: column;
}

.entree__recap-name {
  font-size: 30rpx;
  font-weight: 700;
}

.entree__recap-sub {
  font-size: 24rpx;
  color: #5B6475;
}

.entree__recap-value {
  font-size: 30rpx;
  font-weight: 800;
}

.entree__total-label {
  font-size: 32rpx;
  font-weight: 800;
}

.entree__total-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #C8235F;
}

.entree__infos {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.entree__info {
  padding: 24rpx;
  border-radius: 28rpx;
  background: #F7F8FA;
  display: flex;
  flex-direction: column;
}

.entree__info-value {
  font-size: 30rpx;
  font-weight: 800;
}

/* --- Étape 2 : contrat --------------------------------------------------- */
.entree__read {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #0F1E3D;
  color: #FFFFFF;
}

.entree__read-icon {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 28rpx;
  background: #C8235F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entree__read-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entree__read-title {
  font-size: 30rpx;
  font-weight: 800;
}

.entree__read-sub {
  font-size: 24rpx;
  color: #C9D0DE;
}

.entree__read-chev {
  width: 32rpx;
  height: 32rpx;
}

.entree__agree {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
}

/* --- Étape 3 : paiement -------------------------------------------------- */
.entree__pay {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 4rpx solid #E4E7EE;
}

.entree__pay--on {
  background: #FDF1F5;
  border-color: #C8235F;
}

.entree__radio {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 4rpx solid #C9CFDA;
}

.entree__radio--on {
  border: 14rpx solid #C8235F;
}

.entree__pay-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entree__pay-title {
  font-size: 32rpx;
  font-weight: 800;
}

.entree__pay-amount {
  font-size: 34rpx;
  font-weight: 800;
}

.entree__part {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #F7F8FA;
}

.entree__part-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.entree__presets {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.entree__preset {
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: #FFFFFF;
  color: #0F1E3D;
  border: 4rpx solid #E4E7EE;
  box-sizing: border-box;
}

.entree__preset--on {
  background: #C8235F;
  color: #FFFFFF;
  border-color: #C8235F;
}

.entree__preset-label {
  font-size: 30rpx;
  font-weight: 800;
}

.entree__preset-sub {
  font-size: 20rpx;
  font-weight: 700;
}

.entree__other-label {
  display: block;
  margin: 24rpx 0 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #5B6475;
}

.entree__other {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 100rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 4rpx solid #E4E7EE;
  box-sizing: border-box;
}

.entree__other-input {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.entree__placeholder {
  color: #7A8294;
  font-weight: 500;
}

.entree__error {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #A3261F;
}

.entree__split {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 28rpx;
}

.entree__split-row {
  display: flex;
  justify-content: space-between;
}

.entree__part-note {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #3A4458;
}

/* --- Terminé ------------------------------------------------------------- */
.entree__done {
  padding-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.entree__done-icon {
  width: 152rpx;
  height: 152rpx;
  border-radius: 76rpx;
  background: #FDF1F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entree__done-icon .ic {
  width: 68rpx;
  height: 68rpx;
}

.entree__done-title {
  margin: 32rpx 0 12rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.entree__done-text {
  margin-bottom: 0;
}

.entree__paid {
  margin-top: 36rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: #0F1E3D;
  color: #FFFFFF;
}

.entree__paid-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #C9D0DE;
}

.entree__paid-amount {
  display: block;
  margin: 4rpx 0 20rpx;
  font-size: 52rpx;
  font-weight: 800;
}

.entree__progress {
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.18);
}

.entree__progress-bar {
  height: 16rpx;
  border-radius: 8rpx;
  background: #F08DB2;
}

.entree__paid-rest {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #F08DB2;
}

.entree__receipts {
  margin-top: 28rpx;
  border-radius: 36rpx;
  border: 2rpx solid #E4E7EE;
  overflow: hidden;
}

.entree__receipt {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #EEF0F4;
}

.entree__receipt-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entree__receipt-label {
  font-size: 28rpx;
  font-weight: 700;
}

.entree__receipt-badge {
  font-size: 24rpx;
  font-weight: 800;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #FDF1F5;
  color: #9E1749;
}

.entree__back {
  flex: 0 0 auto;
  padding: 0 40rpx;
}

/* --- Contrat complet ----------------------------------------------------- */
.entree__sheet {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: #F7F8FA;
}

.entree__sheet-scroll {
  height: 100vh;
}

.entree__sheet-hero {
  background: #0F1E3D;
  color: #FFFFFF;
  padding: 0 32rpx 120rpx;
  border-radius: 0 0 56rpx 56rpx;
}

.entree__sheet-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entree__sheet-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #C9D0DE;
}

.entree__sheet-title-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.entree__sheet-doc {
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
}

.entree__sheet-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
}

.entree__sheet-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #C9D0DE;
}

.entree__sheet-tag {
  margin-top: 24rpx;
  display: inline-block;
  font-size: 24rpx;
  font-weight: 800;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #C8235F;
}

.entree__sheet-card {
  position: relative;
  margin: -80rpx 32rpx 0;
  padding: 32rpx;
  border-radius: 44rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 48rpx rgba(15, 30, 61, 0.10);
}

.entree__sheet-h3 {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.entree__sheet-section {
  padding: 32rpx 32rpx 0;
}

.entree__parties {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.entree__party {
  padding: 24rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  display: flex;
  flex-direction: column;
}

.entree__party--to-sign {
  border: 4rpx dashed #C8235F;
}

.entree__eyebrow {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #C8235F;
}

.entree__party-name {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.entree__party-sub {
  font-size: 22rpx;
  color: #5B6475;
}

.entree__sig-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #5B6475;
}

.entree__sig {
  margin: 12rpx 0 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx dashed #C9CFDA;
  font-family: 'Caveat', 'Brush Script MT', cursive;
  font-style: italic;
  font-size: 44rpx;
  color: #0F1E3D;
}

.entree__sig-todo {
  margin: 12rpx 0 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx dashed #C9CFDA;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 60rpx;
  color: #C8235F;
}

.entree__dl {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E4E7EE;
  box-sizing: border-box;
}
