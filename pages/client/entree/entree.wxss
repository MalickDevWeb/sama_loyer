@import "/styles/sama-ui.wxss";

/* --- Barre du haut + progression ----------------------------------------- */
.entree__top {
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entree__title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

.entree__step-count {
  width: 88rpx;
  text-align: center;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-muted);
}

.entree__bars {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 12rpx 40rpx 24rpx;
}

.entree__bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--sl-border);
}

.entree__bar--on {
  background: var(--sl-berry);
}

/* --- Corps --------------------------------------------------------------- */
.entree__body {
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

.entree__home {
  margin-top: 36rpx;
  margin-bottom: 36rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 20rpx;
  border-radius: 36rpx;
  border: 2rpx solid var(--sl-border);
}

.entree__home-thumb {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 28rpx;
}

.entree__home-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entree__home-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.entree__muted {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.entree__strong {
  font-weight: var(--sl-fw-extrabold);
}

.entree__berry {
  color: var(--sl-berry);
}

.entree__right {
  text-align: right;
}

.entree__h2 {
  display: block;
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
  margin-bottom: 8rpx;
}

.entree__lead {
  display: block;
  font-size: var(--sl-fs-body);
  color: var(--sl-muted);
  margin-bottom: 28rpx;
}

/* --- Étape 1 : récapitulatif --------------------------------------------- */
.entree__recap {
  border: 2rpx solid var(--sl-border);
  border-radius: 36rpx;
  overflow: hidden;
}

.entree__recap-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--sl-divider);
}

.entree__recap-row--total {
  padding: 32rpx;
  background: var(--sl-berry-soft);
  border-bottom: 0;
}

.entree__recap-label {
  display: flex;
  flex-direction: column;
}

.entree__recap-name {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-bold);
}

.entree__recap-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.entree__recap-value {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.entree__total-label {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

.entree__total-value {
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.entree__infos {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.entree__info {
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--sl-surface-2);
  display: flex;
  flex-direction: column;
}

.entree__info-value {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

/* --- Étape 2 : contrat --------------------------------------------------- */
.entree__read {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
}

.entree__read-icon {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 28rpx;
  background: var(--sl-berry);
  display: flex;
  align-items: center;
  justify-content: center;
}

.entree__read-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entree__read-title {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.entree__read-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-border-strong);
}

.entree__read-chev {
  width: 32rpx;
  height: 32rpx;
}

.entree__agree {
  margin-top: 24rpx;
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

/* --- Étape 3 : paiement -------------------------------------------------- */
.entree__pay {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: var(--sl-white);
  border: 4rpx solid var(--sl-border);
}

.entree__pay--on {
  background: var(--sl-berry-soft);
  border-color: var(--sl-berry);
}

.entree__radio {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 4rpx solid var(--sl-border-strong);
}

.entree__radio--on {
  border: 14rpx solid var(--sl-berry);
}

.entree__pay-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entree__pay-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

.entree__pay-amount {
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
}

.entree__part {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: var(--sl-surface-2);
}

.entree__part-title {
  display: block;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  margin-bottom: 16rpx;
}

.entree__presets {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.entree__preset {
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--sl-white);
  color: var(--sl-text);
  border: 4rpx solid var(--sl-border);
  box-sizing: border-box;
}

.entree__preset--on {
  background: var(--sl-berry);
  color: var(--sl-on-dark);
  border-color: var(--sl-berry);
}

.entree__preset-label {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.entree__preset-sub {
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-bold);
}

.entree__other-label {
  display: block;
  margin: 24rpx 0 12rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-muted);
}

.entree__other {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 100rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--sl-white);
  border: 4rpx solid var(--sl-border);
  box-sizing: border-box;
}

.entree__other-input {
  flex: 1;
  height: 88rpx;
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.entree__placeholder {
  color: var(--sl-placeholder);
  font-weight: var(--sl-fw-medium);
}

.entree__error {
  display: block;
  margin-top: 12rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-danger);
}

.entree__split {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: var(--sl-fs-body);
}

.entree__split-row {
  display: flex;
  justify-content: space-between;
}

.entree__part-note {
  display: block;
  margin-top: 20rpx;
  font-size: var(--sl-fs-small);
  line-height: 1.45;
  color: var(--sl-text-2);
}

/* --- Terminé ------------------------------------------------------------- */
.entree__done {
  padding-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.entree__done-icon {
  width: 152rpx;
  height: 152rpx;
  border-radius: 76rpx;
  background: var(--sl-berry-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.entree__done-icon .ic {
  width: 68rpx;
  height: 68rpx;
}

.entree__done-title {
  margin: 32rpx 0 12rpx;
  font-size: 48rpx;
  font-weight: var(--sl-fw-extrabold);
}

.entree__done-text {
  margin-bottom: 0;
}

.entree__paid {
  margin-top: 36rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
}

.entree__paid-head {
  display: flex;
  justify-content: space-between;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-border-strong);
}

.entree__paid-amount {
  display: block;
  margin: 4rpx 0 20rpx;
  font-size: var(--sl-fs-h1);
  font-weight: var(--sl-fw-extrabold);
}

.entree__progress {
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.18);
}

.entree__progress-bar {
  height: 16rpx;
  border-radius: 8rpx;
  background: #F08DB2;
}

.entree__paid-rest {
  display: block;
  margin-top: 20rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: #F08DB2;
}

.entree__receipts {
  margin-top: 28rpx;
  border-radius: 36rpx;
  border: 2rpx solid var(--sl-border);
  overflow: hidden;
}

.entree__receipt {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--sl-divider);
}

.entree__receipt-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entree__receipt-label {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
}

.entree__receipt-badge {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
}

.entree__back {
  flex: 0 0 auto;
  padding: 0 40rpx;
}

/* --- Contrat complet ----------------------------------------------------- */
.entree__sheet {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: var(--sl-surface-2);
}

.entree__sheet-scroll {
  height: 100vh;
}

.entree__sheet-hero {
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  padding: 0 32rpx 120rpx;
  border-radius: 0 0 56rpx 56rpx;
}

.entree__sheet-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entree__sheet-num {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-border-strong);
}

.entree__sheet-title-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.entree__sheet-doc {
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
}

.entree__sheet-title {
  display: block;
  font-size: 42rpx;
  font-weight: var(--sl-fw-extrabold);
}

.entree__sheet-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-border-strong);
}

.entree__sheet-tag {
  margin-top: 24rpx;
  display: inline-block;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--sl-white);
  color: var(--sl-berry);
}

.entree__sheet-card {
  position: relative;
  margin: -80rpx 32rpx 0;
  padding: 32rpx;
  border-radius: 44rpx;
  background: var(--sl-white);
  box-shadow: 0 16rpx 48rpx rgba(15, 30, 61, 0.10);
}

.entree__sheet-h3 {
  display: block;
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  margin-bottom: 24rpx;
}

.entree__sheet-section {
  padding: 32rpx 32rpx 0;
}

.entree__parties {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.entree__party {
  padding: 24rpx;
  border-radius: 32rpx;
  background: var(--sl-white);
  border: 2rpx solid var(--sl-border);
  display: flex;
  flex-direction: column;
}

.entree__party--to-sign {
  border: 4rpx dashed var(--sl-berry);
}

.entree__eyebrow {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.08em;
  color: var(--sl-berry);
}

.entree__party-name {
  margin-top: 8rpx;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.entree__party-sub {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
}

.entree__sig-label {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-muted);
}

.entree__sig {
  margin: 12rpx 0 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx dashed var(--sl-border-strong);
  font-family: 'Caveat', 'Brush Script MT', cursive;
  font-style: italic;
  font-size: var(--sl-fs-h2);
  color: var(--sl-text);
}

.entree__sig-todo {
  margin: 12rpx 0 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx dashed var(--sl-border-strong);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  line-height: 60rpx;
  color: var(--sl-berry);
}

.entree__dl {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--sl-border);
  box-sizing: border-box;
}

/* ============================================================================
   SAMA LOYER — Modal Quittance d'Entrée Officielle Certifiée
   ============================================================================ */
.loy__quittance-modal {
  max-width: 660rpx;
  width: 92%;
  padding: 32rpx;
  border-radius: 40rpx;
  background: var(--sl-white);
  box-shadow: 0 20rpx 60rpx rgba(15, 30, 61, 0.35);
}

.loy__quittance-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--sl-border);
}

.loy__quittance-repub {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loy__repub-flag {
  font-size: var(--sl-fs-subtitle);
}

.loy__repub-txt {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.06em;
  color: var(--sl-text);
}

.loy__quittance-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: var(--sl-surface-3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loy__quittance-body {
  padding: 24rpx 0 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loy__quittance-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.loy__quittance-ref {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.loy__quittance-date {
  font-size: var(--sl-fs-caption);
  color: var(--sl-placeholder);
  margin-top: 2rpx;
  margin-bottom: 20rpx;
}

.loy__quittance-seal {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: var(--sl-green-bg);
  border: 2rpx solid #C4EED0;
  margin-bottom: 24rpx;
}

.loy__seal-txt {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-success);
  letter-spacing: 0.02em;
}

.loy__quittance-amount-box {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--sl-bg);
  border: 2rpx solid var(--sl-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.loy__amount-label {
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.05em;
  color: var(--sl-placeholder);
}

.loy__amount-val {
  font-size: 50rpx;
  font-weight: var(--sl-fw-black);
  color: var(--sl-berry);
  margin: 6rpx 0;
  letter-spacing: -0.02em;
}

.loy__amount-period {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.loy__quittance-grid {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 2rpx solid #EAECEF;
  background: var(--sl-white);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.loy__q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-bottom: 2rpx solid var(--sl-surface-3);
  font-size: var(--sl-fs-small);
}

.loy__q-row:last-child {
  border-bottom: 0;
}

.loy__q-row--total {
  background: var(--sl-bg);
}

.loy__q-lbl {
  color: var(--sl-placeholder);
  font-weight: var(--sl-fw-semibold);
}

.loy__q-val {
  color: var(--sl-text);
  font-weight: var(--sl-fw-bold);
  text-align: right;
  max-width: 60%;
}

.loy__q-val--code {
  font-family: var(--sl-font-mono);
  color: var(--sl-success);
  font-weight: var(--sl-fw-extrabold);
}

.loy__quittance-legal {
  font-size: var(--sl-fs-micro);
  line-height: 1.45;
  color: var(--sl-placeholder);
  text-align: center;
  padding: 0 10rpx;
}

.loy__quittance-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.loy__q-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  font-size: var(--sl-fs-body);
}
