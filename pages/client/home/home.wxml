<view class="sama-page">
  <!-- Toast Flottant SAMA LOYER -->
  <view 
    wx:if="{{ toast.visible }}" 
    class="sama-floating-toast {{ toast.hiding ? 'toast--hide' : 'toast--show' }}" 
    style="top: {{ statusBarHeight + 58 }}px;"
    catchtap="onDismissToast"
  >
    <view class="toast-pill-body">
      <view class="toast-icon-wrapper {{ toast.type === 'voice' ? 'toast-icon--voice' : (toast.type === 'heart' ? 'toast-icon--heart' : 'toast-icon--search') }}">
        <view class="toast-svg {{ toast.iconClass }}"></view>
      </view>
      <view class="toast-text-block">
        <view class="toast-main-line">
          <text class="toast-title-text">{{ toast.title }}</text>
        </view>
        <view wx:if="{{ toast.subtitle }}" class="toast-sub-line">
          <text class="toast-subtitle-text">{{ toast.subtitle }}</text>
        </view>
      </view>
      <view class="toast-badge-sparkle">
        <view class="ic ic-sparkle-amber ic--sm"></view>
      </view>
    </view>
  </view>

  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <!-- Défilement continu : Formulaire + Résultats en dessous sans redirection -->
  <scroll-view 
    class="sama-scroll" 
    scroll-y="{{true}}" 
    enhanced="{{true}}" 
    show-scrollbar="{{false}}"
    scroll-into-view="{{ scrollTarget }}"
    scroll-with-animation="{{ true }}"
  >
    <!-- En-tête SAMA LOYER -->
    <view class="sama-header">

      <!-- Ligne 2 : Sélecteur de rôle pleine largeur (Locataire / Bailleur) -->
      <view class="role-switch-bar">
        <view class="role-segment role-segment--active">
          <view class="ic ic-home-white ic--sm"></view>
          <text class="role-label">{{ i18n.profile.roleTenant || 'Locataire' }}</text>
        </view>
        <view 
          class="role-segment" 
          hover-class="role-segment--hover" 
          bindtap="onSwitchToBailleur"
          aria-label="Basculer vers l'espace Bailleur"
        >
          <view class="ic ic-users-navy ic--sm"></view>
          <text class="role-label">{{ i18n.profile.roleLandlord || 'Bailleur' }}</text>
        </view>
      </view>
    </view>

    <!-- Carte d'accroche dégradée rose avec filigrane maison -->
    <view class="hero-pink-card">
      <!-- Scène animée : halo, maison flottante, ombre, buissons, étincelles, repère -->
      <view class="hero-scene" aria-hidden="true">
        <view class="hero-glow"></view>
        <view class="hero-shadow"></view>
        <view class="hero-bush hero-bush--l"></view>
        <view class="hero-bush hero-bush--r"></view>
        <view class="hero-house"></view>
        <view class="hero-pin"><view class="ic ic-pin-berry ic--sm"></view></view>
        <view class="hero-spark hero-spark--1"><view class="ic ic-sparkle-berry"></view></view>
        <view class="hero-spark hero-spark--2"><view class="ic ic-sparkle-amber"></view></view>
        <view class="hero-spark hero-spark--3"><view class="ic ic-sparkle-berry"></view></view>
      </view>

      <!-- Badge utilisateur / Salamalekum -->
      <view class="hero-user-pill">
        <view class="pill-red-dot ui-dot"></view>
        <text class="pill-user-text">Salamalekum, Awa</text>
      </view>

      <!-- Titre d'accroche -->
      <view class="hero-headline">
        <text class="hero-title-dark">{{ i18n.home.heroTitleDark || 'Trouve ton logement.' }}</text>
        <text class="hero-title-accent">{{ i18n.home.heroTitleAccent || 'Simplement.' }}</text>
      </view>

      <text class="hero-subtitle">{{ i18n.home.heroSubtitle || 'Dis-nous où et combien. L’IA choisit pour toi.' }}</text>

      <!-- Tags de réassurance -->
      <view class="hero-trust-badges">
        <view class="trust-badge">
          <view class="ic ic-check-berry ic--sm"></view>
          <text>{{ i18n.home.verifiedBadges || 'Annonces vérifiées' }}</text>
        </view>
        <view class="trust-badge">
          <view class="ic ic-check-berry ic--sm"></view>
          <text>{{ i18n.home.maxitPayment || 'Paiement Max it' }}</text>
        </view>
      </view>
    </view>

    <!-- Formulaire de recherche (Critères ajustables à tout moment) -->
    <view class="sama-form">
      <!-- Champ Localité -->
      <view class="form-group">
        <text class="form-label">{{ i18n.home.locality || 'Localité' }}</text>
        <view class="input-box input-box--stacked {{ focusField === 'lieu' ? 'input-box--focus' : '' }}">
          <view class="icon-svg icon-pin-berry form-ic form-ic--pin"></view>
          <view class="input-stacked-wrap">
            <input
              id="lieu"
              class="input-field input-field--bold"
              type="text"
              value="{{ place }}"
              bindinput="onPlaceInput"
              bindfocus="onFieldFocus"
              bindblur="onFieldBlur"
              data-field="lieu"
              bindconfirm="onSearchTap"
              confirm-type="search"
              placeholder="Ex. Ouakam, Ngor, Yoff, Almadies…"
              placeholder-class="input-placeholder"
            />
            <text class="input-sub-hint">{{ i18n.home.localityHint || 'Changez de localité si besoin' }}</text>
          </view>
          <view wx:if="{{ place }}" class="input-clear-btn" bindtap="onClearPlace"><view class="ic ic-close-grey ic--xs"></view></view>
        </view>
      </view>

      <!-- Champ Budget -->
      <view class="form-group">
        <text class="form-label">{{ i18n.home.budgetLabel || 'Budget maximum par mois' }}</text>
        <view class="input-box {{ focusField === 'budget' ? 'input-box--focus' : '' }}">
          <view class="icon-svg icon-card-berry form-ic form-ic--card"></view>
          <input
            id="budget"
            class="input-field input-field--bold"
            type="number"
            value="{{ budget }}"
            bindinput="onBudgetInput"
            bindfocus="onFieldFocus"
            bindblur="onFieldBlur"
            data-field="budget"
            bindconfirm="onSearchTap"
            confirm-type="search"
            placeholder="Ex. 60 000"
            placeholder-class="input-placeholder"
          />
          <view wx:if="{{ budget }}" class="input-clear-btn" bindtap="onClearBudget"><view class="ic ic-close-grey ic--xs"></view></view>
          <view class="budget-suffix-box">
            <text class="input-suffix">F CFA</text>
            <text class="budget-chevron">⌄</text>
          </view>
        </view>
      </view>

      <!-- Bouton split : Rechercher (gauche) + Parler (droite) -->
      <view class="split-search-btn {{ isSearching ? 'split-search-btn--loading' : '' }}">
        <!-- Reflet lumineux qui balaie le bouton -->
        <view class="split-shine"></view>
        <view 
          class="split-left" 
          hover-class="split-left--active" 
          hover-stay-time="100" 
          bindtap="onSearchTap"
        >
          <view class="search-btn-icon-box {{ isSearching ? 'icon-spin' : '' }}">
            <view class="icon-svg icon-search-white"></view>
          </view>
          <text class="btn-search-label">{{ isSearching ? (i18n.common.loading || 'Recherche en cours…') : (i18n.common.search || 'Rechercher') }}</text>
        </view>
        <view 
          class="split-right-pill" 
          hover-class="split-right--active" 
          hover-stay-time="100" 
          bindtap="onVoiceTap"
        >
          <view class="mic-wave"><view class="icon-svg icon-mic-berry"></view></view>
          <text class="btn-voice-label">{{ i18n.home.voiceBtn || 'Parler' }}</text>
        </view>
      </view>

      <!-- Note d'aide sous le bouton -->
      <text class="form-help-hint">{{ i18n.home.formHint || 'Écris ci-dessus, ou touche « Parler » en wolof ou en français' }}</text>

      <!-- Carte Mes favoris -->
      <view class="favorites-nav-card" hover-class="sl-hover" bindtap="onGoToFavorites">
        <view class="fav-icon-box">
          <view class="icon-svg icon-heart-fill-berry"></view>
        </view>
        <view class="fav-meta">
          <text class="fav-title">{{ i18n.favoris.title || 'Mes favoris' }}</text>
          <text class="fav-sub">{{ favoritesCount }} logement{{ favoritesCount > 1 ? 's' : '' }} enregistré{{ favoritesCount > 1 ? 's' : '' }}</text>
        </view>
        <view class="ic ic-chevron-berry ic--md"></view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- SECTION RÉSULTATS : AFFICHÉS DIRECTEMENT SOUS LES CRITÈRES -->
    <!-- ======================================================== -->
    <view id="results-section" class="inline-results-section">
      <!-- Cas A : Des logements correspondent -->
      <block wx:if="{{ results && results.length > 0 }}">
        <!-- En-tête des résultats trouvés -->
        <view class="inline-results-header">
          <view class="results-count-row">
            <text class="results-count-title">{{ resultsCount }} logement{{ resultsCount > 1 ? 's' : '' }} disponible{{ resultsCount > 1 ? 's' : '' }}</text>
            <view class="results-live-dot">
              <view class="live-dot-pulse ui-dot"></view>
              <text class="live-dot-text">Disponibles</text>
            </view>
          </view>
          <view class="results-pills-row">
            <view class="res-pill ic-row"><view class="ic ic-pin-navy ic--xs"></view><text>{{ searchedPlace || 'Tout Dakar' }}</text></view>
            <view wx:if="{{ searchedBudget }}" class="res-pill ic-row"><view class="ic ic-wallet-navy ic--xs"></view><text>Max {{ searchedBudget }} F</text></view>
          </view>
        </view>

        <!-- Liste verticale des cartes logements -->
        <view class="results-cards-list">
          <block wx:for="{{ results }}" wx:key="id">
            <view 
              class="rec-card {{ index === 0 ? 'rec-card--best' : '' }}" 
              data-item="{{ item }}" 
              hover-class="rec-card--hover"
              hover-stay-time="80"
              bindtap="onListingTap"
            >
              <!-- Hero illustration teintée avec rang et favoris -->
              <view class="rec-card__hero sl-photo" style="background-color: {{ item.tintBg }}; background-image: url('{{ item.cover }}');">
                <view class="rec-card__rank-row">
                  <view class="rec-card__rank">{{ item.rank }}</view>
                  <view wx:if="{{ index === 0 }}" class="rec-card__badge-best">Meilleur choix</view>
                  <view wx:if="{{ item.verified }}" class="rec-card__badge-verified ic-row"><view class="ic ic-check-white ic--xs"></view><text>Vérifié</text></view>
                </view>

                <!-- Bouton favori en haut à droite -->
                <view 
                  class="rec-card__fav-btn" 
                  data-id="{{ item.id }}" 
                  catchtap="onToggleFavorite"
                >
                  <view class="icon-svg {{ item.isFav ? 'icon-heart-fill-berry' : 'icon-heart-outline' }}"></view>
                </view>

                <view wx:if="{{ !item.cover }}" class="rec-card__house-illu"></view>
              </view>

              <!-- Corps de la carte -->
              <view class="rec-card__body">
                <view class="rec-card__meta-top">
                  <text class="rec-card__type">{{ item.typeLabel }}</text>
                </view>
                <text class="rec-card__title">{{ item.title }}</text>
                <view class="rec-card__place ic-row"><view class="ic ic-pin-berry ic--xs"></view><text>{{ item.place }}</text></view>
                
                <view class="rec-card__price-row">
                  <text class="rec-card__price">{{ item.formattedPrice }}</text>
                  <text class="rec-card__unit">F CFA / mois</text>
                </view>

                <!-- Équipements phares -->
                <view wx:if="{{ item.equipements && item.equipements.length > 0 }}" class="rec-card__tags">
                  <text wx:for="{{ item.equipements }}" wx:for-item="eq" wx:key="*this" class="rec-tag">{{ eq }}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </block>

      <!-- Cas B : Aucun logement ne correspond aux critères -->
      <block wx:elif="{{ hasSearched && results.length === 0 }}">
        <view class="empty-results-box">
          <view class="empty-icon-circle">
            <view class="empty-home-icon"><view class="ic ic-home-navy ic--xl"></view></view>
          </view>

          <text class="empty-title">Aucun logement trouvé</text>

          <view class="empty-message-card">
            <text class="empty-desc">
              Aucun logement ne correspond à votre recherche selon le budget de <text class="empty-bold">{{ searchedBudget ? searchedBudget + ' F CFA' : 'ce montant' }}</text> et la localité renseignée (<text class="empty-bold">{{ searchedPlace || 'cette zone' }}</text>).
            </text>
            <text class="empty-sub-tip">
              Vous pouvez modifier directement votre budget ou votre localité ci-dessus pour affiner votre recherche, ou essayer l'une des options suivantes :
            </text>
          </view>

          <!-- Suggestions de quartiers proches cliquables -->
          <view class="empty-suggestions-block">
            <view class="suggestions-label ic-row"><view class="ic ic-pin-berry ic--sm"></view><text>Quartiers disponibles à proximité :</text></view>
            <view class="suggestions-chips-row">
              <block wx:for="{{ fallbackZones }}" wx:key="*this">
                <view 
                  class="suggest-chip" 
                  data-zone="{{ item }}" 
                  hover-class="sl-hover"
                  bindtap="onSelectFallbackZone"
                >
                  <view class="ic-row"><view class="ic ic-pin-berry ic--xs"></view><text>{{ item }}</text></view>
                </view>
              </block>
            </view>
          </view>

          <!-- Suggestions d'ajustement du budget -->
          <view class="empty-suggestions-block">
            <view class="suggestions-label ic-row"><view class="ic ic-wallet-berry ic--sm"></view><text>Ajuster le budget :</text></view>
            <view class="suggestions-chips-row">
              <view class="suggest-chip suggest-chip--budget" data-add="15000" hover-class="sl-hover" bindtap="onApplyBudgetBump">
                <text>+15 000 F</text>
              </view>
              <view class="suggest-chip suggest-chip--budget" data-add="30000" hover-class="sl-hover" bindtap="onApplyBudgetBump">
                <text>+30 000 F</text>
              </view>
              <view class="suggest-chip suggest-chip--budget" data-add="0" hover-class="sl-hover" bindtap="onApplyBudgetBump">
                <text>Sans limite de budget</text>
              </view>
            </view>
          </view>

          <!-- Bouton réinitialiser -->
          <button class="empty-reset-btn" hover-class="sl-hover" bindtap="onResetSearch">
            Voir tous les logements disponibles
          </button>
        </view>
      </block>
    </view>

    <!-- Espacement inférieur pour la barre d'onglets personnalisée -->
    <view class="home-tab-spacer"></view>
  </scroll-view>

  <!-- Bouton flottant de défilement vers les logements (Image 1) -->
  <view 
    class="floating-scroll-down-btn" 
    hover-class="floating-btn--hover"
    bindtap="onQuickScrollToResults"
    aria-label="Voir les logements disponibles"
  >
    <view class="ic ic-arrow-down-navy ic--md"></view>
  </view>

  <!-- ======================================================== -->
  <!-- MODAL ASSISTANT VOCAL SIMPLE & ÉPURÉ (WOLOF & FRANÇAIS)  -->
  <!-- ======================================================== -->
  <view wx:if="{{ showVoiceModal }}" class="modal-backdrop" bindtap="onCloseVoiceModal">
    <view class="modal-card modal-card--simple" catchtap="noop">
      <view class="modal-header">
        <view class="modal-icon-badge">
          <view class="icon-svg icon-mic-berry"></view>
        </view>
        <view class="modal-titles">
          <text class="modal-title">Recherche Vocale</text>
          <text class="modal-subtitle">Parle en wolof ou en français</text>
        </view>
        <view class="btn-close-modal" hover-class="btn-close-hover" bindtap="onCloseVoiceModal"><view class="ic ic-close-grey ic--sm"></view></view>
      </view>

      <!-- Micro épuré avec pulsation douce -->
      <view class="simple-voice-center" bindtap="onToggleRecord">
        <view class="simple-mic-orb {{ isRecording ? 'simple-mic-orb--active' : '' }}">
          <view class="icon-svg icon-mic-white"></view>
        </view>
        <text class="simple-voice-status">{{ voiceStatus }}</text>
        <text class="simple-voice-hint">{{ isRecording ? 'Touchez pour arrêter' : 'Touchez le micro pour parler' }}</text>
      </view>

      <!-- 3 Exemples rapides à toucher -->
      <view class="simple-voice-chips">
        <text class="chips-heading">Exemples rapides :</text>
        <view class="chips-list">
          <block wx:for="{{ voicePrompts }}" wx:key="text">
            <view 
              class="simple-prompt-chip" 
              data-item="{{ item }}" 
              hover-class="chip-hover" 
              bindtap="onApplyVoicePrompt"
            >
              <view class="chip-lang-pill {{ item.lang === 'WO' ? 'chip-lang--wo' : 'chip-lang--fr' }}">
                {{ item.lang }}
              </view>
              <text class="chip-text">{{ item.text }}</text>
              <view class="ic ic-chevron-berry ic--sm"></view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>
</view>

