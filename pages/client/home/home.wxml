<view class="sama-page {{ searchState === 'loading' ? 'sama-page--dark' : '' }}">
  <!-- Toast / Notification Flottante Haute Couture -->
  <view 
    wx:if="{{ toast.visible }}" 
    class="sama-floating-toast {{ toast.hiding ? 'toast--hide' : 'toast--show' }}" 
    style="top: {{ statusBarHeight + 58 }}px;"
    catchtap="onDismissToast"
  >
    <view class="toast-pill-body">
      <view class="toast-icon-wrapper {{ toast.type === 'voice' ? 'toast-icon--voice' : (toast.type === 'heart' ? 'toast-icon--heart' : 'toast-icon--search') }}">
        <view class="toast-svg {{ toast.iconClass }}"></view>
      </view>
      <view class="toast-text-block">
        <view class="toast-main-line">
          <text class="toast-title-text">{{ toast.title }}</text>
        </view>
        <view wx:if="{{ toast.subtitle }}" class="toast-sub-line">
          <text class="toast-subtitle-text">{{ toast.subtitle }}</text>
        </view>
      </view>
      <view class="toast-badge-sparkle">
        <text class="toast-sparkle-symbol">✨</text>
      </view>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- ÉTAT 1 : ACCUEIL FORMULAIRE (Image 1)                    -->
  <!-- ======================================================== -->
  <view wx:if="{{ searchState === 'form' }}" class="state-container">
    <scroll-view 
      class="sama-scroll" 
      scroll-y="{{true}}" 
      enhanced="{{true}}" 
      show-scrollbar="{{false}}"
    >
      <!-- En-tête avec SAMA LOYER -->
      <view class="sama-header" style="padding-top: {{ statusBarHeight + 12 }}px;">
        <view class="sama-brand">
          <view class="sama-brand__icon">
            <view class="icon-svg icon-house-white"></view>
          </view>
          <view class="sama-brand__text">
            <text class="brand-title">SAMA</text>
            <text class="brand-sub">LOYER</text>
          </view>
        </view>
      </view>

      <!-- Carte d'accroche dégradée rose avec filigrane maison -->
      <view class="hero-pink-card">
        <view class="hero-watermark"></view>
        
        <!-- Badge utilisateur / Salamalekum -->
        <view class="hero-user-pill">
          <text class="pill-red-dot">•</text>
          <text class="pill-user-text">Salamalekum, Awa</text>
        </view>

        <!-- Titre d'accroche -->
        <view class="hero-headline">
          <text class="hero-title-dark">Trouve ton logement.</text>
          <text class="hero-title-accent">Simplement.</text>
        </view>

        <text class="hero-subtitle">Dis-nous où et combien. L'IA choisit pour toi.</text>

        <!-- Tags de réassurance -->
        <view class="hero-trust-badges">
          <view class="trust-badge">
            <text class="trust-check">✓</text>
            <text>Annonces vérifiées</text>
          </view>
          <view class="trust-badge">
            <text class="trust-check">✓</text>
            <text>Paiement Max it</text>
          </view>
        </view>
      </view>

      <!-- Formulaire de recherche -->
      <view class="sama-form">
        <!-- Champ Localité -->
        <view class="form-group">
          <text class="form-label">Localité</text>
          <view class="input-box">
            <view class="icon-svg icon-pin-berry"></view>
            <input
              id="lieu"
              class="input-field"
              type="text"
              value="{{ place }}"
              bindinput="onPlaceInput"
              bindconfirm="onSearchTap"
              confirm-type="search"
              placeholder="Ex. Ouakam, Ngor, Yoff, Almadies…"
              placeholder-class="input-placeholder"
            />
            <view wx:if="{{ place }}" class="input-clear-btn" bindtap="onClearPlace">✕</view>
          </view>
        </view>

        <!-- Champ Budget -->
        <view class="form-group">
          <text class="form-label">Budget maximum par mois</text>
          <view class="input-box">
            <view class="icon-svg icon-card-berry"></view>
            <input
              id="budget"
              class="input-field"
              type="number"
              value="{{ budget }}"
              bindinput="onBudgetInput"
              bindconfirm="onSearchTap"
              confirm-type="search"
              placeholder="Ex. 60 000"
              placeholder-class="input-placeholder"
            />
            <view wx:if="{{ budget }}" class="input-clear-btn" bindtap="onClearBudget">✕</view>
            <text class="input-suffix">F CFA</text>
          </view>
        </view>

        <!-- Bouton split : Rechercher (gauche) + Parler (droite) -->
        <view class="split-search-btn">
          <view class="split-left" bindtap="onSearchTap">
            <view class="icon-svg icon-search-white"></view>
            <text class="btn-search-label">Rechercher</text>
          </view>
          <view class="split-right-pill" bindtap="onVoiceTap">
            <view class="icon-svg icon-mic-berry"></view>
            <text class="btn-voice-label">Parler</text>
          </view>
        </view>

        <!-- Note d'aide sous le bouton -->
        <text class="form-help-hint">Écris ci-dessus, ou touche « Parler » en wolof ou en français</text>

        <!-- Carte Mes favoris -->
        <view class="favorites-nav-card" bindtap="onGoToFavorites">
          <view class="fav-icon-box">
            <view class="icon-svg icon-heart-fill-berry"></view>
          </view>
          <view class="fav-meta">
            <text class="fav-title">Mes favoris</text>
            <text class="fav-sub">{{ favoritesCount }} logement{{ favoritesCount > 1 ? 's' : '' }} enregistré{{ favoritesCount > 1 ? 's' : '' }}</text>
          </view>
          <text class="fav-chevron">›</text>
        </view>
      </view>

      <view class="form-scroll-spacer"></view>
    </scroll-view>
  </view>

  <!-- ======================================================== -->
  <!-- ÉTAT 2 : "L'IA CHERCHE POUR TOI..." (Image 2)           -->
  <!-- ======================================================== -->
  <view wx:if="{{ searchState === 'loading' }}" class="ai-loading-screen">
    <!-- En-tête dark -->
    <view class="sama-header" style="padding-top: {{ statusBarHeight + 12 }}px;">
      <view class="sama-brand">
        <view class="sama-brand__icon">
          <view class="icon-svg icon-house-white"></view>
        </view>
        <view class="sama-brand__text">
          <text class="brand-title brand-title--white">SAMA</text>
          <text class="brand-sub">LOYER</text>
        </view>
      </view>
    </view>

    <!-- Centre de l'animation IA -->
    <view class="ai-loading-center">
      <!-- Anneau concentrique lumineux pulsant -->
      <view class="ai-pulse-outer">
        <view class="ai-pulse-ring"></view>
        <view class="ai-pulse-core">
          <text class="ai-star-sparkle">✦</text>
        </view>
      </view>

      <!-- Titre principal -->
      <text class="ai-loading-title">L'IA cherche pour toi...</text>

      <!-- Checklist progressive des 3 étapes -->
      <view class="ai-steps-checklist">
        <!-- Étape 1 -->
        <view class="ai-step-row {{ step1Done ? 'ai-step-row--active' : '' }}">
          <view class="ai-step-circle {{ step1Done ? 'circle--done' : 'circle--pending' }}">
            <text wx:if="{{ step1Done }}">✓</text>
          </view>
          <text class="ai-step-text">Je lis ta demande</text>
        </view>

        <!-- Étape 2 -->
        <view class="ai-step-row {{ step2Done ? 'ai-step-row--active' : '' }}">
          <view class="ai-step-circle {{ step2Done ? 'circle--done' : 'circle--pending' }}">
            <text wx:if="{{ step2Done }}">✓</text>
          </view>
          <text class="ai-step-text">Je compare les logements du quartier</text>
        </view>

        <!-- Étape 3 -->
        <view class="ai-step-row {{ step3Done ? 'ai-step-row--active' : '' }}">
          <view class="ai-step-circle {{ step3Done ? 'circle--done' : 'circle--pending' }}">
            <text wx:if="{{ step3Done }}">✓</text>
          </view>
          <text class="ai-step-text">Je choisis les 3 meilleurs</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- ÉTAT 3 : RÉSULTATS RECOMMANDÉS (Image 3)                 -->
  <!-- ======================================================== -->
  <view wx:if="{{ searchState === 'results' }}" class="ai-results-screen">
    <scroll-view class="ai-results-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <!-- En-tête -->
      <view class="sama-header" style="padding-top: {{ statusBarHeight + 12 }}px;">
        <view class="sama-brand">
          <view class="sama-brand__icon">
            <view class="icon-svg icon-house-white"></view>
          </view>
          <view class="sama-brand__text">
            <text class="brand-title">SAMA</text>
            <text class="brand-sub">LOYER</text>
          </view>
        </view>
      </view>

      <!-- Liste des 3 cartes logements recommandées -->
      <view class="ai-recs-container">
        <block wx:for="{{ recs }}" wx:key="id">
          <view class="rec-card" data-item="{{ item }}" bindtap="onListingTap">
            <!-- Bloc Hero avec couleur teintée et dessin architectural -->
            <view class="rec-card__hero" style="background-color: {{ item.tintBg }};">
              <view class="rec-card__rank">{{ item.rank }}</view>
              <view class="rec-card__house-illu"></view>
            </view>

            <!-- Corps de la carte -->
            <view class="rec-card__body">
              <text class="rec-card__type">{{ item.typeLabel }}</text>
              <text class="rec-card__title">{{ item.title }}</text>
              <text class="rec-card__place">{{ item.place }}</text>
              
              <view class="rec-card__price-row">
                <text class="rec-card__price">{{ item.formattedPrice }}</text>
                <text class="rec-card__unit">F / mois</text>
              </view>

              <!-- Tag match IA vert pastel -->
              <view class="rec-card__match-pill">
                <text class="match-check">✓</text>
                <text class="match-desc">{{ item.reason }}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- Espace pour ne pas être masqué par la barre fixe -->
      <view class="sticky-bar-spacer"></view>
    </scroll-view>

    <!-- Barre d'action fixe inférieure : Modifier | Voir tous les logements -->
    <view class="results-sticky-bar">
      <button class="btn-modify-outline" bindtap="onModifyTap">Modifier</button>
      <button class="btn-see-all-primary" bindtap="onGoToAllResults">Voir tous les logements</button>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- ÉTAT 4 : SI LA RECHERCHE ÉCHOUE ("si on fail le recherche")-->
  <!-- ======================================================== -->
  <view wx:if="{{ searchState === 'failed' }}" class="ai-failed-screen">
    <scroll-view class="ai-failed-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <!-- En-tête -->
      <view class="sama-header" style="padding-top: {{ statusBarHeight + 12 }}px;">
        <view class="sama-brand">
          <view class="sama-brand__icon">
            <view class="icon-svg icon-house-white"></view>
          </view>
          <view class="sama-brand__text">
            <text class="brand-title">SAMA</text>
            <text class="brand-sub">LOYER</text>
          </view>
        </view>
      </view>

      <!-- Contenu d'analyse IA sans résultat exact -->
      <view class="ai-failed-content">
        <view class="failed-badge">
          <text class="failed-badge__icon">✦</text>
          <text class="failed-badge__text">ANALYSE IA SAMA LOYER</text>
        </view>

        <text class="failed-title">Pas de logement à ce prix exact</text>
        <text class="failed-desc">Nous n'avons pas trouvé de logement à {{ qPlace || 'cette zone' }} pour un budget de {{ budget || 'ce montant' }} F CFA.</text>

        <!-- Bulle conseils IA -->
        <view class="failed-tips-box">
          <view class="tips-box-header">
            <text class="tips-icon">💡</text>
            <text class="tips-title">Conseils de l'IA SAMA LOYER :</text>
          </view>
          <view class="tips-body">
            <view class="tip-line">
              <text class="tip-dot">•</text>
              <text class="tip-text">À {{ qPlace || 'Dakar' }}, les loyers démarrent généralement à partir de <text class="tip-strong">70 000 F CFA</text>.</text>
            </view>
            <view class="tip-line">
              <text class="tip-dot">•</text>
              <text class="tip-text">Des alternatives existent dans les quartiers voisins :</text>
            </view>
            <!-- Suggestions cliquables -->
            <view class="nearby-zones-row">
              <block wx:for="{{ fallbackZones }}" wx:key="*this">
                <view class="zone-pill" data-zone="{{ item }}" bindtap="onSelectFallbackZone">
                  <text>📍 {{ item }}</text>
                </view>
              </block>
            </view>
          </view>
        </view>

        <!-- Section des alternatives les plus proches -->
        <view wx:if="{{ fallbackListings && fallbackListings.length > 0 }}" class="fallback-section">
          <text class="fallback-section-title">Logements les plus proches de tes critères :</text>
          <block wx:for="{{ fallbackListings }}" wx:key="id">
            <view class="rec-card" data-item="{{ item }}" bindtap="onListingTap">
              <view class="rec-card__hero" style="background-color: {{ item.tintBg }};">
                <view class="rec-card__rank">{{ item.rank }}</view>
                <view class="rec-card__house-illu"></view>
              </view>
              <view class="rec-card__body">
                <text class="rec-card__type">{{ item.typeLabel }}</text>
                <text class="rec-card__title">{{ item.title }}</text>
                <text class="rec-card__place">{{ item.place }}</text>
                
                <view class="rec-card__price-row">
                  <text class="rec-card__price">{{ item.formattedPrice }}</text>
                  <text class="rec-card__unit">F / mois</text>
                </view>

                <view class="rec-card__match-pill rec-card__match-pill--near">
                  <text class="match-check">ℹ</text>
                  <text class="match-desc">{{ item.reason }}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="sticky-bar-spacer"></view>
    </scroll-view>

    <!-- Barre d'action fixe inférieure : Modifier | Voir tous les logements -->
    <view class="results-sticky-bar">
      <button class="btn-modify-outline" bindtap="onModifyTap">Modifier</button>
      <button class="btn-see-all-primary" bindtap="onGoToAllResults">Voir tous les logements</button>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- MODAL / ASSISTANT VOCAL (FRANÇAIS & WOLOF)               -->
  <!-- ======================================================== -->
  <view wx:if="{{ showVoiceModal }}" class="modal-backdrop" bindtap="onCloseVoiceModal">
    <view class="modal-card" catchtap="true">
      <view class="modal-header">
        <view class="modal-icon-badge">
          <view class="icon-svg icon-mic-berry"></view>
        </view>
        <view class="modal-titles">
          <text class="modal-title">Assistant Vocal SAMA IA</text>
          <text class="modal-subtitle">Exprime ton besoin en français ou en wolof</text>
        </view>
        <view class="btn-close-modal" bindtap="onCloseVoiceModal">✕</view>
      </view>

      <!-- Ondes vocales animées -->
      <view class="voice-anim-box">
        <view class="voice-wave {{ isRecording ? 'voice-wave--recording' : '' }}" bindtap="onToggleRecord">
          <view class="wave-bar bar-1"></view>
          <view class="wave-bar bar-2"></view>
          <view class="wave-bar bar-3"></view>
          <view class="wave-bar bar-4"></view>
          <view class="wave-bar bar-5"></view>
        </view>
        <text class="voice-status-text">{{ voiceStatus }}</text>
      </view>

      <!-- Exemples guidés Wolof / Français -->
      <view class="voice-examples">
        <text class="examples-heading">Exemples que tu peux dire :</text>
        <block wx:for="{{ voicePrompts }}" wx:key="text">
          <view class="example-item" data-item="{{ item }}" bindtap="onApplyVoicePrompt">
            <view class="example-badge {{ item.lang === 'WO' ? 'badge-wo' : 'badge-fr' }}">
              {{ item.lang }}
            </view>
            <text class="example-text">« {{ item.text }} »</text>
            <text class="example-arrow">›</text>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
