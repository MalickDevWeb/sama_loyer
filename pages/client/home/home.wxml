<view class="sama-page">
  <!-- Toast / Notification Flottante Haute Couture (remplace le carré noir natif) -->
  <view 
    wx:if="{{ toast.visible }}" 
    class="sama-floating-toast {{ toast.hiding ? 'toast--hide' : 'toast--show' }}" 
    style="top: {{ statusBarHeight + 58 }}px;"
    catchtap="onDismissToast"
  >
    <view class="toast-pill-body">
      <!-- Cercle Icône dynamique avec dégradé -->
      <view class="toast-icon-wrapper {{ toast.type === 'voice' ? 'toast-icon--voice' : (toast.type === 'heart' ? 'toast-icon--heart' : 'toast-icon--search') }}">
        <view class="toast-svg {{ toast.iconClass }}"></view>
      </view>

      <!-- Textes : Titre + Sous-titre dynamique -->
      <view class="toast-text-block">
        <view class="toast-main-line">
          <text class="toast-title-text">{{ toast.title }}</text>
        </view>
        <view wx:if="{{ toast.subtitle }}" class="toast-sub-line">
          <text class="toast-subtitle-text">{{ toast.subtitle }}</text>
        </view>
      </view>

      <!-- Badge scintillant IA -->
      <view class="toast-badge-sparkle">
        <text class="toast-sparkle-symbol">✨</text>
      </view>
    </view>
  </view>

  <!-- Zone défilante -->
  <scroll-view 
    class="sama-scroll" 
    scroll-y="{{true}}" 
    enhanced="{{true}}" 
    show-scrollbar="{{false}}"
    scroll-into-view="{{ targetScrollId }}"
    scroll-with-animation="{{ true }}"
  >
    
    <!-- En-tête avec safe-area top -->
    <view class="sama-header" style="padding-top: {{ statusBarHeight + 12 }}px;">
      <view class="sama-brand">
        <view class="sama-brand__icon">
          <!-- House SVG -->
          <view class="icon-svg icon-house-white"></view>
        </view>
        <view class="sama-brand__text">
          <text class="brand-title">SAMA</text>
          <text class="brand-sub">LOYER</text>
        </view>
      </view>
    </view>

    <!-- Accroche / Hero -->
    <view class="sama-hero">
      <view class="sama-hero__title">
        <text class="title-dark">Trouve ton logement.</text>
        <text class="title-accent">Simplement.</text>
      </view>
      <text class="sama-hero__subtitle">Dis-nous où et combien. L'IA choisit pour toi.</text>
    </view>

    <!-- Formulaire de recherche -->
    <view class="sama-form">
      <!-- Champ Localité -->
      <view class="form-group">
        <text class="form-label">Localité</text>
        <view class="input-box">
          <view class="icon-svg icon-pin-berry"></view>
          <input
            id="lieu"
            class="input-field"
            type="text"
            value="{{ place }}"
            bindinput="onPlaceInput"
            bindconfirm="onSearchTap"
            confirm-type="search"
            placeholder="Ex. Ouakam, Pikine, Ngor, Yoff…"
            placeholder-class="input-placeholder"
          />
          <view wx:if="{{ place }}" class="input-clear-btn" bindtap="onClearPlace">✕</view>
        </view>
      </view>

      <!-- Champ Budget -->
      <view class="form-group">
        <text class="form-label">Budget maximum par mois</text>
        <view class="input-box">
          <view class="icon-svg icon-card-berry"></view>
          <input
            id="budget"
            class="input-field"
            type="number"
            value="{{ budget }}"
            bindinput="onBudgetInput"
            bindconfirm="onSearchTap"
            confirm-type="search"
            placeholder="Ex. 60 000"
            placeholder-class="input-placeholder"
          />
          <view wx:if="{{ budget }}" class="input-clear-btn" bindtap="onClearBudget">✕</view>
          <text class="input-suffix">F CFA</text>
        </view>
      </view>

      <!-- Boutons d'action : Rechercher + Vocal -->
      <view class="action-row">
        <button class="btn-search" bindtap="onSearchTap" hover-class="btn-search--hover">
          <view class="icon-svg icon-search-white"></view>
          <text class="btn-search__text">Rechercher</text>
        </button>

        <button
          class="btn-voice"
          bindtap="onVoiceTap"
          hover-class="btn-voice--hover"
          aria-label="Rechercher en parlant, en wolof ou en français"
        >
          <view class="icon-svg icon-mic-berry"></view>
        </button>
      </view>

      <!-- Note vocale -->
      <text class="voice-hint">Ou touche le micro et parle en wolof ou en français</text>
    </view>

    <!-- Recommandations IA (Résultats) -->
    <view wx:if="{{ searched }}" id="recs-section" class="sama-recommendations">
      <view class="recs-badge">
        <view class="icon-svg icon-sparkle-berry"></view>
        <text class="recs-badge__text">CHOISIS PAR L'IA</text>
      </view>
      
      <text class="recs-heading">{{ heading }}</text>
      <text class="recs-summary">{{ summary }}</text>

      <!-- Liste des 3 cartes -->
      <view class="recs-list">
        <block wx:for="{{ recs }}" wx:key="id">
          <view class="rec-card" data-item="{{ item }}" bindtap="onListingTap">
            
            <view class="card-body">
              <!-- Thumbnail visuel avec rang 1, 2, 3 -->
              <view class="card-thumb" style="background-color: {{ item.tintBg }};">
                <view class="rank-badge">{{ item.rank }}</view>
                <view class="thumb-house-icon"></view>
              </view>

              <!-- Détails du logement -->
              <view class="card-info">
                <view class="info-top">
                  <text class="type-label">{{ item.typeLabel }}</text>
                  <text class="match-badge">{{ item.match }}</text>
                </view>

                <text class="card-title">{{ item.title }}</text>
                <text class="card-place">{{ item.place }}</text>

                <view class="card-price-row">
                  <text class="card-price">{{ item.formattedPrice }}</text>
                  <text class="card-price-unit">F/mois</text>
                </view>
              </view>
            </view>

            <!-- Ligne de bas de carte avec raison IA + Voir -->
            <view class="card-footer">
              <view class="icon-svg icon-check-berry"></view>
              <text class="card-reason">{{ item.reason }}</text>
              <view class="btn-view" data-item="{{ item }}" catchtap="onListingTap">Voir</view>
            </view>

          </view>
        </block>
      </view>

      <!-- Bouton Voir tous les logements (Page 1 prototype) -->
      <button class="btn-see-all-listings" bindtap="onGoToAllResults">
        Voir tous les logements
      </button>
    </view>

    <!-- Espace vide de fin pour laisser respirer le scroll -->
    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- ======================================================== -->
  <!-- MODAL / ASSISTANT VOCAL (FRANÇAIS & WOLOF) -->
  <!-- ======================================================== -->
  <view wx:if="{{ showVoiceModal }}" class="modal-backdrop" bindtap="onCloseVoiceModal">
    <view class="modal-card" catchtap="true">
      <view class="modal-header">
        <view class="modal-icon-badge">
          <view class="icon-svg icon-mic-berry"></view>
        </view>
        <view class="modal-titles">
          <text class="modal-title">Assistant Vocal SAMA IA</text>
          <text class="modal-subtitle">Exprime ton besoin en français ou en wolof</text>
        </view>
        <view class="modal-close" bindtap="onCloseVoiceModal">✕</view>
      </view>

      <view class="voice-wave-container" bindtap="onToggleRecord">
        <view class="voice-circle {{ isRecording ? 'pulse-fast' : 'pulse' }}"></view>
        <view class="icon-svg icon-mic-berry icon-large"></view>
      </view>

      <!-- Barres d'onde sonore animées -->
      <view wx:if="{{ isRecording }}" class="soundwave-bars">
        <view class="wave-bar bar-1"></view>
        <view class="wave-bar bar-2"></view>
        <view class="wave-bar bar-3"></view>
        <view class="wave-bar bar-4"></view>
        <view class="wave-bar bar-5"></view>
      </view>

      <text class="voice-listening-label">{{ voiceStatus }}</text>

      <view class="voice-prompts-list">
        <block wx:for="{{ voicePrompts }}" wx:key="text">
          <view class="voice-prompt-item" data-item="{{ item }}" bindtap="onApplyVoicePrompt">
            <view class="prompt-lang-tag {{ item.lang === 'WO' ? 'tag-wolof' : 'tag-fr' }}">
              {{ item.lang }}
            </view>
            <text class="prompt-text">{{ item.text }}</text>
          </view>
        </block>
      </view>

      <view class="voice-modal-footer">
        <button class="btn-cancel-voice" bindtap="onCloseVoiceModal">
          Fermer l'assistant
        </button>
      </view>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- BOTTOM SHEET / FICHE DE CONFIANCE DU LOGEMENT -->
  <!-- ======================================================== -->
  <view wx:if="{{ showDetailModal }}" class="modal-backdrop" bindtap="onCloseDetailModal">
    <view class="detail-sheet" catchtap="true">
      
      <view class="sheet-drag-handle"></view>

      <view class="sheet-header">
        <view class="sheet-top-meta">
          <text class="sheet-type">{{ selectedListing.typeLabel }}</text>
          <view class="sheet-verify-pill {{ selectedListing.verified ? 'pill-verified' : 'pill-declared' }}">
            {{ selectedListing.verified ? '✓ ' + selectedListing.verificationLevel : '⚠ ' + selectedListing.verificationLevel }}
          </view>
        </view>

        <view class="sheet-title-row">
          <text class="sheet-title">{{ selectedListing.title }}</text>
          <view class="btn-sheet-fav" data-id="{{ selectedListing.id }}" catchtap="onToggleFavorite">
            <text class="fav-icon">{{ favorites[selectedListing.id] ? '❤️' : '🤍' }}</text>
          </view>
        </view>

        <view class="sheet-location">
          <view class="icon-svg icon-pin-berry"></view>
          <text class="sheet-location-text">{{ selectedListing.place }}</text>
          <text class="sheet-date">{{ selectedListing.dateConfirmation }}</text>
        </view>
      </view>

      <scroll-view class="sheet-scroll" scroll-y="{{true}}">
        <!-- Décomposition financière (Conformité Cahier des Charges) -->
        <view class="sheet-section">
          <text class="section-title">Détail financier & Frais d'entrée</text>
          <view class="price-breakdown">
            <view class="breakdown-row highlight">
              <text class="breakdown-label">Loyer mensuel</text>
              <text class="breakdown-value">{{ selectedListing.formattedPrice }} F CFA</text>
            </view>
            <view class="breakdown-row">
              <text class="breakdown-label">Caution remboursable (1 mois)</text>
              <text class="breakdown-value">{{ selectedListing.formattedPrice }} F CFA</text>
            </view>
            <view class="breakdown-row">
              <text class="breakdown-label">Mois d'avance (1 mois)</text>
              <text class="breakdown-value">{{ selectedListing.formattedPrice }} F CFA</text>
            </view>
            <view class="breakdown-row">
              <text class="breakdown-label">Frais déclarés / agence</text>
              <text class="breakdown-value">{{ selectedListing.frais ? selectedListing.frais + ' F CFA' : '0 F CFA' }}</text>
            </view>
            <view class="breakdown-total">
              <text class="total-label">Total initial à prévoir :</text>
              <text class="total-value">{{ totalInitialCost }} F CFA</text>
            </view>
          </view>
        </view>

        <!-- Équipements -->
        <view class="sheet-section">
          <text class="section-title">Équipements & Atouts</text>
          <view class="equipments-list">
            <block wx:for="{{ selectedListing.equipements }}" wx:key="*this">
              <view class="equipment-chip">
                <text class="chip-check">✓</text>
                <text class="chip-text">{{ item }}</text>
              </view>
            </block>
          </view>
        </view>

        <!-- Bailleur -->
        <view class="sheet-section">
          <text class="section-title">Bailleur / Gestionnaire</text>
          <view class="landlord-card">
            <view class="landlord-avatar">
              <text>{{ selectedListing.bailleurName[0] }}</text>
            </view>
            <view class="landlord-info">
              <text class="landlord-name">{{ selectedListing.bailleurName }}</text>
              <text class="landlord-phone">{{ selectedListing.phone }}</text>
            </view>
            <view class="landlord-badge">Vérifié</view>
          </view>
        </view>
      </scroll-view>

      <!-- Actions de contact et paiement -->
      <view class="sheet-actions">
        <button class="btn-action-outline" bindtap="onCallBailleur">
          📞 Appeler
        </button>
        <button class="btn-action-outline whatsapp" bindtap="onWhatsAppBailleur">
          💬 WhatsApp
        </button>
        <button class="btn-action-primary" bindtap="onPayRentWithOrangeMoney">
          ⚡ Payer loyer (Orange Money)
        </button>
      </view>

    </view>
  </view>
</view>
