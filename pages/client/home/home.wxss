  background: linear-gradient(135deg, #0F1E3D 0%, #1A2E56 100%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 14rpx 24rpx 14rpx 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 30, 61, 0.35), 0 2rpx 8rpx rgba(200, 35, 95, 0.2);
