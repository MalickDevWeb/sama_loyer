/* ============================================================================
   7. TOAST / NOTIFICATION FLOTTANTE MAGNIFIQUE (HAUTE GAMME SAMA LOGEMENT)
   ============================================================================ */
.sama-floating-toast {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  width: calc(100% - 64rpx);
  max-width: 660rpx;
  pointer-events: auto;
}

.sama-floating-toast.toast--show {
  animation: toastSpringIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.25) forwards;
}

.sama-floating-toast.toast--hide {
  animation: toastSpringOut 0.25s cubic-bezier(0.6, -0.28, 0.735, 0.045) forwards;
}

@keyframes toastSpringIn {
  0% {
    opacity: 0;
    transform: translate(-50%, -36rpx) scale(0.92);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
}

@keyframes toastSpringOut {
  0% {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -24rpx) scale(0.94);
  }
}

