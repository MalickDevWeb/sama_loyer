/* ==========================================================================
   Page Favoris - SAMA LOYER (exact match prototype Claude / PDF)
   ========================================================================== */

.favorites-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F8F9FA;
  box-sizing: border-box;
}

.favorites-scroll {
  flex: 1;
  box-sizing: border-box;
}

/* En-tête */
.fav-header {
  padding: 0 32rpx 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #ECEFF2;
}

.fav-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-back {
  font-size: 48rpx;
  color: #0F1E3D;
  font-weight: 700;
  width: 60rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 6rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #5B6475;
  margin-bottom: 24rpx;
}

/* Filter pills */
.fav-filter-pills {
  display: flex;
  gap: 16rpx;
}

.fav-pill {
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  background-color: #F4F6F9;
  color: #0F1E3D;
}

.fav-pill--active {
  background-color: #0F1E3D;
  color: #FFFFFF;
}

/* Liste des cartes */
.fav-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.fav-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

/* Thumbnail */
.fav-thumb {
  height: 280rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-thumb__house {
  width: 140rpx;
  height: 110rpx;
  border: 4rpx solid #0F1E3D;
  border-top: none;
  position: relative;
  opacity: 0.28;
}

.fav-thumb__house::before {
  content: '';
  position: absolute;
  top: -60rpx;
  left: -14rpx;
  border-left: 80rpx solid transparent;
  border-right: 80rpx solid transparent;
  border-bottom: 60rpx solid #0F1E3D;
}

.badge-premium-pill {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.fav-btn-heart {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.heart-icon {
  font-size: 32rpx;
  color: #C8235F;
  line-height: 1;
}

/* Contenu */
.fav-content {
  padding: 24rpx;
}

.fav-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.fav-price {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.fav-unit {
  font-size: 24rpx;
  color: #5B6475;
}

.fav-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 6rpx;
}

.fav-place {
  display: block;
  font-size: 24rpx;
  color: #5B6475;
  margin-bottom: 14rpx;
}

/* Status row */
.fav-status-row {
  margin-bottom: 12rpx;
}

.badge-dispo {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background-color: #E2F0EA;
  color: #007C3D;
  font-size: 22rpx;
  font-weight: 700;
}

.check-icon {
  font-size: 22rpx;
}

.price-drop-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #C8235F;
}

.rented-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #C43D3D;
}

.fav-registered-text {
  display: block;
  font-size: 22rpx;
  color: #8C96A6;
}

.scroll-spacer {
  height: 180rpx;
}
