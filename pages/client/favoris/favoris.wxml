<view class="fav">
  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <!-- En-tête -->
  <view class="fav__header">
    <view class="sl-icon-btn fav__back" hover-class="sl-hover" bindtap="onBackTap" aria-label="Retour">
      <view class="ic ic-back-navy"></view>
    </view>
    <text class="fav__title">{{ i18n.favoris.title }}</text>
    <text class="fav__subtitle">{{ subtitle }}</text>
  </view>

  <!-- Tous / Encore disponibles -->
  <view class="fav__tabs">
    <view
      class="fav__pill {{ filter === 'tous' ? 'fav__pill--on' : '' }}"
      data-filter="tous"
      bindtap="onFilterSelect"
    >{{ i18n.favoris.filterAll }}</view>
    <view
      class="fav__pill {{ filter === 'dispo' ? 'fav__pill--on' : '' }}"
      data-filter="dispo"
      bindtap="onFilterSelect"
    >{{ i18n.favoris.filterAvailable }}</view>
  </view>

  <!-- Liste -->
  <view class="fav__list">
    <view
      wx:for="{{ visible }}"
      wx:key="id"
      class="fav__card {{ item.status === 'rented' ? 'fav__card--gone' : '' }}"
      hover-class="fav__card--hover"
      data-id="{{ item.id }}"
      bindtap="onCardTap"
      aria-label="Ouvrir l’annonce : {{ item.title }}"
    >
      <view class="fav__thumb sl-photo" style="background-color: {{ item.bg }}; background-image: url('{{ item.cover }}');">
        <view wx:if="{{ !item.cover }}" class="fav__house"></view>
        <text wx:if="{{ item.isPremium }}" class="fav__premium">{{ i18n.common.premium }}</text>
      </view>

      <view class="fav__info">
        <view class="fav__price">{{ item.price }} <text class="fav__unit">FCFA / mois</text></view>
        <text class="fav__name">{{ item.title }}</text>
        <text class="fav__place">{{ item.place }}</text>
        <text class="fav__status fav__status--{{ item.status }}">{{ item.statusText }}</text>
        <text class="fav__saved">{{ item.saved }}</text>
      </view>

      <view
        class="fav__heart"
        hover-class="sl-hover"
        data-id="{{ item.id }}"
        catchtap="onRemoveFavorite"
        aria-label="Retirer {{ item.title }} des favoris"
      >
        <view class="ic ic-heart-fill-berry fav__heart-ic"></view>
      </view>
    </view>

    <!-- Vide -->
    <view wx:if="{{ !visible.length }}" class="fav__empty">
      <view class="fav__empty-ic"><view class="ic ic-heart-berry fav__empty-heart"></view></view>
      <text class="fav__empty-title">{{ i18n.favoris.emptyTitle }}</text>
      <text class="fav__empty-text">{{ i18n.favoris.emptyText }}</text>
      <view class="sl-btn sl-btn--berry fav__empty-btn" hover-class="sl-hover" bindtap="onSearchHome">{{ i18n.favoris.emptyCta }}</view>
    </view>
  </view>

  <!-- Annuler la suppression -->
  <view wx:if="{{ lastRemoved }}" class="fav__undo">
    <text class="fav__undo-text">{{ i18n.favoris.removed }}</text>
    <view class="fav__undo-btn" hover-class="sl-hover" bindtap="onUndo">{{ i18n.favoris.undo }}</view>
  </view>

  <view class="fav__bottom"></view>
</view>
