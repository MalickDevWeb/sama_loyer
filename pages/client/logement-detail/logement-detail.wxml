<view class="detail-page">
  
  <!-- Zone défilante -->
  <scroll-view class="detail-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" bindscroll="onDetailScroll">
    
    <!-- Zone Carrousel / Image principale -->
    <view class="hero-carousel" style="background-color: {{ logement.slides[currentSlideIndex].bg }};">
      
      <!-- Galerie réelle : photos par pièce + vidéo de visite (glisser pour changer) -->
      <swiper class="hero-swiper" current="{{ currentSlideIndex }}" duration="300" bindchange="onSwiperChange">
        <swiper-item wx:for="{{ logement.slides }}" wx:key="id">
          <image class="hero-media" src="{{ item.url }}" mode="aspectFill" lazy-load="{{ true }}" />
          <!-- Vidéo : affiche + bouton lecture ; elle s'ouvre dans un lecteur dédié -->
          <view wx:if="{{ item.isVideo }}" class="hero-play" hover-class="hero-play--hover" bindtap="onPlayVideo" aria-label="Lire la vidéo de visite">
            <view class="hero-play-btn"><view class="dh-ic dh-ic-play"></view></view>
            <text class="hero-play-txt">Lire la visite vidéo</text>
          </view>
        </swiper-item>
      </swiper>
      <view class="hero-shade"></view>

      <!-- Flèches de navigation carrousel -->
      <view class="carousel-nav-btn btn-prev" bindtap="onPrevSlide">
        <view class="ic ic-chevron-left-navy ic--md"></view>
      </view>
      <view class="carousel-nav-btn btn-next" bindtap="onNextSlide">
        <view class="ic ic-chevron-navy ic--md"></view>
      </view>

      <!-- Badges sur l'image (Salon / 1/5) -->
      <view class="hero-tag-room">{{ logement.slides[currentSlideIndex].label }}</view>
      <view class="hero-tag-counter">{{ currentSlideIndex + 1 }}/{{ logement.slides.length }}</view>
    </view>

    <!-- Bandeau de miniatures -->
    <view class="thumb-strip">
      <block wx:for="{{ logement.slides }}" wx:key="id">
        <view
          class="thumb-item {{ currentSlideIndex === index ? 'thumb-item--active' : '' }}"
          style="background-color: {{ item.bg }}; background-image: url('{{ item.url }}');"
          data-index="{{ index }}"
          bindtap="onSelectThumb"
        >
          <view wx:if="{{ item.isVideo }}" class="thumb-play-badge"><view class="ic ic-play-navy ic--xs"></view></view>
        </view>
      </block>
    </view>

    <!-- Contenu principal -->
    <view class="detail-body">
      
      <!-- Ligne de tags -->
      <view class="meta-tags-row">
        <view class="tag-premium ic-row"><view class="ic ic-star-white ic--xs"></view><text>Premium</text></view>
        <view class="tag-type">{{ logement.typeLabel }}</view>
        <text class="meta-published">{{ logement.publishedAgo }}</text>
      </view>

      <!-- Titre principal -->
      <text class="detail-main-title">{{ logement.title }}</text>

      <!-- Localisation sous le titre -->
      <view class="detail-location-row">
        <view class="icon-svg icon-pin-berry"></view>
        <text class="location-text">{{ logement.place }}</text>
      </view>

      <!-- Prix mensuel -->
      <view class="price-row">
        <text class="price-amount">{{ logement.price }}</text>
        <text class="price-unit">FCFA / mois</text>
      </view>

      <!-- Carte de disponibilité confirmée (Verte) -->
      <view class="availability-card">
        <view class="avail-check-circle"><view class="ic ic-check-white ic--sm"></view></view>
        <view class="avail-text-col">
          <text class="avail-title">{{ logement.dispoDate }}</text>
          <text class="avail-subtitle">{{ logement.dispoConfirmed }}</text>
        </view>
      </view>

      <!-- Louer à distance -->
      <view class="remote-card" hover-class="remote-card--hover" bindtap="onLouerSansVisite">
        <view class="ic ic-video-white remote-card__icon"></view>
        <view class="remote-card__text">
          <text class="remote-card__title">Tu es loin ? Loue sans visite</text>
          <text class="remote-card__sub">Accepté par ce bailleur · vidéo disponible</text>
        </view>
        <view class="ic ic-chevron-white remote-card__chev"></view>
      </view>

      <!-- SECTION : Prix et conditions -->
      <view class="section-block">
        <text class="section-title">Prix et conditions</text>
        
        <!-- Tableau des conditions financières -->
        <view class="pricing-table">
          <view class="table-row">
            <text class="row-label">Loyer mensuel</text>
            <text class="row-val">{{ logement.loyerMensuel }}</text>
          </view>
          <view class="table-row">
            <text class="row-label">Caution (2 mois)</text>
            <text class="row-val">{{ logement.caution }}</text>
          </view>
          <view class="table-row">
            <text class="row-label">Avance (1 mois)</text>
            <text class="row-val">{{ logement.avance }}</text>
          </view>
          <view class="table-row">
            <text class="row-label">Frais d’agence</text>
            <text class="row-val">{{ logement.fraisAgence }}</text>
          </view>
          <view class="table-row table-row--total">
            <text class="total-label">À payer à l’entrée</text>
            <text class="total-val">{{ logement.totalEntree }}</text>
          </view>
        </view>

        <!-- Puces conditions -->
        <view class="conditions-bullets">
          <block wx:for="{{ logement.conditions }}" wx:key="*this">
            <view class="bullet-item">
              <view class="bullet-dot ui-dot"></view>
              <text class="bullet-text">{{ item }}</text>
            </view>
          </block>
        </view>

        <!-- Bouton Consigner la caution & avance -->
        <view class="caution-cta-box" bindtap="onPayCaution">
          <view class="caution-cta-left">
            <view class="caution-cta-title ic-row"><view class="ic ic-lock-navy ic--sm"></view><text>Consigner la caution & avance</text></view>
            <text class="caution-cta-sub">Séquestre sécurisé Sama · Déblocage après clés</text>
          </view>
          <view class="ic ic-chevron-navy ic--md"></view>
        </view>
      </view>

      <!-- SECTION : Description -->
      <view class="section-block">
        <text class="section-title">Description</text>
        <text class="desc-content">{{ isExpandedDesc ? logement.descriptionFull : logement.descriptionShort }}</text>
        <view class="btn-read-more" bindtap="onToggleDesc">
          {{ isExpandedDesc ? 'Réduire' : 'Lire la suite' }}
        </view>
      </view>

      <!-- SECTION : Équipements -->
      <view class="section-block">
        <text class="section-title">Équipements</text>
        <view class="equipments-grid">
          <block wx:for="{{ logement.equipements }}" wx:key="id">
            <view class="equip-card">
              <view class="equip-icon icon-svg icon-equip-{{ item.icon }}"></view>
              <text class="equip-label">{{ item.label }}</text>
            </view>
          </block>
        </view>
      </view>

      <!-- SECTION : Localisation -->
      <view class="section-block">
        <text class="section-title">Localisation</text>
        
        <view class="map-preview-box">
          <!-- Fond graphique de carte -->
          <view class="map-grid-graphic"></view>
          <!-- Marqueur avec zone de confidentialité -->
          <view class="map-center-pin">
            <view class="map-privacy-halo"></view>
            <view class="map-pin-bubble">
              <view class="icon-svg icon-house-white-mini"></view>
            </view>
          </view>
          <!-- Bouton ouvrir la carte -->
          <view class="btn-open-map" bindtap="onOpenMap">
            <view class="ic ic-external-navy ic--sm"></view>
            <text>Ouvrir la carte</text>
          </view>
        </view>

        <view class="map-caption">
          <text class="map-place-bold">{{ logement.placeDetails }}</text>
          <text class="map-place-sub">L'adresse exacte est donnée après la confirmation de la visite.</text>
        </view>
      </view>

      <!-- SECTION : Le bailleur -->
      <view class="section-block" bindtap="onContactTap">
        <text class="section-title">Le bailleur</text>
        
        <view class="landlord-card">
          <view class="landlord-avatar">
            <text class="landlord-initial">{{ logement.bailleur.initial }}</text>
          </view>
          <view class="landlord-meta">
            <text class="landlord-name">{{ logement.bailleur.name }}</text>
            <view class="verified-label">
              <view class="ic ic-check-green ic--xs"></view>
              <text>Identité vérifiée</text>
            </view>
            <text class="landlord-response">{{ logement.bailleur.responseTime }}</text>
          </view>
          <view class="btn-chat-landlord">
            <view class="ic ic-chat-navy"></view>
          </view>
        </view>
      </view>

      <!-- Signalement de l'annonce -->
      <view class="report-box" bindtap="onReportListing">
        <view class="ic ic-flag-grey ic--sm"></view>
        <text class="report-text">Signaler cette annonce</text>
      </view>

      <view class="scroll-spacer"></view>
    </view>
  </scroll-view>

  <!-- ======================================================== -->
  <!-- BARRE DU HAUT FIXE : retour, partager, j'aime (jamais masqués) -->
  <!-- Transparente sur la photo, blanche dès qu'on fait défiler -->
  <!-- ======================================================== -->
  <view class="dh-bar {{ solidHeader ? 'dh-bar--solid' : '' }}" style="padding-top: {{ headerTop }}px;">
    <view class="dh-row">
      <view class="dh-btn" hover-class="dh-btn--hover" bindtap="onBackTap" aria-label="Retour">
        <view class="icon-svg icon-arrow-left"></view>
      </view>
      <text class="dh-title {{ solidHeader ? 'dh-title--on' : '' }}">{{ logement.title }}</text>
      <view class="dh-btn" hover-class="dh-btn--hover" bindtap="onShareTap" aria-label="Partager ce logement">
        <view class="dh-ic dh-ic-share"></view>
      </view>
      <view class="dh-btn {{ isFavorite ? 'dh-btn--liked' : '' }}" hover-class="dh-btn--hover" bindtap="onToggleFavorite" aria-label="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
        <view class="dh-ic {{ isFavorite ? 'dh-ic-heart-on' : 'dh-ic-heart' }} {{ heartPop ? 'dh-ic--pop' : '' }}"></view>
      </view>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- PANNEAU DE PARTAGE -->
  <!-- ======================================================== -->
  <view wx:if="{{ showShare }}" class="share-overlay" catchtouchmove="noop" bindtap="onCloseShare">
    <view class="share-sheet" catchtap="noop" aria-label="Partager ce logement">
      <view class="share-handle"></view>
      <text class="share-title">Partager ce logement</text>

      <!-- Aperçu de ce qui sera partagé -->
      <view class="share-card">
        <image class="share-card-img" src="{{ logement.slides[0].url }}" mode="aspectFill" />
        <view class="share-card-body">
          <text class="share-card-title">{{ logement.title }}</text>
          <text class="share-card-place">{{ logement.placeDetails }}</text>
          <text class="share-card-price">{{ logement.price }} FCFA <text class="share-card-unit">/ mois</text></text>
        </view>
      </view>

      <view class="share-grid">
        <button class="share-opt share-opt-btn" open-type="share" hover-class="share-opt--hover">
          <view class="share-opt-ic share-opt-ic--berry"><view class="dh-ic dh-ic-send"></view></view>
          <text class="share-opt-txt">À un proche</text>
        </button>
        <view class="share-opt" hover-class="share-opt--hover" bindtap="onShareWhatsApp">
          <view class="share-opt-ic share-opt-ic--green"><view class="dh-ic dh-ic-whatsapp"></view></view>
          <text class="share-opt-txt">WhatsApp</text>
        </view>
        <view class="share-opt" hover-class="share-opt--hover" bindtap="onCopyLink">
          <view class="share-opt-ic share-opt-ic--navy"><view class="dh-ic dh-ic-link"></view></view>
          <text class="share-opt-txt">Copier le lien</text>
        </view>
        <view class="share-opt" hover-class="share-opt--hover" bindtap="onShareMore">
          <view class="share-opt-ic share-opt-ic--grey"><view class="dh-ic dh-ic-dots"></view></view>
          <text class="share-opt-txt">Plus</text>
        </view>
      </view>

      <view class="share-cancel" hover-class="share-opt--hover" bindtap="onCloseShare">Annuler</view>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- MODALE PARTAGER AVEC UN PROCHE (Aux couleurs de SAMA LOYER) -->
  <!-- ======================================================== -->
  <view wx:if="{{ showProcheModal }}" class="share-overlay" catchtouchmove="noop" bindtap="onCloseProcheModal">
    <view class="proche-sheet" catchtap="noop" aria-label="Partager avec un proche">
      <view class="share-handle"></view>
      <view class="proche-sheet__head">
        <view class="proche-sheet__title">
          <view class="share-opt-ic share-opt-ic--berry share-opt-ic--sm">
            <view class="dh-ic dh-ic-send"></view>
          </view>
          <text>Partager à un proche</text>
        </view>
        <view class="modal-close" bindtap="onCloseProcheModal">
          <view class="ic ic-close-grey ic--sm"></view>
        </view>
      </view>

      <text class="proche-sheet__sub">Choisis le canal pour envoyer cette annonce à ton ami(e) ou ta famille :</text>

      <!-- Aperçu du message formaté -->
      <view class="proche-msg-box">
        <view class="proche-msg-badge">
          <view class="dh-ic dh-ic-heart-on"></view>
        </view>
        <view class="proche-msg-body">
          <text class="proche-msg-title">{{ logement.title }}</text>
          <text class="proche-msg-place">📍 {{ logement.placeDetails }}</text>
          <text class="proche-msg-price">{{ logement.price }} FCFA / mois</text>
        </view>
      </view>

      <!-- Options aux couleurs de l'application -->
      <view class="proche-actions-list">
        <!-- 1. WhatsApp -->
        <view class="proche-act-btn proche-act-btn--whatsapp" hover-class="sl-hover" bindtap="onShareWhatsApp">
          <view class="proche-act-left">
            <view class="proche-act-badge proche-act-badge--green">
              <view class="dh-ic dh-ic-whatsapp"></view>
            </view>
            <view class="proche-act-info">
              <text class="proche-act-name">Envoyer sur WhatsApp</text>
              <text class="proche-act-desc">Colle le message direct dans ta discussion</text>
            </view>
          </view>
          <view class="ic ic-chevron-grey ic--sm"></view>
        </view>

        <!-- 2. SMS -->
        <view class="proche-act-btn proche-act-btn--sms" hover-class="sl-hover" bindtap="onShareSMS">
          <view class="proche-act-left">
            <view class="proche-act-badge proche-act-badge--berry">
              <view class="dh-ic dh-ic-sms"></view>
            </view>
            <view class="proche-act-info">
              <text class="proche-act-name">Envoyer par SMS</text>
              <text class="proche-act-desc">Message court avec adresse et loyer</text>
            </view>
          </view>
          <view class="ic ic-chevron-grey ic--sm"></view>
        </view>

        <!-- 3. Copier le lien -->
        <view class="proche-act-btn proche-act-btn--copy" hover-class="sl-hover" bindtap="onCopyLink">
          <view class="proche-act-left">
            <view class="proche-act-badge proche-act-badge--navy">
              <view class="dh-ic dh-ic-link"></view>
            </view>
            <view class="proche-act-info">
              <text class="proche-act-name">Copier le lien direct</text>
              <text class="proche-act-desc">À coller sur n'importe quelle messagerie</text>
            </view>
          </view>
          <view class="ic ic-chevron-grey ic--sm"></view>
        </view>

        <!-- 4. WeChat Mini-Programme -->
        <button class="proche-act-btn proche-act-btn--wechat" open-type="share" hover-class="sl-hover">
          <view class="proche-act-left">
            <view class="proche-act-badge proche-act-badge--wechat">
              <view class="dh-ic dh-ic-wechat"></view>
            </view>
            <view class="proche-act-info">
              <text class="proche-act-name">Transférer dans WeChat</text>
              <text class="proche-act-desc">Envoyer la fiche interactive de l'annonce</text>
            </view>
          </view>
          <view class="ic ic-chevron-grey ic--sm"></view>
        </button>
      </view>

      <view class="proche-sheet__cancel" hover-class="sl-hover" bindtap="onCloseProcheModal">
        Fermer
      </view>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- LECTEUR DE LA VIDÉO DE VISITE -->
  <!-- ======================================================== -->
  <view wx:if="{{ playingVideo }}" class="vplayer-overlay">
    <view class="vplayer-head" style="padding-top: {{ headerTop }}px;">
      <view class="vplayer-back" hover-class="dh-btn--hover" bindtap="onCloseVideo" aria-label="Retour">
        <view class="ic ic-back-white ic--md"></view>
      </view>
      <text class="vplayer-title">Visite vidéo</text>
    </view>
    <video
      id="vplayer-video"
      class="vplayer-video"
      src="{{ logement.video.src }}"
      poster="{{ logement.video.poster }}"
      autoplay="{{ true }}"
      controls="{{ true }}"
      show-progress="{{ true }}"
      enable-progress-gesture="{{ true }}"
      vslide-gesture="{{ true }}"
      vslide-gesture-in-fullscreen="{{ true }}"
      show-center-play-btn="{{ true }}"
      show-play-btn="{{ true }}"
      show-fullscreen-btn="{{ true }}"
      show-mute-btn="{{ true }}"
      enable-play-gesture="{{ true }}"
      object-fit="contain"
      bindtimeupdate="onVideoTimeUpdate"
    ></video>
    <!-- Barre de contrôle enrichie SAMA LOYER pour avancer / reculer / régler facilement -->
    <view class="vplayer-quick-bar">
      <view class="vplayer-quick-btn" hover-class="sl-hover" bindtap="onVideoRewind10" aria-label="Reculer de 10 secondes">
        <view class="ic ic-rewind-white"></view>
        <text>-10s</text>
      </view>
      <view class="vplayer-slider-wrap">
        <slider
          class="vplayer-slider"
          value="{{ videoCurrentTime }}"
          min="0"
          max="{{ videoDuration || 100 }}"
          step="1"
          activeColor="#C8235F"
          backgroundColor="rgba(255, 255, 255, 0.25)"
          block-size="16"
          block-color="#FFFFFF"
          bindchange="onVideoSliderChange"
          bindchanging="onVideoSliderChanging"
        />
        <view class="vplayer-time-row">
          <text class="vplayer-time-txt">{{ videoCurrentTimeFmt || '00:00' }}</text>
          <text class="vplayer-time-txt">{{ videoDurationFmt || '00:00' }}</text>
        </view>
      </view>
      <view class="vplayer-quick-btn" hover-class="sl-hover" bindtap="onVideoForward10" aria-label="Avancer de 10 secondes">
        <text>+10s</text>
        <view class="ic ic-forward-white"></view>
      </view>
    </view>
    <view class="vplayer-foot">
      <text class="vplayer-note">{{ logement.title }} · filmée par le bailleur</text>
      <view class="vplayer-btn-close" hover-class="sl-hover" bindtap="onCloseVideo">
        <view class="ic ic-close-white ic--xs"></view>
        <text>Fermer la vidéo</text>
      </view>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- BARRE D'ACTIONS FIXE INFÉRIEURE -->
  <!-- ======================================================== -->
  <view class="fixed-action-bar fixed-action-bar--entry">
    <view class="entry-summary">
      <view class="entry-summary__left">
        <text class="entry-summary__label">À payer pour entrer</text>
        <text class="entry-summary__total">{{ logement.totalEntreeShort }}</text>
      </view>
      <view class="entry-summary__right">
        <text>{{ logement.entreeDetail }}</text>
        <text class="entry-summary__maxit">Payable avec Max it</text>
      </view>
    </view>
    <view class="entry-actions">
      <button class="btn-contact-outline" bindtap="onOpenVisitModal">
        <view class="ic ic-cal-navy entry-actions__icon"></view>
        <text>Visiter</text>
      </button>
      <button class="btn-visit-primary" bindtap="onLouerSansVisite">
        <view class="ic ic-home-door-white entry-actions__icon"></view>
        <text>Louer sans visite</text>
      </button>
    </view>
  </view>

  <!-- ======================================================== -->
  <!-- MODAL DEMANDE DE VISITE -->
  <!-- ======================================================== -->
  <view wx:if="{{ showVisitModal }}" class="modal-backdrop" bindtap="onCloseVisitModal">
    <view class="visit-sheet" catchtap="noop">
      <view class="visit-sheet__header">
        <view class="visit-sheet__title ic-row"><view class="ic ic-cal-berry ic--md"></view><text>Planifier une visite</text></view>
        <view class="modal-close" bindtap="onCloseVisitModal"><view class="ic ic-close-grey ic--sm"></view></view>
      </view>
      
      <text class="visit-sheet__sub">Choisissez un créneau disponible avec {{ logement.bailleur.name }} :</text>

      <view class="slots-list">
        <block wx:for="{{ visitSlots }}" wx:key="*this">
          <view
            class="slot-item {{ selectedVisitDate === item ? 'slot-item--selected' : '' }}"
            data-slot="{{ item }}"
            bindtap="onSelectSlot"
          >
            <text class="slot-text">{{ item }}</text>
            <view wx:if="{{ selectedVisitDate === item }}" class="ic ic-check-berry ic--sm"></view>
          </view>
        </block>
      </view>

      <button class="btn-confirm-visit" bindtap="onSubmitVisit">
        Confirmer ma demande de visite
      </button>
    </view>
  </view>

</view>

