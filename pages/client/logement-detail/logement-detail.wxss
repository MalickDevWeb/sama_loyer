@import "/styles/icons.wxss";

/* ============================================================================
   SAMA LOYER — FICHE DÉTAIL LOGEMENT
   Fidèle aux captures d'écran (Artifact #page-dcb81aee8d83)
   ============================================================================ */

.detail-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--sl-white);
  font-family: var(--sl-font);
  color: var(--sl-text);
}

.detail-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* ============================================================================
   1. CARROUSEL / IMAGE PRINCIPALE
   ============================================================================ */
.hero-carousel {
  position: relative;
  width: 100%;
  height: 640rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: background-color 0.25s;
}







.carousel-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background-color: var(--sl-white);
  box-shadow: 0 4rpx 12rpx rgba(15, 30, 61, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.btn-prev {
  left: 24rpx;
}

.btn-next {
  right: 24rpx;
}

.nav-arrow-char {
  font-size: var(--sl-fs-h3);
  color: var(--sl-text);
  font-weight: var(--sl-fw-bold);
  line-height: 1;
  margin-top: -4rpx;
}

.hero-tag-room {
  position: absolute;
  bottom: 24rpx;
  left: 28rpx;
  background-color: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  z-index: 5;
}

.hero-tag-counter {
  position: absolute;
  bottom: 24rpx;
  right: 28rpx;
  background-color: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  z-index: 5;
}

/* ============================================================================
   2. BANDEAU DE MINIATURES
   ============================================================================ */
.thumb-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 36rpx 0;
}

.thumb-item {
  flex: 1;
  height: 96rpx;
  border-radius: 20rpx;
  border: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.thumb-item--active {
  border-color: var(--sl-berry);
}

.thumb-play-icon {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-text);
  margin-left: 4rpx;
}

/* ============================================================================
   3. CORPS DE LA FICHE
   ============================================================================ */
.detail-body {
  padding: 32rpx 36rpx 0;
  display: flex;
  flex-direction: column;
}

.meta-tags-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tag-premium {
  background-color: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.tag-type {
  background-color: var(--sl-surface-3);
  color: var(--sl-text);
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.meta-published {
  font-size: var(--sl-fs-caption);
  color: var(--sl-placeholder);
  margin-left: 4rpx;
}

.detail-main-title {
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
  line-height: 1.2;
  color: var(--sl-text);
  letter-spacing: -0.01em;
  margin-bottom: 12rpx;
}

.detail-location-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.location-text {
  font-size: var(--sl-fs-body);
  color: var(--sl-muted);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.price-amount {
  font-size: 56rpx;
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  letter-spacing: -0.02em;
}

.price-unit {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-semibold);
  color: var(--sl-muted);
}

/* Carte Disponibilité */
.availability-card {
  background-color: var(--sl-success-bg);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.avail-check-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: var(--sl-green);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
}

.avail-text-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.avail-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-green);
}

.avail-subtitle {
  font-size: var(--sl-fs-small);
  color: #2E6852;
}

/* Sections communes */
.section-block {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 20rpx;
  display: block;
}

/* Tableau Prix et conditions */
.pricing-table {
  border: 2rpx solid var(--sl-border);
  border-radius: 24rpx;
  overflow: hidden;
  background-color: var(--sl-white);
}

.table-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid var(--sl-surface-3);
}

.table-row:last-child {
  border-bottom: 0;
}

.row-label {
  font-size: var(--sl-fs-body);
  color: var(--sl-muted);
}

.row-val {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.table-row--total {
  background-color: #FFF8FA;
  padding: 28rpx;
}

.total-label {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.total-val {
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.conditions-bullets {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.bullet-dot {
  color: var(--sl-berry);
  font-weight: var(--sl-fw-extrabold);
  font-size: var(--sl-fs-body);
  line-height: 1.2;
}

.bullet-text {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
  line-height: 1.4;
}

/* Caution CTA Box */
.caution-cta-box {
  margin-top: 24rpx;
  background: #E8F0FE;
  border: 2rpx solid #C2D7FA;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.caution-cta-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.caution-cta-title {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: #1A73E8;
}

.caution-cta-sub {
  font-size: var(--sl-fs-caption);
  color: #4A658A;
}

.caution-cta-arrow {
  font-size: var(--sl-fs-title);
  color: #1A73E8;
  font-weight: var(--sl-fw-bold);
}

/* Description */
.desc-content {
  font-size: var(--sl-fs-body);
  line-height: 1.5;
  color: var(--sl-text-2);
}

.btn-read-more {
  color: var(--sl-berry);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  margin-top: 12rpx;
  display: inline-block;
}

/* Équipements */
.equipments-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.equip-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: var(--sl-bg);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  border: 2rpx solid var(--sl-surface-3);
}

.equip-icon {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
}

.equip-label {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

/* Localisation */
.map-preview-box {
  position: relative;
  width: 100%;
  height: 260rpx;
  background-color: #E8EEF5;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-grid-graphic {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.6;
  background-image: 
    linear-gradient(#FFFFFF 3rpx, transparent 3rpx),
    linear-gradient(90deg, #FFFFFF 3rpx, transparent 3rpx),
    linear-gradient(#F5A623 5rpx, transparent 5rpx);
  background-size: 80rpx 80rpx, 80rpx 80rpx, 100% 120rpx;
  background-position: center, center, 0 120rpx;
}

.map-center-pin {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.map-privacy-halo {
  position: absolute;
  width: 130rpx;
  height: 130rpx;
  border-radius: 65rpx;
  background-color: rgba(200, 35, 95, 0.15);
  border: 2rpx dashed var(--sl-berry);
}

.map-pin-bubble {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: var(--sl-berry);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(200, 35, 95, 0.4);
}

.btn-open-map {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background-color: var(--sl-white);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
  box-shadow: 0 4rpx 12rpx rgba(15, 30, 61, 0.1);
  z-index: 3;
}

.map-btn-icon {
  font-weight: var(--sl-fw-extrabold);
}

.map-caption {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.map-place-bold {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.map-place-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-placeholder);
}

/* Le bailleur */
.landlord-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 2rpx solid var(--sl-border);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
}

.landlord-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: var(--sl-navy);
  color: var(--sl-on-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 96rpx;
}

.landlord-initial {
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
}

.landlord-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.landlord-name {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.verified-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-green);
}

.verified-check {
  font-weight: var(--sl-fw-extrabold);
}

.landlord-response {
  font-size: var(--sl-fs-caption);
  color: var(--sl-placeholder);
}

/* Signalement */
.report-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
  margin-top: 16rpx;
}

.report-flag {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-placeholder);
}

.report-text {
  font-size: var(--sl-fs-small);
  color: var(--sl-placeholder);
}

.scroll-spacer {
  height: 60rpx;
}

/* ============================================================================
   4. BARRE FIXE D'ACTION INFÉRIEURE
   ============================================================================ */
.fixed-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background-color: var(--sl-white);
  border-top: 2rpx solid var(--sl-border);
  padding: 16rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(15, 30, 61, 0.06);
}

.btn-contact-outline {
  flex: 1;
  height: 98rpx;
  border-radius: 28rpx;
  border: 4rpx solid var(--sl-navy);
  background-color: var(--sl-white);
  color: var(--sl-text);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0;
  margin: 0;
}

.btn-visit-primary {
  flex: 1.35;
  height: 98rpx;
  border-radius: 28rpx;
  border: 0;
  background-color: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0;
  margin: 0;
  box-shadow: 0 8rpx 20rpx rgba(200, 35, 95, 0.3);
}

/* ============================================================================
   5. ICONS SVG DATA-URI
   ============================================================================ */
