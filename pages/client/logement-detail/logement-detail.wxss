/* ============================================================================
   6. MODAL VISITE
   ============================================================================ */
.modal-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(15, 30, 61, 0.65);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(4px);
}

.visit-sheet {
  width: 100%;
  background-color: var(--sl-white);
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  padding: 36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.visit-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.visit-sheet__title {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.modal-close {
  font-size: var(--sl-fs-title);
  color: var(--sl-placeholder);
  padding: 8rpx;
}

.visit-sheet__sub {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
  margin-bottom: 28rpx;
  display: block;
}

.slots-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.slot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background-color: var(--sl-bg);
  border: 2rpx solid var(--sl-border);
}

.slot-item--selected {
  border-color: var(--sl-berry);
  background-color: #FFF8FA;
}

.slot-text {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.slot-check {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.btn-confirm-visit {
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  background-color: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}


/* ============================================================================
   LOUER À DISTANCE + BARRE « À PAYER POUR ENTRER » (maquette)
   ============================================================================ */
.remote-card {
  margin: 28rpx 0 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
}

.remote-card--hover {
  opacity: 0.9;
}

.remote-card__icon {
  width: 44rpx;
  height: 44rpx;
}

.remote-card__text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.remote-card__title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.remote-card__sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-border-strong);
}

.remote-card__chev {
  width: 32rpx;
  height: 32rpx;
}

.fixed-action-bar--entry {
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
  padding-top: 20rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.entry-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-summary__left {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.entry-summary__label {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.entry-summary__total {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.entry-summary__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text-2);
  text-align: right;
}

.entry-summary__maxit {
  color: var(--sl-berry);
  font-weight: var(--sl-fw-extrabold);
}

.entry-actions {
  display: flex;
  gap: 20rpx;
}

.entry-actions .btn-contact-outline {
  flex: 1;
  height: 108rpx;
  border-radius: 32rpx;
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.entry-actions .btn-visit-primary {
  flex: 1.6;
  height: 108rpx;
  border-radius: 32rpx;
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  box-shadow: 0 12rpx 28rpx rgba(200, 35, 95, 0.28);
}

.entry-actions__icon {
  width: 36rpx;
  height: 36rpx;
}

.btn-chat-landlord {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: var(--sl-surface-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: auto;
}

/* ============================================================================
   GALERIE RÉELLE (photos + vidéo de visite)
   ============================================================================ */
.hero-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hero-media {
  width: 100%;
  height: 100%;
  display: block;
}

/* Léger dégradé pour garder lisibles les boutons et badges posés sur la photo */
.hero-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(15, 30, 61, 0.35) 0%, rgba(15, 30, 61, 0) 28%, rgba(15, 30, 61, 0) 70%, rgba(15, 30, 61, 0.4) 100%);
}

.carousel-nav-btn {
  z-index: 6;
}

.thumb-item {
  background-size: cover;
  background-position: center;
  overflow: hidden;
}

.thumb-play-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============================================================================
   BARRE DU HAUT FIXE (retour · partager · j'aime) — toujours visible
   ============================================================================ */
.dh-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  padding-bottom: 16rpx;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.dh-bar--solid {
  background-color: var(--sl-white);
  box-shadow: 0 6rpx 20rpx rgba(15, 30, 61, 0.08);
}

.dh-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
}

.dh-title {
  flex: 1;
  min-width: 0;
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.dh-title--on {
  opacity: 1;
}

.dh-btn {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 18rpx rgba(15, 30, 61, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dh-btn--hover {
  transform: scale(0.92);
}

.dh-bar--solid .dh-btn {
  background-color: var(--sl-surface-2);
  box-shadow: none;
}

.dh-btn--liked,
.dh-bar--solid .dh-btn--liked {
  background-color: var(--sl-berry-tint);
}

.dh-ic {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.dh-ic--pop {
  animation: dh-pop 0.4s ease-out;
}

@keyframes dh-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.35); }
  100% { transform: scale(1); }
}

