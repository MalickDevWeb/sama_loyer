/* --- Bouton lecture sur la diapo vidéo ------------------------------------ */
.hero-play {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: rgba(15, 30, 61, 0.25);
}

.hero-play--hover {
  background: rgba(15, 30, 61, 0.4);
}

.hero-play-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: var(--sl-white);
  box-shadow: 0 12rpx 32rpx rgba(15, 30, 61, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-play-btn .dh-ic {
  width: 56rpx;
  height: 56rpx;
  margin-left: 6rpx;
}

.hero-play-txt {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(15, 30, 61, 0.75);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
}

.hero-swiper swiper-item {
  position: relative;
}

/* ============================================================================
   PANNEAU DE PARTAGE
   ============================================================================ */
.share-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  background: rgba(15, 30, 61, 0.5);
  display: flex;
  align-items: flex-end;
}

.share-sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--sl-white);
  border-radius: 44rpx 44rpx 0 0;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  animation: share-rise 0.3s ease-out;
}

@keyframes share-rise {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.share-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--sl-border);
  margin: 0 auto;
}

.share-title {
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  text-align: center;
}

.share-card {
  display: flex;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: var(--sl-surface-2);
  border: 2rpx solid var(--sl-divider);
}

.share-card-img {
  width: 152rpx;
  height: 128rpx;
  flex: 0 0 152rpx;
  border-radius: 20rpx;
  background: var(--sl-info-bg);
}

.share-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}

.share-card-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.share-card-place {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.share-card-price {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.share-card-unit {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-semibold);
  color: var(--sl-muted);
}

.share-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.share-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-radius: 24rpx;
}

/* Réinitialise le style natif du <button open-type="share"> */
.share-opt-btn {
  margin: 0;
  padding: 12rpx 0;
  background: transparent;
  line-height: normal;
  font-size: inherit;
  width: auto;
}

.share-opt-btn::after {
  border: none;
}

.share-opt--hover {
  background: var(--sl-surface-2);
}

.share-opt-ic {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-opt-ic .dh-ic {
  width: 44rpx;
  height: 44rpx;
}

.share-opt-ic--berry { background: linear-gradient(135deg, #E0457E 0%, var(--sl-berry) 100%); box-shadow: 0 8rpx 18rpx rgba(200, 35, 95, 0.3); }
.share-opt-ic--green { background: linear-gradient(135deg, #3DD27A 0%, #1FA35C 100%); box-shadow: 0 8rpx 18rpx rgba(31, 163, 92, 0.3); }
.share-opt-ic--navy { background: linear-gradient(135deg, #2B3F6B 0%, var(--sl-navy) 100%); box-shadow: 0 8rpx 18rpx rgba(15, 30, 61, 0.3); }
.share-opt-ic--grey { background: var(--sl-divider); }

.share-opt-txt {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.share-cancel {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 28rpx;
  background: var(--sl-surface-2);
  text-align: center;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

/* ============================================================================
   LECTEUR VIDÉO
   ============================================================================ */
.vplayer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: #070D1C;
  display: flex;
  flex-direction: column;
}

.vplayer-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-left: 24rpx;
  padding-right: 200rpx;
  padding-bottom: 20rpx;
}

.vplayer-back {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.vplayer-back .ic {
  width: 44rpx;
  height: 44rpx;
}

.vplayer-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-on-dark);
}

.vplayer-video {
  width: 100%;
  flex: 1;
}

.vplayer-foot {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #070D1C;
}

.vplayer-note {
  font-size: var(--sl-fs-small);
  color: rgba(255, 255, 255, 0.7);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vplayer-btn-close {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  flex-shrink: 0;
  transition: opacity 0.15s ease;
}
