<view class="search-page">
  <!-- Toast / Notification Flottante Haute Couture (aux couleurs SAMA LOYER) -->
  <view 
    wx:if="{{ toast.visible }}" 
    class="sama-floating-toast {{ toast.hiding ? 'toast--hide' : 'toast--show' }}" 
    style="top: {{ statusBarHeight + 112 }}px;"
    catchtap="onDismissToast"
  >
    <view class="toast-pill-body">
      <view class="toast-icon-wrapper {{ toast.type === 'voice' ? 'toast-icon--voice' : (toast.type === 'heart' ? 'toast-icon--heart' : 'toast-icon--search') }}">
        <view class="toast-svg {{ toast.iconClass }}"></view>
      </view>

      <view class="toast-text-block">
        <view class="toast-main-line">
          <text class="toast-title-text">{{ toast.title }}</text>
        </view>
        <view wx:if="{{ toast.subtitle }}" class="toast-sub-line">
          <text class="toast-subtitle-text">{{ toast.subtitle }}</text>
        </view>
      </view>

      <view class="toast-badge-sparkle">
        <view class="ic ic-sparkle-amber ic--sm"></view>
      </view>
    </view>
  </view>

  <scroll-view class="search-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête avec retour et carte -->
    <view class="search-top-nav" style="padding-top: {{ statusBarHeight + 10 }}px;">
      <view class="btn-back" bindtap="onBackTap"><view class="ic ic-chevron-left-navy ic--md"></view></view>
      <text class="top-nav-title">Résultats de recherche</text>
      <view class="btn-map-icon"><view class="ic ic-map-navy ic--md"></view></view>
    </view>

    <!-- Barre de recherche -->
    <view class="search-bar-row">
      <view class="search-input-pill">
        <view class="ic ic-search-muted ic--sm"></view>
        <input 
          class="search-input" 
          value="{{ searchQuery }}" 
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
          placeholder="Rechercher quartier ou type…"
        />
      </view>
      <view class="btn-mic-round" bindtap="onMicTap"><view class="ic ic-mic-white ic--md"></view></view>
      <view class="btn-filter-icon" bindtap="onFilterTap"><view class="ic ic-sliders-navy ic--md"></view></view>
    </view>

    <!-- Titre et compteur -->
    <view class="search-headline-row">
      <view class="headline-titles">
        <text class="headline-main">{{ headlineText }}</text>
        <text class="headline-count">{{ filteredListings.length }} logements trouvés</text>
      </view>
      <text class="btn-modify-link" bindtap="onModifyTap">Modifier</text>
    </view>

    <!-- Pilules de filtres -->
    <scroll-view class="category-pills-scroll" scroll-x="{{true}}">
      <view class="pills-row">
        <view class="cat-pill pill-filter-btn">
          <view class="ic-row"><view class="ic ic-bolt-berry ic--xs"></view><text>Filtres</text></view>
        </view>
        <view class="cat-pill {{ activeCategory === 'tous' ? 'cat-pill--active' : '' }}" data-cat="tous" bindtap="onCategorySelect">
          <text>Tous</text>
        </view>
        <view class="cat-pill {{ activeCategory === 'chambre' ? 'cat-pill--active' : '' }}" data-cat="chambre" bindtap="onCategorySelect">
          <text>Chambre</text>
        </view>
        <view class="cat-pill {{ activeCategory === 'studio' ? 'cat-pill--active' : '' }}" data-cat="studio" bindtap="onCategorySelect">
          <text>Studio</text>
        </view>
      </view>
    </scroll-view>

    <!-- Section Bailleurs Premium -->
    <view class="section-container">
      <view class="section-header-row">
        <view class="section-title-pink ic-row"><view class="ic ic-star-berry ic--sm"></view><text>Bailleurs Premium</text></view>
        <text class="section-sub-grey">Des logements mis en avant</text>
      </view>

      <scroll-view class="premium-carousel" scroll-x="{{true}}">
        <view class="premium-cards-track">
          <block wx:for="{{ premiumListings }}" wx:key="id">
            <view class="premium-card" data-id="{{ item.id }}" bindtap="onCardTap">
              <view class="premium-card-thumb sl-photo" style="background-color: {{ item.bg }}; background-image: url('{{ item.cover }}');">
                <view class="thumb-badge-premium ic-row"><view class="ic ic-star-white ic--xs"></view><text>Premium</text></view>
                <view class="thumb-heart-icon"><view class="ic ic--sm {{ item.isFavorite ? 'ic-heart-fill-berry' : 'ic-heart-navy' }}"></view></view>
                <view wx:if="{{ !item.cover }}" class="thumb-house-outline"></view>
              </view>
              <view class="premium-card-info">
                <text class="card-price-bold">{{ item.price }}</text>
                <text class="card-title-bold">{{ item.title }}</text>
                <text class="card-place-grey">{{ item.place }}</text>
                <view class="card-dispo-tag ic-row"><view class="ic ic-check-green ic--xs"></view><text>{{ item.badge }}</text></view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- Section Logements disponibles -->
    <view class="section-container">
      <view class="available-head-row">
        <text class="available-title">Logements disponibles</text>
        <view class="sort-dropdown">
          <text class="sort-label">Trier</text>
          <view class="sort-value ic-row"><text>Plus récents</text><view class="ic ic-chevron-down-navy ic--xs"></view></view>
        </view>
      </view>

      <!-- Liste verticale -->
      <view class="available-list">
        <block wx:if="{{ filteredListings && filteredListings.length > 0 }}">
          <block wx:for="{{ filteredListings }}" wx:key="id">
            <view class="avail-card" data-id="{{ item.id }}" bindtap="onCardTap">
              <view class="avail-thumb sl-photo" style="background-color: {{ item.bg }}; background-image: url('{{ item.cover }}');">
                <view wx:if="{{ !item.cover }}" class="thumb-house-outline-sm"></view>
              </view>
              <view class="avail-content">
                <view class="avail-price-row">
                  <text class="avail-price">{{ item.price }}</text>
                  <view class="ic ic--md {{ item.isFavorite ? 'ic-heart-fill-berry' : 'ic-heart-navy' }}"></view>
                </view>
                <text class="avail-title">{{ item.title }}</text>
                <text class="avail-place">{{ item.place }}</text>

                <view class="avail-tags-row">
                  <block wx:for="{{ item.tags }}" wx:for-item="t" wx:key="*this">
                    <view class="chip-tag">{{ t }}</view>
                  </block>
                </view>

                <text class="avail-status">{{ item.status }}</text>
              </view>
            </view>
          </block>
        </block>

        <!-- État si la recherche ne donne aucun résultat ("fail le recherche") -->
        <view wx:else class="search-empty-state">
          <view class="empty-icon-circle">
            <view class="ic ic-search-navy ic--xl"></view>
          </view>
          <text class="empty-title">Aucun logement trouvé</text>
          <text class="empty-desc">Aucune annonce ne correspond exactement à tes critères. Essaie de modifier la localité ou d'augmenter ton budget.</text>
          <button class="btn-empty-reset" bindtap="onResetFilters">
            Voir toutes les annonces
          </button>
        </view>
      </view>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Custom Voice Search Bottom Sheet (Design 100% SAMA LOYER) -->
  <view wx:if="{{ showVoiceModal }}" class="custom-sheet-mask" bindtap="onCloseVoiceModal">
    <view class="custom-bottom-sheet" catchtap="noop">
      <view class="sheet-drag-handle"></view>

      <!-- Sheet Header -->
      <view class="sheet-header">
        <view class="sheet-header-left">
          <view class="voice-icon-pulse">
            <view class="ic ic-mic-white ic--md"></view>
          </view>
          <view class="sheet-title-col">
            <text class="sheet-main-title">Recherche Vocale IA</text>
            <text class="sheet-sub-title">Comprend le Wolof et le Français</text>
          </view>
        </view>
        <view class="sheet-close-btn" bindtap="onCloseVoiceModal"><view class="ic ic-close-grey ic--sm"></view></view>
      </view>

      <!-- Soundwave Visual Banner -->
      <view class="voice-soundwave-banner">
        <view class="soundwave-bars">
          <view class="wave-bar w-1"></view>
          <view class="wave-bar w-2"></view>
          <view class="wave-bar w-3"></view>
          <view class="wave-bar w-4"></view>
          <view class="wave-bar w-5"></view>
          <view class="wave-bar w-4"></view>
          <view class="wave-bar w-2"></view>
        </view>
        <text class="soundwave-text">Dis une phrase ou sélectionne un exemple :</text>
      </view>

      <!-- 3 Voice Cards -->
      <view class="voice-cards-list">
        <!-- Wolof Example -->
        <view 
          class="voice-card-item" 
          hover-class="voice-card-hover"
          bindtap="onSelectVoiceQuery"
          data-query="Chambre à Pikine 65 000 F"
          data-display="Dafa ma bëgg chambre ci Pikine 65 000 F"
          data-cat="chambre"
        >
          <view class="voice-card-top">
            <view class="lang-tag lang-wolof">🇸🇳 WOLOF</view>
            <view class="voice-arrow-pill ic-row"><text>Sélectionner</text><view class="ic ic-arrow-right-berry ic--xs"></view></view>
          </view>
          <text class="voice-quote">« Dafa ma bëgg chambre ci Pikine 65 000 F »</text>
          <view class="voice-translation">
            <view class="ai-sparkle ic-row"><view class="ic ic-sparkle-berry ic--xs"></view><text>IA :</text></view>
            <text class="ai-meaning">Chambre à Pikine · 65 000 FCFA max</text>
          </view>
        </view>

        <!-- French Example 1 -->
        <view 
          class="voice-card-item" 
          hover-class="voice-card-hover"
          bindtap="onSelectVoiceQuery"
          data-query="Chambre ou studio à Pikine"
          data-display="Recherche chambre ou studio à Pikine"
          data-cat="chambre"
        >
          <view class="voice-card-top">
            <view class="lang-tag lang-fr">🇫🇷 FRANÇAIS</view>
            <view class="voice-arrow-pill ic-row"><text>Sélectionner</text><view class="ic ic-arrow-right-berry ic--xs"></view></view>
          </view>
          <text class="voice-quote">« Recherche chambre ou studio à Pikine »</text>
          <view class="voice-translation">
            <view class="ai-sparkle ic-row"><view class="ic ic-sparkle-berry ic--xs"></view><text>IA :</text></view>
            <text class="ai-meaning">Logements disponibles à Pikine</text>
          </view>
        </view>

        <!-- French Example 2 -->
        <view 
          class="voice-card-item" 
          hover-class="voice-card-hover"
          bindtap="onSelectVoiceQuery"
          data-query="Studio meublé à Pikine"
          data-display="Studio meublé 95 000 F max"
          data-cat="studio"
        >
          <view class="voice-card-top">
            <view class="lang-tag lang-fr">🇫🇷 DAKAR</view>
            <view class="voice-arrow-pill ic-row"><text>Sélectionner</text><view class="ic ic-arrow-right-berry ic--xs"></view></view>
          </view>
          <text class="voice-quote">« Studio meublé 95 000 F max »</text>
          <view class="voice-translation">
            <view class="ai-sparkle ic-row"><view class="ic ic-sparkle-berry ic--xs"></view><text>IA :</text></view>
            <text class="ai-meaning">Studios meublés avec entrée indépendante</text>
          </view>
        </view>
      </view>

      <button class="sheet-cancel-btn" bindtap="onCloseVoiceModal">
        Fermer
      </button>
    </view>
  </view>

  <!-- Custom Filter Bottom Sheet -->
  <view wx:if="{{ showFilterModal }}" class="custom-sheet-mask" bindtap="onCloseFilterModal">
    <view class="custom-bottom-sheet" catchtap="noop">
      <view class="sheet-drag-handle"></view>

      <view class="sheet-header">
        <view class="sheet-header-left">
          <text class="sheet-main-title">Type de logement</text>
        </view>
        <view class="sheet-close-btn" bindtap="onCloseFilterModal"><view class="ic ic-close-grey ic--sm"></view></view>
      </view>

      <view class="category-options-list">
        <view 
          class="category-option-row {{ activeCategory === 'tous' ? 'cat-active' : '' }}"
          bindtap="onSelectCategoryModal"
          data-cat="tous"
        >
          <view class="cat-text-col">
            <text class="cat-title">Tous les logements</text>
            <text class="cat-sub">Toutes les offres disponibles à Pikine</text>
          </view>
          <view class="cat-radio-circle {{ activeCategory === 'tous' ? 'cat-radio-active' : '' }}">
            <text wx:if="{{ activeCategory === 'tous' }}" class="cat-radio-dot"></text>
          </view>
        </view>

        <view 
          class="category-option-row {{ activeCategory === 'chambre' ? 'cat-active' : '' }}"
          bindtap="onSelectCategoryModal"
          data-cat="chambre"
        >
          <view class="cat-text-col">
            <text class="cat-title">Chambres</text>
            <text class="cat-sub">Chambre simple ou chambre salon</text>
          </view>
          <view class="cat-radio-circle {{ activeCategory === 'chambre' ? 'cat-radio-active' : '' }}">
            <text wx:if="{{ activeCategory === 'chambre' }}" class="cat-radio-dot"></text>
          </view>
        </view>

        <view 
          class="category-option-row {{ activeCategory === 'studio' ? 'cat-active' : '' }}"
          bindtap="onSelectCategoryModal"
          data-cat="studio"
        >
          <view class="cat-text-col">
            <text class="cat-title">Studios</text>
            <text class="cat-sub">Studio meublé avec entrée indépendante</text>
          </view>
          <view class="cat-radio-circle {{ activeCategory === 'studio' ? 'cat-radio-active' : '' }}">
            <text wx:if="{{ activeCategory === 'studio' }}" class="cat-radio-dot"></text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

