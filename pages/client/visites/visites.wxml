<view class="vis">
  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <!-- En-tête -->
  <view class="vis__header">
    <text class="vis__title">Mes visites</text>
    <text class="vis__subtitle">Suis tes demandes de visite</text>
  </view>

  <!-- Filtres par statut -->
  <scroll-view class="vis__tabs" scroll-x="{{ true }}" enhanced="{{ true }}" show-scrollbar="{{ false }}">
    <view class="vis__tabs-row">
      <view
        wx:for="{{ tabs }}"
        wx:key="id"
        class="vis__pill {{ activeFilter === item.id ? 'vis__pill--on' : '' }}"
        data-filter="{{ item.id }}"
        bindtap="onFilterTap"
      >{{ item.label }}</view>
    </view>
  </scroll-view>

  <!-- Cartes -->
  <view class="vis__list">
    <view wx:for="{{ filteredList }}" wx:key="id" class="vis__card">
      <view class="vis__card-head" data-id="{{ item.id }}" bindtap="onToggleExpand">
        <view class="vis__when">
          <view class="ic ic-cal-navy vis__when-ic"></view>
          <text>{{ item.dateLabel }}</text>
        </view>
        <text class="vis__badge vis__badge--{{ item.status }}">{{ item.statusLabel }}</text>
      </view>

      <view class="vis__prop" hover-class="vis__prop--hover" data-logement-id="{{ item.logementId }}" bindtap="onOpenLogement">
        <view class="vis__thumb sl-photo" style="background-color: {{ item.tint }}; background-image: url('{{ item.cover }}');"><view wx:if="{{ !item.cover }}" class="vis__house"></view></view>
        <view class="vis__prop-text">
          <text class="vis__prop-title">{{ item.title }}</text>
          <text class="vis__prop-place">{{ item.place }}</text>
          <text class="vis__prop-owner">{{ item.bailleur }}</text>
        </view>
      </view>

      <!-- Détails et actions visibles seulement après avoir cliqué sur "Voir plus" -->
      <view wx:if="{{ expandedMap[item.id] }}" class="vis__body">
        <view class="vis__note vis__note--{{ item.status }}">{{ item.note }}</view>

        <block wx:if="{{ item.status === 'accepted' }}">
          <view class="vis__duo">
            <view class="sl-btn sl-btn--navy vis__btn" hover-class="sl-hover" bindtap="onOpenItineraire">
              <view class="ic ic-nav-white vis__btn-ic"></view>
              <text>Itinéraire</text>
            </view>
            <view class="sl-btn sl-btn--outline vis__btn" hover-class="sl-hover" data-logement-id="{{ item.logementId }}" bindtap="onOpenMessage">
              <view class="ic ic-chat-navy vis__btn-ic"></view>
              <text>Message</text>
            </view>
          </view>
          <view class="sl-btn sl-btn--berry vis__take" hover-class="sl-hover" data-logement-id="{{ item.logementId }}" bindtap="onTakeLogement">
            <view class="ic ic-home-white vis__take-ic"></view>
            <text>Je prends ce logement</text>
          </view>
        </block>

        <view
          wx:if="{{ item.status === 'pending' }}"
          class="sl-btn sl-btn--outline vis__btn vis__cancel"
          hover-class="sl-hover"
          data-id="{{ item.id }}"
          bindtap="onCancelDemande"
        >Annuler la demande</view>

        <view
          wx:if="{{ item.status === 'rejected' }}"
          class="sl-btn sl-btn--berry vis__btn"
          hover-class="sl-hover"
          bindtap="onSimilar"
        >Voir des logements similaires</view>
      </view>

      <!-- Bouton Voir plus / Voir moins -->
      <view class="vis__toggle" hover-class="vis__toggle--hover" data-id="{{ item.id }}" catchtap="onToggleExpand" aria-label="{{ expandedMap[item.id] ? 'Voir moins' : 'Voir plus' }}">
        <text class="vis__toggle-text">{{ expandedMap[item.id] ? 'Voir moins' : 'Voir plus' }}</text>
        <view class="ic ic-chevron-berrydark vis__toggle-ic {{ expandedMap[item.id] ? 'vis__toggle-ic--open' : '' }}"></view>
      </view>
    </view>

    <!-- Vide -->
    <view wx:if="{{ !filteredList.length }}" class="vis__empty">
      <text class="vis__empty-title">Aucune visite ici</text>
      <text class="vis__empty-text">Demande une visite depuis une annonce pour la suivre ici.</text>
      <view class="sl-btn sl-btn--berry vis__empty-btn" hover-class="sl-hover" bindtap="onSearchHome">Chercher un logement</view>
    </view>
  </view>

  <view class="vis__tab-spacer"></view>
</view>
