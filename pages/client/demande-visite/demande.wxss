@import "/styles/sama-ui.wxss";

/* ============================================================================
   SAMA LOYER — Demande de visite, d'après la maquette DemandeVisite
   ============================================================================ */

.dv__topbar-space {
  height: 120rpx;
}

/* --- Logement concerné --------------------------------------------------- */
.dv__logement {
  margin: 32rpx 32rpx 0;
  padding: 20rpx;
  border-radius: 36rpx;
  background: var(--sl-surface-2);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dv__thumb {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 28rpx;
}

.dv__logement-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dv__logement-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dv__logement-price {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.dv__logement-owner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-success);
}

.dv__owner-ic {
  width: 24rpx;
  height: 24rpx;
}

/* --- Étapes -------------------------------------------------------------- */
.dv__step {
  padding: 44rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dv__step--first {
  padding: 44rpx 32rpx 8rpx 40rpx;
}

.dv__num {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 26rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__step-title {
  flex: 1;
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
}

.dv__nav {
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  border: 2rpx solid var(--sl-border);
  background: var(--sl-white);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__nav-ic {
  width: 36rpx;
  height: 36rpx;
}

.dv__hint {
  display: block;
  margin: 0 40rpx 20rpx 112rpx;
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

/* --- Jours --------------------------------------------------------------- */
.dv__days {
  padding: 0 32rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.dv__day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 8rpx;
  border-radius: 32rpx;
  border: 4rpx solid var(--sl-border);
  background: var(--sl-white);
  color: var(--sl-text);
}

.dv__day--on {
  background: var(--sl-navy);
  border-color: var(--sl-navy);
  color: var(--sl-on-dark);
}

.dv__day--off {
  background: var(--sl-surface-2);
  border-color: var(--sl-surface-2);
  color: #A3AAB8;
}

.dv__dow {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
}

.dv__date {
  font-size: var(--sl-fs-h3);
  font-weight: var(--sl-fw-extrabold);
  line-height: 1.1;
}

.dv__count {
  margin-top: 4rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  background: var(--sl-success-bg);
  color: var(--sl-success-text);
}

.dv__day--on .dv__count {
  background: rgba(255, 255, 255, 0.16);
  color: var(--sl-on-dark);
}

.dv__day--off .dv__count {
  background: transparent;
  color: #A3AAB8;
}

/* --- Heures -------------------------------------------------------------- */
.dv__slots {
  padding: 0 32rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}

.dv__slot {
  height: 112rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  border: 4rpx solid var(--sl-border);
  background: var(--sl-white);
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.dv__slot--on {
  background: var(--sl-berry);
  border-color: var(--sl-berry);
  color: var(--sl-on-dark);
}

.dv__slot-ic {
  width: 32rpx;
  height: 32rpx;
}

.dv__write {
  margin: 24rpx 40rpx 0;
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-berry);
}

.dv__write-ic {
  width: 32rpx;
  height: 32rpx;
}

/* --- Message ------------------------------------------------------------- */
.dv__msg {
  padding: 28rpx 32rpx 0;
}

.dv__msg-add {
  height: 100rpx;
  border-radius: 28rpx;
  border: 2rpx dashed var(--sl-border-strong);
  background: var(--sl-white);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__msg-label {
  display: block;
  margin: 0 8rpx 16rpx;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.dv__quick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dv__quick-chip {
  height: 72rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 2rpx solid var(--sl-berry-border);
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  display: flex;
  align-items: center;
}

.dv__textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--sl-border);
  font-size: var(--sl-fs-body-lg);
  color: var(--sl-text);
}

.dv__placeholder {
  color: var(--sl-placeholder);
}

/* --- Louer sans visite --------------------------------------------------- */
.dv__remote {
  margin: 36rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dv__remote-ic {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__remote-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dv__remote-title {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.dv__remote-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-border-strong);
}

.dv__remote-chev {
  width: 32rpx;
  height: 32rpx;
}

.dv__bottom-spacer {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

/* --- Barre d'envoi ------------------------------------------------------- */
.dv__bar {
  flex-direction: column;
  gap: 16rpx;
  padding-top: 20rpx;
}

.dv__choice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
}

.dv__choice-ic {
  width: 32rpx;
  height: 32rpx;
}

.dv__send {
  flex: none;
  height: 108rpx;
  font-size: var(--sl-fs-subtitle);
}

/* --- Confirmation -------------------------------------------------------- */
.dv__done {
  min-height: calc(100vh - 240rpx);
  box-sizing: border-box;
  padding: 52rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.dv__done-ic {
  align-self: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  background: var(--sl-success-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__done-check {
  width: 68rpx;
  height: 68rpx;
}

.dv__done-title {
  margin: 32rpx 0 12rpx;
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
  text-align: center;
}

.dv__done-text {
  font-size: var(--sl-fs-body);
  line-height: 1.5;
  color: var(--sl-muted);
  text-align: center;
}

.dv__done-when {
  margin-top: 44rpx;
  padding: 28rpx 32rpx;
  border-radius: 36rpx;
  background: var(--sl-surface-2);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dv__done-cal {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 28rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dv__done-dow {
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-bold);
}

.dv__done-num {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
}

.dv__done-when-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dv__done-full {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

.dv__done-place {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.dv__done-status {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--sl-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dv__done-status-label {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.dv__done-badge {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-warning-text);
  background: var(--sl-warning-bg);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

.dv__done-actions {
  margin-top: auto;
  padding-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dv__done-follow {
  flex: none;
  height: 112rpx;
  font-size: var(--sl-fs-subtitle);
}

.dv__done-edit {
  flex: none;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: var(--sl-fs-body);
}
