@import "/styles/sama-ui.wxss";

/* ============================================================================
   SAMA LOYER — Demande de visite, d'après la maquette DemandeVisite
   ============================================================================ */

.dv__topbar-space {
  height: 120rpx;
}

/* --- Logement concerné --------------------------------------------------- */
.dv__logement {
  margin: 32rpx 32rpx 0;
  padding: 20rpx;
  border-radius: 36rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dv__thumb {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 28rpx;
}

.dv__logement-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dv__logement-title {
  font-size: 28rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dv__logement-price {
  font-size: 26rpx;
  color: #5B6475;
}

.dv__logement-owner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #11643F;
}

.dv__owner-ic {
  width: 24rpx;
  height: 24rpx;
}

/* --- Étapes -------------------------------------------------------------- */
.dv__step {
  padding: 44rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dv__step--first {
  padding: 44rpx 32rpx 8rpx 40rpx;
}

.dv__num {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 26rpx;
  background: #0F1E3D;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__step-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
}

.dv__nav {
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  border: 2rpx solid #E4E7EE;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__nav-ic {
  width: 36rpx;
  height: 36rpx;
}

.dv__hint {
  display: block;
  margin: 0 40rpx 20rpx 112rpx;
  font-size: 24rpx;
  color: #5B6475;
}

/* --- Jours --------------------------------------------------------------- */
.dv__days {
  padding: 0 32rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.dv__day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 8rpx;
  border-radius: 32rpx;
  border: 4rpx solid #E4E7EE;
  background: #FFFFFF;
  color: #0F1E3D;
}

.dv__day--on {
  background: #0F1E3D;
  border-color: #0F1E3D;
  color: #FFFFFF;
}

.dv__day--off {
  background: #F7F8FA;
  border-color: #F7F8FA;
  color: #A3AAB8;
}

.dv__dow {
  font-size: 24rpx;
  font-weight: 700;
}

.dv__date {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.dv__count {
  margin-top: 4rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  background: #E2F0EA;
  color: #0D4F31;
}

.dv__day--on .dv__count {
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
}

.dv__day--off .dv__count {
  background: transparent;
  color: #A3AAB8;
}

/* --- Heures -------------------------------------------------------------- */
.dv__slots {
  padding: 0 32rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}

.dv__slot {
  height: 112rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  border: 4rpx solid #E4E7EE;
  background: #FFFFFF;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.dv__slot--on {
  background: #C8235F;
  border-color: #C8235F;
  color: #FFFFFF;
}

.dv__slot-ic {
  width: 32rpx;
  height: 32rpx;
}

.dv__write {
  margin: 24rpx 40rpx 0;
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #C8235F;
}

.dv__write-ic {
  width: 32rpx;
  height: 32rpx;
}

/* --- Message ------------------------------------------------------------- */
.dv__msg {
  padding: 28rpx 32rpx 0;
}

.dv__msg-add {
  height: 100rpx;
  border-radius: 28rpx;
  border: 2rpx dashed #C9CFDA;
  background: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__msg-label {
  display: block;
  margin: 0 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.dv__quick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dv__quick-chip {
  height: 72rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 2rpx solid #F3C3D5;
  background: #FDF1F5;
  color: #9E1749;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.dv__textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 28rpx;
  border: 2rpx solid #E4E7EE;
  font-size: 30rpx;
  color: #0F1E3D;
}

.dv__placeholder {
  color: #7A8294;
}

/* --- Louer sans visite --------------------------------------------------- */
.dv__remote {
  margin: 36rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #0F1E3D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dv__remote-ic {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__remote-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dv__remote-title {
  font-size: 30rpx;
  font-weight: 800;
}

.dv__remote-sub {
  font-size: 24rpx;
  color: #C9D0DE;
}

.dv__remote-chev {
  width: 32rpx;
  height: 32rpx;
}

.dv__bottom-spacer {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

/* --- Barre d'envoi ------------------------------------------------------- */
.dv__bar {
  flex-direction: column;
  gap: 16rpx;
  padding-top: 20rpx;
}

.dv__choice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.dv__choice-ic {
  width: 32rpx;
  height: 32rpx;
}

.dv__send {
  flex: none;
  height: 108rpx;
  font-size: 32rpx;
}

/* --- Confirmation -------------------------------------------------------- */
.dv__done {
  min-height: calc(100vh - 240rpx);
  box-sizing: border-box;
  padding: 52rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.dv__done-ic {
  align-self: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  background: #E2F0EA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dv__done-check {
  width: 68rpx;
  height: 68rpx;
}

.dv__done-title {
  margin: 32rpx 0 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  text-align: center;
}

.dv__done-text {
  font-size: 28rpx;
  line-height: 1.5;
  color: #5B6475;
  text-align: center;
}

.dv__done-when {
  margin-top: 44rpx;
  padding: 28rpx 32rpx;
  border-radius: 36rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dv__done-cal {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 28rpx;
  background: #0F1E3D;
  color: #FFFFFF;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dv__done-dow {
  font-size: 20rpx;
  font-weight: 700;
}

.dv__done-num {
  font-size: 36rpx;
  font-weight: 800;
}

.dv__done-when-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dv__done-full {
  font-size: 30rpx;
  font-weight: 800;
}

.dv__done-place {
  font-size: 26rpx;
  color: #5B6475;
}

.dv__done-status {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E4E7EE;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dv__done-status-label {
  font-size: 28rpx;
  font-weight: 800;
}

.dv__done-badge {
  font-size: 24rpx;
  font-weight: 800;
  color: #6B4A00;
  background: #FFF4E0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

.dv__done-actions {
  margin-top: auto;
  padding-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dv__done-follow {
  flex: none;
  height: 112rpx;
  font-size: 32rpx;
}

.dv__done-edit {
  flex: none;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
}
