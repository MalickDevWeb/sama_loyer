@import "/styles/sama-ui.wxss";

page {
  background: #F7F8FA;
}

/* --- En-tête ------------------------------------------------------------- */
.contrat__hero {
  background: #0F1E3D;
  color: #FFFFFF;
  padding: 0 32rpx 128rpx;
  border-radius: 0 0 56rpx 56rpx;
}

.contrat__hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contrat__num {
  font-size: 24rpx;
  font-weight: 700;
  color: #C9D0DE;
}

.contrat__title-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 32rpx;
}

.contrat__doc {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 32rpx;
  background: #C8235F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contrat__doc .ic {
  width: 52rpx;
  height: 52rpx;
}

.contrat__title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.contrat__subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #C9D0DE;
}

.contrat__signed {
  margin-top: 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #0F1E3D;
}

.contrat__signed .ic {
  width: 28rpx;
  height: 28rpx;
}

/* --- L'essentiel --------------------------------------------------------- */
.contrat__essential {
  margin: -88rpx 32rpx 0;
  padding: 32rpx;
  border-radius: 44rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 48rpx rgba(15, 30, 61, 0.10);
  position: relative;
}

.contrat__h2 {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.contrat__h2--pad {
  margin: 0 8rpx 20rpx;
}

/* --- Sections ------------------------------------------------------------ */
.contrat__section {
  padding: 36rpx 32rpx 0;
}

.contrat__parties {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.contrat__party {
  padding: 28rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.contrat__eyebrow {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #C8235F;
}

.contrat__party-name {
  font-size: 30rpx;
  font-weight: 800;
}

.contrat__party-phone {
  font-size: 24rpx;
  color: #5B6475;
}

.contrat__party-status {
  font-size: 22rpx;
  font-weight: 800;
}

.contrat__home {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.contrat__home-icon {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 28rpx;
  background: #E3E9F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contrat__home-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contrat__home-title {
  font-size: 28rpx;
  font-weight: 800;
}

.contrat__articles-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 8rpx 20rpx;
}

.contrat__articles-head .contrat__h2 {
  margin-bottom: 0;
}

.contrat__toggle-all {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 20rpx;
  color: #C8235F;
  font-size: 24rpx;
  font-weight: 800;
}

/* --- Signatures ---------------------------------------------------------- */
.contrat__sig-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #5B6475;
}

.contrat__sig {
  margin: 12rpx 0 8rpx;
  font-family: 'Caveat', 'Brush Script MT', cursive;
  font-style: italic;
  font-size: 48rpx;
  color: #0F1E3D;
  border-bottom: 2rpx dashed #C9CFDA;
  padding-bottom: 8rpx;
}

.contrat__sig-date {
  font-size: 22rpx;
  color: #5B6475;
}

.contrat__legal {
  display: block;
  margin: 28rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7A8294;
}

/* --- Barre du bas -------------------------------------------------------- */
.contrat__download {
  flex: 1.4;
}

.contrat__download-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ============================================================================
   SAMA LOYER — Modal Signature & Sceau Certifié
   ============================================================================ */
.contrat__sig-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 40rpx;
}

.contrat__sig-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #EAF7EE;
  border: 2rpx solid #C4EED0;
  font-size: 22rpx;
  font-weight: 800;
  color: #11643F;
}

.contrat__seal {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: #F0F4FA;
  border: 2rpx solid #D5DFED;
  margin: 20rpx 40rpx 0;
}

.contrat__seal-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #0F1E3D;
  line-height: 1.4;
}

/* Modal signature */
.contrat__sign-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2000;
  background: rgba(15, 30, 61, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.contrat__sign-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 50rpx rgba(15, 30, 61, 0.3);
}

.contrat__sign-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.contrat__sign-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.contrat__sign-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #F1F4F9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contrat__sign-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #EAF7EE;
  font-size: 22rpx;
  font-weight: 800;
  color: #11643F;
  margin-bottom: 16rpx;
}

.contrat__sign-desc {
  font-size: 24rpx;
  line-height: 1.45;
  color: #5B6475;
  margin-bottom: 24rpx;
}

.contrat__sign-pad {
  padding: 36rpx 24rpx;
  border-radius: 24rpx;
  background: #F8F9FC;
  border: 2rpx dashed #C9D0DE;
  text-align: center;
  margin-bottom: 24rpx;
}

.contrat__sign-holder {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0F1E3D;
  font-style: italic;
}

.contrat__sign-sub {
  display: block;
  font-size: 22rpx;
  color: #7A8294;
  margin-top: 6rpx;
}

.contrat__sign-line {
  width: 60%;
  height: 2rpx;
  background: #0F1E3D;
  margin: 16rpx auto 0;
}

.contrat__sign-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contrat__sign-cancel {
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #7A8294;
  padding: 12rpx;
}
