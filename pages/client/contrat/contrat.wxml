<view class="contrat">
  <!-- En-tête bleu marine -->
  <view class="contrat__hero" style="padding-top: {{ statusBarHeight + 14 }}px;">
    <view class="contrat__hero-top">
      <view class="sl-icon-btn sl-icon-btn--glass" hover-class="sl-hover" bindtap="onBack" aria-label="Retour à Mon loyer">
        <view class="ic ic-back-white"></view>
      </view>
      <text class="contrat__num">{{ contrat.numero }}</text>
    </view>
    <view class="contrat__title-row">
      <view class="contrat__doc">
        <view class="ic ic-doc-white"></view>
      </view>
      <view>
        <text class="contrat__title">Contrat de location</text>
        <text class="contrat__subtitle">{{ contrat.subtitle }}</text>
      </view>
    </view>
    <view class="contrat__signed">
      <view class="ic ic-check-berry"></view>
      <text>{{ contrat.signedLabel }}</text>
    </view>
  </view>

  <!-- L'essentiel -->
  <view class="contrat__essential">
    <text class="contrat__h2">L'essentiel</text>
    <view class="sl-keys">
      <view wx:for="{{ contrat.keys }}" wx:key="label" class="sl-key">
        <text class="sl-key__label">{{ item.label }}</text>
        <text class="sl-key__value">{{ item.value }}</text>
        <text class="sl-key__sub">{{ item.sub }}</text>
      </view>
    </view>
    <view class="sl-audio {{ playing ? 'sl-audio--playing' : '' }}" hover-class="sl-hover" bindtap="onToggleAudio">
      <view wx:if="{{ !playing }}" class="ic ic-play-berrydark"></view>
      <view wx:else class="sl-wave">
        <view class="sl-wave__bar"></view>
        <view class="sl-wave__bar"></view>
        <view class="sl-wave__bar"></view>
      </view>
      <text class="sl-audio__label">{{ playing ? 'Lecture du résumé en wolof…' : 'Écouter le résumé en wolof' }}</text>
      <text class="sl-audio__dur">1:20</text>
    </view>
  </view>

  <!-- Parties -->
  <view class="contrat__section">
    <text class="contrat__h2 contrat__h2--pad">Entre</text>
    <view class="contrat__parties">
      <view class="contrat__party">
        <text class="contrat__eyebrow">LE BAILLEUR</text>
        <text class="contrat__party-name">{{ contrat.bailleur.name }}</text>
        <text class="contrat__party-phone">{{ contrat.bailleur.phone }}</text>
        <text class="contrat__party-status">{{ contrat.bailleur.status }}</text>
      </view>
      <view class="contrat__party">
        <text class="contrat__eyebrow">LE LOCATAIRE</text>
        <text class="contrat__party-name">{{ contrat.locataire.name }}</text>
        <text class="contrat__party-phone">{{ contrat.locataire.phone }}</text>
        <text class="contrat__party-status">{{ contrat.locataire.status }}</text>
      </view>
    </view>
    <view class="contrat__home">
      <view class="contrat__home-icon">
        <view class="ic ic-home-navy"></view>
      </view>
      <view class="contrat__home-text">
        <text class="contrat__eyebrow">LE LOGEMENT</text>
        <text class="contrat__home-title">{{ contrat.logement.title }}</text>
        <text class="contrat__party-phone">{{ contrat.logement.sub }}</text>
      </view>
    </view>
  </view>

  <!-- Articles -->
  <view class="contrat__section">
    <view class="contrat__articles-head">
      <text class="contrat__h2">Le contrat, article par article</text>
      <text class="contrat__toggle-all" bindtap="onToggleAll">{{ allOpen ? 'Tout replier' : 'Tout ouvrir' }}</text>
    </view>
    <view class="sl-articles">
      <view wx:for="{{ contrat.articles }}" wx:key="title" class="sl-article {{ open[index] ? 'sl-article--open' : '' }}">
        <view class="sl-article__head" hover-class="sl-hover" data-index="{{ index }}" bindtap="onToggleArticle">
          <text class="sl-article__num">{{ index + 1 }}</text>
          <view class="sl-article__titles">
            <text class="sl-article__title">{{ item.title }}</text>
            <text class="sl-article__hint">{{ item.hint }}</text>
          </view>
          <view class="ic ic-chevron-down-grey sl-article__chev"></view>
        </view>
        <text wx:if="{{ open[index] }}" class="sl-article__text">{{ item.text }}</text>
      </view>
    </view>
  </view>

  <!-- Signatures -->
  <view class="contrat__section">
    <view class="contrat__sig-head">
      <text class="contrat__h2 contrat__h2--pad">Signatures numériques</text>
      <view class="contrat__sig-btn" hover-class="sl-hover" bindtap="onOpenSign">
        <view class="ic ic-shield-check-green" style="width: 28rpx; height: 28rpx;"></view>
        <text>Certificat Max it</text>
      </view>
    </view>
    <view class="contrat__parties">
      <view class="contrat__party">
        <text class="contrat__sig-label">Le bailleur</text>
        <text class="contrat__sig">{{ contrat.bailleur.signature }}</text>
        <text class="contrat__sig-date">{{ contrat.bailleur.signedOn }}</text>
      </view>
      <view class="contrat__party contrat__party--locataire">
        <text class="contrat__sig-label">Le locataire</text>
        <text class="contrat__sig">{{ contrat.locataire.signature }}</text>
        <text class="contrat__sig-date">{{ contrat.locataire.signedOn }}</text>
      </view>
    </view>
    <view class="contrat__seal">
      <view class="ic ic-shield-check-green" style="width: 32rpx; height: 32rpx;"></view>
      <text class="contrat__seal-text">Bail officiel vérifié et archivé sous le sceau SAMA LOYER · Code : {{ contrat.numero }}</text>
    </view>
    <text class="contrat__legal">Modèle de contrat proposé par SAMA LOYER. Les signatures sont enregistrées avec le numéro de téléphone vérifié de chaque partie.</text>
  </view>

  <view class="sl-bottom-spacer"></view>

  <!-- Barre du bas -->
  <view class="sl-bottombar">
    <view class="sl-btn sl-btn--outline-navy" hover-class="sl-hover" bindtap="onShare">Partager</view>
    <view class="sl-btn sl-btn--berry contrat__download" hover-class="sl-hover" bindtap="onDownload">
      <view class="ic ic-download-white contrat__download-icon"></view>
      <text>Télécharger (PDF)</text>
    </view>
  </view>

  <!-- Modal Signature Numérique Max it -->
  <view wx:if="{{ showSignModal }}" class="contrat__sign-backdrop" catchtouchmove="noop" bindtap="onCloseSign">
    <view class="contrat__sign-modal" catchtap="noop">
      <view class="contrat__sign-header">
        <text class="contrat__sign-title">Signature électronique certifiée</text>
        <view class="contrat__sign-close" bindtap="onCloseSign">
          <view class="ic ic-close-navy" style="width: 24rpx; height: 24rpx;"></view>
        </view>
      </view>
      <view class="contrat__sign-body">
        <view class="contrat__sign-badge">
          <view class="ic ic-shield-check-green" style="width: 32rpx; height: 32rpx;"></view>
          <text>Authentifié par Orange Max it</text>
        </view>
        <text class="contrat__sign-desc">En apposant votre signature, vous validez l'ensemble des 8 articles du bail de location pour « {{ contrat.subtitle }} ».</text>
        <view class="contrat__sign-pad">
          <text class="contrat__sign-holder">{{ contrat.locataire.name }}</text>
          <text class="contrat__sign-sub">{{ contrat.locataire.phone }} · Session certifiée</text>
          <view class="contrat__sign-line"></view>
        </view>
      </view>
      <view class="contrat__sign-actions">
        <view class="sl-btn sl-btn--berry" hover-class="sl-hover" bindtap="onConfirmSign">Confirmer la signature</view>
        <view class="contrat__sign-cancel" hover-class="sl-hover" bindtap="onCloseSign">Annuler</view>
      </view>
    </view>
  </view>

  <view wx:if="{{ toast }}" class="sl-toast">{{ toast }}</view>
</view>
