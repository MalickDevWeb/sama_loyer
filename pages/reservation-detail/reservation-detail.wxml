<app-layout title="Détails de la réservation" showBack="{{true}}" showLogo="{{false}}" transparent="{{true}}" showNavBorder="{{false}}">
  <scroll-view class="reservation-detail" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <reservation-detail-skeleton wx:if="{{ loading }}" />
    <view wx:elif="{{ reservation }}" class="reservation-detail__content">
      <view wx:if="{{ error }}" class="reservation-detail__notice" bindtap="retry">
        <text>{{ localFallback ? 'Détail indisponible. Données locales affichées. Appuyez pour réessayer.' : 'Impossible de charger le détail. Appuyez pour réessayer.' }}</text>
      </view>
      <view wx:if="{{ reservation.package.image }}" class="reservation-detail__image-wrap">
        <osn-image src="{{ reservation.package.image }}" mode="aspectFill" containerStyle="width: 100%; height: 100%; display: block;" imageStyle="width: 100%; height: 100%; border-radius: 24rpx;" />
      </view>
      <view class="reservation-detail__title-row">
        <text class="reservation-detail__title">{{ reservation.package.title || 'Détails de la réservation' }}</text>
        <view class="reservation-detail__status {{ reservation.statusClass }}"><text>{{ reservation.statusLabel }}</text></view>
      </view>
      <view class="reservation-detail__reference">
        <text class="reservation-detail__label">Référence de réservation</text>
        <text class="reservation-detail__reference-value">{{ reservation.bookingRef }}</text>
      </view>
      <view class="reservation-detail__info-card">
        <app-icon icon="localisation" width="{{34}}" height="{{34}}" containerStyle="padding: 0;" />
        <view class="reservation-detail__info-copy"><text class="reservation-detail__label">Destination</text><text class="reservation-detail__value">{{ reservation.package.location || '—' }}</text></view>
      </view>
      <view class="reservation-detail__info-card">
        <app-icon icon="calendrier" width="{{34}}" height="{{34}}" containerStyle="padding: 0;" />
        <view class="reservation-detail__info-copy"><text class="reservation-detail__label">Date du voyage</text><text class="reservation-detail__value">{{ reservation.dateLabel || '—' }}</text></view>
      </view>
      <view class="reservation-detail__info-card">
        <app-icon icon="users" width="{{34}}" height="{{34}}" containerStyle="padding: 0;" />
        <view class="reservation-detail__info-copy"><text class="reservation-detail__label">Nombre de voyageurs</text><text class="reservation-detail__value">{{ reservation.travelersLabel }}</text></view>
      </view>
      <view wx:if="{{ reservation.note }}" class="reservation-detail__note"><text class="reservation-detail__label">Note</text><text class="reservation-detail__value">{{ reservation.note }}</text></view>
      <view class="reservation-detail__total"><text class="reservation-detail__total-label">Montant total</text><text class="reservation-detail__total-value">{{ reservation.totalLabel }}</text></view>
      <view class="reservation-detail__support">
        <text class="reservation-detail__support-title">Besoin d'aide ?</text>
        <view class="reservation-detail__support-button active" bindtap="callSupport"><text class="support-icon">☎</text><text>Appeler le support</text></view>
        <view class="reservation-detail__support-button" bindtap="sendEmail"><text class="support-icon">✉</text><text>Envoyer un email</text></view>
      </view>
      <view wx:if="{{ reservation.isUpcoming }}" class="reservation-detail__actions">
        <view class="reservation-detail__action primary" bindtap="downloadTicket">⇩　Télécharger le billet</view>
        <view class="reservation-detail__action danger" bindtap="cancelReservation">
          {{ isCancelling ? 'Annulation en cours...' : 'Annuler la réservation' }}
        </view>
      </view>
      <view wx:else class="reservation-detail__actions"><view class="reservation-detail__action primary" bindtap="rebook">Réserver à nouveau</view></view>
    </view>
    <view wx:elif="{{ !loading && error }}" class="reservation-detail__empty">
      <text>Réservation introuvable ou détail indisponible.</text>
      <view class="reservation-detail__action primary" bindtap="retry">Réessayer</view>
    </view>
  </scroll-view>
</app-layout>
