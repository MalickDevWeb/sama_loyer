<app-layout
  title="Mes Voyages"
  showBack="{{true}}"
  logoSrc="/assets/images/logo.png"
  showLogo="{{false}}"
  transparent="{{true}}"
  showNavBorder="{{false}}"
  activeTab="{{activeTab}}"
>
  <scroll-view class="content voyages-page" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="voyages-page__header">
      <app-typography size="14" weight="400" color="#7A8094">
        {{ resultsLabel }}
      </app-typography>
    </view>

    <view wx:if="{{ loading }}" class="voyages-page__list">
      <reservation-card-skeleton wx:for="{{ [1, 2, 3, 4] }}" wx:key="*this" />
    </view>

    <view wx:elif="{{ reservations.length }}" class="voyages-page__list">
      <reservation-card
        wx:for="{{ reservations }}"
        wx:key="id"
        wx:for-item="reservation"
        reservation="{{ reservation }}"
        bind:select="openReservationDetails"
      />
    </view>

    <view wx:elif="{{ !loading }}" class="voyages-page__empty">
      <app-typography size="18" weight="600" color="#1C1C1C">
        Aucune réservation pour le moment
      </app-typography>
      <app-typography size="14" color="#7A8094">
        Vos réservations apparaîtront ici après confirmation.
      </app-typography>
    </view>

  </scroll-view>

</app-layout>
