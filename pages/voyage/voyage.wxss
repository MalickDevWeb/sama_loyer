/* ============================================================================
   SAMA LOGEMENT — CONTACT ET MESSAGES (PAGE 4)
   ============================================================================ */

.messages-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #F8F9FA;
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #0F1E3D;
}

.messages-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  padding: 0 36rpx calc(150rpx + env(safe-area-inset-bottom));
}

/* ============================================================================
   1. EN-TÊTE
   ============================================================================ */
.messages-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.header-titles {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: #0F1E3D;
}

.page-subtitle {
  font-size: 26rpx;
  color: #5B6475;
  margin-top: 4rpx;
}

.header-unread-badge {
  background-color: #FBE3EC;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.unread-count {
  font-size: 22rpx;
  font-weight: 800;
  color: #C8235F;
}

/* ============================================================================
   2. FILTRES
   ============================================================================ */
.filters-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.filter-pill {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E4E7EE;
  font-size: 24rpx;
  font-weight: 700;
  color: #5B6475;
}

.filter-pill--active {
  background-color: #0F1E3D;
  border-color: #0F1E3D;
  color: #FFFFFF;
}

/* ============================================================================
   3. LISTE DES CONVERSATIONS
   ============================================================================ */
.conversations-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.conv-card {
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #E4E7EE;
  box-shadow: 0 4rpx 14rpx rgba(15, 30, 61, 0.03);
  transition: transform 0.15s;
}

.conv-card:active {
  transform: scale(0.99);
}

.conv-card--unread {
  border-color: #C8235F;
  background-color: #FFFFFF;
}

.conv-avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 48rpx;
  background-color: #0F1E3D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-letter {
  font-size: 32rpx;
  font-weight: 800;
}

.verified-dot {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background-color: #009B4D;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
}

.conv-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.conv-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.conv-sender-info {
  display: flex;
  flex-direction: column;
}

.conv-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.conv-property-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #C8235F;
  margin-top: 2rpx;
}

.conv-time {
  font-size: 22rpx;
  color: #9CA3AF;
  white-space: nowrap;
}

.conv-snippet {
  font-size: 26rpx;
  color: #5B6475;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 4rpx 0;
}

.conv-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.status-pill {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.status-pill--success {
  background-color: #E2F0EA;
  color: #007C3D;
}

.status-pill--info {
  background-color: #E3E9F5;
  color: #0F1E3D;
}

.conv-price {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.unread-dot {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.scroll-spacer {
  height: 60rpx;
}

/* ============================================================================
   4. MODAL CHAT EN DIRECT
   ============================================================================ */
.chat-modal-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 30, 61, 0.65);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(4px);
}

.chat-sheet {
  width: 100%;
  height: 85vh;
  background-color: #FFFFFF;
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  border-bottom: 2rpx solid #F1F3F6;
}

.chat-header__info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.chat-landlord-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  font-weight: 800;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-landlord-meta {
  display: flex;
  flex-direction: column;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.chat-verified-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #007C3D;
  background-color: #E2F0EA;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.chat-property {
  font-size: 22rpx;
  color: #5B6475;
}

.chat-close {
  font-size: 36rpx;
  color: #7A8294;
  padding: 10rpx;
}

/* Actions rapides */
.chat-quick-actions {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 36rpx;
  background-color: #F8F9FA;
  border-bottom: 2rpx solid #E4E7EE;
}

.quick-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E4E7EE;
  background-color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  color: #0F1E3D;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  margin: 0;
}

.quick-btn.whatsapp {
  border-color: #25D366;
  color: #128C7E;
}

.quick-btn.confirm {
  background-color: #0F1E3D;
  color: #FFFFFF;
  border-color: #0F1E3D;
}

/* Zone des messages */
.chat-messages-area {
  flex: 1;
  padding: 24rpx 36rpx;
  box-sizing: border-box;
  background-color: #FAFAFB;
}

.message-bubble-row {
  display: flex;
  margin-bottom: 20rpx;
}

.row-client {
  justify-content: flex-end;
}

.row-bailleur {
  justify-content: flex-start;
}

.bubble {
  max-width: 75%;
  padding: 18rpx 24rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
}

.bubble-client {
  background-color: #C8235F;
  color: #FFFFFF;
  border-bottom-right-radius: 6rpx;
}

.bubble-bailleur {
  background-color: #FFFFFF;
  color: #0F1E3D;
  border: 2rpx solid #E4E7EE;
  border-bottom-left-radius: 6rpx;
}

.bubble-text {
  font-size: 26rpx;
  line-height: 1.4;
}

.bubble-time {
  font-size: 18rpx;
  margin-top: 8rpx;
  align-self: flex-end;
  opacity: 0.7;
}

/* Barre de saisie */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 2rpx solid #E4E7EE;
}

.chat-input-field {
  flex: 1;
  height: 84rpx;
  background-color: #F1F3F6;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #0F1E3D;
}

.btn-send-message {
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}
