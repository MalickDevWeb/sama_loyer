@import "../shared-tab-page.wxss";

.explorer-page__hero {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-bottom: 1.66rpx solid #f3f4f6;
}

.explorer-page__search {
  width: 100%;
  padding-bottom: 24rpx;
}

.explorer-page__filters {
  width: 100%;
  padding-bottom: 26rpx;
}

.explorer-page__results {
  padding: 32rpx 0;
  flex: 0 0 auto;
}

.destination-list {
  padding: 0;
}

.explorer-page__list-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.explorer-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  text-align: center;
  color: #7a8094;
}

.explorer-page {
  width: auto;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: transparent !important;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  overflow: visible;
}

.destination-list-head {
  padding-right: 0;
  padding-left: 0;
}
