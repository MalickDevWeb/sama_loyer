<app-layout
  title="Explorer les "
  showBack="{{true}}"
  logoSrc="/assets/images/logo.png"
  showLogo="{{false}}"
  transparent="{{true}}"
  showNavBorder="{{false}}"
  activeTab="{{activeTab}}"
>
  <view class="content explorer-page">
    <view class="explorer-page__hero">
      <view class="explorer-page__search px-3 pt-4">
          <app-input
            containerClass="explore-search-input"
            value="{{ query }}"
            placeholder="Rechercher une destination..."
            field-style="font-size: 28rpx;"
            placeholder-style="font-size: 28rpx; color: #9CA3AF;"
            icon="search"
            bind:input="onInput"
            bind:iconTap="onSearch"
            iconPosition="left"
        />
      </view>

      <view class="explorer-page__filters">
        <app-chip-group
          items="{{filters}}"
          activeId="{{activeFilter}}"
          edgeInset="{{0}}"
          bind:change="handleFilterChange"
        />
      </view>
    </view>

    <scroll-view class="explorer-page__list-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="explorer-page__results px-3">
        <app-typography size="14" weight="500" color="#6A7282">
          {{ resultsLabel }}
        </app-typography>
      </view>

      <view wx:if="{{ loading || visibleDestinations.length }}" class="destination-list px-3">
        <app-list-destination
          destinations="{{ visibleDestinations }}"
          loading="{{ loading }}"
          layout="grid"
          columns="2"
          cardWidth="100%"
          imageHeight="287.98rpx"
          cardPaddingClass="p-2"
          cardStyle="height: 559.98rpx !important; border-radius: 32rpx !important; box-shadow:
  0 1px 2px rgba(0, 0, 0, 0.05),
  0 4px 12px rgba(0, 0, 0, 0.08) !important; background-color: #FFFFFF;"
          cardContainerStyle="border-radius: 32rpx !important;"
          imageRadius="32rpx"
          showDetailsButton="{{ false }}"
          bind:toggleLike="handleDestinationLike"
          bind:onCardPress="handleCardPress"
        />
      </view>

      <view wx:elif="{{ loadError }}" class="explorer-page__empty px-3">
        <app-typography size="18" weight="600" color="#1C1C1C">
          Impossible de charger les destinations
        </app-typography>
        <app-typography size="14" color="#01953E" bindtap="retryLoading">Réessayer</app-typography>
      </view>

      <view wx:else class="explorer-page__empty px-3">
        <app-typography size="18" weight="600" color="#1C1C1C">
          Aucune destination trouvée
        </app-typography>
        <app-typography size="14" color="#7A8094">
          Essayez un autre mot-clé ou un autre filtre.
        </app-typography>
      </view>
    </scroll-view>
  </view>
</app-layout>
