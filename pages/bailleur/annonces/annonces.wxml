<view class="annonces-page">
  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <scroll-view class="annonces-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête avec bouton + rose en haut à droite -->
    <view class="annonces-header">
      <view class="header-top-row">
        <view class="header-titles">
          <text class="page-title">Mes annonces</text>
          <text class="page-subtitle">{{ counts.en_ligne }} en ligne · {{ counts.validation }} en validation · {{ counts.loue }} loué(s)</text>
        </view>
        <view class="header-actions-row">
          <view class="btn-top-batch-qr" hover-class="btn-top-add--hover" bindtap="onOpenBatchQr" aria-label="Télécharger les affiches QR">
            <view class="qr-mini-ic"><view></view><view></view><view></view><view></view></view>
            <text class="btn-batch-txt">Affiches QR</text>
          </view>
          <view class="btn-top-add" hover-class="btn-top-add--hover" bindtap="onGoAjouter" aria-label="Ajouter un logement">
            <text class="btn-top-plus">+</text>
          </view>
        </view>
      </view>

      <!-- Filtres Horizontaux -->
      <scroll-view class="pills-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="pills-row">
          <view 
            class="filter-pill {{ activeFilter === 'all' ? 'filter-pill--active' : '' }}"
            data-filter="all"
            bindtap="onFilterSelect"
          >
            Toutes ({{ counts.all }})
          </view>
          <view 
            class="filter-pill {{ activeFilter === 'en_ligne' ? 'filter-pill--active' : '' }}"
            data-filter="en_ligne"
            bindtap="onFilterSelect"
          >
            En ligne ({{ counts.en_ligne }})
          </view>
          <view 
            class="filter-pill {{ activeFilter === 'validation' ? 'filter-pill--active' : '' }}"
            data-filter="validation"
            bindtap="onFilterSelect"
          >
            Validation ({{ counts.validation }})
          </view>
          <view 
            class="filter-pill {{ activeFilter === 'loue' ? 'filter-pill--active' : '' }}"
            data-filter="loue"
            bindtap="onFilterSelect"
          >
            Loué ({{ counts.loue }})
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Liste des cartes annonces -->
    <view class="annonces-list">
      <block wx:for="{{ filteredAnnonces }}" wx:key="id">
        <view class="annonce-card">
          
          <!-- Ligne Haute: Thumbnail à gauche + Infos à droite (Cliquable pour déplier) -->
          <view class="annonce-top-row" data-id="{{ item.id }}" bindtap="onToggleExpand">
            <!-- Thumbnail carrée avec icône maison douce -->
            <view class="annonce-thumb sl-photo" style="background-color: {{ item.thumbBg }}; background-image: url('{{ item.cover }}');">
              <view wx:if="{{ !item.cover }}" class="thumb-house-shape"></view>
            </view>

            <!-- Colonne détails à droite -->
            <view class="annonce-details-col">
              <view class="tag-wrap">
                <text class="badge-tag {{ item.tagClass }}">{{ item.tag }}</text>
              </view>
              <text class="annonce-title">{{ item.title }}</text>
              <view class="annonce-place-price-row">
                <text class="annonce-place-part">{{ item.placeName }}</text>
                <text class="annonce-price-part">{{ item.price }}</text>
              </view>
              <text wx:if="{{ item.stats }}" class="annonce-stats">{{ item.stats }}</text>
            </view>
          </view>

          <!-- Détails et actions visibles seulement après avoir cliqué sur "Voir plus" -->
          <view wx:if="{{ expandedMap[item.id] }}" class="annonce-expanded-body">
            <!-- Notice contextuelle pleine largeur -->
            <view class="notice-box {{ item.noticeClass }}">
              <text class="notice-text">{{ item.notice }}</text>
            </view>

            <!-- Statut confirmé vert plein/centre -->
            <view wx:if="{{ item.isConfirmed }}" class="confirmed-bar">
              <view class="ic ic-check-green ic--sm"></view>
              <text class="confirmed-bar-text">Disponibilité confirmée</text>
            </view>

            <!-- Gros Bouton Vert Reconfirmation 7 jours -->
            <view wx:if="{{ item.needsConfirm }}" class="reconfirm-action-box">
              <button class="btn-reconfirm" data-id="{{ item.id }}" bindtap="onConfirmDispo">
                <view class="ic ic-check-white ic--sm"></view><text>Toujours libre : je confirme</text>
              </button>
            </view>

            <!-- Bouton Corriger pour modération -->
            <view wx:if="{{ item.canCorrect }}" class="correct-action-box">
              <button class="btn-correct" bindtap="onGoAjouter">
                Corriger et renvoyer
              </button>
            </view>

            <!-- Bouton Remettre en ligne si loué -->
            <view wx:if="{{ item.canRelist }}" class="relist-action-box">
              <button class="btn-relist" data-id="{{ item.id }}" bindtap="onRelist">
                Le logement est libre : remettre en ligne
              </button>
            </view>

            <!-- Boutons Modifier / C'est loué pour annonces en ligne -->
            <view wx:if="{{ item.type === 'en_ligne' }}" class="card-bottom-actions">
              <view class="btn-subaction" bindtap="onGoAjouter">
                <view class="ic ic-edit-navy ic--sm"></view>
                <text class="subaction-label">Modifier</text>
              </view>
              <view class="btn-subaction" data-id="{{ item.id }}" bindtap="onMarkLoue">
                <text class="subaction-label">C'est loué</text>
              </view>
            </view>

            <!-- Affiche QR à coller à l'entrée : visites si libre, paiement du loyer si loué -->
            <view wx:if="{{ item.type === 'en_ligne' || item.type === 'loue' }}" class="btn-subaction btn-qr" hover-class="annonce-toggle--hover" data-id="{{ item.id }}" bindtap="onOpenQrAffiche">
              <view class="qr-mini-ic"><view></view><view></view><view></view><view></view></view>
              <text class="subaction-label">Affiche QR à imprimer</text>
            </view>
          </view>

          <!-- Bouton Voir plus / Voir moins -->
          <view class="annonce-toggle" hover-class="annonce-toggle--hover" data-id="{{ item.id }}" catchtap="onToggleExpand" aria-label="{{ expandedMap[item.id] ? 'Voir moins' : 'Voir plus' }}">
            <text class="annonce-toggle-text">{{ expandedMap[item.id] ? 'Voir moins' : 'Voir plus' }}</text>
            <view class="ic ic-chevron-berrydark annonce-toggle-ic {{ expandedMap[item.id] ? 'annonce-toggle-ic--open' : '' }}"></view>
          </view>
        </view>
      </block>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Modale Téléchargement Groupé des Affiches QR -->
  <view wx:if="{{ batchModalOpen }}" class="batch-overlay" catchtouchmove="noop" bindtap="onCloseBatchModal">
    <view class="batch-sheet" catchtap="noop">
      <view class="batch-sheet-handle"></view>
      <view class="batch-header">
        <view class="batch-header-titles">
          <text class="batch-title">Télécharger les affiches QR</text>
          <text class="batch-sub">Sélectionnez par catégorie ou cochez vos logements</text>
        </view>
        <view class="batch-close" hover-class="sl-hover" bindtap="onCloseBatchModal">
          <view class="ic ic-close-navy ic--sm"></view>
        </view>
      </view>
      <view class="batch-filters-row">
        <view class="batch-pill {{ batchFilter === 'all' ? 'batch-pill--active' : '' }}" data-filter="all" bindtap="onBatchFilterSelect">Tous ({{ annonces.length }})</view>
        <view class="batch-pill {{ batchFilter === 'en_ligne' ? 'batch-pill--active' : '' }}" data-filter="en_ligne" bindtap="onBatchFilterSelect">En ligne ({{ counts.en_ligne }})</view>
        <view class="batch-pill {{ batchFilter === 'loue' ? 'batch-pill--active' : '' }}" data-filter="loue" bindtap="onBatchFilterSelect">Loués ({{ counts.loue }})</view>
      </view>
      <view class="batch-toolbar-row">
        <view class="batch-select-all" hover-class="sl-hover" bindtap="onToggleSelectAll">
          <view class="batch-checkbox {{ isAllSelected ? 'batch-checkbox--checked' : '' }}">
            <view wx:if="{{ isAllSelected }}" class="ic ic-check-white ic--xs"></view>
          </view>
          <text class="batch-select-all-txt">Tout sélectionner ({{ visibleBatchAnnonces.length }})</text>
        </view>
        <text class="batch-selected-count">{{ selectedIds.length }} sélectionné(s)</text>
      </view>
      <scroll-view class="batch-list-scroll" scroll-y="{{true}}" enhanced="{{true}}">
        <block wx:for="{{ visibleBatchAnnonces }}" wx:key="id">
          <view class="batch-item-card {{ selectedMap[item.id] ? 'batch-item-card--checked' : '' }}" data-id="{{ item.id }}" bindtap="onToggleItemSelect">
            <view class="batch-checkbox {{ selectedMap[item.id] ? 'batch-checkbox--checked' : '' }}">
              <view wx:if="{{ selectedMap[item.id] }}" class="ic ic-check-white ic--xs"></view>
            </view>
            <image class="batch-thumb" src="{{ item.cover || item.coverImage }}" mode="aspectFill" />
            <view class="batch-item-info">
              <text class="batch-item-title">{{ item.title }}</text>
              <text class="batch-item-place">{{ item.placeName }} · {{ item.price }}</text>
              <view class="batch-item-tag {{ item.type === 'loue' ? 'batch-tag-loue' : 'batch-tag-ligne' }}">
                {{ item.type === 'loue' ? 'Loué · QR paiement' : 'En ligne · QR visite' }}
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="batch-footer">
        <!-- Message explicatif clair sur le mode de téléchargement -->
        <view wx:if="{{ selectedIds.length > 1 }}" class="batch-hint">
          <view class="ic ic-check-green ic--xs"></view>
          <text class="batch-hint-txt">Les {{ selectedIds.length }} affiches A6 seront réunies dans 1 seul fichier ZIP, prêtes à imprimer ou partager.</text>
        </view>
        <view wx:elif="{{ selectedIds.length === 1 }}" class="batch-hint">
          <view class="ic ic-check-green ic--xs"></view>
          <text class="batch-hint-txt">L'affiche A6 sera enregistrée directement dans votre galerie photo en haute résolution.</text>
        </view>
        <view wx:else class="batch-hint batch-hint--muted">
          <text class="batch-hint-txt">Cochez les logements dont vous souhaitez obtenir l'affiche QR.</text>
        </view>

        <!-- Bouton d'action pleine largeur -->
        <view 
          class="batch-download-btn {{ selectedIds.length === 0 ? 'batch-download-btn--disabled' : '' }}" 
          hover-class="{{ selectedIds.length === 0 ? '' : 'sl-hover' }}" 
          bindtap="onDownloadSelectedPosters"
          aria-label="Télécharger les affiches QR"
        >
          <text wx:if="{{ isBatchSaving }}">{{ batchSaveProgressText }}</text>
          <text wx:elif="{{ selectedIds.length === 0 }}">Sélectionnez au moins 1 logement</text>
          <text wx:elif="{{ selectedIds.length === 1 }}">Enregistrer 1 affiche A6 (Galerie)</text>
          <text wx:else>Télécharger {{ selectedIds.length }} affiches (ZIP groupé)</text>
        </view>
      </view>
    </view>
  </view>
  <canvas wx:if="{{ batchCanvasActive }}" id="batch-qa-canvas" type="2d" class="batch-canvas-offscreen" style="width: 620px; height: 877px;"></canvas>
  <!-- Bailleur Tab Bar -->
  <app-custom-tab-bar activeTab="b-annonces" />
</view>
