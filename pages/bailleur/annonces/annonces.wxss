/* ==========================================================================
   Page Mes Annonces Bailleur - SAMA LOYER (Page 12 exact Claude/PDF)
   ========================================================================== */

.annonces-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: var(--sl-bg);
  box-sizing: border-box;
}

.annonces-scroll {
  height: 100%;
  flex: 1;
  box-sizing: border-box;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

/* En-tête */
.annonces-header {
  padding: 14rpx 32rpx 20rpx;
  background-color: var(--sl-white);
  border-bottom: 1rpx solid var(--sl-divider);
}

.header-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.header-titles {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 6rpx;
}

.page-subtitle {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.btn-top-add {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--sl-gradient-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(200, 35, 95, 0.35);
  margin-left: 20rpx;
}

.btn-top-add--hover {
  opacity: 0.8;
  transform: scale(0.94);
}

.btn-top-plus {
  font-size: var(--sl-fs-h2);
  color: var(--sl-on-dark);
  line-height: 1;
  margin-top: -4rpx;
}

/* Horizontal Filter Pills */
.pills-scroll {
  width: 100%;
  white-space: nowrap;
}

.pills-row {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.filter-pill {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-semibold);
  background-color: var(--sl-surface-2);
  color: var(--sl-text);
}

.filter-pill--active {
  background-color: var(--sl-navy);
  color: var(--sl-on-dark);
}

/* Liste des cartes */
.annonces-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.annonce-card {
  background-color: var(--sl-white);
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--sl-divider);
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

/* Ligne Haute: Thumbnail à gauche + Infos à droite */
.annonce-top-row {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 0;
}

.annonce-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.thumb-house-shape {
  width: 60rpx;
  height: 48rpx;
  border: 3.5rpx solid var(--sl-muted);
  border-top: none;
  position: relative;
  opacity: 0.5;
}

.thumb-house-shape::before {
  content: '';
  position: absolute;
  top: -26rpx;
  left: -8rpx;
  border-left: 35rpx solid transparent;
  border-right: 35rpx solid transparent;
  border-bottom: 26rpx solid var(--sl-muted);
}

.annonce-details-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tag-wrap {
  margin-bottom: 4rpx;
}

.badge-tag {
  display: inline-block;
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-bold);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.tag-enligne {
  background-color: var(--sl-success-bg);
  color: var(--sl-green);
}

.tag-validation {
  background-color: var(--sl-warning-bg);
  color: #B56200;
}

.tag-corriger {
  background-color: var(--sl-berry-tint);
  color: var(--sl-berry);
}

.tag-loue {
  background-color: var(--sl-surface-3);
  color: var(--sl-muted);
}

.annonce-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  line-height: 1.35;
  margin: 6rpx 0 4rpx;
}

.annonce-place-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.annonce-place-part {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.annonce-price-part {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.annonce-stats {
  font-size: var(--sl-fs-caption);
  color: #8C96A6;
}

/* Notice box pleine largeur */
.notice-box {
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.notice-gray {
  background-color: var(--sl-bg);
  border: 1rpx solid var(--sl-divider);
}

.notice-yellow {
  background-color: #FFF9ED;
  border: 1rpx solid #F5E8D3;
}

.notice-pink {
  background-color: var(--sl-berry-soft);
  border: 1rpx solid #F8D3DF;
}

.notice-text {
  font-size: var(--sl-fs-small);
  line-height: 1.45;
}

.notice-gray .notice-text {
  color: var(--sl-muted);
}

.notice-yellow .notice-text {
  color: var(--sl-warning);
}

.notice-pink .notice-text {
  color: #A82246;
}

/* Confirmed Bar */
.confirmed-bar {
  width: 100%;
  height: 80rpx;
  border-radius: 18rpx;
  background-color: var(--sl-green-bg);
  color: var(--sl-green);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.check-icon {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
}

.confirmed-bar-text {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
}

/* Big Green Reconfirm Button */
.reconfirm-action-box {
  margin-bottom: 20rpx;
}

.btn-reconfirm {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #0F6038;
  color: var(--sl-on-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  border: none;
  gap: 12rpx;
}

/* Correction button */
.correct-action-box {
  margin-bottom: 12rpx;
}

.btn-correct {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: var(--sl-berry);
  color: var(--sl-on-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  border: none;
}

/* Relist button */
.relist-action-box {
  margin-bottom: 12rpx;
}

.btn-relist {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: var(--sl-white);
  border: 1.5rpx solid #D5DAE1;
  color: var(--sl-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
}

/* Bottom Actions: Modifier | C'est loué */
.card-bottom-actions {
  display: flex;
  gap: 20rpx;
}

.btn-subaction {
  flex: 1;
  height: 80rpx;
  border-radius: 18rpx;
  background-color: var(--sl-white);
  border: 1.5rpx solid var(--sl-border);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.pencil-sub {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-text);
}

.subaction-label {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

/* Expansion container */
.annonce-expanded-body {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
}

/* --- Bouton Voir plus / Voir moins Annonce --- */
.annonce-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0 4rpx;
  margin-top: 18rpx;
  border-top: 1rpx solid var(--sl-surface-3);
}

.annonce-toggle--hover {
  opacity: 0.75;
}

.annonce-toggle-text {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-berry);
}

.annonce-toggle-ic {
  width: 28rpx;
  height: 28rpx;
  transform: rotate(90deg);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.annonce-toggle-ic--open {
  transform: rotate(-90deg);
}

.scroll-spacer {
  height: calc(240rpx + env(safe-area-inset-bottom));
}


.annonces-scroll::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

/* Bouton « Affiche QR à imprimer » */
.btn-qr {
  flex: none;
  width: 100%;
  border-color: var(--sl-berry);
  background-color: var(--sl-berry-tint);
}

.btn-qr .subaction-label {
  color: var(--sl-berry-dark);
}

/* Petit pictogramme QR dessiné en CSS : 3 repères + 1 module */
.qr-mini-ic {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.qr-mini-ic view {
  position: absolute;
  width: 11rpx;
  height: 11rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--sl-berry-dark);
  border-radius: 2rpx;
}

.qr-mini-ic view:nth-child(1) { top: 0; left: 0; }
.qr-mini-ic view:nth-child(2) { top: 0; right: 0; }
.qr-mini-ic view:nth-child(3) { bottom: 0; left: 0; }
.qr-mini-ic view:nth-child(4) { bottom: 2rpx; right: 2rpx; width: 7rpx; height: 7rpx; border: none; background: var(--sl-berry-dark); }

/* --- En-tête : Bouton Téléchargement Groupé Affiches QR --- */
.header-actions-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-top-batch-qr {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: var(--sl-surface-2);
  border: 1.5rpx solid var(--sl-border);
}

.btn-batch-txt {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-navy);
  white-space: nowrap;
}

/* --- Modale Téléchargement Groupé --- */
.batch-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 30, 61, 0.55);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.batch-sheet {
  background: var(--sl-white);
  border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.batch-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--sl-border-strong);
  margin: 0 auto 24rpx;
}

.batch-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.batch-header-titles {
  flex: 1;
  min-width: 0;
}

.batch-title {
  display: block;
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-black);
  color: var(--sl-navy);
}

.batch-sub {
  display: block;
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
  margin-top: 4rpx;
}

.batch-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--sl-surface-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Filtres Catégories */
.batch-filters-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.batch-pill {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  background: var(--sl-surface-2);
  color: var(--sl-muted);
}

.batch-pill--active {
  background: var(--sl-navy);
  color: #FFFFFF;
}

/* Barre de sélection rapide */
.batch-toolbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--sl-divider);
  border-bottom: 1rpx solid var(--sl-divider);
  margin-bottom: 16rpx;
}

.batch-select-all {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.batch-select-all-txt {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-navy);
}

.batch-selected-count {
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
  background: var(--sl-berry-tint);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* Cases à cocher personnalisées */
.batch-checkbox {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--sl-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sl-white);
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.batch-checkbox--checked {
  background: var(--sl-berry);
  border-color: var(--sl-berry);
}

/* Liste des logements */
.batch-list-scroll {
  max-height: 46vh;
  margin-bottom: 24rpx;
}

.batch-item-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--sl-divider);
  margin-bottom: 14rpx;
  transition: all 0.15s ease;
}

.batch-item-card--checked {
  border-color: var(--sl-berry);
  background: var(--sl-berry-soft);
}

.batch-thumb {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 16rpx;
}

.batch-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.batch-item-title {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-navy);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-item-place {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
  margin: 4rpx 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-item-tag {
  align-self: flex-start;
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-extrabold);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.batch-tag-ligne {
  background: #E8F5E9;
  color: #1B5E20;
}

.batch-tag-loue {
  background: var(--sl-info-bg);
  color: var(--sl-navy);
}

/* Bouton télécharger */
.batch-footer {
  padding-top: 8rpx;
}

.batch-download-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--sl-berry);
  color: #FFFFFF;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(200, 35, 95, 0.35);
}

.batch-download-btn--disabled {
  background: var(--sl-surface-3);
  color: var(--sl-placeholder);
  box-shadow: none;
}

/* Canvas hors-écran */
.batch-canvas-offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
  visibility: hidden;
  pointer-events: none;
}
