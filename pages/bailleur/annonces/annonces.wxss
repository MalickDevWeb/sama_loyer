/* ==========================================================================
   Page Mes Annonces Bailleur - SAMA LOYER (Page 12 exact Claude/PDF)
   ========================================================================== */

.annonces-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: #F8F9FA;
  box-sizing: border-box;
}

.annonces-scroll {
  height: 100%;
  flex: 1;
  box-sizing: border-box;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

/* En-tête */
.annonces-header {
  padding: 0 32rpx 20rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #ECEFF2;
}

.header-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.header-titles {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 6rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #5B6475;
}

.btn-top-add {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #E6007A 0%, #C8235F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(200, 35, 95, 0.35);
  margin-left: 20rpx;
}

.btn-top-add--hover {
  opacity: 0.8;
  transform: scale(0.94);
}

.btn-top-plus {
  font-size: 44rpx;
  color: #FFFFFF;
  line-height: 1;
  margin-top: -4rpx;
}

/* Horizontal Filter Pills */
.pills-scroll {
  width: 100%;
  white-space: nowrap;
}

.pills-row {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.filter-pill {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  background-color: #F4F6F9;
  color: #0F1E3D;
}

.filter-pill--active {
  background-color: #0F1E3D;
  color: #FFFFFF;
}

/* Liste des cartes */
.annonces-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.annonce-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

/* Ligne Haute: Thumbnail à gauche + Infos à droite */
.annonce-top-row {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 0;
}

.annonce-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.thumb-house-shape {
  width: 60rpx;
  height: 48rpx;
  border: 3.5rpx solid #5B6475;
  border-top: none;
  position: relative;
  opacity: 0.5;
}

.thumb-house-shape::before {
  content: '';
  position: absolute;
  top: -26rpx;
  left: -8rpx;
  border-left: 35rpx solid transparent;
  border-right: 35rpx solid transparent;
  border-bottom: 26rpx solid #5B6475;
}

.annonce-details-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tag-wrap {
  margin-bottom: 4rpx;
}

.badge-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.tag-enligne {
  background-color: #E2F0EA;
  color: #007C3D;
}

.tag-validation {
  background-color: #FFF3DC;
  color: #B56200;
}

.tag-corriger {
  background-color: #FDE8EE;
  color: #C8235F;
}

.tag-loue {
  background-color: #F0F2F5;
  color: #5B6475;
}

.annonce-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
  line-height: 1.35;
  margin: 6rpx 0 4rpx;
}

.annonce-place-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.annonce-place-part {
  font-size: 24rpx;
  color: #5B6475;
}

.annonce-price-part {
  font-size: 24rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.annonce-stats {
  font-size: 22rpx;
  color: #8C96A6;
}

/* Notice box pleine largeur */
.notice-box {
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.notice-gray {
  background-color: #F8F9FA;
  border: 1rpx solid #ECEFF2;
}

.notice-yellow {
  background-color: #FFF9ED;
  border: 1rpx solid #F5E8D3;
}

.notice-pink {
  background-color: #FDF2F5;
  border: 1rpx solid #F8D3DF;
}

.notice-text {
  font-size: 24rpx;
  line-height: 1.45;
}

.notice-gray .notice-text {
  color: #5B6475;
}

.notice-yellow .notice-text {
  color: #8A5A00;
}

.notice-pink .notice-text {
  color: #A82246;
}

/* Confirmed Bar */
.confirmed-bar {
  width: 100%;
  height: 80rpx;
  border-radius: 18rpx;
  background-color: #EAF7EE;
  color: #007C3D;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.check-icon {
  font-size: 26rpx;
  font-weight: 800;
}

.confirmed-bar-text {
  font-size: 26rpx;
  font-weight: 700;
}

/* Big Green Reconfirm Button */
.reconfirm-action-box {
  margin-bottom: 20rpx;
}

.btn-reconfirm {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #0F6038;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  gap: 12rpx;
}

/* Correction button */
.correct-action-box {
  margin-bottom: 12rpx;
}

.btn-correct {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

/* Relist button */
.relist-action-box {
  margin-bottom: 12rpx;
}

.btn-relist {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  border: 1.5rpx solid #D5DAE1;
  color: #0F1E3D;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

/* Bottom Actions: Modifier | C'est loué */
.card-bottom-actions {
  display: flex;
  gap: 20rpx;
}

.btn-subaction {
  flex: 1;
  height: 80rpx;
  border-radius: 18rpx;
  background-color: #FFFFFF;
  border: 1.5rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.pencil-sub {
  font-size: 26rpx;
  color: #0F1E3D;
}

.subaction-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F1E3D;
}

/* Expansion container */
.annonce-expanded-body {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
}

/* --- Bouton Voir plus / Voir moins Annonce --- */
.annonce-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0 4rpx;
  margin-top: 18rpx;
  border-top: 1rpx solid #F0F2F6;
}

.annonce-toggle--hover {
  opacity: 0.75;
}

.annonce-toggle-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #C8235F;
}

.annonce-toggle-ic {
  width: 28rpx;
  height: 28rpx;
  transform: rotate(90deg);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.annonce-toggle-ic--open {
  transform: rotate(-90deg);
}

.scroll-spacer {
  height: 180rpx;
}


.annonces-scroll::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}
