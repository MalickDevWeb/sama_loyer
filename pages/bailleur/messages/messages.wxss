@import "/styles/sama-ui.wxss";

.bmsg__header {
  padding-top: 14rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.bmsg__title {
  display: block;
  font-size: var(--sl-fs-h1);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.02em;
}

.bmsg__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: var(--sl-fs-body);
  color: var(--sl-muted);
}

/* --- Conversations / Demandes de visite ---------------------------------- */
.bmsg__segmented {
  margin: 32rpx 40rpx 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 32rpx;
  background: #E9ECF1;
}

.bmsg__segment {
  height: 84rpx;
  border-radius: 24rpx;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.bmsg__segment--on {
  background: var(--sl-white);
  color: var(--sl-text);
  box-shadow: 0 2rpx 8rpx rgba(15, 30, 61, 0.12);
}

.bmsg__count {
  min-width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-caption);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* --- Filtres ------------------------------------------------------------- */
.bmsg__filters {
  padding: 28rpx 40rpx 0;
  display: flex;
  gap: 16rpx;
}

.bmsg__pill {
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  display: flex;
  align-items: center;
  background: var(--sl-white);
  color: var(--sl-text);
  border: 2rpx solid var(--sl-border);
}

.bmsg__pill--on {
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  border-color: var(--sl-navy);
}

/* --- Liste --------------------------------------------------------------- */
.bmsg__list {
  padding: 20rpx 24rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.bmsg__conv {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 16rpx;
  border-bottom: 2rpx solid var(--sl-divider);
}

.bmsg__conv--hover {
  background: var(--sl-surface-2);
}

.bmsg__avatar {
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
  border-radius: 50rpx;
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bmsg__conv-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bmsg__conv-top,
.bmsg__conv-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bmsg__name {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-bold);
}

.bmsg__name--unread {
  font-weight: var(--sl-fw-extrabold);
}

.bmsg__time {
  flex: 0 0 auto;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-medium);
  color: var(--sl-muted);
}

.bmsg__time--unread {
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.bmsg__tag {
  align-self: flex-start;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.bmsg__tag--cand {
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
}

.bmsg__tag--loc {
  background: var(--sl-success-bg);
  color: var(--sl-success-text);
}

.bmsg__last {
  flex: 1;
  min-width: 0;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bmsg__last--unread {
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.bmsg__unread {
  flex: 0 0 auto;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bmsg__tab-spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* Vue simplifiée : nom à gauche, statut (+ non lus) à droite */
.bmsg__conv {
  align-items: center;
}

.bmsg__conv-body--simple {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bmsg__conv-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 0 0 auto;
}
