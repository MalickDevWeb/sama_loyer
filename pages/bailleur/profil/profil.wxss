@import "/styles/icons.wxss";

/* ==========================================================================
   Onglet Profil Bailleur - SAMA LOYER
   ========================================================================== */

.bprof {
  overflow: hidden;
  height: 100vh;
  background-color: var(--sl-surface-2);
  color: var(--sl-text);
  display: flex;
  flex-direction: column;
}

.bprof__scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.bprof__header {
  padding-top: 14rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 16rpx;
}

.bprof__title {
  font-size: var(--sl-fs-h1);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.02em;
  color: var(--sl-text);
}

.bprof__section {
  padding: 16rpx 32rpx 0;
}

.bprof__section-title {
  display: block;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: 0.08em;
  color: var(--sl-placeholder);
  text-transform: uppercase;
  margin: 16rpx 0 14rpx 12rpx;
}

.bprof__card {
  background-color: var(--sl-white);
  border-radius: 32rpx;
  border: 1rpx solid var(--sl-divider);
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

.bprof__card--hover {
  opacity: 0.88;
}

.bprof__chevron {
  width: 32rpx;
  height: 32rpx;
}

/* --- Identité ------------------------------------------------------------ */
.bprof__identity {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.bprof__avatar {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 50%;
  background: var(--sl-gradient-brand);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-title-lg);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(200, 35, 95, 0.25);
}

.bprof__identity-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bprof__name {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.bprof__phone {
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
  font-weight: var(--sl-fw-semibold);
}

.bprof__badge {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background-color: var(--sl-green-bg);
  color: var(--sl-green);
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.bprof__badge--verified {
  background-color: #E6F6ED;
  color: #007C3D;
}

.bprof__badge--pending {
  background-color: #FFF3E0;
  color: #D97706;
}

.bprof__badge--unverified {
  background-color: #F1F3F9;
  color: #64748B;
}

/* --- Section KYC & Modération -------------------------------------------- */
.bprof__section-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 12rpx 14rpx;
}

.bprof__section-head-row .bprof__section-title {
  margin: 0;
}

.bprof__demo-tag {
  font-size: 20rpx;
  font-weight: var(--sl-fw-bold);
  color: var(--sl-primary);
  background: rgba(241, 110, 0, 0.1);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.bprof__kyc {
  padding: 28rpx 32rpx;
}

.bprof__kyc-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.bprof__kyc-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
}

.bprof__kyc-icon--warn {
  background: #FEF2F2;
}

.bprof__kyc-icon--pending {
  background: #FFF7ED;
}

.bprof__kyc-icon--success {
  background: #ECFDF5;
}

.bprof__kyc-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bprof__kyc-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.bprof__kyc-desc {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
  line-height: 1.45;
}

.bprof__kyc-action-btn {
  margin-top: 24rpx;
  background: var(--sl-gradient-brand, #F16E00);
  color: #FFFFFF;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  box-shadow: 0 4rpx 14rpx rgba(241, 110, 0, 0.25);
}

.bprof__kyc-status-bar {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.bprof__kyc-status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D97706;
}

.bprof__kyc-status-text {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-semibold);
  color: #B45309;
}

.bprof__kyc-verified-row {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--sl-divider);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bprof__kyc-verified-label {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
  font-weight: var(--sl-fw-medium);
}

.bprof__kyc-reupload {
  font-size: var(--sl-fs-caption);
  color: var(--sl-primary);
  font-weight: var(--sl-fw-bold);
}

.bprof__badge-check {
  font-weight: var(--sl-fw-black);
}

.bprof__kyc-action-btn--off {
  opacity: 0.5;
  box-shadow: none;
}

.bprof__kyc-missing {
  display: block;
  margin-top: 20rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-semibold);
  color: #B45309;
  text-align: center;
}

.bprof__kyc-cancel {
  display: block;
  margin-top: 18rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-muted);
  text-align: center;
}

/* --- Pièces exigées (liste pilotée par le back office) -------------------- */
.bprof__docs {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bprof__doc-empty {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
}

.bprof__doc {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--sl-divider);
  border-radius: 18rpx;
}

.bprof__doc--done {
  border-color: #A7F3D0;
  background: #F0FDF4;
}

.bprof__doc-state {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--sl-divider);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bprof__doc--done .bprof__doc-state {
  border: none;
  background: #DCFCE7;
}

.bprof__doc-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bprof__doc-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.bprof__doc-title {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.bprof__doc-tag {
  font-size: 20rpx;
  font-weight: var(--sl-fw-bold);
  color: var(--sl-muted);
  background: #F3F4F6;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.bprof__doc-tag--req {
  color: #B91C1C;
  background: #FEF2F2;
}

.bprof__doc-hint {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
  line-height: 1.4;
}

.bprof__doc-file {
  font-size: var(--sl-fs-caption);
  color: #047857;
  font-weight: var(--sl-fw-semibold);
  text-decoration: underline;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bprof__doc-btn {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  border-radius: 14rpx;
  background: var(--sl-berry);
  color: #FFFFFF;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
}

.bprof__doc-btn--ghost {
  background: transparent;
  color: var(--sl-muted);
  border: 1rpx solid var(--sl-divider);
}

/* --- Résumé stats bailleur ------------------------------------------------ */
.bprof__stats {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.bprof__stat {
  flex: 1;
  background-color: var(--sl-white);
  border-radius: 24rpx;
  border: 1rpx solid var(--sl-divider);
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(15, 30, 61, 0.03);
  transition: transform 0.15s ease;
}

.bprof__stat-num {
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.bprof__stat-label {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
  font-weight: var(--sl-fw-bold);
  margin-top: 4rpx;
}

/* --- Abonnement ---------------------------------------------------------- */
.bprof__sub {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  background: var(--sl-white);
  border: 1.5rpx solid #F5D3DE;
}

.bprof__sub-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bprof__sub-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: var(--sl-berry-soft);
  border-radius: 999rpx;
}

.bprof__sub-star {
  color: var(--sl-berry);
  font-size: var(--sl-fs-body-sm);
}

.bprof__sub-plan {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

.bprof__sub-status {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background-color: var(--sl-green-bg);
  color: var(--sl-green);
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
}

.bprof__sub-status--off {
  background-color: var(--sl-berry-tint);
  color: var(--sl-berry);
}

.bprof__sub-validity {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-top: 4rpx;
}

.bprof__sub-note {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
  margin-top: 4rpx;
  margin-bottom: 16rpx;
}

.bprof__sub-perks {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--sl-surface-3);
  border-bottom: 1rpx solid var(--sl-surface-3);
}

.bprof__perk-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bprof__perk-check {
  color: var(--sl-green);
  font-weight: var(--sl-fw-extrabold);
  font-size: var(--sl-fs-small);
}

.bprof__perk-text {
  font-size: var(--sl-fs-small);
  color: #4A5B78;
  font-weight: var(--sl-fw-semibold);
}

.bprof__sub-cta {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bprof__sub-cta-label {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-berry);
}

/* --- Bouton Changer de profil (Bailleur -> Locataire) -------------------- */
.bprof__switch-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 36rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  box-shadow: 0 8rpx 24rpx rgba(15, 30, 61, 0.12);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.bprof__switch-profile--hover {
  transform: scale(0.985);
  opacity: 0.92;
}

.bprof__switch-profile-ic {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FF6600 0%, #E6007A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(255, 102, 0, 0.35);
}

.bprof__switch-emoji {
  font-size: var(--sl-fs-title-lg);
  line-height: 1;
}

.bprof__switch-profile-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bprof__switch-profile-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  letter-spacing: -0.01em;
  color: var(--sl-on-dark);
}

.bprof__switch-profile-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-border-strong);
  margin-top: 4rpx;
}

.bprof__switch-profile-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1.5rpx solid rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-on-dark);
}

.bprof__switch-chevron {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-bold);
  color: #FF7900;
  line-height: 1;
}

/* --- Paramètres du compte & Listes --------------------------------------- */
.bprof__list {
  padding: 0 28rpx;
}

.bprof__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--sl-surface-3);
}

.bprof__row:last-child {
  border-bottom: 0;
}

.bprof__row--hover {
  opacity: 0.7;
}

.bprof__row-label {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.bprof__row-sub {
  font-size: var(--sl-fs-caption);
  color: var(--sl-placeholder);
  margin-top: 4rpx;
}

.bprof__row-value {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
  text-align: right;
}

.bprof__row-col {
  display: flex;
  flex-direction: column;
}

.bprof__row-with-ic {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.bprof__row-ic {
  width: 40rpx;
  height: 40rpx;
}

.bprof__pill-green {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background-color: var(--sl-green-bg);
  color: var(--sl-green);
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
}

.bprof__pill-green-dot {
  font-size: var(--sl-fs-body-sm);
  line-height: 1;
}

/* --- Footer Version ------------------------------------------------------ */
.bprof__section--last {
  padding-bottom: 20rpx;
  text-align: center;
}

.bprof__version {
  font-size: var(--sl-fs-caption);
  color: #8C96A8;
}

.bprof__tab-spacer {
  height: calc(220rpx + env(safe-area-inset-bottom));
  padding-bottom: 40rpx;
}

/* ==========================================================================
   Modals Bottom Sheet (Aide, Sécurité, Support)
   ========================================================================== */
.bprof__sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 30, 61, 0.55);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease;
}

.bprof__sheet {
  width: 100%;
  max-height: 85vh;
  background: var(--sl-white);
  border-radius: 44rpx 44rpx 0 0;
  padding: 20rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.bprof__sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--sl-border);
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.bprof__sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.bprof__sheet-heading {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bprof__sheet-title {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.bprof__sheet-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.bprof__sheet-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--sl-surface-3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bprof__sheet-close-ic {
  width: 28rpx;
  height: 28rpx;
}

.bprof__sheet-body {
  overflow-y: auto;
  max-height: 55vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 8rpx 0 24rpx;
}

/* FAQ Items */
.bprof__faq-item {
  background: var(--sl-bg);
  border: 1rpx solid var(--sl-divider);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bprof__faq-q {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.bprof__faq-a {
  font-size: var(--sl-fs-small);
  color: #4A5B78;
  line-height: 1.45;
}

/* Security Cards */
.bprof__sec-card {
  background: var(--sl-bg);
  border: 1rpx solid var(--sl-divider);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.bprof__sec-ic {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.bprof__sec-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bprof__sec-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.bprof__sec-desc {
  font-size: var(--sl-fs-small);
  color: #4A5B78;
  line-height: 1.45;
}

/* Support Options */
.bprof__support-opt {
  background: var(--sl-bg);
  border: 1rpx solid var(--sl-divider);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.bprof__support-opt-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bprof__support-opt-ic--berry {
  background: var(--sl-berry-tint);
}

.bprof__support-opt-ic--green {
  background: var(--sl-green-bg);
}

.bprof__support-opt-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bprof__support-opt-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.bprof__support-opt-sub {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
}

/* Sheet Footer Buttons */
.bprof__sheet-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
}

.bprof__btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--sl-berry);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.bprof__btn-secondary {
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--sl-surface-3);
  color: var(--sl-text);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.bprof__scroll::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

/* Libellé de ligne sur une seule ligne, pastille compacte */
.bprof__row-label--nowrap {
  white-space: nowrap;
}

.bprof__pill-green {
  flex-shrink: 0;
  white-space: nowrap;
}

/* --- Sélecteur de source de document (Couleurs SAMA LOYER) --- */
.bprof__src-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--sl-white);
  border: 2rpx solid var(--sl-border);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.bprof__src-card--hover {
  background: var(--sl-surface-2);
  border-color: var(--sl-border-strong);
  transform: translateY(-2rpx);
}

.bprof__src-icon {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bprof__src-icon--orange {
  background: linear-gradient(135deg, #FF6600 0%, #E6007A 100%);
  box-shadow: 0 6rpx 18rpx rgba(255, 102, 0, 0.32);
}

.bprof__src-icon--navy {
  background: linear-gradient(135deg, #0F1E3D 0%, #1A3668 100%);
  box-shadow: 0 6rpx 18rpx rgba(15, 30, 61, 0.28);
}

.bprof__src-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bprof__src-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-navy);
  margin-bottom: 6rpx;
}

.bprof__src-desc {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
  line-height: 1.35;
}

.bprof__src-arrow {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  opacity: 0.5;
}

/* --- Popup Succès KYC (Centrée, Design SAMA LOYER) --- */
.bprof__popup {
  position: relative;
  width: 620rpx;
  max-width: 90vw;
  margin: auto;
  background: var(--sl-white);
  border-radius: 40rpx;
  padding: 48rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(15, 30, 61, 0.22);
  animation: bprofPopupZoom 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes bprofPopupZoom {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.bprof__popup-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #007C3D 0%, #11643F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 124, 61, 0.35);
}

.bprof__popup-badge-ic {
  width: 56rpx;
  height: 56rpx;
}

.bprof__popup-title {
  font-size: var(--sl-fs-title);
  font-weight: var(--sl-fw-black);
  color: var(--sl-navy);
  margin-bottom: 12rpx;
}

.bprof__popup-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  background: #FFF4E5;
  border: 1.5rpx solid #FFD8A8;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}

.bprof__popup-dot {
  color: #E08A00;
  width: 14rpx;
  height: 14rpx;
}

.bprof__popup-tag-txt {
  font-size: var(--sl-fs-micro);
  font-weight: var(--sl-fw-extrabold);
  color: #8A5A00;
  letter-spacing: 0.5rpx;
  text-transform: uppercase;
}

.bprof__popup-desc {
  font-size: var(--sl-fs-caption);
  color: var(--sl-text-2);
  line-height: 1.5;
  margin-bottom: 36rpx;
  padding: 0 10rpx;
}

.bprof__popup-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--sl-berry);
  color: #FFFFFF;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(200, 35, 95, 0.32);
}
