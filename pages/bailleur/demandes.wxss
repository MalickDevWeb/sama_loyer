/* ==========================================================================
   Page Demandes Bailleur - SAMA LOGEMENT (Page 13 exact Claude/PDF)
   ========================================================================== */

.demandes-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F8F9FA;
  box-sizing: border-box;
}

.demandes-scroll {
  flex: 1;
  box-sizing: border-box;
}

/* En-tête */
.demandes-header {
  padding: 0 32rpx 20rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #ECEFF2;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 6rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #5B6475;
  margin-bottom: 24rpx;
}

/* Tabs Pilule */
.tabs-outer-pill {
  display: flex;
  background-color: #EAEEF4;
  border-radius: 24rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #5B6475;
  transition: all 0.2s ease;
}

.tab-item--active {
  background-color: #FFFFFF;
  color: #0F1E3D;
  box-shadow: 0 4rpx 14rpx rgba(15, 30, 61, 0.08);
}

/* Demandes list */
.demandes-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.demande-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

.demande-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.demande-user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-circle-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-sm-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.user-text-col {
  display: flex;
  flex-direction: column;
}

.demande-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 2rpx;
}

.demande-prop {
  font-size: 24rpx;
  color: #5B6475;
}

/* Badges */
.status-badge-demande {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

.badge-yellow {
  background-color: #FFF3DC;
  color: #965700;
}

.badge-green {
  background-color: #EAF7EE;
  color: #007C3D;
}

/* Slot box */
.demande-slot-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background-color: #F4F6F9;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
}

.cal-emoji {
  font-size: 28rpx;
}

.slot-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F1E3D;
}

/* Message quote */
.quote-wrap {
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.demande-quote-text {
  display: block;
  font-size: 26rpx;
  color: #333F53;
  line-height: 1.45;
}

/* Notice box SMS */
.accepted-notice-box {
  background-color: #EAF7EE;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-top: 6rpx;
}

.notice-sms-text {
  font-size: 24rpx;
  color: #007C3D;
  line-height: 1.4;
  font-weight: 500;
}

/* Action buttons */
.action-buttons-group {
  margin-top: 20rpx;
}

.buttons-pair-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.btn-refuser {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  border: 1.5rpx solid #E2E8F0;
  color: #A82246;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-accepter {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #0F6038;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.propose-horaire-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 0 4rpx;
}

.chat-bubble-icon {
  font-size: 26rpx;
  color: #5B6475;
}

.propose-text {
  font-size: 25rpx;
  font-weight: 600;
  color: #5B6475;
}

.scroll-spacer {
  height: 180rpx;
}
