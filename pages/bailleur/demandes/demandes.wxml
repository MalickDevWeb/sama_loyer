<view class="demandes-page">
  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <scroll-view class="demandes-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête -->
    <view class="demandes-header">
      <text class="page-title">Demandes</text>
      <text class="page-subtitle">Visites et messages des locataires</text>

      <!-- Accès aux horaires de visite -->
      <view class="horaires-link" hover-class="horaires-link--hover" bindtap="onOpenHoraires">
        <view class="ic ic-clock-berry horaires-link__icon"></view>
        <view class="horaires-link__text">
          <text class="horaires-link__title">Mes horaires de visite</text>
          <text class="horaires-link__sub">12 créneaux par semaine · modifier</text>
        </view>
        <view class="ic ic-chevron-grey horaires-link__chev"></view>
      </view>

      <!-- Tabs Pilule : Visites (1) | Messages (2) | Clients (2) -->
      <view class="tabs-outer-pill">
        <view 
          class="tab-item {{ activeTab === 'visites' ? 'tab-item--active' : '' }}"
          data-tab="visites"
          bindtap="onSelectTab"
        >
          Visites (1)
        </view>
        <view 
          class="tab-item {{ activeTab === 'messages' ? 'tab-item--active' : '' }}"
          data-tab="messages"
          bindtap="onSelectTab"
        >
          Messages (2)
        </view>
        <view 
          class="tab-item {{ activeTab === 'locataires' ? 'tab-item--active' : '' }}"
          data-tab="locataires"
          bindtap="onSelectTab"
        >
          Clients (2)
        </view>
      </view>
    </view>

    <!-- VUE 1 : VISITES -->
    <view wx:if="{{ activeTab === 'visites' }}" class="demandes-list">
      <block wx:for="{{ demandes }}" wx:key="id">
        <view class="demande-card">
          <!-- En-tête de la carte : Avatar, Nom, Logement & Badge statut -->
          <view class="demande-card-top" data-id="{{ item.id }}" bindtap="onToggleExpand">
            <view class="demande-user-info">
              <view class="avatar-circle-sm" style="background-color: {{ item.avatarBg }};">
                <text class="avatar-sm-text">{{ item.initials }}</text>
              </view>
              <view class="user-text-col">
                <text class="demande-name">{{ item.name }}</text>
                <text class="demande-prop">{{ item.property }}</text>
              </view>
            </view>
            <view class="status-badge-demande {{ item.status === 'pending' ? 'badge-yellow' : 'badge-green' }}">
              {{ item.statusLabel }}
            </view>
          </view>

          <!-- Boîte du créneau horaire -->
          <view class="demande-slot-box" data-id="{{ item.id }}" bindtap="onToggleExpand">
            <view class="ic ic-cal-navy ic--sm"></view>
            <text class="slot-text">{{ item.dateLabel }}</text>
          </view>

          <!-- Détails et actions visibles seulement après avoir cliqué sur "Voir plus" -->
          <view wx:if="{{ expandedMap[item.id] }}" class="demande-expanded-body">
            <!-- Citation / message du locataire -->
            <view wx:if="{{ item.message }}" class="quote-wrap">
              <text class="demande-quote-text">{{ item.message }}</text>
            </view>

            <!-- Encadré vert de visite acceptée -->
            <view wx:if="{{ item.notice }}" class="accepted-notice-box">
              <text class="notice-sms-text">{{ item.notice }}</text>
            </view>

            <!-- Boutons Accepter / Refuser (uniquement si en attente) -->
            <view wx:if="{{ item.isPending }}" class="action-buttons-group">
              <view class="buttons-pair-row">
                <button class="btn-refuser" data-id="{{ item.id }}" bindtap="onRefuse">
                  Refuser
                </button>
                <button class="btn-accepter" data-id="{{ item.id }}" bindtap="onAccept">
                  Accepter
                </button>
              </view>

              <!-- Lien Proposer un autre horaire par message -->
              <view class="propose-horaire-link" bindtap="onProposeHoraire">
                <view class="ic ic-chat-muted ic--sm"></view>
                <text class="propose-text">Proposer un autre horaire par message</text>
              </view>
            </view>
          </view>

          <!-- Bouton Voir plus / Voir moins -->
          <view class="demande-toggle" hover-class="demande-toggle--hover" data-id="{{ item.id }}" catchtap="onToggleExpand" aria-label="{{ expandedMap[item.id] ? 'Voir moins' : 'Voir plus' }}">
            <text class="demande-toggle-text">{{ expandedMap[item.id] ? 'Voir moins' : 'Voir plus' }}</text>
            <view class="ic ic-chevron-berrydark demande-toggle-ic {{ expandedMap[item.id] ? 'demande-toggle-ic--open' : '' }}"></view>
          </view>
        </view>
      </block>
    </view>

    <!-- VUE 2 : MESSAGES AVEC LES CLIENTS / LOCATAIRES -->
    <view wx:elif="{{ activeTab === 'messages' }}" class="demandes-list">
      <block wx:for="{{ messagesList }}" wx:key="id">
        <view class="demande-card message-item-card" data-id="{{ item.id }}" data-name="{{ item.name }}" bindtap="onOpenChat">
          <view class="demande-card-top">
            <view class="demande-user-info">
              <view class="avatar-circle-sm" style="background-color: {{ item.avatarBg }};">
                <text class="avatar-sm-text">{{ item.initials }}</text>
              </view>
              <view class="user-text-col">
                <text class="demande-name">{{ item.name }}</text>
                <text class="demande-prop">{{ item.property }}</text>
              </view>
            </view>
            <text class="msg-time">{{ item.time }}</text>
          </view>

          <view class="msg-last-row">
            <text class="msg-preview-text">{{ item.lastMessage }}</text>
            <view wx:if="{{ item.unread > 0 }}" class="msg-unread-badge">{{ item.unread }}</view>
          </view>

          <view class="msg-event-pill">
            <view class="ic-row"><view class="ic ic-cal-navy ic--xs"></view><text>{{ item.event }}</text></view>
          </view>
        </view>
      </block>
    </view>

    <!-- VUE 3 : MES CLIENTS / LOCATAIRES ACTIFS -->
    <view wx:elif="{{ activeTab === 'locataires' }}" class="demandes-list">
      <block wx:for="{{ locataires }}" wx:key="id">
        <view class="demande-card">
          <view class="demande-card-top">
            <view class="demande-user-info">
              <view class="avatar-circle-sm" style="background-color: {{ item.avatarBg }};">
                <text class="avatar-sm-text">{{ item.initials }}</text>
              </view>
              <view class="user-text-col">
                <text class="demande-name">{{ item.name }}</text>
                <text class="demande-prop">{{ item.property }} · {{ item.rent }}</text>
              </view>
            </view>
            <view class="status-badge-demande {{ item.statusClass }}">
              {{ item.statusLabel }}
            </view>
          </view>

          <view class="client-detail-notice">
            <text class="notice-sms-text">{{ item.paymentDetail }} · Tel : {{ item.phone }}</text>
          </view>

          <!-- Boutons directs d'appel et de message -->
          <view class="buttons-pair-row" style="margin-top: 20rpx;">
            <button class="btn-refuser" data-phone="{{ item.phoneRaw }}" bindtap="onCallClient">
              <view class="ic-row"><view class="ic ic-phone-berry ic--sm"></view><text>Appeler</text></view>
            </button>
            <button class="btn-accepter" data-name="{{ item.name }}" data-phone="{{ item.phone }}" bindtap="onWhatsAppClient">
              <view class="ic-row"><view class="ic ic-whatsapp-white ic--sm"></view><text>WhatsApp</text></view>
            </button>
          </view>
        </view>
      </block>

      <!-- Bouton d'accès à la gestion complète -->
      <view class="see-all-clients-wrap">
        <button class="btn-see-all-clients" bindtap="onGoClientsPage">
          <view class="ic-row"><text>Gérer tous mes locataires & quittances</text><view class="ic ic-chevron-navy ic--sm"></view></view>
        </button>
      </view>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Bailleur Tab Bar -->
  <app-custom-tab-bar activeTab="b-messages" />
</view>
