@import "/styles/sama-ui.wxss";

page {
  background: var(--sl-surface-2);
}

.hor__body {
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.hor__intro {
  display: block;
  margin: 32rpx 8rpx 24rpx;
  font-size: var(--sl-fs-body);
  line-height: 1.5;
  color: var(--sl-text-2);
}

.hor__label {
  display: block;
  margin: 0 8rpx 16rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
}

.hor__muted {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

/* --- Choix du logement --------------------------------------------------- */
.hor__homes {
  margin: 0 -32rpx;
  width: calc(100% + 64rpx);
  white-space: nowrap;
}

.hor__homes-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 32rpx 8rpx;
}

.hor__home {
  flex: 0 0 auto;
  height: 84rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  background: var(--sl-white);
  color: var(--sl-text);
  border: 2rpx solid var(--sl-border);
  box-sizing: border-box;
}

.hor__home--on {
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  border-color: var(--sl-navy);
}

/* --- Cartes -------------------------------------------------------------- */
.hor__card {
  margin-top: 28rpx;
  border-radius: 40rpx;
  background: var(--sl-white);
  border: 2rpx solid var(--sl-border);
  overflow: hidden;
}

.hor__card--pad {
  padding: 28rpx;
}

.hor__card-head {
  padding: 28rpx 28rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hor__card-head--flat {
  padding: 0 0 16rpx;
}

.hor__card-title {
  font-size: var(--sl-fs-body-lg);
  font-weight: var(--sl-fw-extrabold);
}

/* --- Semaine ------------------------------------------------------------- */
.hor__day {
  padding: 20rpx 28rpx;
  border-top: 2rpx solid var(--sl-divider);
}

.hor__day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hor__day-name {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.hor__hours {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hor__hour {
  height: 76rpx;
  min-width: 112rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sl-white);
  color: var(--sl-text-2);
  border: 2rpx solid var(--sl-border);
}

.hor__hour--on {
  background: var(--sl-berry);
  color: var(--sl-on-dark);
  border-color: var(--sl-berry);
}

.hor__closed {
  display: block;
  margin-top: 4rpx;
  font-size: var(--sl-fs-small);
  color: var(--sl-placeholder);
}

/* --- Jours bloqués ------------------------------------------------------- */
.hor__add {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-extrabold);
}

.hor__block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: var(--sl-berry-soft);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: #8A2019;
}

.hor__block-remove {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hor__block-remove .ic {
  width: 32rpx;
  height: 32rpx;
}

/* --- Location sans visite ------------------------------------------------ */
.hor__remote {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.hor__remote-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hor__remote-sub {
  font-size: var(--sl-fs-small);
  line-height: 1.45;
  color: var(--sl-muted);
}
