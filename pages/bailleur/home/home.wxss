/* ==========================================================================
   Page Accueil Bailleur - SAMA LOYER (Page 10 exact Claude/PDF screenshots)
   ========================================================================== */

.bailleur-home-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F8F9FA;
  box-sizing: border-box;
}

.bailleur-scroll {
  flex: 1;
  box-sizing: border-box;
}

/* Dark Hero Header */
.dark-hero {
  background-color: #0F1E3D;
  padding: 0 32rpx 48rpx;
  color: #FFFFFF;
}

.hero-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.badge-role-pill {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
  background-color: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.avatar-circle-bailleur {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #C8235F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.hero-titles {
  display: flex;
  flex-direction: column;
}

.hero-welcome {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: #A0AAB8;
}

/* Main Body */
.main-body {
  padding: 32rpx;
  margin-top: -24rpx;
}

/* KPI Grid (4 cards) */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.kpi-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

.kpi-top {
  margin-bottom: 16rpx;
}

.kpi-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-pink { background-color: #FCE8EF; }
.icon-orange { background-color: #FFF3DC; }
.icon-green { background-color: #E2F0EA; }
.icon-blue { background-color: #EAF2FB; }

.kpi-icon {
  font-size: 30rpx;
}

.kpi-number {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 4rpx;
  line-height: 1.1;
}

.kpi-number--price {
  font-size: 36rpx;
}

.kpi-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 6rpx;
}

.kpi-note {
  display: block;
  font-size: 20rpx;
  color: #8C96A6;
}

.note-red {
  color: #C8235F;
  font-weight: 700;
}

/* Big Pink Button */
.cta-add-container {
  margin-bottom: 36rpx;
}

.btn-add-logement {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(200, 35, 95, 0.25);
}

.btn-add-plus {
  font-size: 38rpx;
  font-weight: 700;
}

.btn-add-text {
  font-size: 30rpx;
  font-weight: 700;
}

/* Section À faire maintenant */
.todo-section {
  margin-bottom: 36rpx;
}

.section-heading-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 20rpx;
}

.todo-cards-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.todo-card-item {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 2rpx 10rpx rgba(15, 30, 61, 0.03);
  display: flex;
  align-items: center;
}

.todo-bullet {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.bullet-red { background-color: #C8235F; }
.bullet-orange { background-color: #E68A00; }

.todo-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.todo-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.todo-item-desc {
  font-size: 22rpx;
  color: #5B6475;
}

.todo-chevron {
  font-size: 34rpx;
  color: #5B6475;
}

/* Section Loyers d'octobre */
.loyers-section {
  margin-bottom: 32rpx;
}

.loyers-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.loyers-section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.loyers-history-link {
  font-size: 26rpx;
  font-weight: 700;
  color: #C8235F;
}

.loyers-card-box {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
  padding: 6rpx 24rpx;
}

.loyer-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
}

.loyer-item-info {
  display: flex;
  flex-direction: column;
}

.loyer-prop-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.loyer-prop-sub {
  font-size: 22rpx;
  color: #5B6475;
}

.loyer-item-amount-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.loyer-amount {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.loyer-badge-status {
  font-size: 20rpx;
  font-weight: 700;
}

.badge-recu {
  color: #007C3D;
}

.badge-a-venir {
  color: #B56200;
}

.loyer-divider {
  height: 1rpx;
  background-color: #F0F2F5;
}

/* Carte Premium Actif */
.premium-active-card {
  background-color: #FDF2F5;
  border: 1.5rpx solid #F8D3DF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.star-icon-wrap {
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.star-pink {
  font-size: 32rpx;
  color: #C8235F;
}

.premium-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.premium-card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.premium-card-sub {
  font-size: 22rpx;
  color: #5B6475;
}

.premium-chevron {
  font-size: 34rpx;
  color: #5B6475;
}

/* Switch back to client */
.switch-role-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.btn-switch-client {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
}

.switch-client-icon {
  font-size: 30rpx;
  color: #5B6475;
}

.switch-client-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #5B6475;
}

.scroll-spacer {
  height: 180rpx;
}
