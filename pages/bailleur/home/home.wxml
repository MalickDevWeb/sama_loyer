<view class="bailleur-home-page">
  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <scroll-view class="bailleur-scroll {{ locked ? 'is-locked' : '' }}" scroll-y="{{ !locked }}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- Top Header Section (Fond clair) -->
    <view class="bailleur-header">

      <!-- Ligne : Sélecteur de rôle pleine largeur (Locataire / Bailleur) -->
      <view class="role-switch-bar">
        <view 
          class="role-segment" 
          hover-class="role-segment--hover" 
          bindtap="onSwitchToClient"
          aria-label="Basculer vers l'espace Locataire"
        >
          <view class="ic ic-home-grey ic--sm"></view>
          <text class="role-label">Locataire</text>
        </view>
        <view class="role-segment role-segment--active">
          <view class="ic ic-users-white ic--sm"></view>
          <text class="role-label">Bailleur</text>
        </view>
      </view>

      <!-- Message de bienvenue : Bonjour Moussa -->
      <view class="hero-profile-row">
        <view class="hero-titles">
          <view class="welcome-line">
            <text class="hero-welcome">Bonjour {{ bailleurName }}</text>
            <view class="verified-badge-mini ic-row"><view class="ic ic-check-white ic--xs"></view><text>Vérifié</text></view>
          </view>
          <text class="hero-sub">Voici où en sont tes logements aujourd'hui.</text>
        </view>
      </view>
    </view>

    <!-- Main Content Body -->
    <view class="main-body">
      <!-- 4 KPI Cards Grid -->
      <view class="kpi-grid">
        <!-- KPI 1 -->
        <view class="kpi-card" bindtap="onGoAnnonces">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-pink">
              <view class="ic ic-home-berry ic--md"></view>
            </view>
          </view>
          <text class="kpi-number">{{ kpis.annoncesEnLigne }}</text>
          <text class="kpi-title">Annonces en ligne</text>
          <text class="kpi-note">+{{ kpis.annoncesValidation }} en validation</text>
        </view>

        <!-- KPI 2 -->
        <view class="kpi-card" bindtap="onGoDemandes">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-orange">
              <view class="ic ic-cal-amber ic--md"></view>
            </view>
          </view>
          <text class="kpi-number">{{ kpis.demandesVisite }}</text>
          <text class="kpi-title">Demandes de visite</text>
          <text class="kpi-note note-red">{{ kpis.demandesATraiter }} à traiter</text>
        </view>

        <!-- KPI 3 -->
        <view class="kpi-card" bindtap="onGoClients">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-green">
              <view class="ic ic-key-green ic--md"></view>
            </view>
          </view>
          <text class="kpi-number">{{ kpis.logementsLoues }}</text>
          <text class="kpi-title">Logements loués</text>
          <text class="kpi-note">sur {{ kpis.totalLogements }} logements</text>
        </view>

        <!-- KPI 4 -->
        <view class="kpi-card">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-blue">
              <view class="ic ic-card-blue ic--md"></view>
            </view>
          </view>
          <text class="kpi-number kpi-number--price">{{ kpis.loyersRecus }}</text>
          <text class="kpi-title">Loyers reçus</text>
          <text class="kpi-note">en octobre</text>
        </view>
      </view>

      <!-- Section À faire maintenant (Cartes individuelles blanches) -->
      <view class="todo-section">
        <text class="section-heading-title">À faire maintenant</text>
        <view class="todo-cards-stack">
          
          <!-- Item 1 -->
          <view class="todo-card-item" bindtap="onGoDemandes">
            <view class="todo-bullet bullet-red"></view>
            <view class="todo-content">
              <text class="todo-item-title">Répondre à 2 demandes de visite</text>
              <text class="todo-item-desc">Les locataires attendent depuis hier</text>
            </view>
            <view class="ic ic-chevron-grey ic--sm"></view>
          </view>

          <!-- Item 2 -->
          <view class="todo-card-item" bindtap="onGoAnnonces">
            <view class="todo-bullet bullet-orange"></view>
            <view class="todo-content">
              <text class="todo-item-title">Confirmer que le studio est libre</text>
              <text class="todo-item-desc">Dernière confirmation il y a 14 jours</text>
            </view>
            <view class="ic ic-chevron-grey ic--sm"></view>
          </view>

          <!-- Item 3 -->
          <view class="todo-card-item" bindtap="onGoAnnonces">
            <view class="todo-bullet bullet-red"></view>
            <view class="todo-content">
              <text class="todo-item-title">Remplacer 2 photos floues</text>
              <text class="todo-item-desc">Appartement F2 — demandé par la validation</text>
            </view>
            <view class="ic ic-chevron-grey ic--sm"></view>
          </view>
        </view>
      </view>

      <!-- Historique des loyers (menu déroulant) -->
      <view class="loyers-section">
        <view class="history-toggle {{ historyOpen ? 'history-toggle--open' : '' }}" hover-class="history-toggle--hover" bindtap="onToggleHistory">
          <view class="history-toggle-text">
            <text class="history-toggle-title">Historique</text>
            <text class="history-toggle-sub">Loyers d'octobre · 2 reçus · 1 à venir</text>
          </view>
          <view class="ic ic-chevron-navy history-toggle-chevron"></view>
        </view>

        <view wx:if="{{ historyOpen }}" class="loyers-card-box">
          <!-- Row 1 -->
          <view class="loyer-item-row">
            <view class="loyer-item-info">
              <text class="loyer-prop-title">Chambre · Thiaroye</text>
              <text class="loyer-prop-sub">Fatou K. · payé le 3 oct.</text>
            </view>
            <view class="loyer-item-amount-col">
              <text class="loyer-amount">45 000 F</text>
              <text class="loyer-badge-status badge-recu">Reçu</text>
            </view>
          </view>
          <view class="loyer-divider"></view>

          <!-- Row 2 -->
          <view class="loyer-item-row">
            <view class="loyer-item-info">
              <text class="loyer-prop-title">Maison · Pikine Nord</text>
              <text class="loyer-prop-sub">Famille Ba · payé le 5 oct.</text>
            </view>
            <view class="loyer-item-amount-col">
              <text class="loyer-amount">160 000 F</text>
              <text class="loyer-badge-status badge-recu">Reçu</text>
            </view>
          </view>
          <view class="loyer-divider"></view>

          <!-- Row 3 -->
          <view class="loyer-item-row">
            <view class="loyer-item-info">
              <text class="loyer-prop-title">Appartement · Technopole</text>
              <text class="loyer-prop-sub">Nouveau locataire · attendu le 1er nov.</text>
            </view>
            <view class="loyer-item-amount-col">
              <text class="loyer-amount">180 000 F</text>
              <text class="loyer-badge-status badge-a-venir">À venir</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Barre d'onglets masquée tant que le bailleur n'est pas abonné -->
  <app-custom-tab-bar wx:if="{{ !locked }}" activeTab="b-home" />

  <!-- ================= ESPACE VERROUILLÉ (1re connexion bailleur) ================= -->
  <!-- Tout l'espace reste grisé tant que le bailleur n'a pas choisi l'essai ou l'abonnement -->
  <view wx:if="{{ locked }}" class="lock-overlay" catchtouchmove="noop">
    <view class="lock-sheet" aria-label="Activer l'espace bailleur">
      <view class="lock-handle"></view>

      <!-- En-tête illustré -->
      <view class="lock-hero">
        <view class="lock-halo">
          <view class="lock-badge"><view class="ic lock-ic-lock"></view></view>
        </view>
        <text class="lock-title">{{ expired ? 'Ton abonnement a expiré' : 'Active ton espace bailleur' }}</text>
        <text class="lock-text">{{ expired ? 'Renouvelle avec Max it pour retrouver tes annonces, tes locataires et tes loyers.' : 'Ton compte Max it est prêt. Choisis comment démarrer.' }}</text>
      </view>

      <!-- Ce que débloque l'espace -->
      <view class="lock-perks">
        <view class="lock-perk">
          <view class="lock-perk-ic lock-perk-ic--berry"><view class="ic ic-home-plus-berry"></view></view>
          <text class="lock-perk-txt">Publier tes logements</text>
        </view>
        <view class="lock-perk">
          <view class="lock-perk-ic lock-perk-ic--navy"><view class="ic ic-key-navy"></view></view>
          <text class="lock-perk-txt">Gérer tes locataires</text>
        </view>
        <view class="lock-perk">
          <view class="lock-perk-ic lock-perk-ic--green"><view class="ic ic-shield-check-green"></view></view>
          <text class="lock-perk-txt">Loyers & reçus Max it</text>
        </view>
      </view>

      <!-- Offre 1 : essai gratuit -->
      <view wx:if="{{ canTrial }}" class="lock-offer lock-offer--trial" hover-class="lock-offer--hover" bindtap="onStartTrial" aria-label="Essayer 30 jours gratuitement">
        <view class="lock-offer-ic lock-offer-ic--light"><view class="ic lock-ic-gift"></view></view>
        <view class="lock-offer-body">
          <view class="lock-offer-top">
            <text class="lock-offer-title">Essayer 30 jours</text>
            <text class="lock-offer-tag">Recommandé</text>
          </view>
          <text class="lock-offer-sub">Gratuit · sans engagement</text>
        </view>
        <view class="ic ic-chevron-white lock-offer-chev"></view>
      </view>

      <!-- Offre 2 : abonnement Pro Max it -->
      <view class="lock-offer lock-offer--pro" hover-class="lock-offer--hover" bindtap="onSubscribe" aria-label="Abonnement Pro avec Max it">
        <view class="lock-offer-ic lock-offer-ic--soft"><view class="ic lock-ic-crown"></view></view>
        <view class="lock-offer-body">
          <text class="lock-offer-title">Abonnement Pro</text>
          <view class="lock-offer-price">
            <text class="lock-offer-amount">{{ proPriceText }}</text>
            <text class="lock-offer-sub lock-offer-sub--dark"> / mois · via Max it</text>
          </view>
        </view>
        <view class="ic ic-maxit-berry lock-offer-maxit"></view>
      </view>

      <view class="lock-note">
        <view class="ic ic-shield-check-green lock-note-ic"></view>
        <text>Aucune information à saisir, tout vient de ton compte Max it.</text>
      </view>

      <view class="lock-back" hover-class="sl-hover" bindtap="onSwitchToClient">
        <view class="ic ic-back-line lock-back-ic"></view>
        <text>Revenir au profil locataire</text>
      </view>
    </view>
  </view>

  <!-- ================= MAX IT (simulation) ================= -->
  <view wx:if="{{ mx }}" class="sl-mx-backdrop lock-mx" catchtouchmove="noop">
    <view class="sl-mx" aria-label="Paiement">
      <block wx:if="{{ mx === 'confirm' }}">
        <view class="sl-mx-icon"><view class="ic ic-maxit-berry"></view></view>
        <text class="sl-mx-title">Payer</text>
        <text class="sl-mx-amount">{{ proPriceText }}</text>
        <text class="sl-mx-to">Abonnement Pro bailleur · 1 mois</text>
        <text class="sl-mx-note">Tu vas être redirigé·e vers l'application Max it pour valider le paiement avec ton code secret.</text>
        <view class="sl-btn sl-btn--berry sl-mx-btn" hover-class="sl-hover" bindtap="onMxGo">Payer</view>
        <view class="sl-mx-cancel" hover-class="sl-hover" bindtap="onMxClose">Annuler</view>
      </block>

      <block wx:if="{{ mx === 'redirect' }}">
        <view class="sl-mx-spinner"></view>
        <text class="sl-mx-title sl-mx-title--sm">Ouverture de Max it…</text>
        <text class="sl-mx-muted">Ne ferme pas l'application.</text>
      </block>

      <block wx:if="{{ mx === 'maxit' }}">
        <text class="sl-mx-sim">SIMULATION · ÉCRAN MAX IT</text>
        <view class="sl-mx-box">
          <text class="sl-mx-brand">Max it</text>
          <text class="sl-mx-muted">Demande de paiement</text>
          <view class="sl-mx-row"><text class="sl-mx-muted">Marchand</text><text class="sl-mx-strong">SAMA LOYER</text></view>
          <view class="sl-mx-row"><text class="sl-mx-muted">Motif</text><text class="sl-mx-strong sl-mx-right">Abonnement Pro bailleur</text></view>
          <view class="sl-mx-row sl-mx-row--total"><text class="sl-mx-strong">Montant</text><text class="sl-mx-strong">{{ proPriceText }}</text></view>
        </view>
        <text class="sl-mx-small">Dans la vraie application, tu tapes ici ton code secret Max it. SAMA LOYER ne voit jamais ton code.</text>
        <view class="sl-btn sl-btn--navy sl-mx-btn" hover-class="sl-hover" bindtap="onMxValidate">Valider le paiement</view>
        <view class="sl-btn sl-btn--outline sl-mx-refuse" hover-class="sl-hover" bindtap="onMxClose">Refuser et revenir</view>
      </block>

      <!-- Confirmation d'activation (essai gratuit ou abonnement) -->
      <block wx:if="{{ mx === 'done' }}">
        <view class="done-halo">
          <view class="done-badge"><view class="ic ic-check-white"></view></view>
        </view>
        <text class="sl-mx-title">{{ activatedPlan === 'pro' ? 'Abonnement activé' : 'Essai gratuit activé' }}</text>
        <text class="sl-mx-to">Bienvenue dans ton espace bailleur !</text>

        <view class="done-card">
          <view class="done-row">
            <view class="done-row-ic"><view class="ic {{ activatedPlan === 'pro' ? 'lock-ic-crown' : 'lock-ic-gift-berry' }}"></view></view>
            <view class="done-row-text">
              <text class="done-row-label">Offre</text>
              <text class="done-row-value">{{ activatedPlan === 'pro' ? 'Pro · payé avec Max it' : 'Essai gratuit · 30 jours' }}</text>
            </view>
          </view>
          <view class="done-sep"></view>
          <view class="done-row">
            <view class="done-row-ic"><view class="ic ic-cal-berry"></view></view>
            <view class="done-row-text">
              <text class="done-row-label">Valable jusqu'au</text>
              <text class="done-row-value">{{ activatedUntil }}</text>
            </view>
          </view>
        </view>

        <text class="sl-mx-note">Gère ton abonnement à tout moment dans l'onglet Profil.</text>
        <view class="sl-btn sl-btn--berry sl-mx-btn" hover-class="sl-hover" bindtap="onMxClose">C'est parti</view>
      </block>
    </view>
  </view>
</view>
