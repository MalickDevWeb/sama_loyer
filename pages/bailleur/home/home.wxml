<view class="bailleur-home-page">
  <scroll-view class="bailleur-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- Top Dark Hero Section -->
    <view class="dark-hero" style="padding-top: {{ statusBarHeight + 12 }}px;">
      <!-- Ligne supérieure avec badge ESPACE BAILLEUR (coin droit libre pour la capsule WeChat ··· ⊚) -->
      <view class="hero-top-row">
        <view class="badge-role-pill">ESPACE BAILLEUR</view>
      </view>

      <!-- Profil Bailleur aligné à gauche : Avatar MD + Bonjour Moussa -->
      <view class="hero-profile-row" bindtap="onOpenProfileModal">
        <view class="avatar-circle-bailleur">
          <text class="avatar-text">{{ initials }}</text>
        </view>
        <view class="hero-titles">
          <view class="welcome-line">
            <text class="hero-welcome">Bonjour {{ bailleurName }}</text>
            <view class="verified-badge-mini">✓ Vérifié</view>
          </view>
          <text class="hero-sub">Voici où en sont tes logements aujourd'hui.</text>
        </view>
      </view>
    </view>

    <!-- Main Content Body -->
    <view class="main-body">
      <!-- 4 KPI Cards Grid -->
      <view class="kpi-grid">
        <!-- KPI 1 -->
        <view class="kpi-card" bindtap="onGoAnnonces">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-pink">
              <text class="kpi-icon">🏠</text>
            </view>
          </view>
          <text class="kpi-number">{{ kpis.annoncesEnLigne }}</text>
          <text class="kpi-title">Annonces en ligne</text>
          <text class="kpi-note">+{{ kpis.annoncesValidation }} en validation</text>
        </view>

        <!-- KPI 2 -->
        <view class="kpi-card" bindtap="onGoDemandes">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-orange">
              <text class="kpi-icon">📅</text>
            </view>
          </view>
          <text class="kpi-number">{{ kpis.demandesVisite }}</text>
          <text class="kpi-title">Demandes de visite</text>
          <text class="kpi-note note-red">{{ kpis.demandesATraiter }} à traiter</text>
        </view>

        <!-- KPI 3 -->
        <view class="kpi-card" bindtap="onGoClients">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-green">
              <text class="kpi-icon">🔑</text>
            </view>
          </view>
          <text class="kpi-number">{{ kpis.logementsLoues }}</text>
          <text class="kpi-title">Logements loués</text>
          <text class="kpi-note">sur {{ kpis.totalLogements }} logements</text>
        </view>

        <!-- KPI 4 -->
        <view class="kpi-card">
          <view class="kpi-top">
            <view class="kpi-icon-wrap icon-blue">
              <text class="kpi-icon">💳</text>
            </view>
          </view>
          <text class="kpi-number kpi-number--price">{{ kpis.loyersRecus }}</text>
          <text class="kpi-title">Loyers reçus</text>
          <text class="kpi-note">en octobre</text>
        </view>
      </view>

      <!-- CTA Big Pink Button -->
      <view class="cta-add-container">
        <button class="btn-add-logement" bindtap="onGoAjouter">
          <text class="btn-add-plus">+</text>
          <text class="btn-add-text">Ajouter un logement</text>
        </button>
      </view>

      <!-- Section À faire maintenant (Cartes individuelles blanches) -->
      <view class="todo-section">
        <text class="section-heading-title">À faire maintenant</text>
        <view class="todo-cards-stack">
          
          <!-- Item 1 -->
          <view class="todo-card-item" bindtap="onGoDemandes">
            <view class="todo-bullet bullet-red"></view>
            <view class="todo-content">
              <text class="todo-item-title">Répondre à 2 demandes de visite</text>
              <text class="todo-item-desc">Les locataires attendent depuis hier</text>
            </view>
            <text class="todo-chevron">›</text>
          </view>

          <!-- Item 2 -->
          <view class="todo-card-item" bindtap="onGoAnnonces">
            <view class="todo-bullet bullet-orange"></view>
            <view class="todo-content">
              <text class="todo-item-title">Confirmer que le studio est libre</text>
              <text class="todo-item-desc">Dernière confirmation il y a 14 jours</text>
            </view>
            <text class="todo-chevron">›</text>
          </view>

          <!-- Item 3 -->
          <view class="todo-card-item" bindtap="onGoAnnonces">
            <view class="todo-bullet bullet-red"></view>
            <view class="todo-content">
              <text class="todo-item-title">Remplacer 2 photos floues</text>
              <text class="todo-item-desc">Appartement F2 — demandé par la validation</text>
            </view>
            <text class="todo-chevron">›</text>
          </view>
        </view>
      </view>

      <!-- Section Loyers d'octobre -->
      <view class="loyers-section">
        <view class="loyers-header-row">
          <text class="loyers-section-title">Loyers d'octobre</text>
          <text class="loyers-history-link" bindtap="onGoHistorique">Historique</text>
        </view>

        <view class="loyers-card-box">
          <!-- Row 1 -->
          <view class="loyer-item-row">
            <view class="loyer-item-info">
              <text class="loyer-prop-title">Chambre · Thiaroye</text>
              <text class="loyer-prop-sub">Fatou K. · payé le 3 oct.</text>
            </view>
            <view class="loyer-item-amount-col">
              <text class="loyer-amount">45 000 F</text>
              <text class="loyer-badge-status badge-recu">Reçu</text>
            </view>
          </view>
          <view class="loyer-divider"></view>

          <!-- Row 2 -->
          <view class="loyer-item-row">
            <view class="loyer-item-info">
              <text class="loyer-prop-title">Maison · Pikine Nord</text>
              <text class="loyer-prop-sub">Famille Ba · payé le 5 oct.</text>
            </view>
            <view class="loyer-item-amount-col">
              <text class="loyer-amount">160 000 F</text>
              <text class="loyer-badge-status badge-recu">Reçu</text>
            </view>
          </view>
          <view class="loyer-divider"></view>

          <!-- Row 3 -->
          <view class="loyer-item-row">
            <view class="loyer-item-info">
              <text class="loyer-prop-title">Appartement · Technopole</text>
              <text class="loyer-prop-sub">Nouveau locataire · attendu le 1er nov.</text>
            </view>
            <view class="loyer-item-amount-col">
              <text class="loyer-amount">180 000 F</text>
              <text class="loyer-badge-status badge-a-venir">À venir</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Carte Premium Actif -->
      <view class="premium-active-card" bindtap="onGoPremium">
        <view class="star-icon-wrap">
          <text class="star-pink">★</text>
        </view>
        <view class="premium-card-info">
          <text class="premium-card-title">Premium actif</text>
          <text class="premium-card-sub">Jusqu'au 15 novembre · 2 annonces mises en avant</text>
        </view>
        <text class="premium-chevron">›</text>
      </view>

      <!-- Bouton de retour vers mode Locataire -->
      <view class="switch-role-bar">
        <view class="btn-switch-client" bindtap="onSwitchToClient">
          <text class="switch-client-icon">⇄</text>
          <text class="switch-client-text">Passer en mode locataire</text>
        </view>
      </view>

    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Bailleur Tab Bar -->
  <app-custom-tab-bar activeTab="b-home" />

  <!-- ======================================================== -->
  <!-- MODAL / PROFIL BAILLEUR (Accessible via clic sur l'avatar) -->
  <!-- ======================================================== -->
  <view wx:if="{{ showProfileModal }}" class="profile-modal-overlay" bindtap="onCloseProfileModal">
    <view class="profile-modal-sheet" catchtap="true">
      <view class="modal-drag-handle"></view>
      <view class="profile-sheet-header">
        <view class="avatar-circle-large">
          <text class="avatar-text-large">{{ initials }}</text>
        </view>
        <view class="profile-sheet-titles">
          <text class="profile-sheet-name">{{ bailleurName }} Diop</text>
          <view class="profile-sheet-badge">
            <text class="badge-check">✓</text>
            <text>Bailleur vérifié · Max it</text>
          </view>
        </view>
        <view class="btn-close-sheet" bindtap="onCloseProfileModal">✕</view>
      </view>

      <view class="profile-info-cards">
        <view class="info-card-row">
          <text class="info-card-label">Numéro Orange Money</text>
          <text class="info-card-value">{{ phone }}</text>
        </view>
        <view class="info-card-row">
          <text class="info-card-label">Statut publication</text>
          <text class="info-card-value text-green">Instantanée sans validation</text>
        </view>
      </view>

      <!-- Bouton pour basculer vers le profil locataire -->
      <button class="btn-switch-role-sheet" bindtap="onSwitchToClient">
        <text class="switch-icon">⇄</text>
        <text>Basculer en profil Locataire (Awa)</text>
      </button>
    </view>
  </view>
</view>
