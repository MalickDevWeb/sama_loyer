/* ==========================================================================
   Page Ajouter un Logement (5 étapes complètes) - SAMA LOYER
   ========================================================================== */

.ajouter-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #FFFFFF;
  box-sizing: border-box;
  padding-bottom: 220rpx;
  position: relative;
}

/* Nav Bar */
.nav-bar-custom {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  z-index: 100;
}

.btn-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 38rpx;
  color: #0F1E3D;
  font-weight: 700;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.step-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #5B6475;
}

/* Progress bar segments */
.progress-bar-row {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  gap: 12rpx;
  z-index: 99;
  padding-top: 8rpx;
}

.progress-segment {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #E6EBF5;
  transition: background-color 0.25s ease;
}

.progress-segment.active {
  background-color: #C8235F;
}

/* Step container */
.step-container {
  padding: 32rpx;
}

.step-heading {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0F1E3D;
  line-height: 1.25;
  margin-bottom: 12rpx;
}

.step-subheading {
  display: block;
  font-size: 28rpx;
  color: #5B6475;
  line-height: 1.4;
  margin-bottom: 40rpx;
}

.form-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

/* Chips grid */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip-item {
  padding: 18rpx 32rpx;
  border-radius: 40rpx;
  background-color: #F4F6FA;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.chip-item-active {
  background-color: #FDE8EE;
  border-color: #C8235F;
}

.chip-text {
  font-size: 28rpx;
  color: #0F1E3D;
  font-weight: 600;
}

.chip-item-active .chip-text {
  color: #C8235F;
  font-weight: 700;
}

/* Inputs */
.text-input-field {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  background-color: #F4F6FA;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #0F1E3D;
}

.input-with-suffix {
  position: relative;
  display: flex;
  align-items: center;
}

.number-input {
  font-size: 36rpx;
  font-weight: 700;
  padding-right: 140rpx;
}

.input-suffix {
  position: absolute;
  right: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #5B6475;
}

/* Segmented Choice */
.segmented-choice {
  display: flex;
  gap: 16rpx;
}

.choice-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F4F6FA;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #0F1E3D;
  border: 2rpx solid transparent;
}

.choice-btn-active {
  background-color: #0F1E3D;
  color: #FFFFFF;
}

/* Financial summary card */
.financial-summary-card {
  margin-top: 48rpx;
  padding: 32rpx;
  background-color: #FAFBFD;
  border-radius: 24rpx;
  border: 2rpx solid #E6EBF5;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-label {
  font-size: 28rpx;
  color: #5B6475;
}

.summary-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F1E3D;
}

.summary-divider {
  height: 2rpx;
  background-color: #E6EBF5;
  margin: 20rpx 0;
}

.summary-total-row {
  margin-bottom: 0;
}

.summary-total-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.summary-total-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #C8235F;
}

/* Equipments list */
.equipments-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.equipment-checkbox-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background-color: #F4F6FA;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.equipment-checked {
  background-color: #FDE8EE;
  border-color: #F8B4C8;
}

.custom-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid #CCD2E0;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-checkbox-active {
  background-color: #C8235F;
  border-color: #C8235F;
}

.check-mark {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

.equipment-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F1E3D;
}

.textarea-field {
  width: 100%;
  box-sizing: border-box;
  height: 180rpx;
  background-color: #F4F6FA;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #0F1E3D;
}

/* Media Cards */
.media-upload-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.media-card {
  padding: 32rpx 24rpx;
  background-color: #F4F6FA;
  border-radius: 24rpx;
  border: 2rpx dashed #CCD2E0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.media-card-success {
  border-style: solid;
  border-color: #007C3D;
  background-color: #EAF8EF;
}

.media-icon-wrap {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.media-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 8rpx;
}

.media-status {
  font-size: 24rpx;
  font-weight: 600;
  color: #007C3D;
}

.info-alert-box {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background-color: #FFF8EB;
  border-radius: 20rpx;
  border: 2rpx solid #FFE4A3;
}

.info-alert-icon {
  font-size: 32rpx;
}

.info-alert-text {
  flex: 1;
  font-size: 26rpx;
  color: #8C5300;
  line-height: 1.4;
}

/* Center Content (Step 5) */
.center-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  margin-top: 180rpx;
}

.clock-circle-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: #FFF3DC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.clock-emoji {
  font-size: 64rpx;
}

.confirmation-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 16rpx;
  text-align: center;
}

.confirmation-sub {
  font-size: 28rpx;
  color: #5B6475;
  text-align: center;
  line-height: 1.45;
  margin-bottom: 36rpx;
}

.badge-validation-pill {
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  background-color: #FFF3DC;
  color: #B56200;
  font-size: 26rpx;
  font-weight: 700;
}

/* Sticky Bottom Action */
.bottom-action-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F2F7;
  z-index: 100;
}

.btn-primary-action {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #0F1E3D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}

.btn-publish {
  background-color: #C8235F;
}

.btn-voir-annonces {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #0F1E3D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}
