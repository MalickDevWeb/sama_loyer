<view class="ajouter-page">
  <!-- En-tête fixe : retour + titre (à gauche de la capsule WeChat) + progression -->
  <view class="aj-head" style="{{ headStyle }}">
    <view class="aj-nav" style="{{ navStyle }}">
      <view class="aj-back" hover-class="aj-hover" bindtap="onClose" aria-label="{{ step === 2 ? 'Étape précédente' : 'Fermer' }}">
        <view class="ic ic--md {{ step === 2 ? 'ic-back-navy' : 'ic-close-navy' }}"></view>
      </view>
      <text class="aj-nav-title">{{ step === 3 ? 'Annonce envoyée' : 'Nouvelle annonce' }}</text>
    </view>

    <view wx:if="{{ step < 3 }}" class="aj-progress">
      <view class="aj-progress-track">
        <view class="aj-progress-fill {{ step === 1 ? 'aj-progress-fill--half' : '' }}"></view>
      </view>
      <text class="aj-progress-label">Étape {{ step }} sur 2 · {{ step === 1 ? 'Le logement' : 'Photos et atouts' }}</text>
    </view>
  </view>

  <view class="aj-body" style="{{ bodyStyle }}">

    <!-- ================= ÉTAPE 1 : LE LOGEMENT ================= -->
    <view wx:if="{{ step === 1 }}" class="aj-step">
      <text class="aj-heading">Ton logement</text>
      <text class="aj-sub">Type, quartier et loyer : l'essentiel pour être trouvé.</text>

      <view class="aj-card">
        <text class="aj-label">Type de logement</text>
        <view class="chip-grid">
          <view
            wx:for="{{ typeList }}"
            wx:key="*this"
            class="chip-item {{ selectedType === item ? 'chip-item-active' : '' }}"
            bindtap="onSelectType"
            data-type="{{ item }}"
          >{{ item }}</view>
        </view>
      </view>

      <view class="aj-card">
        <text class="aj-label">Quartier à Dakar</text>
        <view class="chip-grid">
          <view
            wx:for="{{ quartierList }}"
            wx:key="*this"
            class="chip-item {{ selectedQuartier === item ? 'chip-item-active' : '' }}"
            bindtap="onSelectQuartier"
            data-quartier="{{ item }}"
          >{{ item }}</view>
        </view>
        <view class="aj-field aj-field--mt">
          <view class="ic ic-pin-berry ic--sm"></view>
          <input
            class="aj-input"
            placeholder="Repère : rue, pharmacie, mosquée…"
            placeholder-class="aj-placeholder"
            value="{{ adresseDetail }}"
            bindinput="onInputAdresse"
          />
        </view>
      </view>

      <view class="aj-card">
        <text class="aj-label">Loyer mensuel</text>
        <view class="aj-field aj-field--money">
          <input
            class="aj-input aj-input--money"
            type="number"
            placeholder="65000"
            placeholder-class="aj-placeholder"
            value="{{ loyer }}"
            bindinput="onInputLoyer"
          />
          <text class="aj-suffix">F / mois</text>
        </view>

        <text class="aj-label aj-label--mt">Caution</text>
        <view class="aj-segment">
          <view class="aj-seg {{ cautionMonths === 1 ? 'aj-seg--on' : '' }}" bindtap="onSelectCaution" data-months="1">1 mois</view>
          <view class="aj-seg {{ cautionMonths === 2 ? 'aj-seg--on' : '' }}" bindtap="onSelectCaution" data-months="2">2 mois</view>
        </view>

        <view class="aj-total">
          <view class="aj-total-left">
            <text class="aj-total-label">Total pour entrer</text>
            <text class="aj-total-detail">Avance {{ loyerFormatted }} F + caution {{ cautionFormatted }} F</text>
          </view>
          <text class="aj-total-val">{{ totalEntreeFormatted }} F</text>
        </view>
      </view>
    </view>

    <!-- ================= ÉTAPE 2 : PHOTOS ET ATOUTS ================= -->
    <view wx:if="{{ step === 2 }}" class="aj-step">
      <text class="aj-heading">Photos et atouts</text>
      <text class="aj-sub">Une annonce avec photos et vidéo se loue 3× plus vite.</text>

      <view class="aj-card">
        <view class="aj-card-head">
          <text class="aj-label aj-label--flat">Photos</text>
          <text class="aj-count">{{ photoCount }} / 8</text>
        </view>
        <view class="photo-grid">
          <view wx:for="{{ photos }}" wx:key="*this" class="photo-cell">
            <image class="photo-img" src="{{ item }}" mode="aspectFill" data-index="{{ index }}" bindtap="onPreviewPhoto" />
            <text wx:if="{{ index === 0 }}" class="photo-cover-tag">Couverture</text>
            <view class="photo-remove" data-index="{{ index }}" catchtap="onRemovePhoto" aria-label="Retirer la photo">
              <view class="ic ic-close-white"></view>
            </view>
          </view>
          <view wx:if="{{ canAddPhoto }}" class="photo-cell photo-add" hover-class="aj-hover" bindtap="onAddPhotos" aria-label="Ajouter des photos">
            <view class="ic ic-photo-navy photo-add-ic"></view>
            <text class="photo-add-txt">Ajouter</text>
          </view>
        </view>

        <view class="aj-card-head aj-card-head--mt">
          <text class="aj-label aj-label--flat">Vidéo de visite</text>
          <text class="aj-count">60 s max</text>
        </view>
        <view wx:if="{{ video }}" class="video-row">
          <view class="video-thumb" hover-class="aj-hover" bindtap="onPlayVideo" aria-label="Lire la vidéo">
            <image wx:if="{{ videoPoster }}" class="photo-img" src="{{ videoPoster }}" mode="aspectFill" />
            <view class="video-play"><view class="ic ic-play-white ic--sm"></view></view>
          </view>
          <view class="video-info">
            <text class="video-ok">Vidéo ajoutée</text>
            <view class="video-links">
              <text class="video-link" bindtap="onPickVideo">Remplacer</text>
              <text class="video-link video-link--danger" bindtap="onRemoveVideo">Retirer</text>
            </view>
          </view>
        </view>
        <view wx:else class="video-empty" hover-class="aj-hover" bindtap="onPickVideo">
          <view class="ic ic-video-berry photo-add-ic"></view>
          <text class="photo-add-txt">Filmer ou choisir une vidéo</text>
        </view>
      </view>

      <view class="aj-card">
        <text class="aj-label">Équipements inclus</text>
        <view class="chip-grid">
          <view
            wx:for="{{ equipements }}"
            wx:key="id"
            class="chip-item chip-item--eq {{ item.checked ? 'chip-item-active' : '' }}"
            bindtap="onToggleEquipment"
            data-id="{{ item.id }}"
          >
            <view wx:if="{{ item.checked }}" class="ic ic-check-berry ic--xs"></view>
            <text>{{ item.label }}</text>
          </view>
        </view>

        <text class="aj-label aj-label--mt">Description <text class="aj-optional">(facultatif)</text></text>
        <textarea
          class="aj-textarea"
          placeholder="Pièce lumineuse, quartier calme, proche des transports…"
          placeholder-class="aj-placeholder"
          value="{{ description }}"
          bindinput="onInputDescription"
          maxlength="400"
        ></textarea>
      </view>

      <view class="aj-card">
        <text class="aj-label">Contrat de location</text>

        <view class="ct-opt {{ contractMode === 'standard' ? 'ct-opt--on' : '' }}" bindtap="onSelectContractMode" data-mode="standard">
          <view class="ct-radio {{ contractMode === 'standard' ? 'ct-radio--on' : '' }}"></view>
          <view class="ct-opt-text">
            <view class="ct-opt-title-row">
              <text class="ct-opt-title">Modèle SAMA LOYER</text>
              <text class="ct-opt-tag">Recommandé</text>
            </view>
            <text class="ct-opt-sub">Déjà rédigé, rempli avec ton loyer et ta caution. Le locataire le signe dans l'appli, les quittances Max it sont automatiques.</text>
          </view>
        </view>

        <block wx:if="{{ allowCustomContract }}">
          <view class="ct-opt {{ contractMode === 'custom' ? 'ct-opt--on' : '' }}" bindtap="onSelectContractMode" data-mode="custom">
            <view class="ct-radio {{ contractMode === 'custom' ? 'ct-radio--on' : '' }}"></view>
            <view class="ct-opt-text">
              <text class="ct-opt-title">Mon contrat pour ce logement</text>
              <text class="ct-opt-sub">Meublé avec inventaire, colocation, règles de copropriété… Ton PDF est proposé à la signature du locataire.</text>
            </view>
          </view>

          <block wx:if="{{ contractMode === 'custom' }}">
            <view wx:if="{{ customContract }}" class="ct-file">
              <view class="ic ic-doc-navy ic--sm"></view>
              <text class="ct-file-name" bindtap="onViewCustomContract">{{ customContract.name }}</text>
              <text class="video-link" bindtap="onPickCustomContract">Remplacer</text>
              <text class="video-link video-link--danger" bindtap="onRemoveCustomContract">Retirer</text>
            </view>
            <view wx:else class="video-empty" hover-class="aj-hover" bindtap="onPickCustomContract">
              <view class="ic ic-doc-navy photo-add-ic"></view>
              <text class="photo-add-txt">Ajouter mon contrat (PDF)</text>
            </view>
          </block>
        </block>
      </view>

      <view class="aj-note">
        <view class="ic ic-bulb-amber ic--sm"></view>
        <text>Notre équipe vérifie l'annonce, les photos{{ contractMode === 'custom' ? ' et ton contrat' : '' }} sous 24 h ouvrées.</text>
      </view>
    </view>

    <!-- ================= ÉTAPE 3 : CONFIRMATION ================= -->
    <view wx:if="{{ step === 3 }}" class="aj-done">
      <view class="aj-done-badge">
        <view class="ic ic-check-white ic--xl"></view>
      </view>
      <text class="aj-done-title">Annonce envoyée !</text>
      <text class="aj-done-sub">Elle est en cours de validation. Tu recevras un SMS dès qu'elle sera en ligne.</text>

      <view class="aj-recap">
        <image wx:if="{{ coverPhoto }}" class="aj-recap-img" src="{{ coverPhoto }}" mode="aspectFill" />
        <view class="aj-recap-body">
          <text class="aj-recap-title">{{ selectedType }} à {{ selectedQuartier }}</text>
          <text class="aj-recap-price">{{ loyerFormatted }} F / mois</text>
          <text class="aj-recap-contract">Contrat : {{ contractMode === 'custom' ? 'ton PDF pour ce logement' : 'modèle SAMA LOYER' }}</text>
          <view class="aj-recap-pill"><view class="ic ic-clock-amber ic--xs"></view><text>En validation · sous 24 h</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- Barre d'action fixe -->
  <view class="aj-bottom">
    <view wx:if="{{ step === 1 }}" class="aj-btn aj-btn--navy" hover-class="aj-hover" bindtap="onNextStep">
      <text>Continuer</text>
      <view class="ic ic-arrow-right-white ic--sm"></view>
    </view>
    <view wx:if="{{ step === 2 }}" class="aj-btn aj-btn--berry" hover-class="aj-hover" bindtap="onPublishListing">
      <text>Publier l'annonce</text>
    </view>
    <block wx:if="{{ step === 3 }}">
      <view class="aj-btn aj-btn--navy" hover-class="aj-hover" bindtap="onVoirAnnonces">
        <text>Voir mes annonces</text>
      </view>
      <view class="aj-link" hover-class="aj-hover" bindtap="onAddAnother">Ajouter un autre logement</view>
    </block>
  </view>
</view>
