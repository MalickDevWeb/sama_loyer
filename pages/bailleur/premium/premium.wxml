<view class="premium-page">
  <!-- Barre de marque SAMA LOYER fixe sur tous les écrans -->
  <sama-top-bar />

  <scroll-view class="premium-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête -->
    <view class="premium-header">
      <view class="premium-back" hover-class="premium-back--hover" bindtap="onBack" aria-label="Retour au profil">
        <view class="ic ic-back-navy premium-back-ic"></view>
        <text>Profil</text>
      </view>
      <text class="page-title">Premium et revenus</text>
      <text class="page-subtitle">Ton abonnement, tes mises en avant et tes paiements</text>
    </view>

    <view class="premium-content">
      <!-- Dark Hero Card -->
      <view class="dark-subscription-card">
        <view class="subs-header-row">
          <view class="subs-badge">
            <view class="ic ic-star-white ic--sm"></view>
            <text class="subs-badge-text">{{ sub.planLabel }}</text>
          </view>
          <text class="subs-status-green">Actif · {{ sub.daysLeft }} j restants</text>
        </view>

        <text class="valid-until-label">Valable jusqu'au</text>
        <text class="valid-date-text">{{ sub.untilText }}</text>

        <!-- Progress bar Annonces mises en avant -->
        <view class="highlight-progress-wrap">
          <view class="progress-labels-row">
            <text class="prog-label">Annonces mises en avant</text>
            <text class="prog-val">2 sur 3</text>
          </view>
          <view class="prog-track">
            <view class="prog-fill" style="width: 66%;"></view>
          </view>
        </view>

        <!-- Stats 2 col inside darker rounded cards -->
        <view class="subs-stats-row">
          <view class="subs-stat-box">
            <text class="stat-big-number">379</text>
            <text class="stat-big-desc">vues ce mois</text>
          </view>
          <view class="subs-stat-box">
            <text class="stat-big-number">4</text>
            <text class="stat-big-desc">demandes de visite</text>
          </view>
        </view>

        <view class="btn-renew-subs" hover-class="btn-renew-subs--hover" bindtap="onRenew">
          <view class="ic ic-maxit-berry ic--md"></view>
          <text>{{ sub.isTrial ? 'Passer à Pro' : 'Renouveler' }} · {{ proPriceText }}</text>
        </view>
        <text class="subs-renew-via">Paiement sécurisé avec Max it</text>
        <text class="subs-renew-note">{{ sub.isTrial ? 'À la fin de ton essai, ton espace sera bloqué sans abonnement.' : '+30 jours ajoutés à ta date de fin. Sans renouvellement, ton espace sera bloqué.' }}</text>
      </view>

      <!-- Section Mettre une annonce en avant -->
      <view class="boost-section">
        <text class="boost-section-title">Mettre une annonce en avant</text>
        <text class="boost-section-desc">Ton annonce apparaît en haut des recherches de son quartier.</text>

        <!-- Radio List -->
        <view class="boost-options-list">
          <block wx:for="{{ boostOptions }}" wx:key="id">
            <view 
              class="boost-option-card {{ selectedOption === item.id ? 'boost-card--selected' : '' }}"
              data-id="{{ item.id }}"
              bindtap="onSelectOption"
            >
              <!-- Radio Circle -->
              <view class="radio-indicator {{ selectedOption === item.id ? 'radio-indicator--active' : '' }}">
                <view wx:if="{{ selectedOption === item.id }}" class="radio-dot"></view>
              </view>

              <!-- Option Details -->
              <view class="option-details-col">
                <text class="option-title">{{ item.title }}</text>
                <text class="option-subtitle">{{ item.sub }}</text>
              </view>

              <!-- Price -->
              <text class="option-price-label">{{ item.priceLabel }}</text>
            </view>
          </block>
        </view>

        <!-- Action Button Rose -->
        <view class="btn-continue-pay" hover-class="btn-renew-subs--hover" bindtap="onBoost">
          <text>Payer {{ selectedPriceLabel }} avec Max it</text>
        </view>
      </view>

      <!-- Section Loyers reçus (Carte Blanche avec barre verte et blocs mensuels) -->
      <view class="loyers-recus-section">
        <text class="section-big-title">Loyers reçus</text>
        
        <view class="loyers-summary-card">
          <view class="loyers-top-info-row">
            <text class="loyers-month-label">Octobre 2026</text>
            <text class="loyers-expected-label">sur 385 000 F attendus</text>
          </view>

          <text class="loyers-main-amount">205 000 F</text>

          <!-- Barre de progression verte -->
          <view class="loyers-prog-track">
            <view class="loyers-prog-fill" style="width: 53.2%;"></view>
          </view>

          <!-- 3 Blocs Mensuels -->
          <view class="monthly-blocks-row">
            <!-- Bloc Août -->
            <view class="month-block-col">
              <view class="month-bar-block bar-grey"></view>
              <text class="month-label-text">Août · 160 000</text>
            </view>

            <!-- Bloc Septembre -->
            <view class="month-block-col">
              <view class="month-bar-block bar-grey"></view>
              <text class="month-label-text">Sept. · 205 000</text>
            </view>

            <!-- Bloc Octobre -->
            <view class="month-block-col">
              <view class="month-bar-block bar-green"></view>
              <text class="month-label-text month-label-active">Oct. · 205 000</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Section Historique des paiements -->
      <view class="history-payments-section">
        <view class="history-toggle {{ historyOpen ? 'history-toggle--open' : '' }}" hover-class="sl-hover" bindtap="onToggleHistory">
          <view class="history-toggle-text">
            <text class="history-toggle-title">Historique</text>
            <text class="history-toggle-sub">{{ paiementsHistorique.length }} paiement{{ paiementsHistorique.length > 1 ? 's' : '' }}</text>
          </view>
          <view class="ic ic-chevron-navy history-toggle-chevron"></view>
        </view>

        <block wx:if="{{ historyOpen }}">
        <view wx:if="{{ paiementsHistorique.length === 0 }}" class="history-empty">Aucun paiement pour le moment.</view>
        <view wx:else class="history-payments-card">
          <block wx:for="{{ paiementsHistorique }}" wx:key="id">
            <view class="payment-row">
              <!-- Pastille icône - ou + -->
              <view class="pay-icon-circle {{ item.type === 'debit' ? 'circle-minus' : 'circle-plus' }}">
                <text class="pay-icon-symbol">{{ item.type === 'debit' ? '−' : '+' }}</text>
              </view>

              <!-- Détails -->
              <view class="pay-details-col">
                <text class="pay-title">{{ item.title }}</text>
                <text class="pay-meta">{{ item.meta }}</text>
              </view>

              <!-- Montant -->
              <text class="pay-amount {{ item.amountClass }}">{{ item.amount }}</text>
            </view>
            <view wx:if="{{ index < paiementsHistorique.length - 1 }}" class="payment-divider"></view>
          </block>
        </view>

        <!-- Lien Télécharger les reçus -->
        <view class="download-receipts-link" bindtap="onDownloadRecus">
          <view class="ic ic-download-navy ic--sm"></view>
          <text class="download-text">Télécharger les reçus</text>
        </view>
        </block>
      </view>

    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Bailleur Tab Bar -->
  <app-custom-tab-bar activeTab="b-profil" />

  <!-- ================= PAIEMENT MAX IT (abonnement ou boost) ================= -->
  <view wx:if="{{ mx }}" class="sl-mx-backdrop premium-mx" catchtouchmove="noop">
    <view class="sl-mx" aria-label="Paiement avec Max it">
      <block wx:if="{{ mx === 'confirm' }}">
        <view class="sl-mx-icon"><view class="ic ic-maxit-berry"></view></view>
        <text class="sl-mx-title">Payer avec Max it</text>
        <text class="sl-mx-amount">{{ pay.amountText }}</text>
        <text class="sl-mx-to">{{ pay.label }}</text>
        <text class="sl-mx-note">Tu vas être redirigé·e vers l'application Max it pour valider le paiement avec ton code secret.</text>
        <view class="sl-btn sl-btn--berry sl-mx-btn" hover-class="sl-hover" bindtap="onMxGo">Continuer vers Max it</view>
        <view class="sl-mx-cancel" hover-class="sl-hover" bindtap="onMxClose">Annuler</view>
      </block>

      <block wx:if="{{ mx === 'redirect' }}">
        <view class="sl-mx-spinner"></view>
        <text class="sl-mx-title sl-mx-title--sm">Ouverture de Max it…</text>
        <text class="sl-mx-muted">Ne ferme pas l'application.</text>
      </block>

      <block wx:if="{{ mx === 'maxit' }}">
        <text class="sl-mx-sim">SIMULATION · ÉCRAN MAX IT</text>
        <view class="sl-mx-box">
          <text class="sl-mx-brand">Max it</text>
          <text class="sl-mx-muted">Demande de paiement</text>
          <view class="sl-mx-row"><text class="sl-mx-muted">Marchand</text><text class="sl-mx-strong">SAMA LOYER</text></view>
          <view class="sl-mx-row"><text class="sl-mx-muted">Motif</text><text class="sl-mx-strong sl-mx-right">{{ pay.label }}</text></view>
          <view class="sl-mx-row sl-mx-row--total"><text class="sl-mx-strong">Montant</text><text class="sl-mx-strong">{{ pay.amountText }}</text></view>
        </view>
        <text class="sl-mx-small">Dans la vraie application, tu tapes ici ton code secret Max it. SAMA LOYER ne voit jamais ton code.</text>
        <view class="sl-btn sl-btn--navy sl-mx-btn" hover-class="sl-hover" bindtap="onMxValidate">Valider le paiement</view>
        <view class="sl-btn sl-btn--outline sl-mx-refuse" hover-class="sl-hover" bindtap="onMxClose">Refuser et revenir</view>
      </block>

      <block wx:if="{{ mx === 'done' }}">
        <view class="sl-mx-icon"><view class="ic ic-check-berry"></view></view>
        <text class="sl-mx-title">Paiement validé</text>
        <text class="sl-mx-to">{{ pay.doneText }}</text>
        <view class="sl-btn sl-btn--berry sl-mx-btn" hover-class="sl-hover" bindtap="onMxClose">Parfait</view>
      </block>
    </view>
  </view>
</view>
