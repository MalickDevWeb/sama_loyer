@import "/styles/sama-ui.wxss";

/* ==========================================================================
   Page Premium et Revenus Bailleur - SAMA LOYER (Page 14 exact Claude/PDF)
   ========================================================================== */

.premium-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: var(--sl-bg);
  box-sizing: border-box;
}

.premium-scroll {
  height: 100%;
  flex: 1;
  box-sizing: border-box;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

/* En-tête */
.premium-header {
  padding: 14rpx 32rpx 20rpx;
  background-color: var(--sl-white);
  border-bottom: 1rpx solid var(--sl-divider);
}

.page-title {
  display: block;
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 6rpx;
}

.page-subtitle {
  display: block;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.premium-content {
  padding: 32rpx;
}

/* Dark Subscription Card */
.dark-subscription-card {
  background-color: var(--sl-navy);
  border-radius: 28rpx;
  padding: 32rpx;
  color: var(--sl-on-dark);
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 30, 61, 0.15);
}

.subs-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.subs-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: var(--sl-berry);
}

.star-icon {
  font-size: var(--sl-fs-small);
  color: var(--sl-on-dark);
}

.subs-badge-text {
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-on-dark);
}

.subs-status-green {
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: #00E676;
}

.valid-until-label {
  display: block;
  font-size: var(--sl-fs-caption);
  color: #A0AAB8;
  margin-bottom: 4rpx;
}

.valid-date-text {
  display: block;
  font-size: var(--sl-fs-title-lg);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-on-dark);
  margin-bottom: 24rpx;
}

/* Progress bar */
.highlight-progress-wrap {
  margin-bottom: 28rpx;
}

.progress-labels-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--sl-fs-caption);
  color: #A0AAB8;
  margin-bottom: 10rpx;
}

.prog-track {
  height: 10rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 5rpx;
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  background-color: var(--sl-berry);
  border-radius: 5rpx;
}

/* Stats 2 cols inside darker cards */
.subs-stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.subs-stat-box {
  flex: 1;
  background-color: #17284F;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.stat-big-number {
  font-size: var(--sl-fs-h2);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-on-dark);
  margin-bottom: 4rpx;
  line-height: 1.1;
}

.stat-big-desc {
  font-size: var(--sl-fs-caption);
  color: #A0AAB8;
}

.btn-renew-subs {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: var(--sl-white);
  color: var(--sl-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  border: none;
}

/* Section Boost */
.boost-section {
  margin-bottom: 36rpx;
}

.boost-section-title {
  display: block;
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 6rpx;
}

.boost-section-desc {
  display: block;
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
  margin-bottom: 24rpx;
}

.boost-options-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.boost-option-card {
  background-color: var(--sl-white);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--sl-divider);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 10rpx rgba(15, 30, 61, 0.03);
  transition: all 0.2s ease;
}

.boost-card--selected {
  border-color: var(--sl-berry);
  background-color: var(--sl-white);
}

.radio-indicator {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #C5CBD4;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.radio-indicator--active {
  border-color: var(--sl-berry);
}

.radio-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background-color: var(--sl-berry);
}

.option-details-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 4rpx;
}

.option-subtitle {
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
}

.option-price-label {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.btn-continue-pay {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: var(--sl-berry);
  color: var(--sl-on-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(200, 35, 95, 0.25);
}

/* Common Section Titles */
.section-big-title {
  display: block;
  font-size: var(--sl-fs-title-sm);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 20rpx;
}

/* Section Loyers Reçus */
.loyers-recus-section {
  margin-bottom: 36rpx;
}

.loyers-summary-card {
  background-color: var(--sl-white);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid var(--sl-divider);
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

.loyers-top-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
  margin-bottom: 8rpx;
}

.loyers-month-label {
  color: var(--sl-muted);
  font-size: var(--sl-fs-small);
}

.loyers-expected-label {
  color: var(--sl-muted);
  font-size: var(--sl-fs-small);
}

.loyers-main-amount {
  display: block;
  font-size: var(--sl-fs-h1);
  font-weight: var(--sl-fw-black);
  color: var(--sl-text);
  margin-bottom: 18rpx;
  line-height: 1.1;
}

.loyers-prog-track {
  width: 100%;
  height: 12rpx;
  background-color: var(--sl-border);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.loyers-prog-fill {
  height: 100%;
  background-color: #0F6038;
  border-radius: 6rpx;
}

.monthly-blocks-row {
  display: flex;
  gap: 16rpx;
}

.month-block-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.month-bar-block {
  width: 100%;
  height: 68rpx;
  border-radius: 14rpx;
}

.bar-grey {
  background-color: #D9E0EB;
}

.bar-green {
  background-color: #0F6038;
}

.month-label-text {
  font-size: var(--sl-fs-micro);
  color: var(--sl-muted);
  font-weight: var(--sl-fw-semibold);
  text-align: center;
}

.month-label-active {
  color: var(--sl-text);
  font-weight: var(--sl-fw-extrabold);
}

/* Section Historique des paiements */
.history-payments-section {
  margin-bottom: 24rpx;
}

.history-toggle {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: var(--sl-white);
  border-radius: 28rpx;
  border: 1rpx solid var(--sl-divider);
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.history-toggle-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.history-toggle-title {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
}

.history-toggle-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.history-toggle-chevron {
  width: 36rpx;
  height: 36rpx;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.history-toggle--open .history-toggle-chevron {
  transform: rotate(-90deg);
}

.history-empty {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.history-payments-card {
  background-color: var(--sl-white);
  border-radius: 28rpx;
  border: 1rpx solid var(--sl-divider);
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
  padding: 6rpx 28rpx;
  margin-bottom: 20rpx;
}

.payment-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.pay-icon-circle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.circle-minus {
  background-color: var(--sl-berry-tint);
}

.circle-minus .pay-icon-symbol {
  color: var(--sl-berry);
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  line-height: 1;
  margin-top: -4rpx;
}

.circle-plus {
  background-color: var(--sl-green-bg);
}

.circle-plus .pay-icon-symbol {
  color: var(--sl-green);
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
  line-height: 1;
}

.pay-details-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pay-title {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  color: var(--sl-text);
  margin-bottom: 4rpx;
}

.pay-meta {
  font-size: var(--sl-fs-caption);
  color: #8C96A6;
}

.pay-amount {
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
}

.amount-debit {
  color: var(--sl-text);
}

.amount-credit {
  color: var(--sl-green);
}

.payment-divider {
  height: 1rpx;
  background-color: var(--sl-surface-3);
}

.download-receipts-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0 12rpx;
}

.download-icon {
  font-size: var(--sl-fs-body);
  color: var(--sl-muted);
}

.download-text {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-semibold);
  color: var(--sl-muted);
}

.scroll-spacer {
  height: 180rpx;
}

/* Retour vers l'onglet Profil */
.premium-back {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-text);
}

.premium-back--hover {
  opacity: 0.7;
}

.premium-back-ic {
  width: 32rpx;
  height: 32rpx;
}


.premium-scroll::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

/* Abonnement : note sous le bouton de renouvellement */
.subs-renew-note {
  display: block;
  margin-top: 16rpx;
  font-size: var(--sl-fs-caption);
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

/* Fenêtre Max it au-dessus de la barre d'onglets */
.premium-mx {
  z-index: 1001;
}

/* Boutons en <view> : le <button> natif est bridé à 184px de large par WeChat */
.btn-renew-subs {
  gap: 14rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  white-space: nowrap;
}

.btn-renew-subs--hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.subs-renew-via {
  display: block;
  margin-top: 14rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-bold);
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.btn-continue-pay {
  box-sizing: border-box;
  white-space: nowrap;
}
