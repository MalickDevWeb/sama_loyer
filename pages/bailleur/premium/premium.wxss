/* ==========================================================================
   Page Premium et Revenus Bailleur - SAMA LOGEMENT (Page 14 exact Claude/PDF)
   ========================================================================== */

.premium-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F8F9FA;
  box-sizing: border-box;
}

.premium-scroll {
  flex: 1;
  box-sizing: border-box;
}

/* En-tête */
.premium-header {
  padding: 0 32rpx 20rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #ECEFF2;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 6rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #5B6475;
}

.premium-content {
  padding: 32rpx;
}

/* Dark Subscription Card */
.dark-subscription-card {
  background-color: #0F1E3D;
  border-radius: 28rpx;
  padding: 32rpx;
  color: #FFFFFF;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 30, 61, 0.15);
}

.subs-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.subs-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: #C8235F;
}

.star-icon {
  font-size: 24rpx;
  color: #FFFFFF;
}

.subs-badge-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.subs-status-green {
  font-size: 24rpx;
  font-weight: 700;
  color: #00E676;
}

.valid-until-label {
  display: block;
  font-size: 22rpx;
  color: #A0AAB8;
  margin-bottom: 4rpx;
}

.valid-date-text {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

/* Progress bar */
.highlight-progress-wrap {
  margin-bottom: 28rpx;
}

.progress-labels-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #A0AAB8;
  margin-bottom: 10rpx;
}

.prog-track {
  height: 10rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 5rpx;
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  background-color: #C8235F;
  border-radius: 5rpx;
}

/* Stats 2 cols inside darker cards */
.subs-stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.subs-stat-box {
  flex: 1;
  background-color: #17284F;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.stat-big-number {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 4rpx;
  line-height: 1.1;
}

.stat-big-desc {
  font-size: 22rpx;
  color: #A0AAB8;
}

.btn-renew-subs {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #FFFFFF;
  color: #0F1E3D;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
}

/* Section Boost */
.boost-section {
  margin-bottom: 36rpx;
}

.boost-section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 6rpx;
}

.boost-section-desc {
  display: block;
  font-size: 24rpx;
  color: #5B6475;
  margin-bottom: 24rpx;
}

.boost-options-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.boost-option-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid #ECEFF2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 10rpx rgba(15, 30, 61, 0.03);
  transition: all 0.2s ease;
}

.boost-card--selected {
  border-color: #C8235F;
  background-color: #FFFFFF;
}

.radio-indicator {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #C5CBD4;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.radio-indicator--active {
  border-color: #C8235F;
}

.radio-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background-color: #C8235F;
}

.option-details-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.option-subtitle {
  font-size: 22rpx;
  color: #5B6475;
}

.option-price-label {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.btn-continue-pay {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(200, 35, 95, 0.25);
}

/* Common Section Titles */
.section-big-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 20rpx;
}

/* Section Loyers Reçus */
.loyers-recus-section {
  margin-bottom: 36rpx;
}

.loyers-summary-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

.loyers-top-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #5B6475;
  margin-bottom: 8rpx;
}

.loyers-month-label {
  color: #5B6475;
  font-size: 24rpx;
}

.loyers-expected-label {
  color: #5B6475;
  font-size: 24rpx;
}

.loyers-main-amount {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: #0F1E3D;
  margin-bottom: 18rpx;
  line-height: 1.1;
}

.loyers-prog-track {
  width: 100%;
  height: 12rpx;
  background-color: #E2E8F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.loyers-prog-fill {
  height: 100%;
  background-color: #0F6038;
  border-radius: 6rpx;
}

.monthly-blocks-row {
  display: flex;
  gap: 16rpx;
}

.month-block-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.month-bar-block {
  width: 100%;
  height: 68rpx;
  border-radius: 14rpx;
}

.bar-grey {
  background-color: #D9E0EB;
}

.bar-green {
  background-color: #0F6038;
}

.month-label-text {
  font-size: 20rpx;
  color: #5B6475;
  font-weight: 600;
  text-align: center;
}

.month-label-active {
  color: #0F1E3D;
  font-weight: 800;
}

/* Section Historique des paiements */
.history-payments-section {
  margin-bottom: 24rpx;
}

.history-payments-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
  padding: 6rpx 28rpx;
  margin-bottom: 20rpx;
}

.payment-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.pay-icon-circle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.circle-minus {
  background-color: #FDE8EE;
}

.circle-minus .pay-icon-symbol {
  color: #C8235F;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  margin-top: -4rpx;
}

.circle-plus {
  background-color: #EAF7EE;
}

.circle-plus .pay-icon-symbol {
  color: #007C3D;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.pay-details-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pay-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.pay-meta {
  font-size: 22rpx;
  color: #8C96A6;
}

.pay-amount {
  font-size: 28rpx;
  font-weight: 800;
}

.amount-debit {
  color: #0F1E3D;
}

.amount-credit {
  color: #007C3D;
}

.payment-divider {
  height: 1rpx;
  background-color: #F0F2F5;
}

.download-receipts-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0 12rpx;
}

.download-icon {
  font-size: 28rpx;
  color: #5B6475;
}

.download-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #5B6475;
}

.scroll-spacer {
  height: 180rpx;
}
