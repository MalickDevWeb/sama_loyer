@import "/styles/sama-ui.wxss";

page {
  background: var(--sl-surface-2);
  height: 100%;
}

.bconv {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* --- En-tête ------------------------------------------------------------- */
.bconv__head {
  flex-shrink: 0;
  background: var(--sl-white);
}

.bconv__contact {
  height: 136rpx;
  box-sizing: border-box;
  padding: 20rpx 20rpx 20rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-bottom: 2rpx solid var(--sl-border);
}

.bconv__avatar {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  border-radius: 42rpx;
  color: var(--sl-on-dark);
  font-size: var(--sl-fs-body);
  font-weight: var(--sl-fw-extrabold);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bconv__who {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bconv__name {
  font-size: var(--sl-fs-subtitle);
  font-weight: var(--sl-fw-extrabold);
}

.bconv__tag {
  align-self: flex-start;
  margin-top: 4rpx;
  font-size: var(--sl-fs-caption);
  font-weight: var(--sl-fw-extrabold);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
}

.bconv__tag--hired {
  background: var(--sl-success-bg);
  color: var(--sl-success-text);
}

.bconv__listing {
  height: 120rpx;
  box-sizing: border-box;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 2rpx solid var(--sl-border);
}

.bconv__listing-thumb {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  border-radius: 20rpx;
  background: #FBE3EC;
}

.bconv__listing-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bconv__listing-title {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bconv__listing-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

/* --- Messages ------------------------------------------------------------ */
.bconv__messages {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 28rpx;
}

.bconv__day {
  text-align: center;
  font-size: var(--sl-fs-small);
  font-weight: var(--sl-fw-bold);
  color: var(--sl-muted);
  padding: 8rpx 0 16rpx;
}

.bconv__row {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 16rpx;
}

.bconv__row--me {
  justify-content: flex-end;
}

.bconv__bubble {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 28rpx;
  font-size: var(--sl-fs-body-lg);
  line-height: 1.4;
  background: var(--sl-white);
  color: var(--sl-text);
  border: 2rpx solid var(--sl-border);
  border-radius: 36rpx 36rpx 36rpx 8rpx;
}

.bconv__bubble--me {
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  border: 0;
  border-radius: 36rpx 36rpx 8rpx 36rpx;
}

.bconv__meta {
  align-self: flex-end;
  font-size: var(--sl-fs-caption);
  color: var(--sl-muted);
}

.bconv__bubble--me .bconv__meta {
  color: var(--sl-border-strong);
}

.bconv__event {
  margin: 8rpx auto 24rpx;
  max-width: 88%;
  width: fit-content;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: 32rpx;
  background: var(--sl-white);
  border: 2rpx solid var(--sl-border);
}

.bconv__event-icon {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 34rpx;
  background: var(--sl-info-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bconv__event-icon--green {
  background: var(--sl-success-bg);
}

.bconv__event-icon .ic {
  width: 32rpx;
  height: 32rpx;
}

.bconv__event-text {
  display: flex;
  flex-direction: column;
}

.bconv__event-title {
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
}

.bconv__event-sub {
  font-size: var(--sl-fs-small);
  color: var(--sl-muted);
}

.bconv__empty {
  text-align: center;
  padding: 60rpx 20rpx;
  font-size: var(--sl-fs-body-sm);
  color: var(--sl-muted);
}

.bconv__end {
  height: 8rpx;
}

/* --- Pied : actions, réponses rapides, saisie ---------------------------- */
.bconv__footer {
  flex-shrink: 0;
  background: var(--sl-white);
  border-top: 2rpx solid var(--sl-border);
  padding-bottom: env(safe-area-inset-bottom);
}

.bconv__chips {
  white-space: nowrap;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

.bconv__chips--quick {
  padding-top: 16rpx;
}

.bconv__chips-row {
  display: inline-flex;
  gap: 16rpx;
}

.bconv__action {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-extrabold);
  background: var(--sl-navy);
  color: var(--sl-on-dark);
  box-sizing: border-box;
}

.bconv__action--done {
  background: var(--sl-success-soft);
  color: var(--sl-success-text);
  border: 2rpx solid #BFDDCD;
}

.bconv__action-icon {
  width: 32rpx;
  height: 32rpx;
}

.bconv__quick {
  flex: 0 0 auto;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--sl-berry-border);
  background: var(--sl-berry-soft);
  color: var(--sl-berry-dark);
  font-size: var(--sl-fs-body-sm);
  font-weight: var(--sl-fw-bold);
  box-sizing: border-box;
}

.bconv__composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 40rpx;
}

.bconv__input-wrap {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 46rpx;
  background: var(--sl-surface-3);
  display: flex;
  align-items: center;
}

.bconv__input {
  flex: 1;
  height: 88rpx;
  font-size: var(--sl-fs-body-lg);
  color: var(--sl-text);
}

.bconv__placeholder {
  color: var(--sl-placeholder);
}

.bconv__send {
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  border-radius: 46rpx;
  background: var(--sl-berry);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bconv__send-icon {
  width: 40rpx;
  height: 40rpx;
}
