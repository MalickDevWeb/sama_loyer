/* ==========================================================================
   Page Mes Locataires & Clients Bailleur - SAMA LOGEMENT
   ========================================================================== */

.clients-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F8F9FA;
  box-sizing: border-box;
}

/* Custom Navigation Bar */
.nav-bar-custom {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EAECEF;
  z-index: 100;
}

.btn-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F0F2F5;
}

.arrow-back {
  font-size: 52rpx;
  color: #0F1E3D;
  line-height: 1;
  margin-top: -6rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.nav-placeholder {
  width: 72rpx;
}

.clients-scroll {
  flex: 1;
  box-sizing: border-box;
}

/* KPI Banner */
.clients-kpi-banner {
  margin: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kpi-mini-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.kpi-mini-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.green-text {
  color: #007C3D;
}

.kpi-mini-lbl {
  font-size: 20rpx;
  color: #5B6475;
}

.kpi-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #ECEFF2;
}

/* Filter pills */
.clients-filter-pills {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.filter-pill {
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 600;
  background-color: #F4F6F9;
  color: #0F1E3D;
}

.filter-pill--active {
  background-color: #0F1E3D;
  color: #FFFFFF;
}

/* Clients list */
.clients-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.client-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #ECEFF2;
  box-shadow: 0 4rpx 16rpx rgba(15, 30, 61, 0.04);
}

.client-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.client-avatar-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.client-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.client-avatar.lg {
  width: 100rpx;
  height: 100rpx;
}

.avatar-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.avatar-text.lg {
  font-size: 38rpx;
}

.client-meta-col {
  display: flex;
  flex-direction: column;
}

.client-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.client-phone {
  font-size: 24rpx;
  color: #5B6475;
  margin-bottom: 4rpx;
}

.client-cni {
  font-size: 20rpx;
  font-weight: 700;
  color: #007C3D;
}

.client-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
}

.badge-paid {
  background-color: #E2F0EA;
  color: #007C3D;
}

.badge-upcoming {
  background-color: #FFF3DC;
  color: #B56200;
}

/* Property box */
.client-prop-box {
  background-color: #F8F9FA;
  border-radius: 18rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.prop-detail-left {
  display: flex;
  flex-direction: column;
}

.client-prop-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 4rpx;
}

.client-entry-date {
  font-size: 22rpx;
  color: #8C96A6;
}

.prop-detail-right {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.client-rent-amount {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.client-rent-unit {
  font-size: 20rpx;
  color: #5B6475;
}

/* Pay notice */
.client-pay-notice {
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.notice-paid {
  background-color: #F0F9F4;
  border: 1rpx solid #CCEBD9;
}

.notice-upcoming {
  background-color: #FFF9ED;
  border: 1rpx solid #F5E8D3;
}

.pay-notice-text {
  font-size: 22rpx;
  line-height: 1.4;
}

.notice-paid .pay-notice-text {
  color: #007C3D;
}

.notice-upcoming .pay-notice-text {
  color: #8A5A00;
}

/* Actions */
.client-actions-row {
  display: flex;
  gap: 12rpx;
}

.btn-client-action {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin: 0;
  padding: 0;
}

.act-icon {
  font-size: 24rpx;
}

.btn-call {
  background-color: #0F1E3D;
  color: #FFFFFF;
}

.btn-wa {
  background-color: #FFFFFF;
  border: 1.5rpx solid #CCEBD9;
  color: #007C3D;
}

.btn-receipt {
  background-color: #FFFFFF;
  border: 1.5rpx solid #ECEFF2;
  color: #5B6475;
}

/* Modal Bottom Sheet */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 30, 61, 0.6);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.detail-modal-card {
  width: 100%;
  background-color: #FFFFFF;
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  padding: 24rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal-handle {
  width: 72rpx;
  height: 8rpx;
  background-color: #D1D5DB;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.modal-client-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.modal-client-titles {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.modal-client-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F1E3D;
}

.modal-client-phone {
  font-size: 24rpx;
  color: #5B6475;
}

.btn-modal-close {
  font-size: 36rpx;
  color: #A0AAB8;
  padding: 10rpx;
}

.modal-info-block {
  background-color: #F8F9FA;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.info-line {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-k {
  font-size: 24rpx;
  color: #5B6475;
}

.info-v {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.highlight-price {
  color: #C8235F;
}

.green-badge-txt {
  color: #007C3D;
}

.modal-btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-modal-action {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-receipt-full {
  background-color: #C8235F;
  color: #FFFFFF;
}

.scroll-spacer {
  height: 180rpx;
}

