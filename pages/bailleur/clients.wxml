<view class="clients-page">
  <!-- Barre supérieure personnalisée -->
  <view class="nav-bar-custom" style="padding-top: {{ statusBarHeight }}px; height: {{ navBarHeight }}px;">
    <view class="btn-back" bindtap="onGoBack">
      <text class="arrow-back">‹</text>
    </view>
    <text class="nav-title">Mes locataires & clients</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="clients-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" style="padding-top: {{ statusBarHeight + navBarHeight }}px;">
    
    <!-- Résumé KPI du portefeuille de clients -->
    <view class="clients-kpi-banner">
      <view class="kpi-mini-col">
        <text class="kpi-mini-val">2</text>
        <text class="kpi-mini-lbl">Locataires actifs</text>
      </view>
      <view class="kpi-divider"></view>
      <view class="kpi-mini-col">
        <text class="kpi-mini-val">205 000 F</text>
        <text class="kpi-mini-lbl">Loyers perçus</text>
      </view>
      <view class="kpi-divider"></view>
      <view class="kpi-mini-col">
        <text class="kpi-mini-val green-text">0</text>
        <text class="kpi-mini-lbl">Impayé</text>
      </view>
    </view>

    <!-- Filtres rapides -->
    <view class="clients-filter-pills">
      <view 
        class="filter-pill {{ activeFilter === 'all' ? 'filter-pill--active' : '' }}"
        data-filter="all"
        bindtap="onFilterSelect"
      >
        Tous (3)
      </view>
      <view 
        class="filter-pill {{ activeFilter === 'actif' ? 'filter-pill--active' : '' }}"
        data-filter="actif"
        bindtap="onFilterSelect"
      >
        En cours (2)
      </view>
      <view 
        class="filter-pill {{ activeFilter === 'futur' ? 'filter-pill--active' : '' }}"
        data-filter="futur"
        bindtap="onFilterSelect"
      >
        À venir (1)
      </view>
    </view>

    <!-- Liste des fiches clients -->
    <view class="clients-list">
      <block wx:for="{{ filteredClients }}" wx:key="id">
        <view class="client-card">
          
          <!-- Ligne haute : Avatar, Nom, Statut de paiement -->
          <view class="client-card-top" data-client="{{ item }}" bindtap="onViewClientDetail">
            <view class="client-avatar-row">
              <view class="client-avatar" style="background-color: {{ item.avatarBg }};">
                <text class="avatar-text">{{ item.initials }}</text>
              </view>
              <view class="client-meta-col">
                <text class="client-name">{{ item.name }}</text>
                <text class="client-phone">{{ item.phone }}</text>
                <text class="client-cni">{{ item.cniStatus }}</text>
              </view>
            </view>

            <view class="client-badge {{ item.paymentStatus === 'paid' ? 'badge-paid' : 'badge-upcoming' }}">
              {{ item.paymentLabel }}
            </view>
          </view>

          <!-- Détail du logement loué -->
          <view class="client-prop-box">
            <view class="prop-detail-left">
              <text class="client-prop-name">🏠 {{ item.property }}</text>
              <text class="client-entry-date">{{ item.dateEntry }}</text>
            </view>
            <view class="prop-detail-right">
              <text class="client-rent-amount">{{ item.rent }}</text>
              <text class="client-rent-unit">/ mois</text>
            </view>
          </view>

          <!-- Encadré statut de paiement du loyer -->
          <view class="client-pay-notice {{ item.paymentStatus === 'paid' ? 'notice-paid' : 'notice-upcoming' }}">
            <text class="pay-notice-text">{{ item.paymentDetail }}</text>
          </view>

          <!-- Actions de contact et quittance -->
          <view class="client-actions-row">
            <button class="btn-client-action btn-call" data-phone="{{ item.phoneRaw }}" bindtap="onCallClient">
              <text class="act-icon">📞</text> Appeler
            </button>
            <button class="btn-client-action btn-wa" data-client="{{ item }}" bindtap="onWhatsAppClient">
              <text class="act-icon">💬</text> WhatsApp
            </button>
            <button class="btn-client-action btn-receipt" data-client="{{ item }}" bindtap="onOpenQuittance">
              <text class="act-icon">📄</text> Quittance
            </button>
          </view>

        </view>
      </block>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>

  <!-- Modale Fiche Détaillée Locataire -->
  <view wx:if="{{ showModal }}" class="modal-backdrop" bindtap="onCloseModal">
    <view class="detail-modal-card" catchtap="true">
      <view class="modal-handle"></view>

      <view class="modal-client-header">
        <view class="client-avatar lg" style="background-color: {{ selectedClient.avatarBg }};">
          <text class="avatar-text lg">{{ selectedClient.initials }}</text>
        </view>
        <view class="modal-client-titles">
          <text class="modal-client-name">{{ selectedClient.name }}</text>
          <text class="modal-client-phone">{{ selectedClient.phone }} · {{ selectedClient.cniStatus }}</text>
        </view>
        <view class="btn-modal-close" bindtap="onCloseModal">✕</view>
      </view>

      <view class="modal-info-block">
        <view class="info-line">
          <text class="info-k">Logement sous contrat :</text>
          <text class="info-v">{{ selectedClient.property }}</text>
        </view>
        <view class="info-line">
          <text class="info-k">Loyer mensuel :</text>
          <text class="info-v highlight-price">{{ selectedClient.rent }} CFA</text>
        </view>
        <view class="info-line">
          <text class="info-k">Caution déclarée :</text>
          <text class="info-v">{{ selectedClient.deposit }}</text>
        </view>
        <view class="info-line">
          <text class="info-k">Statut du mois :</text>
          <text class="info-v green-badge-txt">{{ selectedClient.paymentLabel }}</text>
        </view>
        <view class="info-line">
          <text class="info-k">Dernière quittance :</text>
          <text class="info-v">#{{ selectedClient.receiptNumber }}</text>
        </view>
      </view>

      <view class="modal-btn-row">
        <button class="btn-modal-action btn-call" data-phone="{{ selectedClient.phoneRaw }}" bindtap="onCallClient">
          📞 Appeler directement
        </button>
        <button class="btn-modal-action btn-receipt-full" data-client="{{ selectedClient }}" bindtap="onOpenQuittance">
          📄 Télécharger la quittance
        </button>
      </view>
    </view>
  </view>

  <!-- Bailleur Tab Bar -->
  <app-custom-tab-bar activeTab="b-home" />
</view>
