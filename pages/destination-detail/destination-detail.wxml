<destination-detail-skeleton wx:if="{{ pageState === 'loading' }}" pageTopOffset="{{ pageTopOffset }}" />

<view class="destination-detail-page" wx:elif="{{ pageState === 'success' }}">
  <scroll-view
    class="destination-detail-page__scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="destination-detail-page__inner" style="padding-top: {{ pageTopOffset }}px;">
      <view class="detail-hero-container">
        <view class="detail-hero">
          <osn-image
            src="{{ destination.heroImage }}"
            mode="aspectFill"
            containerStyle="width: 100%; height: 100%; display: block;"
            imageStyle="width: 100%; height: 100%; border-radius: 40rpx;"
          />

          <view class="detail-floating-button detail-floating-button--back" catchtap="handleBack">
            <app-icon
              icon="arrow-left"
              width="{{40}}"
              height="{{40}}"
              enableBg="{{false}}"
              containerStyle="padding: 0 !important;"
              bind:iconTap="handleBack"
            />
          </view>

          <view class="detail-floating-button detail-floating-button--favorite" catchtap="handleToggleLike">
            <block wx:if="{{ isLiked }}">
              <app-icon
                icon="heartRed"
                width="{{38}}"
                height="{{36}}"
                enableBg="{{false}}"
                containerStyle="padding: 0 !important; transform: translateY(2rpx);"
              />
            </block>
            <block wx:else>
              <app-icon
                icon="heart"
                width="{{38}}"
                height="{{36}}"
                enableBg="{{false}}"
                containerStyle="padding: 0 !important; transform: translateY(2rpx);"
              />
            </block>
          </view>
        </view>
      </view>

      <view class="detail-content">
        <app-typography containerClass="detail-title" fontSize="48rpx" weight="700" color="#1C1C1C" lineHeight="58rpx">
          {{ destination.title }}
        </app-typography>

        <view class="detail-rating-row">
          <view class="detail-stars">
            <text
              wx:for="{{ destination.stars }}"
              wx:key="value"
              class="detail-star {{ item.active ? 'detail-star--active' : 'detail-star--inactive' }}"
            >{{ item.icon }}</text>
          </view>
          <app-typography containerClass="detail-rating-score" fontSize="30rpx" weight="700" color="#1C1C1C" lineHeight="38rpx">
            {{ destination.ratingLabel }}
          </app-typography>

          <app-typography containerClass="detail-rating-count" fontSize="28rpx" weight="400" color="#667085" lineHeight="40rpx">
            {{ destination.reviewLabel }}
          </app-typography>
        </view>

        <view class="detail-meta-row">
          <view class="detail-meta-item">
            <app-icon
              icon="localisation"
              width="{{28}}"
              height="{{28}}"
              enableBg="{{false}}"
              containerStyle="padding: 0 !important;"
            />
            <app-typography containerClass="detail-meta-text" fontSize="28rpx" weight="400" color="#667085" lineHeight="40rpx">
              {{ destination.subtitle }}
            </app-typography>
          </view>

          <view class="detail-meta-item">
            <app-icon
              icon="calendrier"
              width="{{28}}"
              height="{{28}}"
              enableBg="{{false}}"
              containerStyle="padding: 0 !important;"
            />
            <app-typography containerClass="detail-meta-text" fontSize="28rpx" weight="400" color="#667085" lineHeight="40rpx">
              {{ destination.duration }}
            </app-typography>
          </view>
        </view>

        <view class="detail-section">
          <app-typography containerClass="detail-section-title" fontSize="36rpx" weight="700" color="#1C1C1C" lineHeight="48rpx">
            À Propos de Cette Expérience
          </app-typography>

          <app-typography containerClass="detail-description" fontSize="34rpx" weight="400" color="#667085" lineHeight="52rpx">
            {{ destination.description }}
          </app-typography>
        </view>

        <view class="detail-category-pill">
          <app-typography containerClass="detail-category-text" fontSize="28rpx" weight="500" color="#1C1C1C" lineHeight="40rpx">
            Catégorie: {{ destination.category }}
          </app-typography>
        </view>

        <view class="detail-section detail-section--gallery">
          <app-typography containerClass="detail-section-title" fontSize="36rpx" weight="700" color="#1C1C1C" lineHeight="48rpx">
            Galerie Photos
          </app-typography>

          <view wx:if="{{ destination.galleryMode === 'single' }}" class="detail-gallery detail-gallery--single">
            <view
              class="detail-gallery__full"
              data-index="{{0}}"
              catchtap="handlePreviewGallery"
            >
              <osn-image
                src="{{ destination.mainGalleryImage }}"
                mode="aspectFill"
                data-index="{{0}}"
                containerStyle="width: 100%; height: 100%; display: block;"
                imageStyle="width: 100%; height: 100%; border-radius: 28rpx;"
              />
            </view>
          </view>

          <view wx:elif="{{ destination.galleryMode === 'double' }}" class="detail-gallery detail-gallery--double">
          
            <view
  wx:for="{{ destination.gallery }}"
  wx:key="*this"
  wx:for-item="item"
  wx:for-index="index"
  class="detail-gallery__full"
  data-index="{{index}}"
  catchtap="handlePreviewGallery"
>
              <osn-image
                src="{{ item }}"
                mode="aspectFill"
                data-index="{{index}}"
                containerStyle="width: 100%; height: 100%; display: block;"
                imageStyle="width: 100%; height: 100%; border-radius: 28rpx;"
              />
            </view>
          </view>

          <view wx:else class="detail-gallery detail-gallery--mosaic">
            <view
              class="detail-gallery__full"
              data-index="{{0}}"
              catchtap="handlePreviewGallery"
            >
              <osn-image
                src="{{ destination.mainGalleryImage }}"
                mode="aspectFill"
                data-index="{{0}}"
                containerStyle="width: 100%; height: 100%; display: block;"
                imageStyle="width: 100%; height: 100%; border-radius: 28rpx;"
              />
            </view>

            <view class="detail-gallery__grid">
              <view
                wx:for="{{ destination.remainingGalleryItems }}"
                wx:key="src"
                class="detail-gallery__grid-item {{ item.fullWidth ? 'detail-gallery__grid-item--full' : '' }}"
                data-index="{{item.index}}"
                catchtap="handlePreviewGallery"
              >
                <osn-image
                  src="{{ item.src }}"
                  mode="aspectFill"
                  data-index="{{item.index}}"
                  containerStyle="width: 100%; height: 100%; display: block;"
                  imageStyle="width: 100%; height: 100%; border-radius: 24rpx;"
                />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="detail-booking-bar">
    <view class="detail-booking-price">
      <app-typography containerClass="detail-booking-label" fontSize="28rpx" weight="400" color="#667085" lineHeight="34rpx">
        À partir de
      </app-typography>

      <view class="detail-booking-price-line">
        <app-typography containerClass="detail-booking-amount" fontSize="48rpx" weight="700" color="#1C1C1C" lineHeight="58rpx">
          {{ destination.price }}
        </app-typography>
        <app-typography containerClass="detail-booking-unit" fontSize="24rpx" weight="400" color="#667085" lineHeight="32rpx">
          /pers
        </app-typography>
      </view>
    </view>

    <view class="detail-booking-button">
      <app-button
        type="primary"
        buttonClass="destination-detail-booking-button"
        bind:onPress="handleReserve"
      >
        <app-typography containerClass="detail-booking-button-label" fontSize="32rpx" weight="600" color="#FFFFFF" lineHeight="48rpx" align="center">
          Réserver
        </app-typography>
      </app-button>
    </view>
  </view>
</view>

<view wx:elif="{{ pageState === 'notFound' }}" class="destination-detail-page destination-detail-page--empty">
  <view class="detail-empty-card">
    <app-typography containerClass="detail-empty-title" fontSize="36rpx" weight="700" color="#1C1C1C" lineHeight="48rpx">
      Destination introuvable
    </app-typography>

    <app-typography containerClass="detail-empty-text" fontSize="28rpx" weight="400" color="#667085" lineHeight="40rpx">
      {{ errorMessage }}
    </app-typography>

    <view class="detail-empty-button" bindtap="handleBack">
      <app-typography fontSize="28rpx" weight="700" color="#FFFFFF" lineHeight="40rpx">
        Retour
      </app-typography>
    </view>
  </view>
</view>

<view wx:elif="{{ pageState === 'error' }}" class="destination-detail-page destination-detail-page--empty">
  <view class="detail-empty-card">
    <app-typography containerClass="detail-empty-title" fontSize="36rpx" weight="700" color="#1C1C1C" lineHeight="48rpx">
      Impossible de charger la destination
    </app-typography>
    <app-typography containerClass="detail-empty-text" fontSize="28rpx" weight="400" color="#667085" lineHeight="40rpx">
      {{ errorMessage }}
    </app-typography>
    <view wx:if="{{ canRetry }}" class="detail-empty-button" bindtap="retryLoad">
      <app-typography fontSize="28rpx" weight="700" color="#FFFFFF" lineHeight="40rpx">
        Réessayer
      </app-typography>
    </view>
    <view class="detail-empty-button detail-empty-button--back" bindtap="handleBack">
      <app-typography fontSize="28rpx" weight="700" color="#16A34A" lineHeight="40rpx">
        Retour
      </app-typography>
    </view>
  </view>
</view>

<view wx:if="{{ showPreview }}" class="custom-preview-overlay">
  <view class="custom-preview-header">
    <view class="custom-preview-counter">
      {{ previewIndex + 1 }} / {{ previewGallery.length }}
    </view>
    <view class="custom-preview-close" catchtap="closePreview">
      <text class="close-text">✕</text>
    </view>
  </view>
<swiper 
  class="custom-preview-swiper"
  current="{{ previewIndex }}"
  circular="true"
  bindchange="onPreviewChange"
>
  <swiper-item wx:for="{{ previewGallery }}" wx:key="*this">
    <image src="{{ item }}" mode="aspectFill" class="custom-preview-image" />
  </swiper-item>
</swiper>

  <view class="custom-preview-arrow custom-preview-arrow--left" catchtap="prevPreviewImage">
    <text class="arrow-text">❮</text>
  </view>
  <view class="custom-preview-arrow custom-preview-arrow--right" catchtap="nextPreviewImage">
    <text class="arrow-text">❯</text>
  </view>
</view>
