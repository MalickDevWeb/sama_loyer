<view class="chat-page">
  
  <!-- En-tête de chat -->
  <view class="chat-top-header" style="padding-top: {{ statusBarHeight + 10 }}px;">
    <view class="btn-chat-back" bindtap="onBackTap">‹</view>
    <view class="chat-user-info">
      <view class="user-avatar-round">
        <text>MD</text>
        <view class="online-dot"></view>
      </view>
      <view class="user-meta-col">
        <text class="user-chat-name">Moussa D.</text>
        <text class="user-status-text">✓ Bailleur vérifié · en ligne</text>
      </view>
    </view>
    <view class="chat-header-actions">
      <view class="action-circle-icon" bindtap="onCall">📞</view>
      <view class="action-circle-icon whatsapp-color" bindtap="onWhatsApp">💬</view>
    </view>
  </view>

  <!-- Bandeau Logement concerné -->
  <view class="property-context-bar" bindtap="onPropertyBannerTap">
    <view class="prop-mini-thumb">
      <view class="prop-house-mini"></view>
    </view>
    <view class="prop-meta-col">
      <text class="prop-meta-title">Chambre salon avec douche intérieure</text>
      <text class="prop-meta-price">Icotaf, Pikine · 65 000 FCFA/mois</text>
    </view>
    <text class="prop-arrow">›</text>
  </view>

  <!-- Alerte Sécurité Jaune -->
  <view class="security-banner-box">
    <text class="security-icon">⚠️</text>
    <text class="security-text">Sécurité : ne payez jamais de caution ou d’avance avant d’avoir visité le logement et signé un contrat.</text>
  </view>

  <!-- Zone de défilement des messages -->
  <scroll-view class="chat-conversation-scroll" scroll-y="{{true}}">
    <view class="chat-date-pill">Aujourd'hui</view>

    <view class="messages-flow">
      <block wx:for="{{ messages }}" wx:key="id">
        
        <!-- Bulle Client -->
        <view wx:if="{{ item.sender === 'client' }}" class="chat-bubble-row row-right">
          <view class="chat-bubble bubble-pink">
            <text class="bubble-content-text">{{ item.text }}</text>
            <text class="bubble-timestamp">{{ item.time }}</text>
          </view>
        </view>

        <!-- Bulle Bailleur -->
        <view wx:elif="{{ item.sender === 'bailleur' }}" class="chat-bubble-row row-left">
          <view class="chat-bubble bubble-white">
            <text class="bubble-content-text">{{ item.text }}</text>
            <text class="bubble-timestamp text-dark">{{ item.time }}</text>
          </view>
        </view>

        <!-- Carte Événement Visite -->
        <view wx:elif="{{ item.isEvent }}" class="chat-event-card">
          <view class="event-icon-circle">📅</view>
          <view class="event-text-col">
            <text class="event-title-bold">{{ item.eventTitle }}</text>
            <text class="event-date-sub">{{ item.eventDate }}</text>
          </view>
        </view>

      </block>
    </view>
  </scroll-view>

  <!-- Suggestions rapides -->
  <scroll-view class="quick-replies-scroll" scroll-x="{{true}}">
    <view class="quick-replies-row">
      <block wx:for="{{ quickReplies }}" wx:key="*this">
        <view class="quick-chip" data-text="{{ item }}" bindtap="onQuickReplyTap">
          {{ item }}
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- Barre de saisie -->
  <view class="chat-bottom-input-bar">
    <view class="btn-attach-image">🖼</view>
    <input
      class="chat-input-pill"
      placeholder="Écrire un message..."
      value="{{ inputText }}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSendTap"
    />
    <view class="btn-send-round" bindtap="onSendTap">
      <text class="send-char">➤</text>
    </view>
  </view>

</view>

