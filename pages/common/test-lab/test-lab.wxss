.test-lab-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F8FAFC;
}

.test-lab-header {
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
}

.test-lab-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
}

.test-lab-title-box {
  display: flex;
  flex-direction: column;
}

.test-lab-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0A192F;
}

.test-lab-sub {
  font-size: 20rpx;
  color: #64748B;
}

.test-lab-body {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.test-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1.5rpx solid #E2E8F0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.test-card-head {
  margin-bottom: 20rpx;
}

.test-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #C8235F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.test-card-desc {
  display: block;
  font-size: 22rpx;
  color: #64748B;
}

/* Grille de scénarios */
.scenarios-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.scenario-btn {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  gap: 16rpx;
  transition: all 0.2s ease;
}

.scenario-btn:active {
  background: #F1F5F9;
  border-color: #C8235F;
}

.scenario-btn--bailleur {
  background: #F0F4FF;
  border-color: #C7D2FE;
}

.scenario-btn__icon {
  font-size: 34rpx;
}

.scenario-btn__text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.scenario-btn__title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}

.scenario-btn__sub {
  font-size: 20rpx;
  color: #64748B;
}

/* Boîtes de règles */
.rule-box {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1.5rpx dashed #E2E8F0;
}

.rule-box:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.rule-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.btn-cluster {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.btn-test {
  margin: 0 !important;
  padding: 12rpx 20rpx !important;
  font-size: 20rpx !important;
  font-weight: 700 !important;
  border-radius: 12rpx !important;
  line-height: 1.3 !important;
}

.btn-test--pass {
  background: #ECFDF5 !important;
  color: #065F46 !important;
  border: 1.5rpx solid #10B981 !important;
}

.btn-test--fail {
  background: #FEF2F2 !important;
  color: #991B1B !important;
  border: 1.5rpx solid #EF4444 !important;
}

.btn-test--wide {
  width: 100% !important;
  background: #F8FAFC !important;
  color: #0F172A !important;
  border: 1.5rpx solid #CBD5E1 !important;
}

.rule-result {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.35;
}

.rule-result--success {
  background: #ECFDF5;
  color: #065F46;
  border: 1.5rpx solid #A7F3D0;
}

.rule-result--reject {
  background: #FFF1F2;
  color: #9F1239;
  border: 1.5rpx solid #FECDD3;
}

/* Terminal */
.terminal-box {
  background: #0A192F;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  max-height: 380rpx;
  overflow-y: auto;
  font-family: monospace;
}

.term-line {
  display: flex;
  gap: 12rpx;
  font-size: 19rpx;
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.term-time {
  color: #64748B;
  white-space: nowrap;
}

.term-line--info .term-msg {
  color: #93C5FD;
}

.term-line--success .term-msg {
  color: #34D399;
}

.term-line--reject .term-msg {
  color: #F87171;
}


/* Styles Création de groupe */
.test-card--highlight {
  border: 2.5rpx solid #10B981;
  background: #F0FDF4;
}

.test-badge--green {
  background: #059669 !important;
}

.group-form-box {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1.5rpx solid #E2E8F0;
}

.group-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.group-input-wrap {
  background: #F8FAFC;
  border: 2rpx solid #CBD5E1;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

.group-input {
  font-size: 24rpx;
  font-weight: 600;
  color: #0F172A;
}

.group-segmented {
  display: flex;
  background: #F1F5F9;
  border-radius: 12rpx;
  padding: 6rpx;
  gap: 8rpx;
}

.group-seg {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #64748B;
  border-radius: 8rpx;
}

.group-seg--active {
  background: #FFFFFF;
  color: #0F172A;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.btn-create-group {
  margin-top: 20rpx !important;
  background: #C8235F !important;
  color: #FFFFFF !important;
  font-size: 24rpx !important;
  font-weight: 800 !important;
  border-radius: 14rpx !important;
  padding: 16rpx !important;
}

.created-group-card {
  margin-top: 18rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #A7F3D0;
}

.created-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.created-group-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #065F46;
}

.created-group-badge {
  background: #ECFDF5;
  color: #059669;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.created-group-creator, .created-group-token {
  display: block;
  font-size: 20rpx;
  color: #64748B;
  margin-top: 6rpx;
}

.created-group-token {
  font-family: monospace;
  color: #059669;
  background: #F0FDF4;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  margin-top: 10rpx;
}

.created-group-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.btn-group-action {
  margin: 0 !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  border-radius: 12rpx !important;
  padding: 14rpx !important;
}

.btn-group-action--wa {
  background: #ECFDF5 !important;
  color: #065F46 !important;
  border: 1.5rpx solid #059669 !important;
}

.btn-group-action--book {
  background: #0A192F !important;
  color: #FFFFFF !important;
}
