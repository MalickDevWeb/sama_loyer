.test-lab-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F8FAFC;
}

.test-lab-header {
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
}

.test-lab-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
}

.test-lab-title-box {
  display: flex;
  flex-direction: column;
}

.test-lab-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0A192F;
}

.test-lab-sub {
  font-size: 20rpx;
  color: #64748B;
}

.test-lab-body {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.test-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1.5rpx solid #E2E8F0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.test-card-head {
  margin-bottom: 20rpx;
}

.test-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #C8235F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.test-card-desc {
  display: block;
  font-size: 22rpx;
  color: #64748B;
}

/* Grille de scénarios */
.scenarios-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.scenario-btn {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  gap: 16rpx;
  transition: all 0.2s ease;
}

.scenario-btn:active {
  background: #F1F5F9;
  border-color: #C8235F;
}

.scenario-btn--bailleur {
  background: #F0F4FF;
  border-color: #C7D2FE;
}

.scenario-btn__icon {
  font-size: 34rpx;
}

.scenario-btn__text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.scenario-btn__title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}

.scenario-btn__sub {
  font-size: 20rpx;
  color: #64748B;
}

/* Boîtes de règles */
.rule-box {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1.5rpx dashed #E2E8F0;
}

.rule-box:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.rule-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.btn-cluster {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.btn-test {
  margin: 0 !important;
  padding: 12rpx 20rpx !important;
  font-size: 20rpx !important;
  font-weight: 700 !important;
  border-radius: 12rpx !important;
  line-height: 1.3 !important;
}

.btn-test--pass {
  background: #ECFDF5 !important;
  color: #065F46 !important;
  border: 1.5rpx solid #10B981 !important;
}

.btn-test--fail {
  background: #FEF2F2 !important;
  color: #991B1B !important;
  border: 1.5rpx solid #EF4444 !important;
}

.btn-test--wide {
  width: 100% !important;
  background: #F8FAFC !important;
  color: #0F172A !important;
  border: 1.5rpx solid #CBD5E1 !important;
}

.rule-result {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.35;
}

.rule-result--success {
  background: #ECFDF5;
  color: #065F46;
  border: 1.5rpx solid #A7F3D0;
}

.rule-result--reject {
  background: #FFF1F2;
  color: #9F1239;
  border: 1.5rpx solid #FECDD3;
}

/* Terminal */
.terminal-box {
  background: #0A192F;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  max-height: 380rpx;
  overflow-y: auto;
  font-family: monospace;
}

.term-line {
  display: flex;
  gap: 12rpx;
  font-size: 19rpx;
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.term-time {
  color: #64748B;
  white-space: nowrap;
}

.term-line--info .term-msg {
  color: #93C5FD;
}

.term-line--success .term-msg {
  color: #34D399;
}

.term-line--reject .term-msg {
  color: #F87171;
}


/* Styles Création de groupe */
.test-card--highlight {
  border: 2.5rpx solid #10B981;
  background: #F0FDF4;
}

.test-badge--green {
  background: #059669 !important;
}

.group-form-box {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1.5rpx solid #E2E8F0;
}

.group-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.group-input-wrap {
  background: #F8FAFC;
  border: 2rpx solid #CBD5E1;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

.group-input {
  font-size: 24rpx;
  font-weight: 600;
  color: #0F172A;
}

.group-segmented {
  display: flex;
  background: #F1F5F9;
  border-radius: 12rpx;
  padding: 6rpx;
  gap: 8rpx;
}

.group-seg {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #64748B;
  border-radius: 8rpx;
}

.group-seg--active {
  background: #FFFFFF;
  color: #0F172A;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.btn-create-group {
  margin-top: 20rpx !important;
  background: #C8235F !important;
  color: #FFFFFF !important;
  font-size: 24rpx !important;
  font-weight: 800 !important;
  border-radius: 14rpx !important;
  padding: 16rpx !important;
}

.created-group-card {
  margin-top: 18rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #A7F3D0;
}

.created-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.created-group-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #065F46;
}

.created-group-badge {
  background: #ECFDF5;
  color: #059669;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.created-group-creator, .created-group-token {
  display: block;
  font-size: 20rpx;
  color: #64748B;
  margin-top: 6rpx;
}

.created-group-token {
  font-family: monospace;
  color: #059669;
  background: #F0FDF4;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  margin-top: 10rpx;
}

.created-group-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.btn-group-action {
  margin: 0 !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  border-radius: 12rpx !important;
  padding: 14rpx !important;
}

.btn-group-action--wa {
  background: #ECFDF5 !important;
  color: #065F46 !important;
  border: 1.5rpx solid #059669 !important;
}

.btn-group-action--book {
  background: #0A192F !important;
  color: #FFFFFF !important;
}

/* ======================================================== */
/* SECTION PERSONAS & SIMULATEUR MULTI-UTILISATEURS         */
/* ======================================================== */
.test-card--personas {
  border-top: 6rpx solid #8B5CF6;
  background: #FFFFFF;
}

.test-badge--purple {
  background: #8B5CF6 !important;
  color: #FFFFFF !important;
}

.personas-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  gap: 16rpx;
  margin: 16rpx 0 24rpx 0;
  padding-bottom: 8rpx;
  width: 100%;
}

.persona-tab {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  margin-right: 14rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.persona-tab--active {
  background: #F5F3FF;
  border-color: #8B5CF6;
  box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.15);
}

.persona-tab__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.persona-tab__emoji {
  font-size: 28rpx;
}

.persona-tab__meta {
  display: flex;
  flex-direction: column;
}

.persona-tab__name {
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
}

.persona-tab__name--active {
  color: #7C3AED;
}

.persona-tab__role {
  font-size: 18rpx;
  color: #64748B;
}

/* Fiche Persona Active */
.active-persona-card {
  background: #FAF5FF;
  border-radius: 16rpx;
  border: 1.5rpx solid #E9D5FF;
  border-left-width: 8rpx;
  padding: 20rpx;
}

.active-persona-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.active-persona-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.active-persona-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(139, 92, 246, 0.2);
}

.active-persona-icon {
  font-size: 40rpx;
}

.active-persona-info {
  display: flex;
  flex-direction: column;
}

.active-persona-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.active-persona-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #0A192F;
}

.active-persona-pill {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.active-persona-sub {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.active-persona-props {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border: 1rpx solid #EDE9FE;
  margin-bottom: 20rpx;
}

.persona-prop-item {
  display: flex;
  font-size: 20rpx;
  gap: 10rpx;
  line-height: 1.4;
}

.prop-label {
  font-weight: 700;
  color: #4B5563;
  width: 140rpx;
  flex-shrink: 0;
}

.prop-val {
  color: #1F2937;
  flex: 1;
}

/* Actions Dédiées */
.persona-actions-head {
  margin-bottom: 14rpx;
}

.persona-actions-title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: #1E293B;
}

.persona-actions-sub {
  display: block;
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.persona-actions-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.persona-action-card {
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  border: 1.5rpx solid #E2E8F0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.persona-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.persona-action-desc {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.persona-action-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #0F172A;
}

.persona-action-subtitle {
  font-size: 19rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.btn-persona-exec {
  margin: 0 !important;
  font-size: 20rpx !important;
  font-weight: 700 !important;
  padding: 10rpx 20rpx !important;
  border-radius: 10rpx !important;
  flex-shrink: 0;
  line-height: 1.4 !important;
}

.btn-persona-exec--primary {
  background: #0284C7 !important;
  color: #FFFFFF !important;
}

.btn-persona-exec--success {
  background: #10B981 !important;
  color: #FFFFFF !important;
}

.btn-persona-exec--danger {
  background: #EF4444 !important;
  color: #FFFFFF !important;
}

/* Rendu du Résultat d'Action */
.persona-action-result {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  animation: fadeIn 0.25s ease;
}

.persona-action-result--success {
  background: #F0FDF4;
  border: 1.5rpx solid #86EFAC;
}

.persona-action-result--reject {
  background: #FEF2F2;
  border: 1.5rpx solid #FCA5A5;
}

.persona-action-result--info {
  background: #F0F9FF;
  border: 1.5rpx solid #BAE6FD;
}

.result-title {
  font-size: 21rpx;
  font-weight: 800;
  color: #0F172A;
}

.result-detail {
  font-size: 19rpx;
  color: #334155;
  line-height: 1.4;
}

.btn-action-goto {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
  padding: 8rpx 12rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  border: 1rpx solid #CBD5E1;
  align-self: flex-start;
}

.goto-text {
  font-size: 19rpx;
  font-weight: 700;
  color: #C8235F;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-4rpx); }
  to { opacity: 1; transform: translateY(0); }
}
