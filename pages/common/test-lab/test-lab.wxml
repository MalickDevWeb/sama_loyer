<view class="test-lab-page">
  <!-- Barre supérieure fixe -->
  <sama-top-bar />
  <view class="test-lab-header">
    <view class="test-lab-nav">
      <view class="btn-back" bindtap="onBack">
        <view class="ic ic-back-navy ic--md"></view>
      </view>
      <view class="test-lab-title-box">
        <text class="test-lab-title">🧪 Laboratoire de Test SAMA LOYER</text>
        <text class="test-lab-sub">Vérification interactive du Prompt Maître</text>
      </view>
    </view>
  </view>

  <scroll-view class="test-lab-body" scroll-y="{{true}}">

    <!-- ======================================================== -->
    <!-- SECTION 0 : SIMULATEUR MULTI-UTILISATEURS & PERSONAS -->
    <!-- ======================================================== -->
    <view class="test-card test-card--personas">
      <view class="test-card-head">
        <view class="test-badge test-badge--purple">🎭 Simulateur Multi-Utilisateurs & Tests Dédiés</view>
        <text class="test-card-desc">Sélectionne un utilisateur test pour voir ses contraintes de colocation et appliquer ses propres tests en live :</text>
      </view>

      <!-- Carrousel horizontal de sélection d'utilisateur -->
      <scroll-view class="personas-scroll" scroll-x="{{true}}" enable-flex="{{true}}">
        <block wx:for="{{ personas }}" wx:key="id">
          <view
            class="persona-tab {{ selectedPersonaId === item.id ? 'persona-tab--active' : '' }}"
            bindtap="onSelectPersona"
            data-id="{{ item.id }}"
          >
            <view class="persona-tab__avatar" style="background: {{ item.themeColor }}20; border-color: {{ selectedPersonaId === item.id ? item.themeColor : 'transparent' }};">
              <text class="persona-tab__emoji">{{ item.icon }}</text>
            </view>
            <view class="persona-tab__meta">
              <text class="persona-tab__name {{ selectedPersonaId === item.id ? 'persona-tab__name--active' : '' }}">{{ item.name }}</text>
              <text class="persona-tab__role">{{ item.badge }}</text>
            </view>
          </view>
        </block>
      </scroll-view>

      <!-- Fiche détaillée de la Persona sélectionnée -->
      <view class="active-persona-card" style="border-left-color: {{ selectedPersona.themeColor }};">
        <view class="active-persona-head">
          <view class="active-persona-left">
            <view class="active-persona-avatar" style="background: {{ selectedPersona.themeColor }}15;">
              <text class="active-persona-icon">{{ selectedPersona.icon }}</text>
            </view>
            <view class="active-persona-info">
              <view class="active-persona-name-row">
                <text class="active-persona-name">{{ selectedPersona.name }}</text>
                <text class="active-persona-pill" style="background: {{ selectedPersona.themeColor }}; color: #fff;">{{ selectedPersona.badge }}</text>
              </view>
              <text class="active-persona-sub">{{ selectedPersona.role }}</text>
            </view>
          </view>
        </view>

        <!-- Attributs de profil & habitudes -->
        <view class="active-persona-props">
          <view class="persona-prop-item">
            <text class="prop-label">Habitudes :</text>
            <text class="prop-val">{{ selectedPersona.habits }}</text>
          </view>
          <view class="persona-prop-item">
            <text class="prop-label">Budget :</text>
            <text class="prop-val">{{ selectedPersona.budget }}</text>
          </view>
          <view class="persona-prop-item">
            <text class="prop-label">Objectif :</text>
            <text class="prop-val">{{ selectedPersona.desc }}</text>
          </view>
        </view>

        <!-- Liste des tests dédiés à cette persona -->
        <view class="persona-actions-head">
          <text class="persona-actions-title">⚡ Tests Dédiés pour {{ selectedPersona.name }}</text>
          <text class="persona-actions-sub">Clique sur une action pour appliquer la règle métier et voir le rendu design en direct :</text>
        </view>

        <view class="persona-actions-list">
          <block wx:for="{{ selectedPersona.actions }}" wx:key="id">
            <view class="persona-action-card">
              <view class="persona-action-row">
                <view class="persona-action-desc">
                  <text class="persona-action-title">{{ item.title }}</text>
                  <text class="persona-action-subtitle">{{ item.subtitle }}</text>
                </view>
                <button
                  class="btn-persona-exec {{ item.badgeType === 'fail' ? 'btn-persona-exec--danger' : (item.badgeType === 'pass' ? 'btn-persona-exec--success' : 'btn-persona-exec--primary') }}"
                  bindtap="runPersonaAction"
                  data-actionid="{{ item.id }}"
                >
                  Appliquer
                </button>
              </view>

              <!-- Résultat en direct après clic sur l'action -->
              <view
                wx:if="{{ personaResults[item.id] }}"
                class="persona-action-result persona-action-result--{{ personaResults[item.id].status }}"
              >
                <view class="result-title-row">
                  <text class="result-title">{{ personaResults[item.id].title }}</text>
                </view>
                <text class="result-detail">{{ personaResults[item.id].detail }}</text>
                <view
                  wx:if="{{ personaResults[item.id].linkId }}"
                  class="btn-action-goto"
                  bindtap="onOpenScenarioLink"
                  data-id="{{ personaResults[item.id].linkId }}"
                >
                  <text class="goto-text">{{ personaResults[item.id].linkText }}</text>
                  <view class="ic ic-chevron-berry ic--xs"></view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- SECTION A : ACCÈS DIRECT AUX ÉCRANS & SCÉNARIOS UI -->
    <!-- ======================================================== -->
    <view class="test-card">
      <view class="test-card-head">
        <text class="test-badge">1. Écrans UI & Scénarios</text>
        <text class="test-card-desc">Ouvrir et tester chaque chambre dans l'interface complète :</text>
      </view>

      <view class="scenarios-grid">
        <view class="scenario-btn" bindtap="openListing" data-id="coloc-isep-keur-gorgui">
          <view class="scenario-btn__icon">🛏️</view>
          <view class="scenario-btn__text">
            <text class="scenario-btn__title">Chambre 4 lits (Hommes)</text>
            <text class="scenario-btn__sub">Keur Gorgui · 2 lits ISEP + 2 libres</text>
          </view>
          <view class="ic ic-chevron-berry ic--sm"></view>
        </view>

        <view class="scenario-btn" bindtap="openListing" data-id="coloc-femmes-ouakam">
          <view class="scenario-btn__icon">🌸</view>
          <view class="scenario-btn__text">
            <text class="scenario-btn__title">Chambre 2 lits (Femmes)</text>
            <text class="scenario-btn__sub">Ouakam · 1 lit Awa + 1 libre</text>
          </view>
          <view class="ic ic-chevron-berry ic--sm"></view>
        </view>

        <view class="scenario-btn" bindtap="openListing" data-id="coloc-couples-mermoz">
          <view class="scenario-btn__icon">👫</view>
          <view class="scenario-btn__text">
            <text class="scenario-btn__title">Studio Couples Uniquement</text>
            <text class="scenario-btn__sub">Mermoz · Opt-in bilatéral requis</text>
          </view>
          <view class="ic ic-chevron-berry ic--sm"></view>
        </view>

        <view class="scenario-btn" bindtap="openListing" data-id="coloc-libre-fann">
          <view class="scenario-btn__icon">✨</view>
          <view class="scenario-btn__text">
            <text class="scenario-btn__title">Chambre 3 lits 100% libre</text>
            <text class="scenario-btn__sub">Fann · Créer un groupe d'amis</text>
          </view>
          <view class="ic ic-chevron-berry ic--sm"></view>
        </view>

        <view class="scenario-btn scenario-btn--bailleur" bindtap="openBailleurAdd">
          <view class="scenario-btn__icon">📋</view>
          <view class="scenario-btn__text">
            <text class="scenario-btn__title">Formulaire Bailleur Colocation</text>
            <text class="scenario-btn__sub">Créer une annonce par lits & règles</text>
          </view>
          <view class="ic ic-chevron-navy ic--sm"></view>
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- SECTION GROUPE : CRÉATION & TEST DU MODULE DE GROUPE -->
    <!-- ======================================================== -->
    <view class="test-card test-card--highlight">
      <view class="test-card-head">
        <text class="test-badge test-badge--green">Nouveau : Créer & Tester un Groupe de Colocation</text>
        <text class="test-card-desc">Configure ton groupe, génère le lien Duo WhatsApp et réserve ensemble :</text>
      </view>

      <view class="group-form-box">
        <text class="group-label">Nom de ton groupe</text>
        <view class="group-input-wrap">
          <input
            class="group-input"
            value="{{ groupForm.name }}"
            placeholder="Ex : Groupe ISEP, Binôme Keur Gorgui..."
            bindinput="onInputGroupName"
          />
        </view>

        <text class="group-label" style="margin-top: 16rpx;">Places demandées par le groupe</text>
        <view class="group-segmented">
          <view
            class="group-seg {{ groupForm.placesRequested === 2 ? 'group-seg--active' : '' }}"
            bindtap="onSelectGroupPlaces"
            data-places="2"
          >2 places</view>
          <view
            class="group-seg {{ groupForm.placesRequested === 3 ? 'group-seg--active' : '' }}"
            bindtap="onSelectGroupPlaces"
            data-places="3"
          >3 places</view>
          <view
            class="group-seg {{ groupForm.placesRequested === 4 ? 'group-seg--active' : '' }}"
            bindtap="onSelectGroupPlaces"
            data-places="4"
          >4 places</view>
        </view>

        <text class="group-label" style="margin-top: 16rpx;">Genre autorisé pour ce groupe</text>
        <view class="chip-grid" style="display: flex; gap: 10rpx; margin-top: 8rpx;">
          <view
            class="chip-item {{ groupForm.genderMode === 'HOMMES_UNIQUEMENT' ? 'chip-item-active' : '' }}"
            bindtap="onSelectGroupGender"
            data-gender="HOMMES_UNIQUEMENT"
            style="padding: 10rpx 16rpx; font-size: 20rpx; border-radius: 10rpx; background: {{ groupForm.genderMode === 'HOMMES_UNIQUEMENT' ? '#C8235F' : '#F1F5F9' }}; color: {{ groupForm.genderMode === 'HOMMES_UNIQUEMENT' ? '#fff' : '#0F172A' }};"
          >Hommes</view>
          <view
            class="chip-item {{ groupForm.genderMode === 'FEMMES_UNIQUEMENT' ? 'chip-item-active' : '' }}"
            bindtap="onSelectGroupGender"
            data-gender="FEMMES_UNIQUEMENT"
            style="padding: 10rpx 16rpx; font-size: 20rpx; border-radius: 10rpx; background: {{ groupForm.genderMode === 'FEMMES_UNIQUEMENT' ? '#C8235F' : '#F1F5F9' }}; color: {{ groupForm.genderMode === 'FEMMES_UNIQUEMENT' ? '#fff' : '#0F172A' }};"
          >Femmes</view>
          <view
            class="chip-item {{ groupForm.genderMode === 'COUPLES_UNIQUEMENT' ? 'chip-item-active' : '' }}"
            bindtap="onSelectGroupGender"
            data-gender="COUPLES_UNIQUEMENT"
            style="padding: 10rpx 16rpx; font-size: 20rpx; border-radius: 10rpx; background: {{ groupForm.genderMode === 'COUPLES_UNIQUEMENT' ? '#C8235F' : '#F1F5F9' }}; color: {{ groupForm.genderMode === 'COUPLES_UNIQUEMENT' ? '#fff' : '#0F172A' }};"
          >Couple</view>
        </view>

        <button class="btn-create-group" bindtap="onCreateGroup">
          ✨ Créer le groupe & Générer le lien WhatsApp
        </button>
      </view>

      <!-- Carte du Groupe Créé -->
      <view wx:if="{{ createdGroup }}" class="created-group-card">
        <view class="created-group-header">
          <text class="created-group-title">👥 {{ createdGroup.name }}</text>
          <text class="created-group-badge">{{ createdGroup.placesRequested }} places demandées</text>
        </view>
        <text class="created-group-creator">Créateur : {{ createdGroup.creator.name }}</text>
        <text class="created-group-token">Jeton Duo : {{ groupInvite.token }}</text>

        <view class="created-group-actions">
          <button class="btn-group-action btn-group-action--inapp" bindtap="onSendInAppInviteClick">
            💬 Inviter dans l'app (par n° tél)
          </button>
          <button class="btn-group-action btn-group-action--wa" bindtap="onCopyGroupWhatsApp">
            📲 Copier l'invitation WhatsApp (Optionnel)
          </button>
          <button class="btn-group-action btn-group-action--book" bindtap="onBookTargetRoomWithGroup" data-roomid="coloc-isep-keur-gorgui">
            🛏️ Réserver dans Chambre Keur Gorgui
          </button>
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- SECTION MESSAGERIE INTERNE : BOÎTE DE RÉCEPTION & CHAT -->
    <!-- ======================================================== -->
    <view class="test-card test-card--inapp-chat">
      <view class="test-card-head">
        <text class="test-badge test-badge--blue">💬 Messagerie & Invitations Internes à l'Application</text>
        <text class="test-card-desc">Pas besoin de WhatsApp : invite, accepte et discute directement dans SAMA LOYER</text>
      </view>

      <!-- Invitations Internes Reçues -->
      <view class="inapp-section-title">📬 Invitations Reçues dans l'App</view>
      <view class="inapp-invitations-list">
        <block wx:for="{{ inAppInvitations }}" wx:key="id">
          <view class="inapp-inv-card">
            <view class="inapp-inv-head">
              <text class="inapp-inv-group">👥 {{ item.groupName }}</text>
              <text class="inapp-inv-status inapp-inv-status--{{ item.status }}">{{ item.status }}</text>
            </view>
            <text class="inapp-inv-text">{{ item.text }}</text>
            <view wx:if="{{ item.status === 'EN_ATTENTE' }}" class="inapp-inv-btns">
              <button class="btn-inv-accept" bindtap="onAcceptInAppInvitation" data-id="{{ item.id }}">
                ✅ Accepter dans l'app
              </button>
              <button class="btn-inv-decline" bindtap="onDeclineInAppInvitation" data-id="{{ item.id }}">
                ❌ Refuser
              </button>
            </view>
          </view>
        </block>
      </view>

      <!-- Fil de discussion interne du groupe -->
      <view class="inapp-section-title" style="margin-top: 20rpx;">🗨️ Discussion Interne du Groupe (Chat Privé)</view>
      <view class="inapp-chat-box">
        <scroll-view class="inapp-chat-messages" scroll-y="{{true}}">
          <block wx:for="{{ inAppGroupChat }}" wx:key="id">
            <view class="inapp-chat-bubble {{ item.isMine ? 'inapp-chat-bubble--mine' : 'inapp-chat-bubble--other' }}">
              <text class="inapp-chat-author">{{ item.senderName }} · {{ item.time }}</text>
              <text class="inapp-chat-content">{{ item.text }}</text>
            </view>
          </block>
        </scroll-view>

        <!-- Barre de saisie interne -->
        <view class="inapp-chat-input-bar">
          <input
            class="inapp-chat-input"
            value="{{ chatInputText }}"
            placeholder="Écrire un message aux colocataires..."
            bindinput="onInputChatText"
            confirm-type="send"
            bindconfirm="onSendInAppGroupChat"
          />
          <button class="btn-chat-send" bindtap="onSendInAppGroupChat">Envoyer</button>
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- SECTION B : TESTS DES RÈGLES MÉTIER EN DIRECT -->
    <!-- ======================================================== -->
    <view class="test-card">
      <view class="test-card-head">
        <text class="test-badge">2. Moteur Métier & Règles de Validation</text>
        <text class="test-card-desc">Clique sur chaque bouton pour exécuter la validation serveur :</text>
      </view>

      <!-- RÈGLE 1 : GENRES -->
      <view class="rule-box">
        <text class="rule-title">Règle 1 : Isolation absolue des genres</text>
        <view class="btn-cluster">
          <button class="btn-test btn-test--pass" bindtap="runTestGender" data-variant="valid_males">
            2 Hommes dans ch. Hommes ✅
          </button>
          <button class="btn-test btn-test--fail" bindtap="runTestGender" data-variant="female_in_male">
            Femme dans ch. Hommes ❌
          </button>
          <button class="btn-test btn-test--fail" bindtap="runTestGender" data-variant="male_in_female">
            Homme dans ch. Femmes ❌
          </button>
        </view>
        <view wx:if="{{ results.gender }}" class="rule-result {{ results.gender.success ? 'rule-result--success' : 'rule-result--reject' }}">
          {{ results.gender.msg }}
        </view>
      </view>

      <!-- RÈGLE 2 : COUPLES -->
      <view class="rule-box">
        <text class="rule-title">Règle 2 : Mode Couples (Opt-in mutuel)</text>
        <view class="btn-cluster">
          <button class="btn-test btn-test--pass" bindtap="runTestCouples" data-variant="valid_couple">
            Duo 2 comptes confirmés ✅
          </button>
          <button class="btn-test btn-test--fail" bindtap="runTestCouples" data-variant="solo">
            Personne seule en couple ❌
          </button>
          <button class="btn-test btn-test--fail" bindtap="runTestCouples" data-variant="unconfirmed">
            Partenaire non confirmé ❌
          </button>
        </view>
        <view wx:if="{{ results.couple }}" class="rule-result {{ results.couple.success ? 'rule-result--success' : 'rule-result--reject' }}">
          {{ results.couple.msg }}
        </view>
      </view>

      <!-- RÈGLE 3 : MULTI-GROUPES -->
      <view class="rule-box">
        <text class="rule-title">Règle 3 : Cohabitation multi-groupes sans fusion</text>
        <button class="btn-test btn-test--wide" bindtap="runTestMultiGroup">
          Simuler Groupe A (2 lits) + Groupe B (2 lits) dans 4 places
        </button>
        <view wx:if="{{ results.multigroup }}" class="rule-result {{ results.multigroup.success ? 'rule-result--success' : 'rule-result--reject' }}">
          {{ results.multigroup.msg }}
        </view>
      </view>

      <!-- RÈGLE 4 : CONCURRENCE -->
      <view class="rule-box">
        <text class="rule-title">Règle 4 : Verrou atomique 15 min (Collision)</text>
        <button class="btn-test btn-test--wide" bindtap="runTestConcurrency">
          Simuler 2 candidats verrouillant le Lit #1 au même instant
        </button>
        <view wx:if="{{ results.concurrency }}" class="rule-result {{ results.concurrency.success ? 'rule-result--success' : 'rule-result--reject' }}">
          {{ results.concurrency.msg }}
        </view>
      </view>

      <!-- RÈGLE 5 : RACHAT EXCLUSIF SOLO -->
      <view class="rule-box">
        <text class="rule-title">Règle 5 : Rachat solo exclusif & Remboursement 100%</text>
        <button class="btn-test btn-test--wide" bindtap="runTestSoloPrivatization">
          Simuler un candidat solo qui rachète toute la chambre
        </button>
        <view wx:if="{{ results.solobuyout }}" class="rule-result {{ results.solobuyout.success ? 'rule-result--success' : 'rule-result--reject' }}">
          {{ results.solobuyout.msg }}
        </view>
      </view>

      <!-- RÈGLE 6 : IDEMPOTENCE PAIEMENTS -->
      <view class="rule-box">
        <text class="rule-title">Règle 6 : Webhooks Orange Money idempotents</text>
        <button class="btn-test btn-test--wide" bindtap="runTestIdempotence">
          Simuler l'envoi répété du même paiement (Déduplication)
        </button>
        <view wx:if="{{ results.idempotence }}" class="rule-result {{ results.idempotence.success ? 'rule-result--success' : 'rule-result--reject' }}">
          {{ results.idempotence.msg }}
        </view>
      </view>
    </view>

    <!-- ======================================================== -->
    <!-- SECTION C : TERMINAL ET LOGS EN DIRECT -->
    <!-- ======================================================== -->
    <view class="test-card">
      <view class="test-card-head">
        <text class="test-badge">3. Journal d'Audit & Console</text>
      </view>

      <view class="terminal-box">
        <block wx:for="{{ logs }}" wx:key="index">
          <view class="term-line term-line--{{ item.type }}">
            <text class="term-time">[{{ item.time }}]</text>
            <text class="term-msg">{{ item.msg }}</text>
          </view>
        </block>
      </view>
    </view>

  </scroll-view>
</view>

