/* ==========================================================================
   Page 404 - SAMA LOYER
   Design soigné, moderne et rassurant
   ========================================================================== */

.not-found-page {
  min-height: 100vh;
  background-color: #FFFFFF;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* Nav Bar */
.nav-bar-custom {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background-color: #FFFFFF;
  z-index: 100;
  box-sizing: border-box;
}

.nav-back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #F4F6FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #0F1E3D;
  font-weight: 700;
}

.nav-brand {
  display: flex;
  align-items: center;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F1E3D;
  letter-spacing: 0.5rpx;
}

.nav-placeholder {
  width: 72rpx;
}

/* Scroll Content */
.scroll-content {
  flex: 1;
  box-sizing: border-box;
}

.content-wrapper {
  padding: 40rpx 48rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* 404 Illustration Hero */
.illustration-container {
  position: relative;
  width: 380rpx;
  height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.shape-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(20rpx);
}

.shape-pink {
  width: 220rpx;
  height: 220rpx;
  background-color: rgba(200, 35, 95, 0.15);
  top: 20rpx;
  right: 20rpx;
}

.shape-blue {
  width: 200rpx;
  height: 200rpx;
  background-color: rgba(14, 27, 56, 0.08);
  bottom: 20rpx;
  left: 20rpx;
}

/* House Artwork Graphic */
.house-artwork {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.house-roof {
  width: 0;
  height: 0;
  border-left: 110rpx solid transparent;
  border-right: 110rpx solid transparent;
  border-bottom: 70rpx solid #C8235F;
}

.house-body {
  width: 200rpx;
  height: 140rpx;
  background-color: #0F1E3D;
  border-bottom-left-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding-bottom: 0;
  position: relative;
}

.house-door {
  width: 60rpx;
  height: 90rpx;
  background-color: #FBE3EC;
  border-top-left-radius: 12rpx;
  border-top-right-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.door-handle {
  position: absolute;
  right: 8rpx;
  top: 48rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #C8235F;
}

.door-sign {
  font-size: 20rpx;
  font-weight: 800;
  color: #C8235F;
  letter-spacing: 0.5rpx;
}

.house-window {
  width: 44rpx;
  height: 44rpx;
  background-color: #FFD480;
  border-radius: 8rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 0 20rpx rgba(255, 212, 128, 0.6);
}

.floating-key-badge {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(15, 30, 61, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: floatKey 3s ease-in-out infinite;
}

.key-icon {
  font-size: 36rpx;
}

@keyframes floatKey {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

/* Badge Code */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 24rpx;
  background-color: #FFF0F4;
  border-radius: 30rpx;
  margin-bottom: 24rpx;
}

.badge-dot {
  font-size: 22rpx;
  color: #C8235F;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #C8235F;
  letter-spacing: 0.8rpx;
}

/* Headings */
.title-primary {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0F1E3D;
  line-height: 1.25;
  margin-bottom: 16rpx;
}

.subtitle-text {
  display: block;
  font-size: 28rpx;
  color: #5B6475;
  line-height: 1.5;
  margin-bottom: 48rpx;
  max-width: 580rpx;
}

/* Suggestions Section */
.suggestions-section {
  width: 100%;
  background-color: #FAFBFD;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 48rpx;
  border: 2rpx solid #EAEFF7;
}

.suggestions-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0F1E3D;
  margin-bottom: 20rpx;
  text-align: left;
}

.pills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.zone-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #E2E8F3;
  box-shadow: 0 2rpx 6rpx rgba(15, 30, 61, 0.04);
}

.zone-pin {
  font-size: 22rpx;
}

.zone-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F1E3D;
}

/* Actions Section */
.actions-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #0F1E3D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(15, 30, 61, 0.2);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.btn-secondary {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #CCD4E2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F1E3D;
}

.bailleur-link {
  padding: 20rpx;
  margin-top: 10rpx;
}

.bailleur-link-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #C8235F;
}
