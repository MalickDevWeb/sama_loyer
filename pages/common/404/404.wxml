<view class="not-found-page">
  <!-- Header officiel SAMA LOYER avec respiration sous la notch -->
  <view class="not-found-header" style="padding-top: {{ statusBarHeight + 16 }}px;">
    <view class="header-brand-row">
      <view class="sama-brand" bindtap="onGoHome">
        <view class="sama-brand__icon">
          <view class="icon-svg icon-house-white"></view>
        </view>
        <view class="sama-brand__text">
          <text class="brand-title">SAMA</text>
          <text class="brand-sub">LOYER</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Contenu défilant fluide -->
  <scroll-view scroll-y class="scroll-content">
    <view class="content-wrapper">
      
      <!-- Premium Hero Artwork -->
      <view class="hero-illu-wrap">
        <view class="hero-illu-art"></view>
      </view>

      <!-- Badge Code -->
      <view class="error-badge">
        <text class="badge-dot">✦</text>
        <text class="badge-text">ERREUR 404 · LOGEMENT INTROUVABLE</text>
      </view>

      <!-- Clean Typography -->
      <text class="main-title">Ce logement n'habite plus à cette adresse</text>
      <text class="main-subtitle">
        L'annonce a été retirée ou le lien n'est plus actif. Rassure-toi, ton futur chez-toi t'attend à Dakar !
      </text>

      <!-- Card Suggestions : Quartiers Populaires -->
      <view class="suggestions-card">
        <view class="suggestions-header">
          <text class="suggestions-title">Où souhaites-tu chercher ?</text>
          <text class="suggestions-sub">Quartiers populaires à Dakar</text>
        </view>

        <view class="zones-grid">
          <view 
            wx:for="{{ popularZones }}" 
            wx:key="key" 
            class="zone-card"
            bindtap="onSelectZone"
            data-zone="{{ item.label }}"
          >
            <view class="zone-pin-circle">📍</view>
            <text class="zone-label">{{ item.label }}</text>
            <text class="zone-arrow">→</text>
          </view>
        </view>
      </view>

      <!-- Action Buttons -->
      <view class="actions-group">
        <button class="btn-primary" bindtap="onSearchAll">
          <text class="btn-primary-text">Trouver un logement</text>
          <text class="btn-arrow">→</text>
        </button>

        <button class="btn-secondary" bindtap="onGoHome">
          <text class="btn-secondary-text">Retourner à l'accueil</text>
        </button>

        <view class="bailleur-row" bindtap="onSwitchBailleur">
          <text class="bailleur-hint">Vous êtes propriétaire ? </text>
          <text class="bailleur-link-bold">Espace bailleur →</text>
        </view>
      </view>

    </view>
  </scroll-view>
</view>
