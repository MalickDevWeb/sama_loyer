<view class="not-found-page">
  <!-- Custom Navigation Header -->
  <view class="nav-bar-custom" style="padding-top: {{ statusBarHeight }}px; height: {{ navBarHeight }}px;">
    <view class="nav-back-btn" bindtap="onGoHome">
      <text class="back-arrow">←</text>
    </view>
    <view class="nav-brand">
      <text class="brand-title">SAMA LOYER</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view scroll-y class="scroll-content" style="padding-top: {{ statusBarHeight + navBarHeight }}px;">
    <view class="content-wrapper">
      <!-- 404 Illustration Hero -->
      <view class="illustration-container">
        <!-- Floating shapes background -->
        <view class="shape-circle shape-pink"></view>
        <view class="shape-circle shape-blue"></view>

        <!-- Graphic House Artwork with Key & Magnifier -->
        <view class="house-artwork">
          <view class="house-roof"></view>
          <view class="house-body">
            <view class="house-door">
              <view class="door-handle"></view>
              <view class="door-sign">404</view>
            </view>
            <view class="house-window"></view>
          </view>
          <!-- Floating badge -->
          <view class="floating-key-badge">
            <text class="key-icon">🔑</text>
          </view>
        </view>
      </view>

      <!-- Badge Code -->
      <view class="status-badge">
        <text class="badge-dot">✦</text>
        <text class="badge-text">ERREUR 404 · PAGE INTROUVABLE</text>
      </view>

      <!-- Headings -->
      <text class="title-primary">Cette porte ne mène nulle part !</text>
      <text class="subtitle-text">
        L'adresse demandée est introuvable ou le logement a déjà été attribué. Pas d'inquiétude, d'autres pépites t'attendent à Dakar.
      </text>

      <!-- Quick Neighborhood Suggestions -->
      <view class="suggestions-section">
        <text class="suggestions-label">Explorer par quartier :</text>
        <view class="pills-grid">
          <view 
            wx:for="{{ popularZones }}" 
            wx:key="key" 
            class="zone-pill"
            bindtap="onSelectZone"
            data-zone="{{ item.label }}"
          >
            <text class="zone-pin">📍</text>
            <text class="zone-name">{{ item.label }}</text>
          </view>
        </view>
      </view>

      <!-- Action Buttons -->
      <view class="actions-section">
        <button class="btn-primary" bindtap="onGoHome">
          <text class="btn-icon">🏠</text>
          <text class="btn-label">Retour à l'accueil</text>
        </button>

        <button class="btn-secondary" bindtap="onSearchAll">
          <text class="btn-secondary-label">Voir tous les logements</text>
        </button>

        <view class="bailleur-link" bindtap="onSwitchBailleur">
          <text class="bailleur-link-text">Vous êtes propriétaire ? Accéder à l'espace bailleur →</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
