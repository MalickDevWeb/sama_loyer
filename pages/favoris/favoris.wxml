<view class="favorites-page">
  <scroll-view class="favorites-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête -->
    <view class="fav-header" style="padding-top: {{ statusBarHeight + 14 }}px;">
      <view class="fav-header__titles">
        <text class="page-title">Mes Favoris</text>
        <text class="page-subtitle">{{ favoritesList.length }} logements enregistrés</text>
      </view>
    </view>

    <!-- Liste des logements favoris -->
    <view wx:if="{{ favoritesList.length > 0 }}" class="fav-list">
      <block wx:for="{{ favoritesList }}" wx:key="id">
        <view class="fav-card" data-id="{{ item.id }}" bindtap="onCardTap">
          <!-- Thumbnail -->
          <view class="fav-thumb" style="background-color: {{ item.bg }};">
            <view class="fav-thumb__house"></view>
            <view class="fav-btn-heart" data-id="{{ item.id }}" catchtap="onRemoveFavorite">
              <text class="heart-icon">♥</text>
            </view>
          </view>

          <!-- Détails -->
          <view class="fav-content">
            <view class="fav-meta-row">
              <text class="fav-type">{{ item.typeLabel }}</text>
              <text class="fav-date">{{ item.dateAdded }}</text>
            </view>

            <text class="fav-title">{{ item.title }}</text>
            <text class="fav-place">{{ item.place }}</text>

            <view class="fav-bottom-row">
              <view class="fav-price-col">
                <text class="fav-price">{{ item.price }}</text>
                <text class="fav-unit">{{ item.unit }}</text>
              </view>
              <view class="btn-fav-view">Voir</view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- État vide -->
    <view wx:else class="fav-empty-state">
      <view class="empty-icon-circle">
        <text class="empty-heart">♡</text>
      </view>
      <text class="empty-title">Aucun favori pour le moment</text>
      <text class="empty-desc">Sauvegardez les logements qui vous intéressent pour les retrouver et les comparer facilement.</text>
      <button class="btn-discover" bindtap="onGoToHome">
        Découvrir des logements
      </button>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>
</view>
