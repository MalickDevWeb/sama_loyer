<view class="favorites-page">
  <scroll-view class="favorites-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    
    <!-- En-tête -->
    <view class="fav-header" style="padding-top: {{ statusBarHeight + 14 }}px;">
      <view class="fav-title-row">
        <view class="btn-back" bindtap="onBackTap">‹</view>
        <text class="page-title">{{ i18n.favoris.title }}</text>
      </view>
      <text class="page-subtitle">{{ subtitle }}</text>

      <!-- Filtres Tous / Encore disponibles -->
      <view class="fav-filter-pills">
        <view 
          class="fav-pill {{ activeTabFilter === 'tous' ? 'fav-pill--active' : '' }}"
          data-filter="tous"
          bindtap="onFilterSelect"
        >
          {{ i18n.favoris.filterAll }}
        </view>
        <view 
          class="fav-pill {{ activeTabFilter === 'dispo' ? 'fav-pill--active' : '' }}"
          data-filter="dispo"
          bindtap="onFilterSelect"
        >
          {{ i18n.favoris.filterAvailable }}
        </view>
      </view>
    </view>

    <!-- Liste des logements favoris -->
    <view class="fav-list">
      <block wx:for="{{ filteredList }}" wx:key="id">
        <view class="fav-card" data-id="{{ item.id }}" bindtap="onCardTap">
          <!-- Thumbnail illustration maison avec bouton coeur -->
          <view class="fav-thumb" style="background-color: {{ item.bg }};">
            <view class="fav-thumb__house"></view>
            <view wx:if="{{ item.isPremium }}" class="badge-premium-pill">
              {{ i18n.common.premium }}
            </view>
            <view class="fav-btn-heart" data-id="{{ item.id }}" catchtap="onRemoveFavorite">
              <text class="heart-icon">♥</text>
            </view>
          </view>

          <!-- Détails -->
          <view class="fav-content">
            <!-- Prix -->
            <view class="fav-price-row">
              <text class="fav-price">{{ item.price }}</text>
              <text class="fav-unit">{{ item.unit }}</text>
            </view>

            <!-- Titre & Localisation -->
            <text class="fav-title">{{ item.title }}</text>
            <text class="fav-place">{{ item.place }}</text>

            <!-- Statuts conditionnels -->
            <view class="fav-status-row" wx:if="{{ item.status === 'disponible' }}">
              <view class="badge-dispo">
                <text class="check-icon">✓</text> {{ i18n.common.available }}
              </view>
            </view>

            <view class="fav-status-row" wx:elif="{{ item.status === 'price-drop' }}">
              <text class="price-drop-text">{{ item.priceDropLabel }}</text>
            </view>

            <view class="fav-status-row" wx:elif="{{ item.status === 'rented' }}">
              <text class="rented-text">{{ item.statusLabel }}</text>
            </view>

            <!-- Date d'enregistrement -->
            <text class="fav-registered-text">{{ item.registeredAt }}</text>
          </view>
        </view>
      </block>
    </view>

    <view class="scroll-spacer"></view>
  </scroll-view>
</view>
