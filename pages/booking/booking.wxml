<app-layout
  title="Date & Voyageurs"
  showBack="{{true}}"
  showLogo="{{false}}"
  transparent="{{true}}"
  showNavBorder="{{false}}"
  showTabBar="{{false}}"
>
  <scroll-view
    class="booking-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
  <view class="booking-page">
    <view class="booking-container">
      <view class="booking-section">
        <view class="booking-section-title">
          <view class="booking-title-icon booking-title-icon--calendar"></view>
          <app-typography fontSize="35rpx" weight="600" color="#111827" lineHeight="54rpx">
            Choisir une Date
          </app-typography>
        </view>

        <view class="date-grid">
          <view
            wx:for="{{ dates }}"
            wx:key="isoDate"
            wx:for-item="dateItem"
            data-index="{{ index }}"
            class="date-card {{ selectedDate === index ? 'date-card--active' : '' }}"
            bindtap="selectDate"
          >
            <app-typography fontSize="24rpx" color="#667085" align="center" lineHeight="34rpx">
              {{ dateItem.day }}
            </app-typography>
            <app-typography fontSize="40rpx" weight="700" color="#1C1C1C" align="center" lineHeight="48rpx">
              {{ dateItem.date }}
            </app-typography>
            <app-typography fontSize="24rpx" color="#667085" align="center" lineHeight="34rpx">
              {{ dateItem.month }}
            </app-typography>
          </view>
        </view>

        <picker mode="date" start="{{ minDate }}" value="{{ minDate }}" bindchange="onDatePickerChange">
          <view class="more-dates">Voir Plus de Dates</view>
        </picker>
      </view>

      <view class="booking-section booking-section--travelers">
        <view class="booking-section-title travelers-section-title">
          <view class="travelers-icon">
            <view class="travelers-icon__head travelers-icon__head--main"></view>
            <view class="travelers-icon__head travelers-icon__head--side"></view>
            <view class="travelers-icon__body travelers-icon__body--main"></view>
            <view class="travelers-icon__body travelers-icon__body--side"></view>
          </view>
          <app-typography fontSize="35rpx" weight="600" color="#111827" lineHeight="54rpx">
            Nombre de Voyageurs
          </app-typography>
        </view>

        <app-card containerClass="traveler-card">
          <view class="traveler-card__content">
          <view class="traveler-copy">
            <app-typography fontSize="29rpx" weight="600" color="#111827" lineHeight="38rpx">
              Adultes
            </app-typography>
            <app-typography fontSize="27rpx" color="#7A8599" lineHeight="38rpx">
              13 ans et +
            </app-typography>
          </view>
          <view class="traveler-controls">
            <view class="counter-btn-wrap">
              <view class="counter-btn counter-btn--minus {{ adults <= 1 ? 'counter-btn--disabled' : '' }}" bindtap="decreaseAdult">
                <app-typography fontSize="36rpx" weight="500" color="#667085" lineHeight="40rpx" align="center">
                  -
                </app-typography>
              </view>
            </view>
            <app-typography containerClass="counter-value" fontSize="31rpx" weight="600" color="#111827" align="center" lineHeight="44rpx">
              {{ adults }}
            </app-typography>
            <view class="counter-btn-wrap">
              <view class="counter-btn counter-btn--plus" bindtap="increaseAdult">
                <app-typography fontSize="36rpx" weight="500" color="#FFFFFF" lineHeight="40rpx" align="center">
                  +
                </app-typography>
              </view>
            </view>
          </view>
          </view>
        </app-card>

        <app-card containerClass="traveler-card">
          <view class="traveler-card__content">
          <view class="traveler-copy">
            <app-typography fontSize="29rpx" weight="600" color="#111827" lineHeight="38rpx">
              Enfants
            </app-typography>
            <app-typography fontSize="27rpx" color="#7A8599" lineHeight="38rpx">
              2-12 ans
            </app-typography>
          </view>
          <view class="traveler-controls">
            <view class="counter-btn-wrap">
              <view class="counter-btn counter-btn--minus {{ children <= 0 ? 'counter-btn--disabled' : '' }}" bindtap="decreaseChild">
                <app-typography fontSize="36rpx" weight="500" color="#667085" lineHeight="40rpx" align="center">
                  -
                </app-typography>
              </view>
            </view>
            <app-typography containerClass="counter-value" fontSize="31rpx" weight="600" color="#111827" align="center" lineHeight="44rpx">
              {{ children }}
            </app-typography>
            <view class="counter-btn-wrap">
              <view class="counter-btn counter-btn--plus" bindtap="increaseChild">
                <app-typography fontSize="36rpx" weight="500" color="#FFFFFF" lineHeight="40rpx" align="center">
                  +
                </app-typography>
              </view>
            </view>
          </view>
          </view>
        </app-card>
      </view>

      <app-card containerClass="price-card">
        <app-typography wx:if="{{ priceError }}" fontSize="23rpx" color="#B42318" lineHeight="34rpx">
          {{ priceError }}
        </app-typography>
        <app-typography fontSize="29rpx" weight="600" color="#111827" lineHeight="40rpx">
          Détail du Prix
        </app-typography>
        <view class="price-line">
          <app-typography fontSize="23rpx" color="#6B7280" lineHeight="34rpx">
            {{ adultLine }}
          </app-typography>
          <app-typography fontSize="23rpx" color="#6B7280" lineHeight="34rpx" align="right">
            {{ adultSubtotal }}
          </app-typography>
        </view>
        <view wx:if="{{ childrenLine }}" class="price-line">
          <app-typography fontSize="23rpx" color="#6B7280" lineHeight="34rpx">
            {{ childrenLine }}
          </app-typography>
          <app-typography fontSize="23rpx" color="#6B7280" lineHeight="34rpx" align="right">
            {{ childrenSubtotal }}
          </app-typography>
        </view>
        <view class="price-divider"></view>
        <view class="price-total-row">
          <app-typography fontSize="25rpx" weight="600" color="#111827" lineHeight="56rpx">
            Total
          </app-typography>
          <app-typography fontSize="50rpx" weight="700" color="#16A34A" lineHeight="58rpx" align="right">
            {{ totalPrice }}
          </app-typography>
        </view>
      </app-card>

      <app-typography
        containerClass="booking-terms"
        fontSize="24rpx"
        weight="400"
        color="#7A8094"
        lineHeight="56rpx"
      >
        <view>En finalisant cette réservation, vous acceptez nos</view>
        <view><text class="booking-terms__link" style="font-size: 28rpx;" catchtap="openTerms">Conditions d'Utilisation</text> et notre</view>
        <view><text class="booking-terms__link" style="font-size: 28rpx;" catchtap="openPolicy">Politique d'Annulation</text>. Remboursement complet</view>
        <view>disponible jusqu'à 24h avant le voyage.</view>
      </app-typography>

    </view>
  </view>
  </scroll-view>

  <view class="booking-payment-footer">
    <app-button
      type="primary"
      disabled="{{ !canContinue }}"
      buttonClass="booking-reserve-button"
      bind:onPress="handleReserve"
    >
      <app-typography fontSize="32rpx" weight="700" color="#FFFFFF" lineHeight="40rpx" align="center">
        Payer
      </app-typography>
    </app-button>

    <app-typography
      wx:if="{{ !canContinue }}"
      containerClass="booking-date-helper"
      fontSize="28rpx"
      color="#667085"
      align="center"
      lineHeight="38rpx"
    >
      Veuillez sélectionner une date pour continuer
    </app-typography>
  </view>
</app-layout>

<app-modal
  visible="{{showPolicy}}"
  placement="bottom"
  size="full"
  hasHeader="{{true}}"
  hasContent="{{true}}"
  bind:close="closePolicy"
>
  <view slot="header" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
    <text style="font-weight: 600; font-size: 32rpx; color: #1C1C1C;">Politique d'Annulation</text>
    <view catchtap="closePolicy" style="padding: 10rpx;">
      <icon type="cancel" size="24" color="#666" />
    </view>
  </view>
  <view slot="content" style="max-height: 70vh; padding-bottom: env(safe-area-inset-bottom, 40rpx);">
    <app-cancellation-policy />
  </view>
</app-modal>

<app-modal
  visible="{{showTerms}}"
  placement="bottom"
  size="full"
  hasHeader="{{true}}"
  hasContent="{{true}}"
  bind:close="closeTerms"
>
  <view slot="header" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
    <text style="font-weight: 600; font-size: 32rpx; color: #1C1C1C;">Conditions d'Utilisation</text>
    <view catchtap="closeTerms" style="padding: 10rpx;">
      <icon type="cancel" size="24" color="#666" />
    </view>
  </view>
  <view slot="content" style="max-height: 70vh; padding-bottom: env(safe-area-inset-bottom, 40rpx);">
    <app-terms-of-use />
  </view>
</app-modal>


