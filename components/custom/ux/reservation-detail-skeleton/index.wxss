.detail-skeleton { padding: 36rpx 32rpx 60rpx; }
.detail-skeleton__image { width: 100%; height: 384rpx; border-radius: 24rpx; }
.detail-skeleton__title-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 48rpx 0 42rpx; }
.detail-skeleton__title { width: 56%; height: 48rpx; border-radius: 999rpx; }
.detail-skeleton__status { width: 120rpx; height: 48rpx; border-radius: 999rpx; }
.detail-skeleton__reference { padding: 32rpx; margin-bottom: 48rpx; border-radius: 24rpx; background: #f5e9da; }
.detail-skeleton__line { height: 24rpx; border-radius: 999rpx; }
.detail-skeleton__line--short { width: 46%; }
.detail-skeleton__line--ref { width: 65%; height: 34rpx; margin-top: 22rpx; }
.detail-skeleton__info { min-height: 156rpx; display: flex; align-items: flex-start; gap: 24rpx; padding: 34rpx; margin-bottom: 32rpx; border-radius: 24rpx; background: #fafbfc; box-sizing: border-box; }
.detail-skeleton__icon { width: 48rpx; height: 48rpx; flex: 0 0 48rpx; border-radius: 50%; }
.detail-skeleton__copy { flex: 1; display: flex; flex-direction: column; gap: 18rpx; }
.detail-skeleton__line--medium { width: 45%; }
.detail-skeleton__line--wide { width: 70%; height: 28rpx; }
.detail-skeleton__total { display: flex; justify-content: space-between; align-items: center; margin: 44rpx 0 56rpx; }
.detail-skeleton__line--amount { width: 35%; height: 40rpx; }
.detail-skeleton__support { height: 260rpx; border-radius: 24rpx; }
.shimmer { background: linear-gradient(90deg,#f0f1f3 25%,#f8f9fa 38%,#f0f1f3 62%); background-size: 400% 100%; animation: detail-skeleton-shimmer 1.5s ease-in-out infinite; }
@keyframes detail-skeleton-shimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
