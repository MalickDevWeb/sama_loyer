<view class="sama-top-bar {{ showBorder ? 'sama-top-bar--border' : '' }}" style="padding-top: {{ statusBarHeight + 8 }}px; background-color: {{ backgroundColor }};">
  <view class="sama-top-bar__inner">
    <view class="sama-brand">
      <view class="sama-brand__icon">
        <view class="icon-svg icon-house-white"></view>
      </view>
      <view class="sama-brand__text">
        <text class="brand-title">SAMA</text>
        <text class="brand-sub">LOYER</text>
      </view>
    </view>
  </view>
</view>
