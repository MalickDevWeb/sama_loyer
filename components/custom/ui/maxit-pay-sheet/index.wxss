.maxit-sheet {
  display: flex;
  flex-direction: column;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)) 32rpx;
  background: #FFFFFF;
  box-sizing: border-box;
  border-radius: 40rpx 40rpx 0 0;
}

.maxit-sheet__title {
  font-size: 38rpx;
  font-weight: 800;
  color: #000000;
  margin-bottom: 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  letter-spacing: -0.5rpx;
}

.maxit-box {
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.maxit-box--merchant {
  gap: 28rpx;
}

.maxit-box__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.maxit-icon {
  display: block;
}

.maxit-icon--user {
  width: 52rpx;
  height: 52rpx;
}

.maxit-merchant {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.maxit-merchant__name {
  font-size: 32rpx;
  font-weight: 800;
  color: #000000;
  line-height: 1.25;
}

.maxit-merchant__code {
  font-size: 28rpx;
  font-weight: 800;
  color: #FF7900;
  margin-top: 6rpx;
}

.maxit-box--total {
  justify-content: space-between;
}

.maxit-total-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.maxit-icon--globe {
  width: 44rpx;
  height: 44rpx;
}

.maxit-total-label {
  font-size: 32rpx;
  font-weight: 800;
  color: #000000;
}

.maxit-total-amount {
  font-size: 30rpx;
  font-weight: 800;
  color: #FF7900;
}

.maxit-account-card {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border: 1.5rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-top: 12rpx;
  margin-bottom: 36rpx;
  box-sizing: border-box;
}

.maxit-account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.maxit-account-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B7280;
}

.maxit-account-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.maxit-account-balance {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
}

.maxit-icon--check {
  width: 38rpx;
  height: 38rpx;
}

.maxit-insufficient-msg {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 8rpx;
}

.maxit-insufficient-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #D03801;
}

.maxit-actions-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.maxit-btn {
  flex: 1;
  height: 98rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  box-sizing: border-box;
  margin: 0;
}

.maxit-btn::after {
  border: none;
}

.maxit-btn--cancel {
  background: #FFFFFF;
  color: #111827;
  border: 1.5rpx solid #D1D5DB;
}

.maxit-btn--cancel-pressed {
  background: #F9FAFB;
  opacity: 0.9;
}

.maxit-btn--confirm {
  background: #FF7900;
  color: #FFFFFF;
}

.maxit-btn--confirm-pressed {
  opacity: 0.9;
}

.maxit-btn--disabled {
  background: #FFAE70;
  color: #FFFFFF;
  opacity: 0.85;
}

.maxit-qa-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 24rpx;
}

.maxit-qa-toggle {
  font-size: 22rpx;
  color: #9CA3AF;
  text-decoration: underline;
  padding: 6rpx;
}
