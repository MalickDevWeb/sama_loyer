<view class="card-container" hover-class="card-container--hovered" hover-stay-time="200" style="width: {{ cardWidth }}; {{ cardContainerStyle }}" bindtap="handleCardTap">
    <app-card containerClass="h-100 {{ cardPaddingClass }}" containerStyle="{{ resolvedCardStyle }}">
        <view class="image-container">
            <osn-image
                src="{{ destination.image }}"
                mode="aspectFill"
                containerStyle="width: 100%; height: {{ imageHeight }}; display: block;"
                imageStyle="width: 100%; height: {{ imageHeight }}; border-radius: {{ imageRadius }};"
            />
            <view class="icon-heart" catchtap="handleLikeTap">
                <view class="icon-heart__inner">
                    <block wx:if="{{ isLiked }}">
                        <osn-icon icon="heartRed" width="{{34}}" height="{{32}}"/>
                    </block>
                    <block wx:else>
                        <osn-icon icon="heart" width="{{34}}" height="{{32}}"/>
                    </block>
                </view>
            </view>
        </view>

        <view class="destination-card__content">
            <app-typography size="14" weight="600" color="#1C1C1C" lineHeight="35rpx" containerStyle="min-height: 34.98rpx;">
                {{ destination.title }}
            </app-typography>

            <view class="subtitle-row">
                <view class="subtitle-icon-wrap">
                    <view class="destination-card__location-pin"></view>
                </view>
                <app-typography size="14" weight="400" color="#4A5565" lineHeight="40rpx">
                    {{ destination.subtitle }}
                </app-typography>
            </view>
            
           <view class="price-button-row{{ !showDetailsButton ? ' price-only' : '' }}">
                <app-typography containerClass="flex-1 " size="16" weight="700" color="#1C1C1C" lineHeight="48rpx">
                    {{ destination.price }}
                </app-typography>
                <view class="button-container" wx:if="{{ showDetailsButton }}">
                    <app-button
                        buttonClass="destination-details-button"
                        buttonClass="destination-card-details-button"
                        type="primary"
                        loading="{{ destination.loading }}"
                        bind:onPress="handleSubmit"
                    >
                        {{ destination.buttonLabel || 'Details' }}
                    </app-button>
                </view>
            </view>
            
        </view>
    </app-card>
</view>
