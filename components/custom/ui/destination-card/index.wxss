/* wxss */

.card-container {
  position: relative;
  width: 480rpx;
  /* overflow: hidden; */
  min-height: 580rpx;
  box-sizing: border-box;
}

.card-container--hovered {
  box-shadow:
    0 8rpx 24rpx -4rpx rgba(0, 0, 0, 0.12),
    0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border-radius: 16rpx;
  transition: box-shadow 0.2s ease;
}

.image-container {
  position: relative;
  width: 100%;
}

.destination-card__content {
  display: flex;
  flex-direction: column;
  padding-top: 32rpx;
}

.icon-heart {
  position: absolute;
  top: 40rpx;
  right: 24rpx;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1),
    0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
}

.icon-heart__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(4rpx);
}

.subtitle-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
}

.subtitle-icon-wrap {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.destination-card__location-pin {
  position: relative;
  width: 32rpx;
  height: 38rpx;
  flex: 0 0 32rpx;
}

.destination-card__location-pin::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #0aa347;
  border-radius: 50% 50% 50% 0;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.destination-card__location-pin::after {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 11rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #0aa347;
}

.price-button-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  white-space: nowrap;
  gap: 16rpx;
  min-height: 68rpx;
}

.price-button-row.price-only {
  justify-content: flex-start;
}

.button-container {
  display: flex;
  justify-content: flex-end;
  flex: 0 0 176rpx;
  width: 176rpx;
}
