<view class="h-100">
    <!-- Scroll layout -->
    <scroll-view
        wx:if="{{ layout === 'scroll' }}"
        class="menu-tabs {{ containerClass }}"
        scroll-x="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}">
        <block wx:if="{{ loading }}">
            <view
                class="menu-tabs__item menu-tabs__item--scroll {{index === 0 ? 'menu-tabs__item--first' : ''}} {{index === skeletonItems.length - 1 ? 'menu-tabs__item--last' : ''}}"
                wx:for="{{ skeletonItems }}"
                wx:key="*this"
                style="width: {{ cardWidth }};"
            >
                <app-destination-card-skeleton
                    cardWidth="{{ cardWidth }}"
                    imageHeight="{{ imageHeight }}"
                    cardPaddingClass="{{ cardPaddingClass }}"
                    cardStyle="{{ cardStyle }}"
                    cardContainerStyle="{{ cardContainerStyle }}"
                    imageRadius="{{ imageRadius }}"
                    showDetailsButton="{{ showDetailsButton }}" />
            </view>
        </block>
        <block wx:else>
            <view
                class="menu-tabs__item menu-tabs__item--scroll {{index === 0 ? 'menu-tabs__item--first' : ''}} {{index === destinations.length - 1 ? 'menu-tabs__item--last' : ''}}"
                wx:for="{{ destinations }}"
                wx:key="id"
                wx:for-item="destination"
                style="width: {{ cardWidth }};"
            >
                <app-destination-card
                    destination="{{ destination }}"
                    cardWidth="{{ cardWidth }}"
                    imageHeight="{{ imageHeight }}"
                    cardPaddingClass="{{ cardPaddingClass }}"
                    cardStyle="{{ cardStyle }}"
                    cardContainerStyle="{{ cardContainerStyle }}"
                    imageRadius="{{ imageRadius }}"
                    showDetailsButton="{{ showDetailsButton }}"
                    bind:toggleLike="handleToggleLike"
                    bind:onCardPress="handleCardPress" />
            </view>
        </block>
    </scroll-view>

    <!-- Grid layout -->
    <view wx:elif="{{ layout === 'grid' }}" class="grid-container {{ containerClass }}">
        <block wx:if="{{ loading }}">
            <view class="grid-item" wx:for="{{ skeletonItems }}" wx:key="*this" style="flex: 0 0 {{ computedGridItemWidth }};">
                <app-destination-card-skeleton
                    cardWidth="100%"
                    imageHeight="{{ imageHeight }}"
                    cardPaddingClass="{{ cardPaddingClass }}"
                    cardStyle="{{ cardStyle }}"
                    cardContainerStyle="{{ cardContainerStyle }}"
                    imageRadius="{{ imageRadius }}"
                    showDetailsButton="{{ showDetailsButton }}" />
            </view>
        </block>
        <block wx:else>
            <view class="grid-item" wx:for="{{ destinations }}" wx:key="id" wx:for-item="destination" style="flex: 0 0 {{ computedGridItemWidth }};">
                <app-destination-card
                    destination="{{ destination }}"
                    cardWidth="100%"
                    imageHeight="{{ imageHeight }}"
                    cardPaddingClass="{{ cardPaddingClass }}"
                    cardStyle="{{ cardStyle }}"
                    cardContainerStyle="{{ cardContainerStyle }}"
                    imageRadius="{{ imageRadius }}"
                    showDetailsButton="{{ showDetailsButton }}"
                    bind:toggleLike="handleToggleLike"
                    bind:onCardPress="handleCardPress" />
            </view>
        </block>
    </view>

    <!-- Vertical list layout -->
    <view wx:else class="vertical-list">
        <block wx:if="{{ loading }}">
            <view class="menu-tabs__item" wx:for="{{ skeletonItems }}" wx:key="*this" style="width: 100%;">
                <app-destination-card-skeleton
                    cardWidth="100%"
                    imageHeight="{{ imageHeight }}"
                    cardPaddingClass="{{ cardPaddingClass }}"
                    cardStyle="{{ cardStyle }}"
                    cardContainerStyle="{{ cardContainerStyle }}"
                    imageRadius="{{ imageRadius }}"
                    showDetailsButton="{{ showDetailsButton }}" />
            </view>
        </block>
        <block wx:else>
            <view class="menu-tabs__item" wx:for="{{ destinations }}" wx:key="id" wx:for-item="destination" style="width: 100%;">
                <app-destination-card
                    destination="{{ destination }}"
                    cardWidth="100%"
                    imageHeight="{{ imageHeight }}"
                    cardPaddingClass="{{ cardPaddingClass }}"
                    cardStyle="{{ cardStyle }}"
                    cardContainerStyle="{{ cardContainerStyle }}"
                    imageRadius="{{ imageRadius }}"
                    showDetailsButton="{{ showDetailsButton }}"
                    bind:toggleLike="handleToggleLike"
                    bind:onCardPress="handleCardPress" />
            </view>
        </block>
    </view>
</view>
