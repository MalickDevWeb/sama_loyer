.osn-input {
  position: relative;
  border-radius: 50rpx;
  border: 2rpx solid #efefef;
  background: rgb(248, 247, 247);
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 38rpx;
}
.osn-input__field {
  flex: 1;
  height: 68rpx;
  border: none;
  background: transparent;
  font-size: inherit;
  outline: none;
  width: 0;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.osn-input__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b3b3b3;
  font-size: 54rpx;
  margin-right: 20rpx;
}

.osn-input__results {
  width: 100%;
  z-index: 1001;
  left: 0;
  top: 80rpx;
  background: #fff;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.osn-input__field--picker {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  background: transparent;
  font-size: inherit;
  border: none;
  padding: 0;
  outline: none;
}
.osn-input__field--picker.readonly {
  color: #bbb;
}

.search-input {
  width: 100%;
  max-width: 100%;
  min-height: 88rpx;
  padding: 22rpx 32rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 32rpx;
  background: #f9fafb;
  box-sizing: border-box;
  font-size: 28rpx;
  justify-content: flex-start;
}

.search-input .osn-input__field {
  flex: 1;
  width: auto;
  height: 42rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #1c1c1c;
  text-align: left;
}

.search-input .osn-input__icon {
  margin-right: 16rpx;
}

.explore-search-input {
  width: 100%;
  max-width: 100%;
  min-height: 83rpx;
  padding: 20rpx 32rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 40rpx;
  background: #f9fafb;
  box-sizing: border-box;
  font-size: 28rpx;
  justify-content: flex-start;
  margin-top: 10rpx;
}

.explore-search-input .osn-input__field {
  flex: 1;
  width: auto;
  height: 40rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #1c1c1c;
  text-align: left;
}

.explore-search-input .osn-input__icon {
  flex: 0 0 auto;
  margin-right: 16rpx;
}
