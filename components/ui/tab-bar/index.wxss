/* Badge numérique rouge */
.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -18rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.osn-tab-bar__label {
  font-size: 24rpx;
  font-weight: 600;
  color: #5B6475;
  line-height: 1.1;
}

.osn-tab-bar__label.active {
  font-weight: 800;
  color: #C8235F;
}
