/* Bouton spécial ajouter + */
.tab-special {
  margin-top: -30rpx;
}

.special-plus-circle {
  width: 90rpx;
  height: 90rpx;
  border-radius: 45rpx;
  background-color: #C8235F;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(200, 35, 95, 0.4);
}

.plus-char {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -6rpx;
}

