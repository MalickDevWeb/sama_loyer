.osn-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 280;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
  pointer-events: none;
}

.osn-tab-bar__tabs {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 128rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.16);
  pointer-events: auto;
}

.osn-tab-bar__tab {
  flex: 0.5;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 84rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #009b4d;
  /* transition: color 0.25s, background 0.25s; */
}

.osn-tab-bar__tab--active {
  flex: 1;
  min-width: 176rpx;
  padding: 0 24rpx;
  color: #ffffff;
  background: #009b4d;
  box-shadow: 0 8rpx 18rpx rgba(0, 155, 77, 0.28);
}

.osn-tab-bar__icon {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  display: block;
}

.osn-tab-bar__tab--active .osn-tab-bar__icon {
  filter: brightness(0) invert(1);
} 

.osn-tab-bar__label {
  max-width: 100%;
  margin-left: 14rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  white-space: nowrap;
}
