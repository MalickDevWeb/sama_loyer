<view class="osn-tab-bar">
  <view class="osn-tab-bar__tabs">
    <block wx:for="{{ tabs }}" wx:key="id">
      
      <!-- Bouton central spécial (Ajouter + pour Bailleur) -->
      <view
        wx:if="{{ item.isSpecial }}"
        class="osn-tab-bar__tab tab-special"
        data-tab="{{ item.id }}"
        data-url="{{ item.url }}"
        bindtap="handleTap"
      >
        <view class="special-plus-circle">
          <text class="plus-char">+</text>
        </view>
        <text class="osn-tab-bar__label">{{ item.label }}</text>
      </view>

      <!-- Onglet normal -->
      <view
        wx:else
        class="osn-tab-bar__tab {{ activeTab === item.id ? 'osn-tab-bar__tab--active' : '' }}"
        data-tab="{{ item.id }}"
        data-url="{{ item.url }}"
        bindtap="handleTap"
      >
        <view class="tab-icon-wrapper">
          <view class="tab-svg-icon tab-icon-{{ item.id }} {{ activeTab === item.id ? 'active' : '' }}"></view>
          <text wx:if="{{ item.badge }}" class="tab-badge">{{ item.badge }}</text>
        </view>
        <text class="osn-tab-bar__label {{ activeTab === item.id ? 'active' : '' }}">{{ item.label }}</text>
      </view>

    </block>
  </view>
</view>
