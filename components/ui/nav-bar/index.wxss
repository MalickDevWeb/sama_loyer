/* ============================================================================
   CUSTOM NAV BAR
   ============================================================================ */

.osn-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 300;
  width: 100%;
  box-sizing: content-box;
  background-color: transparent !important;
  border-bottom: 2rpx solid #F3F4F6;
  padding-bottom: 34rpx;
}

.osn-nav-bar--transparent {
  background: transparent !important;
}

.osn-nav-bar--no-border {
  border-bottom: none;
}

.osn-nav-bar__content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  box-sizing: border-box;
  position: relative;
}

.osn-nav-bar__logo {
  width: 118rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.osn-nav-bar__back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  transition: background 0.15s ease-out;
  transform: translateY(-50%);
}

.osn-nav-bar__back:active {
  background: rgba(0, 0, 0, 0.1);
}

.osn-nav-bar__back-icon {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  line-height: 1;
  margin-top: -4rpx;
}

.osn-nav-bar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1c1c;
  text-align: center;
}

.osn-nav-bar__title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 96rpx;
}

.osn-nav-bar__back--hover {
  opacity: 0.6;
  background: rgba(0, 0, 0, 0.05) !important;
  transition: all 0.15s ease-out;
}
