var fr = {
  'app.title': 'Showcase Sonatel Max It',
  'balance.title': 'Solde Orange Money',
  'btn.topup': 'Recharger',
  'btn.offline_test': 'Tester Action Hors-Ligne',
  'state.loading': 'Mode Chargement (Shimmer)',
  'state.success': 'Mode Succes (Donnees)',
  'state.empty': 'Mode Liste Vide'
};

var wo = {
  'app.title': 'Doolilu Sonatel Max It',
  'balance.title': 'Khaloiss Orange Money',
  'btn.topup': 'Doolil',
  'btn.offline_test': 'Jeem action bi reseau amul',
  'state.loading': 'Xaaral tuti (Shimmer)',
  'state.success': 'Baxna (Donnees)',
  'state.empty': 'Dara nekkul ci biir'
};

var en = {
  'app.title': 'Sonatel Max It Showcase',
  'balance.title': 'Orange Money Balance',
  'btn.topup': 'Top up',
  'btn.offline_test': 'Test Offline Action',
  'state.loading': 'Loading State (Shimmer)',
  'state.success': 'Success State (Data)',
  'state.empty': 'Empty State'
};

function t(key, lang) {
  var active = lang || 'fr';
  if (active === 'wo') {
    return wo[key] || fr[key] || key;
  }
  if (active === 'en') {
    return en[key] || fr[key] || key;
  }
  return fr[key] || key;
}

module.exports = {
  t: t
};
